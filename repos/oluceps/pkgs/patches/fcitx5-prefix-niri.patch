+    let niri = Niri::new();
+    let (desired, receiver) = prefix_request();
+    let task = tokio::spawn(run(receiver, niri.socket.clone(), Some(client)));
+    notified(&controller.changed).await;
+    let release = Arc::new(Notify::new());
+    *controller.activate_release.lock().unwrap() = Some(release.clone());
+    desired.send_modify(|request| request.active = false);
+    notified(&controller.activating).await;
+    desired.send_modify(|request| request.active = true);
+    // The timed-out activation is still queued in Fcitx. Its eventual success
+    // must be followed by deactivation while the new prefix remains active.
+    tokio::time::sleep(CALL_TIMEOUT + Duration::from_millis(50)).await;
+    release.notify_one();
+    tokio::time::timeout(Duration::from_secs(3), async {
