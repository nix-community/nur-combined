+use super::*;
+use std::{
+    io::BufRead,
+    process::{Child, Command, Stdio},
+    sync::{
+        atomic::{AtomicI32, AtomicU64, Ordering},
+        Arc, Mutex,
+    },
+};
+use tokio::sync::Notify;
+
+fn prefix_request() -> (watch::Sender<Request>, watch::Receiver<Request>) {
+    watch::channel(Request {
+        active: true,
+        ..Request::default()
+    })
+}
+
+struct Niri {
+    socket: PathBuf,
+    window: Arc<AtomicU64>,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Niri {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let socket = std::env::temp_dir().join(format!(
+            "herdr-input-{}-{}.sock",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        let listener = tokio::net::UnixListener::bind(&socket).unwrap();
+        let window = Arc::new(AtomicU64::new(42));
+        let current = window.clone();
+        let task = tokio::spawn(async move {
+            loop {
+                let (stream, _) = listener.accept().await.unwrap();
+                let mut stream = BufReader::new(stream);
+                let mut request = String::new();
+                stream.read_line(&mut request).await.unwrap();
+                assert_eq!(request, "\"FocusedWindow\"\n");
+                let id = current.load(Ordering::Acquire);
+                let window = if id == 0 {
+                    serde_json::Value::Null
+                } else {
+                    serde_json::json!({"id": id})
+                };
+                let reply = serde_json::json!({"Ok": {"FocusedWindow": window}});
+                stream
+                    .write_all(format!("{reply}\n").as_bytes())
+                    .await
+                    .unwrap();
+            }
+        });
+        Self {
+            socket,
+            window,
+            task,
+        }
+    }
+}
+
+impl Drop for Niri {
+    fn drop(&mut self) {
+        self.task.abort();
+        let _ = std::fs::remove_file(&self.socket);
+    }
+}
+
+#[tokio::test]
+async fn niri_focused_window_handles_focused_and_empty_workspaces() {
+    let niri = Niri::new();
+    assert_eq!(focused_window(&niri.socket).await.unwrap(), Some(42));
+    niri.window.store(0, Ordering::Release);
+    assert_eq!(focused_window(&niri.socket).await.unwrap(), None);
+}
+
+#[tokio::test]
+async fn desktop_input_requests_are_bounded() {
+    let result = bounded(std::future::pending::<zbus::Result<()>>()).await;
+    assert!(result.is_err());
+}
+
+#[derive(Clone)]
+struct Controller {
+    state: Arc<AtomicI32>,
+    calls: Arc<Mutex<Vec<&'static str>>>,
+    changed: Arc<Notify>,
+    state_read: Arc<Notify>,
+    state_release: Arc<Mutex<Option<Arc<Notify>>>>,
+    deactivating: Arc<Notify>,
+    activating: Arc<Notify>,
+    activate_release: Arc<Mutex<Option<Arc<Notify>>>>,
+    serial: Arc<tokio::sync::Mutex<()>>,
+    // Pause a deactivation after delivery, to exercise rapid entry/exit and
+    // client teardown without timing-dependent sleeps.
+    release: Option<Arc<Notify>>,
+}
+
+#[zbus::interface(name = "org.fcitx.Fcitx.Controller1")]
+impl Controller {
+    async fn state(&self) -> i32 {
+        self.state_read.notify_one();
+        let _serial = self.serial.lock().await;
+        let release = self.state_release.lock().unwrap().take();
+        if let Some(release) = release {
+            release.notified().await;
+        }
+        self.state.load(Ordering::Acquire)
+    }
+
+    async fn deactivate(&self) {
+        let _serial = self.serial.lock().await;
+        self.deactivating.notify_one();
+        if let Some(release) = &self.release {
+            release.notified().await;
+        }
+        self.state.store(1, Ordering::Release);
+        self.calls.lock().unwrap().push("deactivate");
+        self.changed.notify_one();
+    }
+
+    async fn activate(&self) {
+        let _serial = self.serial.lock().await;
+        self.activating.notify_one();
+        let release = self.activate_release.lock().unwrap().take();
+        if let Some(release) = release {
+            release.notified().await;
+        }
+        self.state.store(2, Ordering::Release);
+        self.calls.lock().unwrap().push("activate");
+        self.changed.notify_one();
+    }
+}
+
+struct Bus(Child);
+
+impl Bus {
+    async fn start() -> (Self, zbus::Connection, zbus::Connection, Controller) {
+        let mut bus = Self(
+            Command::new("dbus-daemon")
+                .args(["--session", "--nofork", "--print-address=1"])
+                .stdout(Stdio::piped())
+                .spawn()
+                .unwrap(),
+        );
+        let mut address = String::new();
+        std::io::BufReader::new(bus.0.stdout.take().unwrap())
+            .read_line(&mut address)
+            .unwrap();
+        let controller = Controller {
+            state: Arc::new(AtomicI32::new(2)),
+            calls: Arc::default(),
+            changed: Arc::default(),
+            state_read: Arc::default(),
+            state_release: Arc::default(),
+            deactivating: Arc::default(),
+            activating: Arc::default(),
+            activate_release: Arc::default(),
+            serial: Arc::default(),
+            release: None,
+        };
+        let service = zbus::connection::Builder::address(address.trim())
+            .unwrap()
+            .name(FCITX_SERVICE)
+            .unwrap()
+            .serve_at("/controller", controller.clone())
+            .unwrap()
+            .build()
+            .await
+            .unwrap();
+        let client = zbus::connection::Builder::address(address.trim())
+            .unwrap()
+            .build()
+            .await
+            .unwrap();
+        (bus, service, client, controller)
+    }
+}
+
+impl Drop for Bus {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+async fn notified(notify: &Notify) {
+    tokio::time::timeout(Duration::from_secs(3), notify.notified())
+        .await
+        .unwrap();
+}
+
+async fn join(task: tokio::task::JoinHandle<()>) {
+    tokio::time::timeout(Duration::from_secs(3), task)
+        .await
+        .unwrap()
+        .unwrap();
+}
+
+#[tokio::test]
+#[ignore = "requires dbus-daemon; uses a private bus and fake niri, never changes the host IME"]
+async fn fcitx_prefix_restores_only_an_input_method_it_deactivated() {
+    let (_bus, _service, client, controller) = Bus::start().await;
+    let niri = Niri::new();
+    for initial in [0, 1, 2] {
+        controller.state.store(initial, Ordering::Release);
+        let (desired, receiver) = prefix_request();
+        let task = tokio::spawn(run(receiver, niri.socket.clone(), Some(client.clone())));
+        notified(&controller.state_read).await;
+        if initial == 2 {
+            notified(&controller.changed).await;
+            assert_eq!(controller.state.load(Ordering::Acquire), 1);
+        }
+        drop(desired);
+        join(task).await;
+        assert_eq!(controller.state.load(Ordering::Acquire), initial);
+    }
+    assert_eq!(
+        *controller.calls.lock().unwrap(),
+        ["deactivate", "activate"]
+    );
+}
