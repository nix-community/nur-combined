+#[tokio::test]
+#[ignore = "requires dbus-daemon; uses a private bus and fake niri, never changes the host IME"]
+async fn fcitx_saved_state_cannot_reactivate_a_replacement_daemon() {
+    let (_bus, service, client, controller) = Bus::start().await;
+    let niri = Niri::new();
+    let (_desired, receiver) = prefix_request();
+    let saved = switch(&mut Some(client.clone()), &niri.socket, &receiver)
+        .await
+        .unwrap()
+        .unwrap();
+    // The old unique owner disappears, even if a new daemon takes the public name.
+    service.close().await.unwrap();
+    client
+        .object_server()
+        .at("/controller", controller.clone())
+        .await
+        .unwrap();
+    client.request_name(FCITX_SERVICE).await.unwrap();
+    assert!(saved.restore(&niri.socket, None).await.unwrap());
+    assert_eq!(*controller.calls.lock().unwrap(), ["deactivate"]);
+    controller.state.store(2, Ordering::Release);
+    assert!(switch(&mut Some(client), &niri.socket, &receiver)
+        .await
+        .unwrap()
+        .is_some());
+    assert_eq!(
+        *controller.calls.lock().unwrap(),
+        ["deactivate", "deactivate"]
+    );
+}
