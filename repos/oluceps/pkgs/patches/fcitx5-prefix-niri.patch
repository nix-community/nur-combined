+#[tokio::test]
+#[ignore = "requires dbus-daemon; uses a private bus and fake niri, never changes the host IME"]
+async fn fcitx_pending_deactivation_is_restored_on_cancellation_and_client_drop() {
+    for close_client in [false, true] {
+        let (_bus, service, client, controller) = Bus::start().await;
+        let release = Arc::new(Notify::new());
+        service
+            .object_server()
+            .interface::<_, Controller>("/controller")
+            .await
+            .unwrap()
+            .get_mut()
+            .await
+            .release = Some(release.clone());
+        let niri = Niri::new();
+        let (desired, receiver) = prefix_request();
+        let task = tokio::spawn(run(receiver, niri.socket.clone(), Some(client)));
+        notified(&controller.deactivating).await;
+        desired.send_modify(|request| request.active = false);
+        if close_client {
+            drop(desired);
+        }
+        release.notify_one();
+        if !close_client {
+            // Wait for both calls, then close the worker. Notifications can
+            // coalesce, so the recorded calls are the completion condition.
+            tokio::time::timeout(Duration::from_secs(3), async {
+                while controller.calls.lock().unwrap().len() < 2 {
+                    controller.changed.notified().await;
+                }
+            })
+            .await
+            .unwrap();
+            task.abort();
+        } else {
+            join(task).await;
+        }
+        assert_eq!(
+            *controller.calls.lock().unwrap(),
+            ["deactivate", "activate"]
+        );
+    }
+}
