+#[tokio::test]
+#[ignore = "requires dbus-daemon; uses a private bus and fake niri, never changes the host IME"]
+async fn fcitx_worker_coalesces_cancelled_prefix_and_serializes_reentry() {
+    let (_bus, _service, client, controller) = Bus::start().await;
+    let niri = Niri::new();
+    let (desired, receiver) = prefix_request();
+    // The prefix was cancelled before the worker could act.
+    desired.send_modify(|request| request.active = false);
+    drop(desired);
+    run(receiver, niri.socket.clone(), Some(client.clone())).await;
+    assert!(controller.calls.lock().unwrap().is_empty());
+
+    let (desired, receiver) = prefix_request();
+    let task = tokio::spawn(run(receiver, niri.socket.clone(), Some(client)));
+    notified(&controller.changed).await;
+    desired.send_modify(|request| request.active = false);
+    desired.send_modify(|request| request.active = true);
+    // The latest request still wants ASCII: no old restore may run after it.
+    drop(desired);
+    join(task).await;
+    assert_eq!(
+        *controller.calls.lock().unwrap(),
+        ["deactivate", "activate"]
+    );
+}
