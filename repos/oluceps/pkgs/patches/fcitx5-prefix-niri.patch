+//! Fcitx5 prefix input switching on niri/Wayland. Desktop calls run on one
+//! worker, never on the client's input/render path.
+
+use std::{
+    path::PathBuf,
+    sync::atomic::{AtomicBool, Ordering},
+    time::Duration,
+};
+
+use tokio::{
+    io::{AsyncBufReadExt, AsyncReadExt, AsyncWriteExt, BufReader},
+    sync::watch,
+};
+
+use crate::platform::PrefixInputSource;
+
+const CALL_TIMEOUT: Duration = Duration::from_millis(300);
+const FCITX_SERVICE: &str = "org.fcitx.Fcitx5";
+const FCITX_INTERFACE: &str = "org.fcitx.Fcitx.Controller1";
+
+const RESTORE_ATTEMPTS: usize = 3;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct Request {
+    active: bool,
+    focused: bool,
+    focus_generation: u64,
+}
+
+impl Default for Request {
+    fn default() -> Self {
+        Self {
+            active: false,
+            focused: true,
+            focus_generation: 0,
+        }
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct RealPrefixInputSource {
+    request: Request,
+    desired: Option<watch::Sender<Request>>,
+    worker: Option<std::thread::JoinHandle<()>>,
+}
+
+impl PrefixInputSource for RealPrefixInputSource {
+    fn switch_to_ascii(&mut self) {
+        self.request.active = true;
+        if let Some(desired) = &self.desired {
+            desired.send_replace(self.request);
+            return;
+        }
+        let Some(socket) = std::env::var_os("NIRI_SOCKET").map(PathBuf::from) else {
+            return;
+        };
+        let (desired, receiver) = watch::channel(self.request);
+        // A separate runtime lets Drop finish restoring even when the client's
+        // main Tokio runtime is about to shut down on detach or error.
+        let worker = std::thread::Builder::new()
+            .name("herdr-fcitx5".into())
+            .spawn(move || {
+                match tokio::runtime::Builder::new_current_thread()
+                    .enable_all()
+                    .build()
+                {
+                    Ok(runtime) => runtime.block_on(run(receiver, socket, None)),
+                    Err(error) => tracing::debug!(%error, "Fcitx5 worker runtime unavailable"),
+                }
+            });
+        match worker {
+            Ok(worker) => {
+                self.desired = Some(desired);
+                self.worker = Some(worker);
+            }
+            Err(error) => tracing::debug!(%error, "Fcitx5 worker unavailable"),
+        }
+    }
+
+    fn set_focused(&mut self, focused: bool) {
+        if self.request.focused != focused {
+            self.request.focused = focused;
+            self.request.focus_generation = self.request.focus_generation.wrapping_add(1);
+            if let Some(desired) = &self.desired {
+                desired.send_replace(self.request);
+            }
+        }
+    }
+
+    fn restore(&mut self) {
+        self.request.active = false;
+        if let Some(desired) = &self.desired {
+            desired.send_replace(self.request);
+        }
+    }
+}
+
+impl Drop for RealPrefixInputSource {
+    fn drop(&mut self) {
+        drop(self.desired.take());
+        if let Some(worker) = self.worker.take() {
+            // Only client teardown waits. Every desktop request is bounded;
+            // normal prefix transitions remain nonblocking.
+            if worker.join().is_err() {
+                tracing::debug!("Fcitx5 input source worker panicked");
+            }
+        }
+    }
+}
+
+// Closing the channel restores before exiting; aborting the worker could
+// strand the desktop in the temporary input state.
+async fn run(
+    mut desired: watch::Receiver<Request>,
+    socket: PathBuf,
+    mut connection: Option<zbus::Connection>,
+) {
+    let mut restore: Option<Restore> = None;
+    let mut retries = 0;
+    loop {
+        let request = *desired.borrow_and_update();
+        let mut retry = false;
+        if request.focused && request.active {
+            if let Some(saved) = &restore {
+                if saved.activation_dispatched.load(Ordering::Acquire) {
+                    if let Err(error) = saved.reassert_ascii(&socket, &desired).await {
+                        tracing::debug!(%error, "Fcitx5 prefix reentry switch unavailable");
+                        retries += 1;
+                        retry = retries < RESTORE_ATTEMPTS;
+                    }
+                }
+            } else {
+                match switch(&mut connection, &socket, &desired).await {
+                    Ok(saved) => restore = saved,
+                    Err(error) => {
+                        connection = None;
+                        tracing::debug!(%error, "Fcitx5 prefix switch unavailable");
+                    }
+                }
+            }
+        } else if request.focused && !request.active {
+            if let Some(saved) = &restore {
+                match saved.restore(&socket, Some(&desired)).await {
+                    Ok(true) => restore = None,
+                    Ok(false) => {} // A newer prefix or focus event superseded this restore.
+                    Err(error) => {
+                        tracing::debug!(%error, "Fcitx5 prefix restore unavailable");
+                        retries += 1;
+                        retry = retries < RESTORE_ATTEMPTS;
+                    }
+                }
+            }
+        }
+        let closed = if retry {
+            tokio::select! {
+                result = desired.changed() => { retries = 0; result.is_err() }
+                _ = tokio::time::sleep(CALL_TIMEOUT) => false,
+            }
+        } else {
+            retries = 0;
+            desired.changed().await.is_err()
+        };
+        if closed {
+            if let Some(saved) = restore {
+                for _ in 0..RESTORE_ATTEMPTS {
+                    match saved.restore(&socket, None).await {
+                        Ok(true) => break,
+                        Ok(false) => {}
+                        Err(error) => tracing::debug!(%error, "Fcitx5 exit restore unavailable"),
+                    }
+                    tokio::time::sleep(CALL_TIMEOUT).await;
+                }
+            }
+            break;
+        }
+    }
+}
+
+struct Fcitx {
+    connection: zbus::Connection,
+    // Address the existing daemon directly: never auto-start Fcitx or restore
+    // state saved from a daemon that has since been replaced.
+    owner: String,
+}
+
+impl Fcitx {
+    async fn connect(connection: &mut Option<zbus::Connection>) -> zbus::Result<Self> {
+        if connection.is_none() {
+            *connection = Some(bounded(zbus::Connection::session()).await?);
+        }
+        let connection = connection
+            .as_ref()
+            .ok_or_else(|| zbus::Error::Failure("missing session bus".into()))?
+            .clone();
+        let reply = bounded(connection.call_method(
+            Some("org.freedesktop.DBus"),
+            "/org/freedesktop/DBus",
+            Some("org.freedesktop.DBus"),
+            "GetNameOwner",
+            &(FCITX_SERVICE,),
+        ))
+        .await?;
+        Ok(Self {
+            connection,
+            owner: reply.body().deserialize()?,
+        })
+    }
+
+    async fn call<R>(&self, method: &str) -> zbus::Result<R>
+    where
+        R: serde::de::DeserializeOwned + zbus::zvariant::Type,
+    {
+        let reply = bounded(self.connection.call_method(
+            Some(self.owner.as_str()),
+            "/controller",
+            Some(FCITX_INTERFACE),
+            method,
+            &(),
+        ))
+        .await?;
+        reply.body().deserialize()
+    }
+}
+
+struct Restore {
+    fcitx: Fcitx,
+    window: u64,
+    // An Activate may still execute after its reply timed out. A reentered
+    // prefix must enqueue Deactivate after it, rather than trust the saved token.
+    activation_dispatched: AtomicBool,
+}
+
+async fn switch(
+    connection: &mut Option<zbus::Connection>,
+    socket: &std::path::Path,
+    desired: &watch::Receiver<Request>,
+) -> zbus::Result<Option<Restore>> {
+    let request = *desired.borrow();
+    if !request.active || !request.focused || desired.has_changed().is_err() {
+        return Ok(None);
+    }
+    let Some(window) = focused_window(socket).await? else {
+        return Ok(None);
+    };
+    let fcitx = Fcitx::connect(connection).await?;
+    // State 0 has no usable context; 1 is already inactive (direct input).
+    if fcitx.call::<i32>("State").await? != 2 {
+        return Ok(None);
+    }
+    if focused_window(socket).await? != Some(window)
+        || *desired.borrow() != request
+        || desired.has_changed().is_err()
+    {
+        return Ok(None);
+    }
+    // Keep responsibility even on timeout: cancellation cannot retract a
+    // Deactivate already delivered to the daemon. Restore rechecks its state.
+    let restore = Restore {
+        fcitx,
+        window,
+        activation_dispatched: AtomicBool::new(false),
+    };
+    if let Err(error) = restore.fcitx.call::<()>("Deactivate").await {
+        tracing::debug!(%error, "Fcitx5 prefix deactivation failed");
+    }
+    Ok(Some(restore))
+}
+
+impl Restore {
+    async fn reassert_ascii(
+        &self,
+        socket: &std::path::Path,
+        desired: &watch::Receiver<Request>,
+    ) -> zbus::Result<()> {
+        let request = *desired.borrow();
+        if focused_window(socket).await? == Some(self.window)
+            && request.active
+            && request.focused
+            && *desired.borrow() == request
+            && desired.has_changed().is_ok()
+        {
+            self.fcitx.call::<()>("Deactivate").await?;
+            self.activation_dispatched.store(false, Ordering::Release);
+        }
+        Ok(())
+    }
+
+    // false retains the token when focus or a newer prefix prevents restoration;
+    // errors retain it for bounded retries against the same daemon owner.
+    async fn restore(
+        &self,
+        socket: &std::path::Path,
+        desired: Option<&watch::Receiver<Request>>,
+    ) -> zbus::Result<bool> {
+        let request = desired.map(|desired| *desired.borrow());
+        if request.is_some_and(|request| request.active || !request.focused) {
+            return Ok(false);
+        }
+        // Fcitx's controller targets the most recent input context. Do not
+        // reactivate another niri window or override a manual reactivation.
+        let state = match self.fcitx.call::<i32>("State").await {
+            Err(zbus::Error::MethodError(name, _, _))
+                if matches!(
+                    name.as_str(),
+                    "org.freedesktop.DBus.Error.NameHasNoOwner"
+                        | "org.freedesktop.DBus.Error.ServiceUnknown"
+                ) =>
+            {
+                // This unique owner is gone, so its queued commands cannot
+                // affect a replacement daemon. Allow the next prefix to reconnect.
+                return Ok(true);
+            }
+            result => result?,
+        };
+        if state != 1 {
+            return Ok(true);
+        }
+        if focused_window(socket).await? != Some(self.window) {
+            return Ok(desired.is_none());
+        }
+        if desired.is_some_and(|desired| {
+            Some(*desired.borrow()) != request || desired.has_changed().is_err()
+        }) {
+            return Ok(false);
+        }
+        self.activation_dispatched.store(true, Ordering::Release);
+        self.fcitx.call::<()>("Activate").await?;
+        Ok(true)
+    }
+}
+
+async fn bounded<T>(future: impl std::future::Future<Output = zbus::Result<T>>) -> zbus::Result<T> {
+    tokio::time::timeout(CALL_TIMEOUT, future)
+        .await
+        .map_err(|_| zbus::Error::Failure("desktop input source request timed out".into()))?
+}
+
+async fn focused_window(socket: &std::path::Path) -> zbus::Result<Option<u64>> {
+    bounded(async {
+        let mut stream = tokio::net::UnixStream::connect(socket).await?;
+        stream.write_all(b"\"FocusedWindow\"\n").await?;
+        // A niri IPC reply is one JSON line. Bound the read even if the peer
+        // closes without sending a newline or sends an unexpectedly large reply.
+        let mut reply = String::new();
+        BufReader::new(stream.take(64 * 1024))
+            .read_line(&mut reply)
+            .await?;
+        let reply: serde_json::Value = serde_json::from_str(&reply)
+            .map_err(|error| zbus::Error::Failure(error.to_string()))?;
+        let window = reply
+            .get("Ok")
+            .and_then(|reply| reply.get("FocusedWindow"))
+            .ok_or_else(|| zbus::Error::Failure("invalid niri focused-window reply".into()))?;
+        if window.is_null() {
+            return Ok(None);
+        }
+        window
+            .get("id")
+            .and_then(serde_json::Value::as_u64)
+            .map(Some)
+            .ok_or_else(|| zbus::Error::Failure("missing niri window id".into()))
+    })
+    .await
+}
+
