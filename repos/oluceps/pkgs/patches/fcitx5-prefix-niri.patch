+    for manual_reactivation in [false, true] {
+        niri.window.store(42, Ordering::Release);
+        controller.state.store(2, Ordering::Release);
+        let (desired, receiver) = prefix_request();
+        let task = tokio::spawn(run(receiver, niri.socket.clone(), Some(client.clone())));
+        notified(&controller.changed).await;
+        if manual_reactivation {
+            controller.state.store(2, Ordering::Release);
+        } else {
+            niri.window.store(99, Ordering::Release);
+        }
+        drop(desired);
+        join(task).await;
+    }
+    assert_eq!(
+        *controller.calls.lock().unwrap(),
+        ["deactivate", "deactivate"]
+    );
+}
