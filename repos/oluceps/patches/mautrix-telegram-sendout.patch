@@ -0,0 +1,123 @@
+package updates
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"go.uber.org/zap"
+
+	"go.mau.fi/mautrix-telegram/pkg/gotd/tg"
+)
+
+func newSendOutState(out chan tracedUpdate) *channelState {
+	return &channelState{
+		updates: make(chan channelUpdate, 1),
+		out:     out,
+		log:     zap.NewNop(),
+	}
+}
+
+// TestChannelStateSendOutDeadlock reproduces the deadlock: both s.out and
+// s.updates are full, and the only reader of s.out (the main loop) cannot
+// proceed until it manages to push into s.updates.
+func TestChannelStateSendOutDeadlock(t *testing.T) {
+	out := make(chan tracedUpdate, 1)
+	s := newSendOutState(out)
+
+	// Fill both bounded queues.
+	out <- tracedUpdate{}
+	s.updates <- channelUpdate{}
+
+	want := &tg.Updates{Updates: []tg.UpdateClass{&tg.UpdateNewMessage{}}}
+	got := make(chan tg.UpdatesClass, 2)
+
+	// Emulate the single main loop: it only reads s.out after sending the
+	// next item to s.updates, which is initially blocked because the queue
+	// is full.
+	go func() {
+		s.updates <- channelUpdate{}
+		for i := 0; i < 2; i++ {
+			tu := <-out
+			if tu.update != nil {
+				got <- tu.update
+			}
+		}
+	}()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+
+	done := make(chan error, 1)
+	go func() {
+		done <- s.sendOut(ctx, tracedUpdate{update: want})
+	}()
+
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("sendOut returned error: %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("sendOut did not complete: deadlock")
+	}
+
+	for {
+		select {
+		case u := <-got:
+			if u == want {
+				return
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("expected update was not delivered to s.out")
+		}
+	}
+}
+
+func TestChannelStateSendOutContextCancel(t *testing.T) {
+	s := newSendOutState(make(chan tracedUpdate))
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() {
+		done <- s.sendOut(ctx, tracedUpdate{update: &tg.Updates{}})
+	}()
+
+	select {
+	case <-time.After(50 * time.Millisecond):
+		cancel()
+	case <-done:
+		t.Fatal("sendOut returned before context cancellation")
+	}
+
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("sendOut returned nil error after cancellation")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("sendOut did not exit on context cancellation")
+	}
+}
+
+func TestChannelStateSendOut(t *testing.T) {
+	out := make(chan tracedUpdate, 1)
+	s := newSendOutState(out)
+
+	want := &tg.Updates{}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+
+	if err := s.sendOut(ctx, tracedUpdate{update: want}); err != nil {
+		t.Fatalf("sendOut returned error: %v", err)
+	}
+
+	select {
+	case tu := <-out:
+		if tu.update != want {
+			t.Fatalf("unexpected update: %T", tu.update)
+		}
+	default:
+		t.Fatal("sendOut did not deliver update to s.out")
+	}
+}
