direction: down
vars: { d2-config: { theme-id: 0 } }
classes: {
  node: { style: { fill: "#eef4ff"; stroke: "#37628b"; border-radius: 10; font-size: 20 } }
  gateway: { style: { fill: "#e6f4ed"; stroke: "#31765b"; border-radius: 10; font-size: 20 } }
  note: { style: { fill: "#fff6df"; stroke: "#aa8330"; border-radius: 8; font-size: 18 } }
}
title: "Config Compiler: Declarations to System Setup" { shape: text; style.font-size: 30 }
declarations: "Workload and route declarations\nTypes, identity, and authorization\nHTTP gateway choices" { class: node }
local: "Local exported data\nService identities, listener addresses, and ports\nReadable without egress lookup" { class: node }
aggregate: "Static catalogs\nDeclared identities and listeners\nBuilt during Nix evaluation" { class: gateway }
compile: "Fixed output schema\nservices, sockets, userGroups, users\ntmpfiles, registrations, publications, assertions" { class: gateway }
outputs: "Systemd setup\nSPIRE registration\nStatic DNS" { class: node }
native: "Gateway configuration generators\nObservability Caddy / Internet Envoy" { class: node }
notes: "Nix reads local listener addresses and identities without resolving egress.\nEndpoint selection stays fixed until configuration changes." { class: note }
declarations -> local
local -> aggregate
aggregate -> compile
declarations -> compile: "Local configuration"
compile -> outputs
aggregate -> outputs: "Catalog data"
declarations -> native: "Gateway settings"
native -> outputs: "Gateway configuration"
# Invisible edges place the title and note on their own rows.
title -> declarations: { style.opacity: 0 }
outputs -> notes: { style.opacity: 0 }
