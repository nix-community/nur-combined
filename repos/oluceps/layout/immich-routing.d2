direction: down
vars: { d2-config: { theme-id: 0 } }
classes: {
  node: { style: { fill: "#eef4ff"; stroke: "#37628b"; border-radius: 10; font-size: 20 } }
  gateway: { style: { fill: "#e6f4ed"; stroke: "#31765b"; border-radius: 10; font-size: 20 } }
  note: { style: { fill: "#fff6df"; stroke: "#aa8330"; border-radius: 8; font-size: 18 } }
}
title: "Immich: Public and Internal Routes" { shape: text; style.font-size: 30 }
public: "Public Caddy entry" { class: node }
internal: "Internal Caddy entry" { class: node }
auth: "Public main-site gate\nCaddy Basic Auth" { class: gateway }
ipp: "Immich Public Proxy (IPP)\nShare-link permissions apply\nNo Caddy Basic Auth" { class: gateway }
main: "Immich main site\nKeeps its own login" { class: node }
public -> auth: "Other paths"
auth -> main: "After Basic Auth\nRealm mTLS"
internal -> main: "Other paths\nNo Basic Auth, Realm mTLS"
public -> ipp: "/share and /share/*\nRealm mTLS"
internal -> ipp: "/share and /share/*\nRealm mTLS"
ipp -> main: "Separate IPP identity\nRealm mTLS"
note: "caddy/immich.nix builds both sets of routing rules." { class: note }
# Invisible edges arrange the title and note.
title -> public: { style.opacity: 0 }
title -> internal: { style.opacity: 0 }
main -> note: { style.opacity: 0 }
