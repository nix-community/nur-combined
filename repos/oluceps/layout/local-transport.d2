direction: down
vars: { d2-config: { theme-id: 0 } }
classes: {
  node: { style: { fill: "#eef4ff"; stroke: "#37628b"; border-radius: 10; font-size: 20 } }
  gateway: { style: { fill: "#e6f4ed"; stroke: "#31765b"; border-radius: 10; font-size: 20 } }
  note: { style: { fill: "#fff6df"; stroke: "#aa8330"; border-radius: 8; font-size: 18 } }
}
title: "Local Transport: App to Backend" { shape: text; style.font-size: 30 }
app: "App private network space\nUnix socket, or optional TCP adapter\nTCP adapter uses 127.0.0.1" { class: node }
socket: "Unix egress socket\n/run/realm/<app>/egress/<route>.sock" { class: node }
client: "Ghostunnel client\nGets caller identity from local SPIRE Agent\nChecks expected receiver identity" { class: gateway }
server: "Ghostunnel server\nGets receiver identity locally\nAllowed IDs authorize the caller" { class: gateway }
backend: "Private backend\nUnix socket or adapter to its loopback listener" { class: node }
app -> socket: "Direct socket or local TCP adapter"
socket -> client
client -> server: "mTLS, including local calls"
server -> backend
native: "Alternate receiver\nObservability Caddy / Internet Envoy\nChecks mTLS without a Ghostunnel server" { class: gateway }
peer: "Alternate: local PostgreSQL\nUnix socket with peer auth\nNo Ghostunnel or mTLS" { class: node }
note: "PostgreSQL peer auth checks the local user.\nReceiver authorization must allow the caller identity." { class: note }

# Invisible edges place title, alternates, and note on separate rows.
title -> app: { style.opacity: 0 }
backend -> native: { style.opacity: 0 }
native -> peer: { style.opacity: 0 }
peer -> note: { style.opacity: 0 }
