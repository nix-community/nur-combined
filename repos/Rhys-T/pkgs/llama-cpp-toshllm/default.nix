{ lib, fetchFromGitHub, llama-cpp, avx2Support ? true, maintainers }: let
    toshllm-version = "0.88.0";
    toshllm-hash = "sha256-5VT6KCEL0Zamn02U7iVUs6e6YJTi+nRgpMJH/TaWljU=";
    llama-cpp-rev = "b1b770d90d94cad9e9ea5b993bdbc383a522fb28";
    llama-cpp-hash = "sha256-aYziwYzK9Zj7sopAEsrANhMGs4BO0F2g0cDCGmYLxDA=";
    llama-cpp-npmDepsHash = "sha256-5WvxC4lsyJ7g10Qd+UX7JsjyYztD0IiUt9Vep/F/c0A=";
    
    toshllmSrc = fetchFromGitHub {
        owner = "engeldlgado";
        repo = "toshllm";
        tag = "v${toshllm-version}";
        sparseCheckout = [
            "scripts/build-engines.sh"
            "patches/llama"
        ];
        nonConeMode = true;
        hash = toshllm-hash;
    };
    llama-cpp' = llama-cpp.override {
        metalSupport = true;
        vulkanSupport = false;
    };
    llama-cpp'' = llama-cpp'.overrideAttrs (finalAttrs: old: {
        pname = "${lib.getName llama-cpp}-toshllm";
        version = toshllm-version;
        src = fetchFromGitHub {
            owner = "ggml-org";
            repo = "llama.cpp";
            rev = llama-cpp-rev;
            hash = llama-cpp-hash;
        };
        npmDepsHash = llama-cpp-npmDepsHash;
        npmDeps = old.npmDeps.overrideAttrs {
            inherit (finalAttrs) prePatch toshllmSrc;
        };
        inherit toshllmSrc;
        # package-lock.patch is currently needed to prevent:
        # npm error `npm ci` can only install packages when your package.json and package-lock.json or npm-shrinkwrap.json are in sync. Please update your lock file with `npm install` before continuing.
        # Patch was generated by:
        # - Checking out llama.cpp v1.0.0.
        # - Importing the ToshLLM patches via StGit.
        # - Hand-editing the spurious "node_modules/@emnapi/core/node_modules/@emnapi/wasi-threads" entry out of "packages".
        # - Running `nix-shell -p nodejs --command 'npm install --package-lock-only'` to re-normalize it.
        # - `git diff > /path/to/nur-packages/pkgs/llama-cpp-toshllm/package-lock.patch`
        prePatch = (old.prePatch or "") + ''
            patches+=" $(find "$toshllmSrc/patches/llama" -name '*.patch' -print | \
                awk -F/ '{print $NF"\t"$0}' | sort | cut -f2-) ${./package-lock.patch}"
        '';
        cmakeFlags = builtins.filter (flag: !(lib.any (x: lib.hasInfix x flag) [
            "LLAMA_BUILD_NUMBER"
            "LLAMA_BUILD_COMMIT"
            "CMAKE_CXX_FLAGS"
        ])) (old.cmakeFlags or []) ++ [
            (lib.cmakeFeature "LLAMA_BUILD_NUMBER" "0")
            (lib.cmakeFeature "LLAMA_BUILD_COMMIT" (builtins.substring 0 7 llama-cpp-rev))
            (let
                myCXXFlags = "-DTOSH_VERSION=${finalAttrs.version}";
                oldCXXFlagsFlag = lib.findFirst (lib.hasInfix "CMAKE_CXX_FLAGS") null (old.cmakeFlags or []);
                newCXXFlagsFlag = if oldCXXFlagsFlag != null then "${oldCXXFlagsFlag} ${myCXXFlags}" else lib.cmakeFeature "CMAKE_CXX_FLAGS" myCXXFlags;
            in newCXXFlagsFlag)
            # Match ISA_FLAGS in `scripts/build-engines.sh`:
            (lib.cmakeBool "GGML_SSE42" avx2Support)
            (lib.cmakeBool "GGML_AVX" avx2Support)
            (lib.cmakeBool "GGML_AVX2" avx2Support)
            (lib.cmakeBool "GGML_FMA" avx2Support)
            (lib.cmakeBool "GGML_F16C" avx2Support)
            (lib.cmakeBool "GGML_BMI2" avx2Support)
            (lib.cmakeBool "GGML_AVX_VNNI" false)
            (lib.cmakeBool "GGML_AVX512" false)
        ];
        passthru = (old.passthru or {}) // {
            updateScript = ./update.sh;
            _pkgForUpdater = finalAttrs.finalPackage // {
                src = finalAttrs.toshllmSrc;
                llama-cpp-src = finalAttrs.src;
            };
        };
    });
    llama-cpp''' = lib.addMetaAttrs {
        description = lib.replaceStrings [") ("] ["; "] "${llama-cpp.meta.description or "llama-cpp"} (ToshLLM patched version, tuned for Intel Macs with AMD GPUs)";
        homepage = "https://toshllm.com/";
        license = lib.licenses.gpl3Plus; # ? Not sure if this applies to the engine patches, or just the GUI app, but should be a safe guess
        platforms = ["x86_64-darwin"];
        maintainers = [maintainers.Rhys-T];
    } llama-cpp'';
in llama-cpp'''
