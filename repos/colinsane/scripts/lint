#!/usr/bin/env -S NIX_BUILD_SHELL=/bin/sh nix-shell
#!nix-shell -i bash ../. -A static-nix-shell.mkBash --arg packages 'ps: [ ps.bash ps.deadnix ps.mdformat ps.nixfmt ps.ruff ps.shfmt-sane ps.statix ps.stylua ps.treefmt ps.treefmt-nix-shell ]'

# docs:
# statix: <https://github.com/molybdenumsoftware/statix>

# TODO:
