#!/usr/bin/env -S NIX_BUILD_SHELL=/bin/sh nix-shell
#!nix-shell -i bash ../. -A static-nix-shell.mkBash --arg packages 'ps: [ ps.bash ps.deadnix ps.nixfmt ps.statix ps.treefmt ps.treefmt-nix-shell ]'

# docs:
# statix: <https://github.com/molybdenumsoftware/statix>

# TODO:
# - [ ] investigate .editorconfig
# - [ ] enable on full tree
# - [ ] apply treefmt to ALL tracked files, not just nix files

usage() {
  echo "lint: flag style errors across the repo"
  echo ""
  echo "usage: lint [options] [path ...]"
  echo ""
  echo "options:"
  echo "- --fix: auto-fix source files to comply with the lint rules."
  echo "         this is best-effort, and should be reviewed before accepting."
  echo "- --format: format (reflow) the given paths"
  echo ""
  echo "if PATH is omitted, a default coverage set is determined"
  exit "$@"
}

# TODO: enable more in time...
DEFAULT_PATHS=(pkgs hosts/common/programs)

doFix=
doFormat=
paths=()
parseArgs() {
  while [ "$#" -ne 0 ]; do
    local arg=$1
    shift
    case "$arg" in
      (-h|--help)
        usage
        ;;
      (--fix)
        doFix=1
        ;;
      (--format)
        doFormat=1
        ;;
      (*)
        paths+=("$arg")
        ;;
    esac
  done

  if ! (( ${#paths[@]} )); then
    paths=("${DEFAULT_PATHS[@]}")
  fi
}

parseArgs "$@"

lint_deadnix() {
  local flags=()
  if [[ -n "$doFix" ]]; then
    flags+=(--edit)
  fi
  deadnix "${flags[@]}" "$@"
}

lint_statix() {
  if [[ -n "$doFix" ]]; then
    statix fix "$@"
  else
    statix check "$@"
  fi
}

maybe_format() {
  if [[ -n "$doFormat" ]]; then
    treefmt "$@"
  fi
}

for path in "${paths[@]}"; do
  if [[ -f "$path" ]] && ! [[ "$path" =~ ^.*\.nix$ ]]; then
    # if called *directly* on a non-nix file, these linters will error.
    # calling on a directory is safe, even if that directory contains non-nix.
    continue
  fi
  lint_deadnix "$path"
  lint_statix "$path"
done
maybe_format "${paths[@]}"
