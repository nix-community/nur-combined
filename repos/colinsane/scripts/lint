#   - [ ] #!/usr/bin/env sh

usage() {
  echo "lint: flag style errors across the repo"
  echo ""
  echo "usage: lint [options] [path ...]"
  echo ""
  echo "options:"
  echo "- --fix: auto-fix source files to comply with the lint rules."
  echo "         this is best-effort, and should be reviewed before accepting."
  echo "- --format: format (reflow) the given paths"
  echo ""
  echo "if PATH is omitted, a default coverage set is determined"
  exit "$@"
}

# TODO: enable more in time...
DEFAULT_PATHS=(
  doc
  # hosts/by-name
  hosts/common
  # hosts/modules
  integrations
  # modules
  overlays
  pkgs
  scripts
  templates
)

doFix=
doFormat=
paths=()
parseArgs() {
  while [ "$#" -ne 0 ]; do
    local arg=$1
    shift
    case "$arg" in
      (-h | --help)
        usage
        ;;
      (--fix)
        doFix=1
        ;;
      (--format)
        doFormat=1
        ;;
      (*)
        paths+=("$arg")
        ;;
    esac
  done

  if ! ((${#paths[@]})); then
    paths=("${DEFAULT_PATHS[@]}")
  fi
}

parseArgs "$@"

lint_deadnix() {
  local flags=()
  if [[ -n "$doFix" ]]; then
    flags+=(--edit)
  fi
  deadnix "${flags[@]}" "$@"
}

lint_statix() {
  if [[ -n "$doFix" ]]; then
    statix fix "$@"
  else
    statix check "$@"
  fi
}

maybe_format() {
  if [[ -n "$doFormat" || -n "$doFix" ]]; then
    treefmt "$@"
  fi
  # treefmt has no "dry run" option, else we would show a proposed diff, or just "files not adhering to treefmt" here.
}

for path in "${paths[@]}"; do
  if [[ -f "$path" ]] && ! [[ "$path" =~ ^.*\.nix$ ]]; then
    # if called *directly* on a non-nix file, these linters will error.
    # calling on a directory is safe, even if that directory contains non-nix.
    continue
  fi
  lint_deadnix "$path"
  lint_statix "$path"
done
maybe_format "${paths[@]}"
