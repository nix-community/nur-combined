From 08205ae349b2101ce527ce44c4925036774e15f8 Mon Sep 17 00:00:00 2001
From: Sizhe Zhao <prc.zhao@outlook.com>
Date: Fri, 19 Dec 2025 14:28:52 +0800
Subject: [PATCH] buildRustPackage: use cargoHash from finalAttrs

---
 pkgs/build-support/rust/build-rust-package/default.nix | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/pkgs/build-support/rust/build-rust-package/default.nix b/pkgs/build-support/rust/build-rust-package/default.nix
index 06f96b75ce05c03713deb61f21130e6fcaa973d4..93abc3b43bb8c4674d6a8eb8900ef6b1ab56ce57 100644
--- a/pkgs/build-support/rust/build-rust-package/default.nix
+++ b/pkgs/build-support/rust/build-rust-package/default.nix
@@ -62,6 +62,7 @@ lib.extendMkDerivation {
       meta ? { },
       useFetchCargoVendor ? true,
       cargoDeps ? null,
+      cargoHash ? null,
       cargoLock ? null,
       cargoVendorDir ? null,
       checkType ? buildType,
@@ -111,7 +112,7 @@ lib.extendMkDerivation {
           cargoDeps
         else if cargoLock != null then
           importCargoLock cargoLock
-        else if args.cargoHash or null == null then
+        else if cargoHash == null then
           throw "cargoHash, cargoVendorDir, cargoDeps, or cargoLock must be set"
         else
           fetchCargoVendor (
@@ -127,11 +128,14 @@ lib.extendMkDerivation {
                 ;
               name = cargoDepsName;
               patches = cargoPatches;
-              hash = args.cargoHash;
+              hash = finalAttrs.cargoHash;
             }
             // depsExtraArgs
           );
-      inherit buildAndTestSubdir;
+      inherit
+        buildAndTestSubdir
+        cargoHash
+        ;
 
       cargoBuildType = buildType;
 
