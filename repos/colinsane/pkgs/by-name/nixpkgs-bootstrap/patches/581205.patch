From 565622a14a3d312ae83a8ef0da3b2c3d424c9b13 Mon Sep 17 00:00:00 2001
From: kashw2 <supra4keanu@hotmail.com>
Date: Sat, 31 Oct 2026 11:30:12 +1100
Subject: [PATCH] diffutils: fix pkgsStatic build

gnulib's threadlib only disables weak symbols for static builds when it
sees -static in LDFLAGS. Our cc-wrapper injects -static via
NIX_CFLAGS_LINK, while pkgsStatic is a cross build so the runtime probe
is skipped and gl_cv_have_weak is then assumed to be set as yes. The
weak pthread_create etc. references then resolve to NULL.

Fixes #580949
---
 pkgs/by-name/di/diffutils/package.nix | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/pkgs/by-name/di/diffutils/package.nix b/pkgs/by-name/di/diffutils/package.nix
index 7fba0dc6df86989e4cd1ecc3a9b9ba72d63b8699..09d244beb3514de206e28f7510a5f3f9e6152a65 100644
--- a/pkgs/by-name/di/diffutils/package.nix
+++ b/pkgs/by-name/di/diffutils/package.nix
@@ -77,6 +77,12 @@ stdenv.mkDerivation (finalAttrs: {
     ]
     ++ lib.optionals (stdenv.buildPlatform != stdenv.hostPlatform) [
       "gl_cv_func_strcasecmp_works=yes"
+    ]
+    # gnulib only detects static linking via `-static` in LDFLAGS, but our
+    # wrapper injects it through NIX_CFLAGS_LINK. Weak pthread references then
+    # resolve to NULL, breaking the multithreaded gnulib tests.
+    ++ lib.optionals stdenv.hostPlatform.isStatic [
+      "gl_cv_have_weak=no"
     ];
 
   # Test failure on QEMU only (#300550)
