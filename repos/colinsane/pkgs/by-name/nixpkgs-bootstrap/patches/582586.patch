From 84161d511b38ce79579fd76e372f3314e6445f34 Mon Sep 17 00:00:00 2001
From: Colin <colin@uninsane.org>
Date: Tue, 3 Nov 2026 08:20:47 +0000
Subject: [PATCH] bind: respect NIX_BUILD_CORES in checkPhase

ISC_TASK_WORKERS is read by bind
[here](https://gitlab.isc.org/isc-projects/bind9/-/blob/769c3fb93a0a06b2f1f44b5156c4f7e52f57ef78/tests/isc/doh_test.c#L289)
and defaults to all available CPUs if unset.

some of these tests are quite heavy, so it's nice to have
`nix-build -A bind --cores 8` actually use only 8 cores instead of
loading all available cores.
---
 pkgs/by-name/bi/bind/package.nix | 1 +
 1 file changed, 1 insertion(+)

diff --git a/pkgs/by-name/bi/bind/package.nix b/pkgs/by-name/bi/bind/package.nix
index bfdc26b7ef6349b8dbb60c8589a997c92a6d37da..eaa7a28e909461e92141cf8cb7c4961bbefa712d 100644
--- a/pkgs/by-name/bi/bind/package.nix
+++ b/pkgs/by-name/bi/bind/package.nix
@@ -119,6 +119,7 @@ stdenv.mkDerivation (finalAttrs: {
     cmocka
   ];
   preCheck = ''
+    export ISC_TASK_WORKERS=$NIX_BUILD_CORES
     # skip timezone-related tests, they are flaky inside the nix sandbox
     sed -i '/^ISC_TEST_ENTRY(isc_time_formatISO8601L/d' tests/isc/time_test.c
     sed -i '/^ISC_TEST_ENTRY(isc_time_formattimestamp_test/d' tests/isc/time_test.c
