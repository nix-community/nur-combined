class FetchFormat(enum.StrEnum):
  MARKDOWN = "markdown"
  HTML = "html"
  RAW = "raw"


class Network(enum.StrEnum):
  WAN = "wan"
  TOR = "tor"


def is_onion_url(url: str) -> bool:
  hostname = urllib.parse.urlparse(url).hostname
  return bool(hostname and hostname.lower().rstrip(".").endswith(".onion"))


def find_tor_geoip(name: str) -> Optional[str]:
  for data_dir in os.environ.get("XDG_DATA_DIRS", "").split(":"):
    if data_dir:
      path = os.path.join(data_dir, "tor", name)
      if os.path.isfile(path):
        return path
  return None


def find_tor_geoip_from_path(name: str) -> Optional[str]:
  tor_path = shutil.which("tor")
  if not tor_path:
    return None
  tor_root = os.path.dirname(os.path.dirname(tor_path))
  path = os.path.join(tor_root, "share", "tor", name)
  return path if os.path.isfile(path) else None


class TorConnection:
  def __init__(self) -> None:
    self._data_dir: Optional[tempfile.TemporaryDirectory[str]] = None
    self._process = None
    self._controller: Optional[Controller] = None
    self.socks_port: Optional[int] = None

  def __enter__(self) -> "TorConnection":
    data_dir = tempfile.TemporaryDirectory(prefix="sane-fetch-tor-")
    self._data_dir = data_dir
    control_socket = os.path.join(data_dir.name, "control")
    config = {
      "DataDirectory": data_dir.name,
      "ClientOnly": "1",
      "SocksPort": "127.0.0.1:auto",
      "ControlSocket": control_socket,
      "CookieAuthentication": "1",
      "AvoidDiskWrites": "1",
      "Log": ["NOTICE stdout"],
    }
    geoip = find_tor_geoip("geoip") or find_tor_geoip_from_path("geoip")
    geoip6 = find_tor_geoip("geoip6") or find_tor_geoip_from_path("geoip6")
    if geoip:
      config["GeoIPFile"] = geoip
    if geoip6:
      config["GeoIPv6File"] = geoip6

    try:
      tor = shutil.which("tor")
      assert tor is not None, "tor executable is not available"
      self._process = launch_tor_with_config(
        config,
        tor_cmd=tor,
        timeout=180,
        take_ownership=True,
      )
      self._controller = Controller.from_socket_file(control_socket)
      self._controller.authenticate()
      listeners = self._controller.get_listeners(Listener.SOCKS)
      assert len(listeners) == 1 and listeners[0][0] in ("127.0.0.1", "localhost"), \
        f"unexpected Tor SOCKS listeners: {listeners}"
      self.socks_port = int(listeners[0][1])
      return self
    except Exception:
      self.__exit__(None, None, None)
      raise

  def __exit__(self, exc_type, exc_value, traceback) -> None:
    if self._controller is not None:
      try:
        self._controller.close()
      except Exception:
        pass
      self._controller = None

    if self._process is not None:
      try:
        self._process.terminate()
        self._process.wait(timeout=10)
      except Exception:
        try:
          self._process.kill()
          self._process.wait(timeout=10)
        except Exception:
          pass
      self._process = None

    if self._data_dir is not None:
      self._data_dir.cleanup()
      self._data_dir = None
    self.socks_port = None


class TorHTTPCrawlerStrategy(AsyncHTTPCrawlerStrategy):
  def __init__(self, socks_port: int, **kwargs: Any):
    super().__init__(**kwargs)
    self.socks_port = socks_port

  async def start(self) -> None:
    if not self._session:
      connector = ProxyConnector.from_url(
        f"socks5://127.0.0.1:{self.socks_port}",
        rdns=True,
        limit=self.max_connections,
        ttl_dns_cache=self.dns_cache_ttl,
      )
      self._session = aiohttp.ClientSession(
        headers=dict(self._BASE_HEADERS),
        connector=connector,
        timeout=aiohttp.ClientTimeout(total=self.DEFAULT_TIMEOUT),
      )


P = ParamSpec("P")
R = TypeVar("R")


def make_sync(f: Callable[P, Coroutine[Any, Any, R]]) -> Callable[P, R]:
  def wrapped(*args: P.args, **kwargs: P.kwargs) -> R:
    try:
      return asyncio.run(f(*args, **kwargs))
    except RuntimeError:
      # XXX idk what this is about. Kimi thinks that asyncio isn't re-entrant (i.e. async -> sync -> async would deadlock)
      # and i don't doubt it because async is fuck.
      with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:
        return pool.submit(asyncio.run, f(*args, **kwargs)).result()

  return wrapped


@make_sync
async def crawl4ai_fetch(url: str, network: Network) -> CrawlResultContainer:
  if network is Network.TOR:
    with TorConnection() as tor:
      strategy = TorHTTPCrawlerStrategy(socks_port=tor.socks_port)
      async with AsyncWebCrawler(crawler_strategy=strategy) as crawler:
        return await crawler.arun(
          url=url,
          config=CrawlerRunConfig(cache_mode=CacheMode.BYPASS),
        )
  elif network is Network.WAN:
    async with AsyncWebCrawler(crawler_strategy=AsyncHTTPCrawlerStrategy()) as crawler:
      return await crawler.arun(url=url)


def extract_pdf_text(path: str) -> str:
  reader = PdfReader(path)
  return "\n".join(page.extract_text() for page in reader.pages)


def do_fetch(url: str, format: FetchFormat, network: Optional[Network]) -> Union[str, bytes]:
  if network is None:
    network = Network.TOR if is_onion_url(url) else Network.WAN

  result = crawl4ai_fetch(url, network)

  def get_pdf_content() -> Optional[str]:
    if result.downloaded_files:
      path = result.downloaded_files[0]
      with open(path, "rb") as f:
        is_pdf = f.read(4) == b"%PDF"
      if is_pdf:
        return extract_pdf_text(path)

  def get_file_content() -> Optional[Union[str, bytes]]:
    if result.downloaded_files:
      try:
        with open(result.downloaded_files[0], "r") as f:
          return f.read()
      except:
        with open(result.downloaded_files[0], "rb") as f:
          return f.read()

  if format is FetchFormat.HTML:
    results = [
      lambda: result.html,
      lambda: result.cleaned_html,
      get_pdf_content,
      get_file_content,
    ]
  elif format is FetchFormat.MARKDOWN:
    results = [
      get_pdf_content,
      lambda: result.markdown,
      lambda: result.cleaned_html,
      lambda: result.html,
      get_file_content,
    ]
  elif format is FetchFormat.RAW:
    results = [
      get_file_content,
      lambda: result.markdown,
      lambda: result.html,
      lambda: result.cleaned_html,
    ]


  for get in results:
    if r := get():
      return r
  else:
    raise RuntimeError(f"failed to extract content. url={url}, result={result}")


def cli_fetch(url: str, format: FetchFormat, network: Optional[Network]) -> None:
  result = do_fetch(url, format=format, network=network)
  if isinstance(result, bytes):
    sys.stdout.buffer.write(result)
  else:
    print(result)


def cli_mcp(default_format: FetchFormat) -> None:
  mcp = FastMCP("sane-fetch")

  @mcp.tool()
  def fetch(
    url: str,
    format: FetchFormat = default_format,
    network: Optional[Network] = None,
  ) -> str:
    """Fetch a URL and return its content as markdown, HTML, or raw bytes (base64-encoded)."""
    try:
      result = do_fetch(url, format=format, network=network)
      if isinstance(result, bytes):
        # MCP (JSON-RPC) passes binary via base64 encoding and a specific schema (BlobResourceContentsSchema).
        # i don't know how to manage the schema, so the best for now is to send inline.
        return base64.b64encode(result).decode('ascii')
      return result
    except Exception as e:
      return str(e)

  mcp.run(transport="stdio")


def add_format_options(parser: argparse.ArgumentParser, suppress: bool = False) -> None:
  default = argparse.SUPPRESS if suppress else FetchFormat.MARKDOWN
  format_group = parser.add_mutually_exclusive_group()
  format_group.add_argument("--html", action="store_const", const=FetchFormat.HTML, dest="format", default=default, help="Return content as HTML")
  format_group.add_argument("--markdown", action="store_const", const=FetchFormat.MARKDOWN, dest="format", default=default, help="Return content as markdown (default)")
  format_group.add_argument("--raw", action="store_const", const=FetchFormat.RAW, dest="format", default=default, help="Return raw HTTP response body")


def add_network_options(parser: argparse.ArgumentParser) -> None:
  parser.set_defaults(network=None)
  network_group = parser.add_mutually_exclusive_group()
  network_group.add_argument(
    "--tor",
    action="store_const",
    const=Network.TOR,
    dest="network",
    help="Use the Tor network",
  )
  network_group.add_argument(
    "--wan",
    action="store_const",
    const=Network.WAN,
    dest="network",
    help="Use the WAN network",
  )


def main():
  parser = argparse.ArgumentParser(description="robot-friendly URL fetcher")
  add_format_options(parser)

  subparsers = parser.add_subparsers(dest="command")

  fetch_parser = subparsers.add_parser("fetch", help="Fetch a URL and print its content")
  add_format_options(fetch_parser, suppress=True)
  add_network_options(fetch_parser)
  fetch_parser.add_argument("url", help="URL to fetch")

  mcp_parser = subparsers.add_parser("mcp", help="Run as an MCP server over stdio")
  add_format_options(mcp_parser, suppress=True)

  args = parser.parse_args()

  if args.command == "fetch":
    cli_fetch(args.url, format=args.format, network=args.network)
  elif args.command == "mcp":
    cli_mcp(default_format=args.format)
  else:
    parser.print_help()
    raise ValueError(f"unknown command: {args.command}")


if __name__ == "__main__":
    main()
