#!/usr/bin/env -S NIX_BUILD_SHELL=/bin/sh nix-shell
#!nix-shell -i bash ../../.. -A static-nix-shell.mkBash --arg packages 'ps: [ ps.bash ps.git ]'
set -euo pipefail

usage() {
  echo "git-pr PR_NUMBER: pull and switch into the PR branch"
}

pr_num=
parseArgs() {
  while [ "$#" -ne 0 ]; do
    local arg=$1
    shift
    case $arg in
      (-h|--help)
        usage
        exit 0
        ;;
      (*)
        if [ -n "$pr_num" ]; then
          usage
          exit 1
        fi;
        pr_num="$arg"
        ;;
    esac
  done
}

parseArgs "$@"

git fetch upstream "pull/$pr_num/head:pr-$pr_num" >&2

if git rev-parse --show-toplevel 2>/dev/null; then
  # switch the current checkout
  git switch "pr-$pr_num" >&2
  echo "$PWD"
else
  # checkout into a worktree
  git worktree add "pr-$pr_num" >&2
  echo "$PWD/pr-$pr_num"
fi
