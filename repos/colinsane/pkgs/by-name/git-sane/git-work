#!/usr/bin/env -S NIX_BUILD_SHELL=/bin/sh nix-shell
#!nix-shell -i bash ../../.. -A static-nix-shell.mkBash --arg packages 'ps: [ ps.bash ps.git ]'

set -euo pipefail

usage() {
  echo "git-work DIRECTORY: create a worktree in DIRECTORY and cd into it"
}

base=
dir=
parseArgs() {
  while [ "$#" -ne 0 ]; do
    local arg=$1
    shift
    case $arg in
      (-h|--help)
        usage
        exit 0
        ;;
      (-b)
        base="$1"
        shift
        ;;
      (*)
        if [ -z "$dir" ]; then
          dir="$arg"
        else
          usage
          exit 1
        fi
        ;;
    esac
  done
}

parseArgs "$@"

if [ -n "$base" ]; then
  # branch off of `$base` and name it `$dir`; also checkout branch `$dir` into a newly-created worktree directory `$dir`.
  # this is different than stock git worktree syntax, where
  # `git worktree add $dir $branch` would checkout $branch into $dir AND ERROR if $branch were checked out anywhere else.
  git worktree add -b "$dir" "$dir" "$base" >&2
else
  git worktree add "$dir" >&2
fi
echo "$PWD/$dir"
