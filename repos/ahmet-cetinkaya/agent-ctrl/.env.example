# agent-ctrl env template — copy to .env and fill in.
# agent-ctrl substitutes ${VAR} in mcps/*.json and profiles/*/mcps/*.json at apply-time.
# Blank = skip that server/integration. Never commit .env.

# agent-ctrl catalog registries
SKILLSMP_API_KEY=
SMITHERY_API_KEY=

# Claude settings: OmniRoute model routing (settings/claude/settings.json)
OMNIROUTE_BASE_URL=
OMNIROUTE_AUTH_TOKEN=

# Global MCP: context7
CONTEXT7_API_KEY=

# Global MCP: morph
MORPH_KEY=

# Global MCP: playwright — chromium executable path (NixOS: use system chromium, not the
# broken downloaded binary). Find yours with `which chromium`. Must be non-blank: if left empty,
# Playwright falls back to its bundled browser, which fails on NixOS's non-FHS filesystem.
CHROMIUM_PATH=

# Profile: web-platform
FIRECRAWL_API_KEY=

# Profile: atlassian / jira
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Profile: atlassian / confluence
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Profile: godot
GODOT_PATH=

# Profile: supabase
SUPABASE_PROJECT_REF=
