# Copy to .env and fill in. An unset ${VAR} stays literal on apply, with no warning.

# agent-ctrl registries: https://skillsmp.com/docs/api, https://smithery.ai/account/api-keys
SKILLSMP_API_KEY=your-skillsmp-api-key
SMITHERY_API_KEY=your-smithery-api-key

# Model gateway (Claude and OpenCode settings)
OMNIROUTE_BASE_URL=your-omniroute-base-url
OMNIROUTE_AUTH_TOKEN=your-omniroute-auth-token

# Claude settings: extra directory Claude Code may access
SECOND_BRAIN_DIR=/path/to/second-brain

# MCP servers
CONTEXT7_API_KEY=your-context7-api-key
MORPH_KEY=your-morph-api-key
WHPH_MCP_TOKEN=your-whph-mcp-token

# Browser: system Chromium for the agent-browser skill
CHROMIUM_PATH=/path/to/chromium
