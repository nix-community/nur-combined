{
  "auto_update": false,
  "markdown_preview_code_font_family": "FiraCode Nerd Font Mono",
  "markdown_preview_font_family": ".SystemUIFont",
  "markdown_preview_font_size": 24.0,
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "mode": "Prometheus - Plan Builder"
      },
      "type": "registry"
    }
  },
  "minimap": {
    "show": "always"
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
    "provider": "codestral"
  },
  "diff_view_style": "split",
  "language_models": {
    "openai_compatible": {
      "OmniRoute": {
        "api_url": "http://192.168.1.4:8208/v1",
        "available_models": [
          {
            "name": "combo/high-models",
            "max_tokens": 500000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": true
            }
          },
          {
            "name": "combo/mid-models",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": true
            }
          },
          {
            "name": "combo/lite-models",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": true
            }
          }
        ]
      }
    },
    "opencode": {
      "show_zen_models": false,
      "show_go_models": false
    }
  },
  "agent": {
    "sidebar_side": "right",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "effort": "medium",
      "provider": "OmniRoute",
      "model": "combo/lite-models",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "autosave": "off",
  "base_keymap": "VSCode",
  "buffer_font_fallbacks": [
    "CaskaydiaCove Nerd Font Mono",
    "Noto Sans Mono CJK JP",
    "Noto Sans Mono CJK SC",
    "Noto Sans Mono CJK KR",
    "Noto Sans Symbols",
  ],
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_size": 16,
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "colorize_brackets": true,
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
  },
  "cursor_blink": false,
  "git": {
    "file_diff": {
      "show_full_file": true
    },
    "git_gutter": "tracked_files",
  },
  "git_panel": {
    "show_count_badge": true,
    "scrollbar": {

    },
    "entry_primary_click_action": "file_diff",
    "file_icons": true,
    "status_style": "label_color",
    "group_by": "staging",
    "dock": "left",
    "sort_by_path": true,
    "tree_view": true,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "closureReturnTypeHints": {
            "enable": "always",
          },
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "maxLength": null,
        },
        "rust": {
          "analyzerTargetDir": true,
        },
      },
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "relative_line_numbers": "enabled",
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "never",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "button": false,
    "dock": "right",
    "font_fallbacks": [
      "CaskaydiaCove Nerd Font Mono",
      "Noto Sans Mono CJK JP",
      "Noto Sans Mono CJK SC",
      "Noto Sans Mono CJK KR",
      "Noto Sans Symbols",
    ],
    "font_family": "FiraCode Nerd Font Mono",
    "font_size": 14,
    "line_height": "standard",
    "shell": "system",
    "working_directory": "current_project_directory",
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Modern"
  },
  "ui_font_size": 16,
  "vertical_scroll_margin": 0,
  "vim_mode": true,
}
