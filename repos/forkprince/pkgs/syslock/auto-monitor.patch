diff --git a/src/syslock.cpp b/src/syslock.cpp
--- a/src/syslock.cpp
+++ b/src/syslock.cpp
@@ -88,9 +88,23 @@
 	if (monitor != NULL)
 		connector = gdk_monitor_get_connector(monitor);
 
-	const char *main_monitor = config_main["main"]["main-monitor"].c_str();
+	std::string main_monitor = config_main["main"]["main-monitor"];
 
-	if (connector == NULL || !strcmp(connector, main_monitor)) {
+	bool is_main;
+	if (connector == NULL)
+		is_main = true;
+	else if (!main_monitor.empty())
+		is_main = !strcmp(connector, main_monitor.c_str());
+	else {
+		// No monitor configured, fall back to the first one in the layout
+		auto monitors = Gdk::Display::get_default()->get_monitors();
+		GObject* first = static_cast<GObject*>(g_list_model_get_item(monitors->gobj(), 0));
+		is_main = first != NULL && GDK_MONITOR(first) == monitor;
+		if (first != NULL)
+			g_object_unref(first);
+	}
+
+	if (is_main) {
 		syslock_window* window = new syslock_window(&config_main);
 		window->dispatcher_auth.connect(sigc::mem_fun(*this, &syslock::unlock));
 		setup_window(window->gobj(), monitor, "syslock");
