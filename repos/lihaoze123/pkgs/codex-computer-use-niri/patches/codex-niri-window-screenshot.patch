+// Niri deliberately omits global coordinates for tiled windows. Capture the
+// exact window through compositor IPC instead of guessing a desktop crop.
+pub async fn capture_niri_window_raw(window_id: u64) -> Result<RawScreenshotCapture> {
+    use std::os::unix::fs::DirBuilderExt;
+    let mut nonce = [0u8; 16];
+    getrandom::fill(&mut nonce).map_err(|e| anyhow!("screenshot nonce: {e}"))?;
+    let name = nonce.iter().map(|b| format!("{b:02x}")).collect::<String>();
+    let directory = std::env::temp_dir().join(format!("codex-niri-{name}"));
+    fs::DirBuilder::new().mode(0o700).create(&directory)?;
+    let path = directory.join("window.png");
+    let result = async {
+        let mut command = Command::new("niri");
+        command.args(["msg", "action", "screenshot-window", "--id", &window_id.to_string(),
+            "--write-to-disk", "true", "--show-pointer", "false", "--path"]);
+        command.arg(&path);
+        let output = crate::command_runner::output(command, "capture Niri window").await?;
+        if !output.status.success() {
+            bail!("Niri window capture failed: {}", String::from_utf8_lossy(&output.stderr));
+        }
+        // IPC acknowledges before the compositor finishes encoding/writing PNG.
+        let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+        loop {
+            if let Ok(capture) = read_png_as_capture_inner(&path, "niri-window") {
+                if image::load_from_memory_with_format(&capture.bytes, image::ImageFormat::Png).is_ok() {
+                    return Ok(capture);
+                }
+            }
+            if tokio::time::Instant::now() >= deadline {
+                bail!("Niri did not write a complete window screenshot within 5 seconds");
+            }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+    }.await;
+    let _ = fs::remove_file(&path);
+    let _ = fs::remove_dir(&directory);
+    result
+}
