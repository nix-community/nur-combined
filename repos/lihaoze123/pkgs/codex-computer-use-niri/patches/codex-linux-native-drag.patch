+fn apply_window_relative_drag_coordinates(
+    params: &mut DragParams,
+    capture_rect: (i32, i32, u32, u32),
+) -> std::result::Result<(), String> {
+    let (origin_x, origin_y, width, height) = capture_rect;
+    if width == 0 || height == 0 {
+        return Err(
+            "Relative coordinate drags require non-empty target-window bounds.".to_string(),
+        );
+    }
+    let translate = |x: i32, y: i32| -> std::result::Result<(i32, i32), String> {
+        if x < 0 || y < 0 || x as u32 >= width || y as u32 >= height {
+            return Err("Relative drag coordinates must be inside target-window bounds.".to_string());
+        }
+        Ok((
+            origin_x
+                .checked_add(x)
+                .ok_or_else(|| "Relative drag x coordinate overflowed.".to_string())?,
+            origin_y
+                .checked_add(y)
+                .ok_or_else(|| "Relative drag y coordinate overflowed.".to_string())?,
+        ))
+    };
+    (params.start_x, params.start_y) = translate(params.start_x, params.start_y)?;
+    (params.end_x, params.end_y) = translate(params.end_x, params.end_y)?;
+    Ok(())
+}
