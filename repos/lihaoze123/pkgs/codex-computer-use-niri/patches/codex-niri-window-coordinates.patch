+async fn hydrate_window_origins(windows: &mut [WindowInfo]) -> Result<()> {
+    let workspaces = niri_output_async(&["msg", "--json", "workspaces"])
+        .await
+        .context("failed to query Niri workspaces")?;
+    if !workspaces.status.success() {
+        bail!("niri workspaces query failed: {}", command_failure_detail(&workspaces));
+    }
+    let workspaces: Vec<NiriWorkspace> = serde_json::from_slice(&workspaces.stdout)
+        .context("failed to parse Niri workspaces")?;
+    let workspace_outputs = workspaces
+        .into_iter()
+        .filter_map(|workspace| {
+            let id = i32::try_from(workspace.id).ok()?;
+            Some((id, workspace.output?))
+        })
+        .collect::<HashMap<_, _>>();
+
+    let outputs = query_outputs().await?;
+    for window in windows {
+        let Some(workspace) = window.workspace else { continue };
+        let Some(output_name) = workspace_outputs.get(&workspace) else { continue };
+        let Some(output) = outputs.get(output_name) else { continue };
+        let Some(logical) = output.logical.as_ref() else { continue };
+        let Some(bounds) = window.bounds.as_mut() else { continue };
+        if let (Some(x), Some(y)) = (bounds.x, bounds.y) {
+            bounds.x = x.checked_add(logical.x);
+            bounds.y = y.checked_add(logical.y);
+        }
+    }
+    Ok(())
+}
+
+pub async fn monitor_layout() -> Result<Vec<(i32, i32, i32, i32)>> {
+    let monitors = query_outputs()
+        .await?
+        .into_values()
+        .filter_map(|output| {
+            let logical = output.logical?;
+            (logical.width > 0 && logical.height > 0)
+                .then_some((logical.x, logical.y, logical.width, logical.height))
+        })
+        .collect::<Vec<_>>();
+    if monitors.is_empty() {
+        bail!("Niri returned no usable logical outputs");
+    }
+    Ok(monitors)
+}
+
+async fn query_outputs() -> Result<HashMap<String, NiriOutput>> {
+    let output = niri_output_async(&["msg", "--json", "outputs"])
+        .await
+        .context("failed to query Niri outputs")?;
+    if !output.status.success() {
+        bail!("niri outputs query failed: {}", command_failure_detail(&output));
+    }
+    serde_json::from_slice(&output.stdout).context("failed to parse Niri outputs")
+}
