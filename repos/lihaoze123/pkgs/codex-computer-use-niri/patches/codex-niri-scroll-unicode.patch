+async fn run_wtype_text(text: &str) -> std::result::Result<Output, String> {
+    let executable = option_env!("COMPUTER_USE_WTYPE_EXECUTABLE").unwrap_or("wtype");
+    let mut command = TokioCommand::new(executable);
+    // niri drops the first event while attaching a fresh virtual keyboard.
+    // A modifier tap primes it without inserting text or touching the clipboard.
+    command.args(["-P", "Shift_L", "-p", "Shift_L", "-s", "50", "--", text]);
+    let output = crate::command_runner::output_with_timeout(
+        command, "run wtype", ydotool_type_timeout(text),
+    ).await.map_err(|error| format!("{error:#}"))?;
+    if output.status.success() {
+        Ok(output)
+    } else {
+        Err(format!("wtype failed: {}", String::from_utf8_lossy(&output.stderr)))
+    }
+}
+
+fn chromium_browser_window(window: &WindowInfo) -> bool {
+    [window.app_id.as_deref(), window.wm_class.as_deref()]
+        .into_iter()
+        .flatten()
+        .any(|identity| {
+            matches!(
+                identity.to_ascii_lowercase().as_str(),
+                "microsoft-edge" | "microsoft-edge-stable" | "google-chrome" |
+                "google-chrome-stable" | "chromium" | "chromium-browser" |
+                "brave-browser" | "vivaldi-stable"
+            )
+        })
+}
+
+async fn run_chromium_unicode_hex_text(text: &str) -> std::result::Result<Vec<Output>, String> {
+    let mut outputs = Vec::new();
+    let mut ascii = String::new();
+    for character in text.chars() {
+        if character.is_ascii() {
+            ascii.push(character);
+            continue;
+        }
+        if !ascii.is_empty() {
+            outputs.push(run_ydotool_type_text(&ascii).await?);
+            ascii.clear();
+        }
+        let begin = key_sequence("Ctrl+Shift+U").expect("supported Unicode hex chord");
+        outputs.push(run_ydotool(&ydotool_key_args(begin, true)).await?);
+        sleep(Duration::from_millis(35)).await;
+        outputs.push(run_ydotool_type_text(&format!("{:x}", character as u32)).await?);
+        sleep(Duration::from_millis(35)).await;
+        let commit = key_sequence("Space").expect("supported Unicode hex commit key");
+        outputs.push(run_ydotool(&ydotool_key_args(commit, false)).await?);
+        sleep(Duration::from_millis(35)).await;
+    }
+    if !ascii.is_empty() {
+        outputs.push(run_ydotool_type_text(&ascii).await?);
+    }
+    Ok(outputs)
+}
+
 fn ydotool_type_timeout(text: &str) -> Duration {
     let text_seconds = (text.chars().count() as u64).div_ceil(YDOTOOL_TYPE_CHARS_PER_SECOND);
     Duration::from_secs(INPUT_COMMAND_TIMEOUT.as_secs().saturating_add(text_seconds))
