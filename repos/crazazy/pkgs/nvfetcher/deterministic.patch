From b6d7d9459d40f60a5b7617045c5ee021c0f72d67 Mon Sep 17 00:00:00 2001
From: Crazazy <crazazy@disroot.org>
Date: Tue, 13 Oct 2026 12:05:53 +0200
Subject: [PATCH] Make fetchtarball deterministic

so that it doesn't rely on builtins
---
 src/NvFetcher.hs         | 3 ++-
 src/NvFetcher/NixExpr.hs | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/NvFetcher.hs b/src/NvFetcher.hs
index 8b40af1..b822816 100644
--- a/src/NvFetcher.hs
+++ b/src/NvFetcher.hs
@@ -234,6 +234,7 @@ srouces body =
     {
       fetchgit,
       fetchurl,
+      fetchzip,
       fetchFromGitHub,
       dockerTools,
     }:
diff --git a/src/NvFetcher/NixExpr.hs b/src/NvFetcher/NixExpr.hs
index 392cd3b..176c72f 100644
--- a/src/NvFetcher/NixExpr.hs
+++ b/src/NvFetcher/NixExpr.hs
@@ -128,7 +128,7 @@ nixFetcher = \case
     |]
   (FetchTarball (quote -> url) (coerce quote -> sha256)) ->
     [trimming|
-          fetchTarball {
+          fetchzip {
             url = $url;
             sha256 = $sha256;
           }
-- 
2.55.0

