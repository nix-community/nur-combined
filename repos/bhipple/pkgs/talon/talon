#!/usr/bin/env bash
set -euo pipefail

pgrep talon && exit 0

export TERM=xterm-256color
export NIXPKGS_ALLOW_UNFREE=1

notify-send "Starting talon..."

channel='https://github.com/NixOS/nixpkgs/archive/f68407657ad294471eb4b2e65d193df26edf729f.tar.gz'  # NixOS release-26.05 as of 2026-11-16
pgrep snixembed || snixembed &

rm -f ~/talon
nix build -Lvf $channel talon --out-link ~/talon

steam-run ~/talon/talon
