#!/bin/sh
# Trim the image.  Everything removed here is documentation or tooling that
# an appliance with no shell-facing users will never open.
set -e

rm -rf /usr/share/doc/* \
       /usr/share/man/* \
       /usr/share/info/* \
       /usr/share/lintian \
       /usr/share/linda \
       /var/cache/apt/archives/*.deb \
       /var/lib/apt/lists/* \
       /var/cache/debconf/*-old \
       /var/lib/dpkg/*-old

# Keep only English locales.
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
	! -name 'en*' ! -name 'C*' -exec rm -rf {} + 2>/dev/null || true

# The C compiler proper, 33 MB of it.  This arrived through
# x11-xserver-utils, which depended on cpp because xrdb pipes X resource files
# through a preprocessor.  That package left with X11, so this may now find
# nothing -- kept because it costs nothing and something else may pull cpp in
# again.
rm -rf /usr/libexec/gcc/x86_64-linux-gnu/*/cc1 \
       /usr/libexec/gcc/x86_64-linux-gnu/*/cc1plus \
       2>/dev/null || true

# PostScript and PDF rendering, which used to arrive by a genuinely silly
# route: openbox -> libobrender -> imlib2 -> libspectre -> ghostscript, so
# imlib2 could load a PostScript file as a window decoration.  openbox left
# with X11, so this may now find nothing -- kept for the same reason as the
# compiler above.
rm -rf /usr/share/poppler \
       /usr/share/ghostscript \
       /usr/share/color/icc/ghostscript \
       2>/dev/null || true

# /usr/share/consolefonts is 8 MB and mostly scripts this image will never
# render, but it is deliberately left alone: console-setup has CODESET=guess,
# the console font is what the whole settings UI is drawn in, and 2 MB is a
# poor trade against an unreadable menu on some machine that guesses
# differently.

# Drop firmware for hardware that cannot plausibly be a streaming client.
rm -rf /lib/firmware/netronome /lib/firmware/liquidio /lib/firmware/qed \
       /lib/firmware/bnx2x /lib/firmware/cxgb4 /lib/firmware/dpaa2 \
       2>/dev/null || true

apt-get clean
