# The ops safe to run unattended, for --self-test. Anything that changes the
# machine is deliberately absent.
READ_ONLY = ("ping", "status", "settings.status", "display.status", "audio.status", "wifi.list", "wifi.saved",
             "tailscale.status", "bluetooth.status", "usb.list", "system.health", "system.context", "ssh.status",
             "battery.status", "region.status", "backup.status", "install.status", "setup.status")


# ------------------------------------------------------------------- serving --


def handle_client(conn):
    usb_owned = set()
    disk_owned = [False]
    try:
        conn.settimeout(CLIENT_IDLE_TIMEOUT)
        with conn, conn.makefile("rwb") as stream:
            while True:
                raw = stream.readline(MAX_REQUEST_BYTES + 1)
                if not raw:
                    break
                if len(raw) > MAX_REQUEST_BYTES:
                    stream.write(json.dumps({
                        "ok": False,
                        "error": {"code": E_BAD_REQUEST,
                                  "message": "request exceeds %d bytes" % MAX_REQUEST_BYTES},
                    }).encode() + b"\n")
                    stream.flush()
                    break
                try:
                    request = json.loads(raw)
                    if not isinstance(request, dict):
                        raise ValueError
                except ValueError:
                    # No id to answer with, so this is all that can be said.
                    stream.write(json.dumps({
                        "ok": False,
                        "error": {"code": E_BAD_REQUEST, "message": "not a JSON object"},
                    }).encode() + b"\n")
                    stream.flush()
                    continue

                req_id = request.get("id")
                op_name = request.get("op")
                args = request.get("args") or {}

                def emit(message):
                    stream.write(json.dumps({
                        "id": req_id, "event": "progress", "message": message,
                    }).encode() + b"\n")
                    stream.flush()

                handler = OPS.get(op_name)
                if op_name == "usb.session.sync":
                    handler = lambda request_args, progress: op_usb_session_sync(
                        request_args, progress, usb_owned)
                elif op_name == "disk.session.acquire":
                    handler = lambda request_args, progress: op_disk_session_acquire(
                        request_args, progress, disk_owned)
                if handler is None:
                    reply = {"id": req_id, "ok": False,
                             "error": {"code": E_UNKNOWN_OP, "message": "no such operation"}}
                elif not isinstance(args, dict):
                    reply = {"id": req_id, "ok": False,
                             "error": {"code": E_BAD_REQUEST, "message": "args must be an object"}}
                else:
                    try:
                        reply = {"id": req_id, "ok": True, "result": handler(args, emit)}
                    except Error as err:
                        reply = {"id": req_id, "ok": False,
                                 "error": {"code": err.code, "message": err.message}}
                    except Exception as err:  # noqa: BLE001 - a handler bug must not kill the daemon
                        log("%s raised %r" % (op_name, err))
                        reply = {"id": req_id, "ok": False,
                                 "error": {"code": E_FAILED, "message": "internal error"}}

                stream.write(json.dumps(reply).encode() + b"\n")
                stream.flush()
    except (socket.timeout, ConnectionError, OSError):
        # Idle and disconnected clients are routine. Their session leases are
        # released below without an unhandled worker-thread traceback.
        pass
    finally:
        # A stream crash, network loss, helper-client reconnect, and an orderly
        # Selene exit all close this connection and therefore release the same
        # appliance-side lease without a separate teardown command.
        usb_session_release(usb_owned)
        disk_session_release(disk_owned)


def serve():
    os.makedirs(os.path.dirname(SOCKET_PATH), mode=0o755, exist_ok=True)
    recover_usb_sessions()
    recover_disk_session()

    # A socket left behind by a killed daemon would make bind() fail; nothing
    # else owns this path, so removing it is safe rather than presumptuous.
    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET_PATH)

    # Ownership before listen(), so there is no window where the socket exists
    # and is reachable by more than it should be.
    try:
        import grp
        os.chown(SOCKET_PATH, 0, grp.getgrnam(SOCKET_GROUP).gr_gid)
    except (KeyError, OSError) as err:
        log("could not set socket group: %s" % err)
    os.chmod(SOCKET_PATH, SOCKET_MODE)

    server.listen(4)
    log("listening on %s" % SOCKET_PATH)

    clients = threading.BoundedSemaphore(MAX_CLIENTS)

    def serve_client(conn):
        try:
            handle_client(conn)
        finally:
            clients.release()

    while True:
        conn, _ = server.accept()
        if not clients.acquire(blocking=False):
            log("rejecting helper client: connection limit reached")
            conn.close()
            continue
        threading.Thread(target=serve_client, args=(conn,), daemon=True).start()


def self_test():
    failures = 0
    for name in READ_ONLY:
        try:
            result = OPS[name]({}, lambda message: None)
            print("%-18s ok  %s" % (name, json.dumps(result)[:100]))
        except Error as err:
            print("%-18s %s: %s" % (name, err.code, err.message))
            # An absent tool is a fact about the image, not a failure of this.
            if err.code != E_UNAVAILABLE:
                failures += 1
        except Exception as err:  # noqa: BLE001
            print("%-18s raised %r" % (name, err))
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    if "--self-test" in sys.argv[1:]:
        sys.exit(self_test())
    try:
        serve()
    except KeyboardInterrupt:
        pass
