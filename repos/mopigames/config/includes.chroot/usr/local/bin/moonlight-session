#!/bin/sh
# Moonlight OS boot flow.  Started from ~/.bash_profile on tty1 after
# autologin.  Owns the whole lifetime of the appliance:
#
#   start sway -> graphical welcome/setup -> Selene
#     -> (Selene exits) -> menu -> repeat
#
# The graphical first-run flow lives inside sway so it can provide real
# progress, errors, pointer input, and a consistent control-centre UI.  The
# older console flows remain below as the fallback when no display starts.
#
# shellcheck source=./moonlight-common
. /usr/local/bin/moonlight-common

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Only ever run on the console we autologin to.
[ -t 0 ] || exit 0

clear
printf '\n  Moonlight OS -- starting up\n\n'

while :; do
	mlos_load

	# Graphical session.  Blocks until Moonlight exits.  sway starts
	# moonlight-wlsession, which owns first-run before launching the streamer.
	#    The hint is the only place the panel key is advertised, and the
	#    panel is the only route to the installer once Moonlight has the
	#    screen -- so it gets its own pause rather than scrolling past.
	clear
	printf '\n\n      Moonlight OS\n\n'
	printf '      Press Ctrl+Alt+M at any time for settings,\n'
	printf '      Wi-Fi, Tailscale and the installer.\n\n'
	sleep 4

	# sway runs the session itself (see /etc/sway/config, which execs
	# moonlight-wlsession); when that exits, so does sway.  No display
	# manager and no startx -- this is the tty we already autologged into.
	if ! mlos_run_compositor > "$MLOS_STATE/session.log" 2>&1; then
		clear
		printf '\n  The graphical session failed to start.\n'
		printf '  Log: %s\n\n' "$MLOS_STATE/session.log"

		# A machine without a usable compositor must still be recoverable.  Each
		# console tool keeps its own completion guard, so these are no-ops after
		# setup and become the complete first-run path only when still needed.
		sudo -n /usr/local/bin/moonlight-welcome
		sudo -n /usr/local/bin/moonlight-region --first-run
		sudo -n /usr/local/bin/moonlight-netsetup --ensure

		if ! mlos_yesno "Moonlight could not start a display.\n\nOpen the maintenance menu?"; then
			sleep 3
			continue
		fi
	fi

	# Moonlight exited -- offer the maintenance menu.
	moonlight-menu || true
done
