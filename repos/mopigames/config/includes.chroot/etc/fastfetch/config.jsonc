// Moonlight OS.
//
// The logo is the distro icon rendered as half-block characters with 24-bit
// colour escapes, generated by tools/make-boot-art.sh.  "file-raw" prints it
// untouched; the "file" type would try to substitute colour placeholders and
// mangle the escapes.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file-raw",
        "source": "/usr/share/moonlight-os/logo.ans",
        "padding": { "top": 1, "left": 1, "right": 3 }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "title",
        "separator",
        { "type": "os",      "key": "OS" },
        { "type": "kernel",  "key": "Kernel" },
        { "type": "host",    "key": "Machine" },
        { "type": "uptime",  "key": "Uptime" },
        { "type": "cpu",     "key": "CPU" },
        { "type": "gpu",     "key": "GPU" },
        { "type": "memory",  "key": "Memory" },
        { "type": "display", "key": "Screens" },

        "break",

        { "type": "command", "key": "Moonlight", "text": "moonlight-facts version" },
        { "type": "command", "key": "Streams to", "text": "moonlight-facts host" },
        { "type": "command", "key": "On screen",  "text": "moonlight-facts screen" },
        { "type": "command", "key": "Layout",     "text": "moonlight-facts layout" },
        { "type": "localip", "key": "Address" },
        { "type": "command", "key": "Tailscale",  "text": "moonlight-facts tailscale" },

        "break",
        "colors"
    ]
}
