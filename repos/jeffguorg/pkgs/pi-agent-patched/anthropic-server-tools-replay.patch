@@ -0,0 +1,37 @@
+/**
+ * Capability marker for patched pi builds (e.g. distribution packages that
+ * carry source patches upstream does not accept, see nur pi-agent-patched).
+ *
+ * The module is imported for its side effect: at startup it publishes a
+ * `__PI_PATCH_CAPABILITIES__` global that extensions can probe at runtime to
+ * detect patched behavior and degrade gracefully on stock pi. Each patch set
+ * bumps `version` (date-based) and lists its capabilities as boolean flags;
+ * capability names are stable identifiers consumers branch on, not versions.
+ *
+ * Stock pi never defines the global, so absence of the marker is the
+ * "unpatched" signal and consumers must fall back to stock behavior.
+ */
+
+export interface PiPatchCapabilities {
+	/** Date-based version of the applied patch set, bumped on every change. */
+	version: number;
+	/** Boolean capability flags; consumers branch on presence and value. */
+	capabilities: Readonly<Record<string, boolean>>;
+}
+
+/** Capabilities provided by the current patch set. Bump `version` on changes. */
+export const PI_PATCH_CAPABILITIES: PiPatchCapabilities = {
+	version: 20261014,
+	capabilities: {
+		// anthropic-messages adapter emits server_tool_start/server_tool_end
+		// stream events and the agent loop forwards them as message_update.
+		server_tool_stream_events: true,
+	},
+};
+
+declare global {
+	// eslint-disable-next-line no-var -- var is required for globalThis merging
+	var __PI_PATCH_CAPABILITIES__: PiPatchCapabilities | undefined;
+}
+
+globalThis.__PI_PATCH_CAPABILITIES__ = PI_PATCH_CAPABILITIES;
