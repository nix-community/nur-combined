+import { describe, expect, it } from "vitest";
+import { PI_PATCH_CAPABILITIES } from "../src/patch-capabilities.ts";
+
+describe("patch capabilities marker", () => {
+	it("#given the module is imported #when probing globalThis #then the marker is published", () => {
+		const marker = globalThis.__PI_PATCH_CAPABILITIES__;
+		expect(marker).toBeDefined();
+		expect(marker?.version).toBeGreaterThan(0);
+		expect(marker?.capabilities["server_tool_stream_events"]).toBe(true);
+	});
+
+	it("#given the constant #when compared to the global #then both reference the same capabilities", () => {
+		expect(globalThis.__PI_PATCH_CAPABILITIES__).toBe(PI_PATCH_CAPABILITIES);
+	});
+});
