+describe("server_tool stream event forwarding", () => {
+	it("#given server_tool stream events #when the loop consumes them #then forwards each as message_update", async () => {
+		const events: AgentEvent[] = [];
+		const partial = createAssistantMessage([], "toolUse");
+		const doneMessage: AssistantMessage = { ...partial, stopReason: "stop", usage: createUsage() };
+		await runAgentLoop(
+			[createUserMessage("q")],
+			{ messages: [], tools: [] },
+			{ model: createModel(), convertToLlm: identityConverter },
+			(event) => {
+				events.push(event);
+			},
+			undefined,
+			() => {
+				const stream = createAssistantMessageEventStream();
+				queueMicrotask(() => {
+					stream.push({ type: "start", partial });
+					stream.push({
+						type: "server_tool_start",
+						index: 1,
+						block: { type: "server_tool_use", id: "srv_A", name: "web_search" },
+						partial,
+					});
+					stream.push({
+						type: "server_tool_end",
+						index: 1,
+						block: { type: "server_tool_use", id: "srv_A", name: "web_search", input: { query: "q" } },
+						partial,
+					});
+					stream.push({
+						type: "server_tool_end",
+						index: 2,
+						block: { type: "web_search_tool_result", tool_use_id: "srv_A", content: [] },
+						partial,
+					});
+					stream.push({ type: "done", reason: "stop", message: doneMessage });
+				});
+				return stream;
+			},
+		);
+
+		const updates = events.filter((event) => event.type === "message_update");
+		expect(updates.map((event) => event.assistantMessageEvent?.type)).toEqual([
+			"server_tool_start",
+			"server_tool_end",
+			"server_tool_end",
+		]);
+		// The forwarded events carry the raw wire block for display consumers.
+		const first = updates[0];
+		if (first?.type !== "message_update") throw new Error("unreachable");
+		expect(first.assistantMessageEvent).toMatchObject({
+			type: "server_tool_start",
+			index: 1,
+			block: { type: "server_tool_use", id: "srv_A" },
+		});
+	});
+});
