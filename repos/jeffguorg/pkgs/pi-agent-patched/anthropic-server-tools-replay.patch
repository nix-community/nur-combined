@@ -0,0 +1,167 @@
+import type Anthropic from "@anthropic-ai/sdk";
+import { describe, expect, it } from "vitest";
+import { stream as streamAnthropic } from "../src/api/anthropic-messages.ts";
+import { getModel, normalizeContext } from "../src/compat.ts";
+
+function createSseResponse(events: Array<{ event: string; data: string }>): Response {
+	const body = events.map(({ event, data }) => `event: ${event}\ndata: ${data}\n`).join("\n");
+	return new Response(body, {
+		status: 200,
+		headers: { "content-type": "text/event-stream" },
+	});
+}
+
+function createFakeAnthropicClient(response: Response): Anthropic {
+	return {
+		beta: {
+			messages: {
+				create: () => ({
+					asResponse: async () => response,
+				}),
+			},
+		},
+	} as unknown as Anthropic;
+}
+
+const serverToolSseEvents = [
+	{
+		event: "message_start",
+		data: JSON.stringify({
+			type: "message_start",
+			message: { id: "msg_server_tool", usage: { input_tokens: 12, output_tokens: 0 } },
+		}),
+	},
+	{
+		event: "content_block_start",
+		data: JSON.stringify({ type: "content_block_start", index: 0, content_block: { type: "text", text: "" } }),
+	},
+	{
+		event: "content_block_delta",
+		data: JSON.stringify({
+			type: "content_block_delta",
+			index: 0,
+			delta: { type: "text_delta", text: "Search results for query: q" },
+		}),
+	},
+	{ event: "content_block_stop", data: JSON.stringify({ type: "content_block_stop", index: 0 }) },
+	{
+		event: "content_block_start",
+		data: JSON.stringify({
+			type: "content_block_start",
+			index: 1,
+			content_block: { type: "server_tool_use", id: "tool_A", name: "web_search", input: {} },
+		}),
+	},
+	{
+		event: "content_block_delta",
+		data: JSON.stringify({
+			type: "content_block_delta",
+			index: 1,
+			delta: { type: "input_json_delta", partial_json: '{"query":"q"}' },
+		}),
+	},
+	{ event: "content_block_stop", data: JSON.stringify({ type: "content_block_stop", index: 1 }) },
+	{
+		event: "content_block_start",
+		data: JSON.stringify({
+			type: "content_block_start",
+			index: 2,
+			content_block: {
+				type: "web_search_tool_result",
+				tool_use_id: "srvtoolu_B",
+				content: [{ type: "web_search_result", title: "t", url: "https://example.com" }],
+			},
+		}),
+	},
+	{ event: "content_block_stop", data: JSON.stringify({ type: "content_block_stop", index: 2 }) },
+	{
+		event: "content_block_start",
+		data: JSON.stringify({
+			type: "content_block_start",
+			index: 3,
+			content_block: { type: "tool_use", id: "tool_C", name: "bash", input: { command: "date" } },
+		}),
+	},
+	{ event: "content_block_stop", data: JSON.stringify({ type: "content_block_stop", index: 3 }) },
+	{
+		event: "message_delta",
+		data: JSON.stringify({
+			type: "message_delta",
+			delta: { stop_reason: "tool_use" },
+			usage: { input_tokens: 12, output_tokens: 5 },
+		}),
+	},
+	{ event: "message_stop", data: JSON.stringify({ type: "message_stop" }) },
+];
+
+describe("anthropic server tool stream events", () => {
+	it("#given a stream with server_tool_use and web_search_tool_result #when streaming #then emits server_tool events in wire order with final blocks", async () => {
+		const model = getModel("anthropic", "claude-haiku-4-5");
+		const response = streamAnthropic(
+			model,
+			normalizeContext({ messages: [{ role: "user", content: "q", timestamp: 1 }] }),
+			{ client: createFakeAnthropicClient(createSseResponse(serverToolSseEvents)) },
+		);
+
+		const types: string[] = [];
+		const serverToolEvents: Array<{ type: string; index: number; block: Record<string, unknown> }> = [];
+		for await (const event of response) {
+			types.push(event.type);
+			if (event.type === "server_tool_start" || event.type === "server_tool_end") {
+				serverToolEvents.push({ type: event.type, index: event.index, block: event.block });
+			}
+		}
+
+		// Wire order: text block, then the server-tool use, its result, then the
+		// regular tool_use. The server-tool events must interleave in that order.
+		expect(types.filter((type) => type.startsWith("server_tool"))).toEqual([
+			"server_tool_start",
+			"server_tool_end",
+			"server_tool_end",
+		]);
+		expect(serverToolEvents[0]).toEqual({
+			type: "server_tool_start",
+			index: 1,
+			block: { type: "server_tool_use", id: "tool_A", name: "web_search", input: {} },
+		});
+		expect(serverToolEvents[1]?.type).toBe("server_tool_end");
+		expect(serverToolEvents[1]?.block).toMatchObject({
+			type: "server_tool_use",
+			id: "tool_A",
+			input: { query: "q" },
+		});
+		expect(serverToolEvents[2]?.type).toBe("server_tool_end");
+		expect(serverToolEvents[2]?.block).toMatchObject({
+			type: "web_search_tool_result",
+			tool_use_id: "srvtoolu_B",
+			content: [{ type: "web_search_result", title: "t", url: "https://example.com" }],
+		});
+		// The regular tool call still terminates the turn after the search; the
+		// stream then ends with the done event.
+		expect(types[types.length - 2]).toBe("toolcall_end");
+		expect(types[types.length - 1]).toBe("done");
+	});
+
+	it("#given the same stream #when the message finishes #then anthropicWireContent stays attached for verbatim replay", async () => {
+		const model = getModel("anthropic", "claude-haiku-4-5");
+		const result = await streamAnthropic(
+			model,
+			normalizeContext({ messages: [{ role: "user", content: "q", timestamp: 1 }] }),
+			{ client: createFakeAnthropicClient(createSseResponse(serverToolSseEvents)) },
+		).result();
+
+		const wire = result.anthropicWireContent as Array<Record<string, unknown>> | undefined;
+		expect(Array.isArray(wire)).toBe(true);
+		expect(wire?.map((block) => block["type"])).toEqual([
+			"text",
+			"server_tool_use",
+			"web_search_tool_result",
+			"tool_use",
+		]);
+		expect(wire?.[1]).toMatchObject({ id: "tool_A", input: { query: "q" } });
+		// Internal representation stays untouched: the search never becomes a
+		// content block, so the agent loop only sees text and the trailing tool call.
+		expect(result.content.map((block) => block.type)).toEqual(["text", "toolCall"]);
+		expect(result.stopReason).toBe("toolUse");
+	});
+});
