{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "github",
  "repositories": ["spotdemo4/trevpkgs"],
  "allowedCommands": [
    "^fix-hash --file utils/images$",
    "^utils/renovate/refresh_forgejo_flake_hash\\.py --file packages/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+\\.nix --dep-name [A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
  ],
  "exposeAllEnv": true,

  // repository
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"] // sunday
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "docker images",
      "managerFilePatterns": ["/^images/.*.nix$/"],
      "matchStrings": [
        "image = \"?(?<depName>[^\\s:@\"]+)(?::(?<currentValue>[-a-zA-Z0-9.]+))?(?:@(?<currentDigest>sha256:[a-zA-Z0-9]+))?\"?"
      ],
      "autoReplaceStringTemplate": "image = \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\"",
      "depTypeTemplate": "image",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "GitHub flakes",
      "managerFilePatterns": ["/^packages/.*.nix$/"],
      "matchStrings": [
        "builtins\\.getFlake \"github:(?<depName>.+/.+)/(?<currentDigest>.+)\" # (?<currentValue>.+)"
      ],
      "autoReplaceStringTemplate": "builtins.getFlake \"github:{{{depName}}}/{{{newDigest}}}\" # {{{newValue}}}",
      "depTypeTemplate": "flake",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Forgejo flakes",
      "managerFilePatterns": ["/^packages/.*.nix$/"],
      "matchStrings": [
        "builtins\\.getFlake\\s+\"(?<registryUrl>https?://[^/]+)/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/archive/(?<currentDigest>[a-f0-9]{40})\\.tar\\.gz\\?narHash=[^\"&\\s]+\"\\s+#\\s+(?<currentValue>\\S+)"
      ],
      "depTypeTemplate": "flake",
      "datasourceTemplate": "forgejo-tags"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix inputs"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["image"],
      "groupName": "docker images",
      "pinDigests": true,
      "postUpgradeTasks": {
        "commands": ["fix-hash --file utils/images"]
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["forgejo-tags"],
      "matchDepTypes": ["flake"],
      "postUpgradeTasks": {
        "commands": [
          "utils/renovate/refresh_forgejo_flake_hash.py --file {{{packageFile}}} --dep-name {{{depName}}}"
        ],
        "executionMode": "update"
      }
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["flake"],
      "groupName": "flakes",
      "pinDigests": true
    }
  ]
}
