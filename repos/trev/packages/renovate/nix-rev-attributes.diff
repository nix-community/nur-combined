+function maskNixStringsAndComments(content: string): string {
+  return content.replace(
+    regEx(/"(?:\\.|[^"\\])*"|''[\s\S]*?''|#[^\n]*|\/\*[\s\S]*?\*\//g),
+    (match) => ' '.repeat(match.length),
+  );
+}
+
+function findAttrSetEnd(maskedContent: string, start: number): number {
+  let depth = 0;
+  for (let i = start; i < maskedContent.length; i += 1) {
+    if (maskedContent[i] === '{') {
+      depth += 1;
+    } else if (maskedContent[i] === '}') {
+      depth -= 1;
+      if (depth === 0) {
+        return i;
+      }
+    }
+  }
+  return -1;
+}
+
+function getValueIndex(match: RegExpMatchArray): number {
+  return match.index! + match[0].length - match.groups!.value.length - 1;
+}
+
+interface InputAttribute {
+  name: string;
+  value: string;
+  index: number;
+}
+
+function findInputAttributes(
+  fileContent: string,
+  depName: string,
+): InputAttribute[] {
+  const inputPrefix = '(?:inputs\\.)?';
+  const attributes: InputAttribute[] = [];
+
+  // inputs.<name>.rev = "..."; or <name>.ref = "...";
+  const directPattern = regEx(
+    `^\\s*${inputPrefix}${RegExp.escape(depName)}\\.(?<name>rev|ref)\\s*=\\s*"(?<value>[^"\\\\$]*)"`,
+    'gm',
+  );
+  for (const match of fileContent.matchAll(directPattern)) {
+    if (getBraceDepth(fileContent, match.index) <= 2) {
+      attributes.push({
+        name: match.groups!.name,
+        value: match.groups!.value,
+        index: getValueIndex(match),
+      });
+    }
+  }
+
+  // <name> = { ...; rev = "..."; ref = "..."; };
+  const attrSetPattern = regEx(
+    `^\\s*${inputPrefix}${RegExp.escape(depName)}\\s*=\\s*\\{`,
+    'gm',
+  );
+  const attrSet = [...fileContent.matchAll(attrSetPattern)].find(
+    (match) => getBraceDepth(fileContent, match.index) <= 2,
+  );
+  if (attrSet?.index === undefined) {
+    return attributes;
+  }
+
+  const maskedContent = maskNixStringsAndComments(fileContent);
+  const start = attrSet.index + attrSet[0].length;
+  const end = findAttrSetEnd(maskedContent, start - 1);
+  if (end === -1) {
+    return attributes;
+  }
+
+  const body = fileContent.slice(start, end);
+  const maskedBody = maskedContent.slice(start, end);
+  const memberPattern = regEx(
+    /(?<prefix>^|[^\w'.-])(?<name>rev|ref)\s*=\s*"(?<value>[^"\\$]*)"/g,
+  );
+  for (const match of body.matchAll(memberPattern)) {
+    const nameIndex = match.index + match.groups!.prefix.length;
+    // Skip matches inside strings or comments and members of nested
+    // attribute sets such as input overrides.
+    if (
+      maskedBody[nameIndex] !== body[nameIndex] ||
+      getBraceDepth(maskedBody, nameIndex) !== 0
+    ) {
+      continue;
+    }
+    attributes.push({
+      name: match.groups!.name,
+      value: match.groups!.value,
+      index: start + getValueIndex(match),
+    });
+  }
+
+  return attributes;
+}
+
+function updateInputAttributes(
+  fileContent: string,
+  depName: string,
+  currentValue?: string,
+  newValue?: string,
+  currentDigest?: string,
+  newDigest?: string,
+): string | null {
+  const attributes = findInputAttributes(fileContent, depName);
+  if (!attributes.length) {
+    return null;
+  }
+
+  let updatedContent = fileContent;
+  for (const { name, value, index } of attributes.sort(
+    (a, b) => b.index - a.index,
+  )) {
+    let newAttributeValue = value;
+    if (name === 'ref') {
+      newAttributeValue = replaceVersion(value, currentValue, newValue);
+    } else if (
+      currentDigest &&
+      newDigest &&
+      currentDigest !== newDigest &&
+      value === currentDigest
+    ) {
+      newAttributeValue = newDigest;
+    }
+
+    if (newAttributeValue === value) {
+      continue;
+    }
+
+    updatedContent =
+      updatedContent.slice(0, index) +
+      newAttributeValue +
+      updatedContent.slice(index + value.length);
+    logger.debug(
+      {
+        depName,
+        attribute: name,
+        oldValue: value,
+        newValue: newAttributeValue,
+      },
+      'Successfully updated Nix flake input attribute',
+    );
+  }
+
+  return updatedContent;
+}
+
