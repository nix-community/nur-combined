+      `;
+
+      const updatedNixpkgs = updateDependency({
+        fileContent,
+        upgrade: {
+          depName: 'nixpkgs',
+          currentValue: '24.05',
+          newValue: '25.05',
+        },
+      });
+      expect(updatedNixpkgs).toContain(
+        'inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-25.05"',
