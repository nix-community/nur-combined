+
+    void        setVirtualPointer(SP<CCZwlrVirtualPointerV1> ptr) {virtualPointer  = ptr;}
+    void        setVirtualKeyboard(SP<CCZwpVirtualKeyboardV1> kb) {virtualKeyboard = kb; }
