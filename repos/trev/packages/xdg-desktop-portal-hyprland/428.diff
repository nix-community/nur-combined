+    SP<CCZwpVirtualKeyboardV1> virtualKeyboard = nullptr;
+
+    uint32_t                   depressed       = 0;
+    uint32_t                   latched         = 0;
+    uint32_t                   locked          = 0;
+
+    Keymap keymap;
+
+    int    onEvent(eis_event* e);
+    void   pollEvents();
+    void   ensurePointer();
+    void   ensureKeyboard();
+    Keymap openKeymap();
+    void   clearPointer();
+    void   clearKeyboard();
+};
