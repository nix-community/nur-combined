diff --git i/src/shared/KeyboardState.hpp w/src/shared/KeyboardState.hpp
new file mode 100644
index 0000000..172b976
--- /dev/null
+++ w/src/shared/KeyboardState.hpp
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <xkbcommon/xkbcommon.h>
+#include <cstdint>
+#include <memory>
+#include <unordered_set>
+#include <vector>
+
+// Track modifiers using the compositor's keymap, rather than fixed masks.
+class KeyboardState {
+  public:
+    bool setKeymap(const char* text) {
+        std::unique_ptr<xkb_context, decltype(&xkb_context_unref)> context(
+            xkb_context_new(XKB_CONTEXT_NO_FLAGS), xkb_context_unref);
+        if (!context)
+            return false;
+        std::unique_ptr<xkb_keymap, decltype(&xkb_keymap_unref)> map(
+            xkb_keymap_new_from_string(context.get(), text, XKB_KEYMAP_FORMAT_TEXT_V1, XKB_KEYMAP_COMPILE_NO_FLAGS), xkb_keymap_unref);
+        if (!map)
+            return false;
+        std::unique_ptr<xkb_state, decltype(&xkb_state_unref)> state(xkb_state_new(map.get()), xkb_state_unref);
+        if (!state)
+            return false;
+        m_state = std::move(state);
+        m_pressed.clear();
+        return true;
+    }
+
+    void key(uint32_t code, bool pressed) {
+        if (!m_state)
+            return;
+        // Repeated presses must not increment XKB's modifier reference count.
+        const bool changed = pressed ? m_pressed.insert(code).second : m_pressed.erase(code) != 0;
+        if (changed)
+            xkb_state_update_key(m_state.get(), code + 8, pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+    }
+
+    std::vector<uint32_t> releaseAll() {
+        std::vector<uint32_t> keys(m_pressed.begin(), m_pressed.end());
+        for (auto code : keys)
+            key(code, false);
+        return keys;
+    }
+
+    uint32_t modifiers(xkb_state_component component) const {
+        return m_state ? xkb_state_serialize_mods(m_state.get(), component) : 0;
+    }
+
+    uint32_t group() const {
+        return m_state ? xkb_state_serialize_layout(m_state.get(), XKB_STATE_LAYOUT_EFFECTIVE) : 0;
+    }
+
+    uint32_t character(uint32_t code) const {
+        return m_state ? xkb_state_key_get_utf32(m_state.get(), code + 8) : 0;
+    }
+
+  private:
+    std::unique_ptr<xkb_state, decltype(&xkb_state_unref)> m_state{nullptr, xkb_state_unref};
+    std::unordered_set<uint32_t> m_pressed;
+};
diff --git i/tests/keyboard-state.cpp w/tests/keyboard-state.cpp
new file mode 100644
index 0000000..0d422e8
--- /dev/null
+++ w/tests/keyboard-state.cpp
@@ -0,0 +1,57 @@
+#include "../src/shared/KeyboardState.hpp"
+#include <cassert>
+#include <cstdlib>
+#include <iostream>
+#include <linux/input-event-codes.h>
+
+int main() {
+    auto* context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    assert(context);
+    xkb_rule_names names{};
+    names.layout = "fr";
+    names.options = "compose:caps,shift:both_capslock_cancel";
+    auto* map = xkb_keymap_new_from_names(context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+    assert(map);
+    char* text = xkb_keymap_get_as_string(map, XKB_KEYMAP_FORMAT_TEXT_V1);
+    assert(text);
+    KeyboardState state;
+    assert(state.setKeymap(text));
+    free(text);
+    assert(state.character(KEY_Q) == 'a');
+    assert(state.character(KEY_A) == 'q');
+    assert(state.character(KEY_W) == 'z');
+    assert(state.character(KEY_2) == U'é');
+    assert(state.group() == 0);
+    state.key(KEY_RIGHTALT, true);
+    auto mod5 = xkb_keymap_mod_get_index(map, "Mod5");
+    auto mod1 = xkb_keymap_mod_get_index(map, "Mod1");
+    assert(state.modifiers(XKB_STATE_MODS_DEPRESSED) & (1u << mod5));
+    assert(!(state.modifiers(XKB_STATE_MODS_DEPRESSED) & (1u << mod1)));
+    assert(state.character(KEY_0) == '@');
+    state.key(KEY_RIGHTALT, false);
+    state.key(KEY_LEFTSHIFT, true);
+    state.key(KEY_LEFTSHIFT, true); // Duplicate press must not leave Shift stuck.
+    assert(state.character(KEY_Q) == 'A');
+    state.key(KEY_LEFTSHIFT, false);
+    assert(state.character(KEY_Q) == 'a');
+    assert(state.modifiers(XKB_STATE_MODS_DEPRESSED) == 0);
+    state.key(KEY_LEFTCTRL, true);
+    state.key(KEY_RIGHTCTRL, true);
+    state.key(KEY_LEFTCTRL, false);
+    assert(state.modifiers(XKB_STATE_MODS_DEPRESSED) != 0);
+    state.key(KEY_RIGHTCTRL, false);
+    assert(state.modifiers(XKB_STATE_MODS_DEPRESSED) == 0);
+    for (int cycle = 0; cycle < 100; ++cycle) {
+        state.key(KEY_LEFTCTRL, true);
+        state.key(KEY_RIGHTALT, true);
+        state.key(KEY_Q, true);
+        assert(state.releaseAll().size() == 3);
+        assert(state.releaseAll().empty());
+        assert(state.modifiers(XKB_STATE_MODS_DEPRESSED) == 0);
+        assert(state.character(KEY_Q) == 'a');
+        assert(state.group() == 0);
+    }
+    xkb_keymap_unref(map);
+    xkb_context_unref(context);
+    std::cout << "PASS: French AZERTY, accents, AltGr, both Ctrl keys, duplicate presses, 100 stop/resume cycles\n";
+}
