+vector<duckdb::string> ExtensionHelper::NixExtensionFolders() {
+	vector<duckdb::string> nix_folders;
+	auto dirs_string = FileSystem::GetEnvVariable("DUCKDB_NIX_EXTENSION_DIRECTORIES");
+	for (auto &dir : StringUtil::Split(dirs_string, ':')) {
+		if (!dir.empty()) {
+			nix_folders.push_back(dir);
+		}
+	}
+	return nix_folders;
+}
+
+bool ExtensionHelper::IsNixProvidedExtension(FileSystem &fs, const string &extension) {
+	if (ExtensionHelper::IsFullPath(extension)) {
+		return false;
+	}
+	auto extension_name = ExtensionHelper::ApplyExtensionAlias(extension);
+	for (const auto &dir : ExtensionHelper::NixExtensionFolders()) {
+		auto path = dir;
+		for (const auto &component : PathComponents()) {
+			path = fs.JoinPath(path, component);
+		}
+		if (fs.FileExists(fs.JoinPath(path, extension_name + ".duckdb_extension"))) {
+			return true;
+		}
+	}
+	return false;
+}
