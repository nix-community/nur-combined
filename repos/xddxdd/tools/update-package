#!/usr/bin/env bash
# Run passthru.updateScript-based package updates (see helpers/update.nix).
#
# Usage:
#   ./tools/update-package <attr-path> [<attr-path>...]
#   ./tools/update-package --path <group-prefix>
#   ./tools/update-package --all
set -euo pipefail
cd "$(dirname "$0")/.."

# nix-update's eval step and the nix-shell shebangs of the per-package update
# scripts resolve <nixpkgs> through NIX_PATH; pin it to the flake-locked tree so
# they match what the flake builds instead of drifting with the ambient channel.
export NIX_PATH=nixpkgs=$(nix eval --impure --raw --expr '(builtins.getFlake (toString ./.)).inputs.nixpkgs.outPath')

if [ $# -eq 0 ]; then
	echo "Usage: $0 <attr-path>... | --path <prefix> | --all" >&2
	exit 1
fi

case "$1" in
--all)
	exec nix-shell helpers/update.nix --argstr packages ""
	;;
--path)
	[ $# -ge 2 ] || { echo "Usage: $0 --path <prefix>" >&2; exit 1; }
	shift
	exec nix-shell helpers/update.nix --argstr path "$*"
	;;
*)
	exec nix-shell helpers/update.nix --argstr packages "$*"
	;;
esac
