--- a/src/os/unix/ngx_recv.c
+++ b/src/os/unix/ngx_recv.c
@@ -16,6 +16,14 @@
     ssize_t       n;
     ngx_err_t     err;
     ngx_event_t  *rev;
+#if (NGX_SSL && NGX_LINUX && defined BIO_get_ktls_recv)
+    struct msghdr  msg;
+    struct iovec   iov;
+    union {
+        struct cmsghdr  align;
+        u_char          data[CMSG_SPACE(sizeof(u_char))];
+    } control;
+#endif

     rev = c->read;

@@ -68,7 +76,27 @@
 #endif

     do {
-        n = recv(c->fd, buf, size, 0);
+#if (NGX_SSL && NGX_LINUX && defined BIO_get_ktls_recv)
+        if (c->ssl
+            && (SSL_get_shutdown(c->ssl->connection) & SSL_SENT_SHUTDOWN)
+            && BIO_get_ktls_recv(SSL_get_rbio(c->ssl->connection)))
+        {
+            /* KTLS control records need cmsg space even during raw drain. */
+            ngx_memzero(&msg, sizeof(struct msghdr));
+            iov.iov_base = buf;
+            iov.iov_len = size;
+            msg.msg_iov = &iov;
+            msg.msg_iovlen = 1;
+            msg.msg_control = control.data;
+            msg.msg_controllen = sizeof(control.data);
+
+            n = recvmsg(c->fd, &msg, 0);
+
+        } else
+#endif
+        {
+            n = recv(c->fd, buf, size, 0);
+        }

         ngx_log_debug3(NGX_LOG_DEBUG_EVENT, c->log, 0,
                        "recv: fd:%d %z of %uz", c->fd, n, size);
