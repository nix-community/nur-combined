+# different range/precision than Win D3D11. Format:
+# "SHADERTYPE*PRECISIONTYPE|rangeMin:rangeMax:precision,..." where
+# SHADERTYPE=35632 (FRAGMENT) or 35633 (VERTEX), PRECISIONTYPE=36336..36341
