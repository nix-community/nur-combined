+  type: DataMutexString
+  value: ""
+  mirror: always
+
+# Optional fake LAN host IP for the synthetic host candidate base.
+# Empty = leave host gathering to native code (mDNS *.local obfuscation).
+- name: zoom.stealth.webrtc.host_ip
+  type: DataMutexString
+  value: ""
+  mirror: always
+
+# Drop IPv6 host candidates from ICE gathering. The upstream
