+# vs ANGLE/Windows) when spoofing a different target OS at the JS layer —
+# the resulting canvas fingerprint is purely seed-driven, OS-independent.
+- name: zoom.stealth.canvas.substitute_pixels
+  type: RelaxedAtomicBool
+  value: false
+  mirror: always
+
+# Mask used by ApplyStealthCanvasPixelNoise to choose which pixels get the
+# +/-1 noise. A pixel is modified iff (per_pixel_hash & mask) == 0, so a
+# mask of 2^N - 1 yields a 1/2^N modification rate. Defaults to 7 = 1/8
+# pixels (~12.5%). Set to 15 (= 1/16, ~6.25%) for low-variance GPU stacks
+# (Intel HD) where the default rate over-amplifies the FP Pro tampering ML
+# score; set to 31 for the most conservative noise.
+- name: zoom.stealth.canvas.noise_skip_mask
+  type: RelaxedAtomicInt32
+  value: 7
+  mirror: always
