+const GLOW_IDLE_SOFT = `rgba(${LOGO_GREEN}, .6)`;
+const GLOW_PRESSED = `rgba(${LOGO_GREEN}, 1)`;
+const GLOW_PRESSED_SOFT = `rgba(${LOGO_GREEN}, .75)`;
