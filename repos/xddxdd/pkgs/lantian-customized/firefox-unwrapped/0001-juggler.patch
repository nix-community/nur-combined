index 00000000..cd553af2
--- /dev/null
+++ b/juggler/screencast/nsScreencastService.cpp
@@ -0,0 +1,690 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsScreencastService.h"
+
+#include <stdio.h>
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <cinttypes>
+#include <memory>
+#include <utility>
+
+#include "VideoEngine.h"
+#include "video_engine/desktop_capture_impl.h"
+
+#include "api/scoped_refptr.h"
+#include "api/video/i420_buffer.h"
+#include "api/video/video_frame.h"
+#include "api/video/video_frame_buffer.h"
+#include "api/video/video_sink_interface.h"
+#include "modules/video_capture/video_capture_defines.h"
+
+#include "gfxPlatform.h"
+#include "mozilla/Base64.h"
+#include "mozilla/ClearOnShutdown.h"
+#include "mozilla/EndianUtils.h"
+#include "mozilla/PresShell.h"
+#include "mozilla/StaticPtr.h"
+#include "mozilla/TimeStamp.h"
+#include "mozilla/gfx/Rect.h"
+#include "nsIDocShell.h"
+#include "nsIRandomGenerator.h"
+#include "nsIWidget.h"
+#include "nsServiceManagerUtils.h"
+#include "nsThreadUtils.h"
+
+extern "C" {
+#include "jpeglib.h"
+}
+#include "libyuv/convert_argb.h"
+
+namespace mozilla {
+
+NS_IMPL_ISUPPORTS(nsScreencastService, nsIScreencastService)
+
+namespace {
+
+// Flow control. A client that cannot keep up sees fewer frames; the queue to
+// the main thread never grows, and neither does the base64 held in memory.
+const uint32_t kMaxFramesInFlight = 1;
+
+// A capture that ended on its own is started again after this long, and again
+// after the same interval for as long as the window cannot be captured.
+//
+// ⛔ THE CAPTURE MODULE ENDS FOR GOOD ON A WINDOW THAT IS ONLY TEMPORARILY
+// UNCAPTURABLE, AND SAYS SO TO NOBODY WHO LISTENS. Measured 2026-09-14: a
+// headed window minimised for a moment. The GDI capturer answers a 1x1 black
+// frame for an iconic window, the blank detector passes the turn to the WGC
+// capturer Firefox keeps as a fallback, and that one - built with the delayed
+// capturability check - reports the minimised window as a PERMANENT error.
+// DesktopCaptureImpl then cancels its timer and fires CaptureEndedEvent, which
+// this file did not subscribe to. The client kept serving the last frame it
+// held, and a person watched a search page while the browser was two sites
+// on. Restoring the window changed nothing: nothing was asking any more.
+const uint32_t kRetryDelayMs = 1000;
+
+// A window whose capturer reports nothing new is answered with the last frame
+// again at this interval, so the client can tell a quiet window from a dead
+// capture by the frame's age alone.
+//
+// Measured on the same day: a headed window that is fully visible on screen
+// is captured through the SCREEN capturer, which delivers a frame only when
+// the screen changed - one frame in four seconds on a still page - while the
+// same window occluded, or a cloaked one, is captured through the window
+// capturer at the requested rate: 48 and 65 frames in four seconds. So
+// silence meant two different things, and a client that restarted the
+// capture after two silent seconds was right for the dead capture and wrong
+// for the quiet window. Repeating the last frame makes silence mean one thing.
+//
+// The age is checked more often than it is allowed to grow, or a tick that
+// lands just short of the age lets it run to two ticks: measured with one
+// constant for both, 6 frames in 4 s where 16 were meant.
+//
+// And the age is never shorter than the period the caller asked for (see
+// HeartbeatAgeFor). With a fixed 250 ms every rate under 4 fps was filled up
+// to about 4: asking for 2 delivered 11 frames in 3 s on CI, the ordinary
+// half-second gap between two captured frames being taken for silence. A
+// repetition must answer a capture that went quiet, never the rate itself.
+const uint32_t kHeartbeatMs = 250;
+const uint32_t kHeartbeatTickMs = 100;
+
+StaticRefPtr<nsScreencastService> gScreencastService;
+
+// Atomic: every session creates its modules on its own control thread.
+int32_t NextModuleId() {
+  static std::atomic<int32_t> sModuleId{0};
+  return ++sModuleId;
+}
+
+nsresult GenerateUid(nsString& aUid) {
+  nsresult rv = NS_OK;
+  nsCOMPtr<nsIRandomGenerator> rg =
+      do_GetService("@mozilla.org/security/random-generator;1", &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+  uint8_t* buffer = nullptr;
+  const int kLen = 16;
+  rv = rg->GenerateRandomBytes(kLen, &buffer);
+  NS_ENSURE_SUCCESS(rv, rv);
+  for (int i = 0; i < kLen; i++) {
+    aUid.AppendPrintf("%02x", buffer[i]);
+  }
+  free(buffer);
+  return rv;
+}
+
+}  // namespace
+
+// One capture session: one window, one capture module at a time, one client.
+//
+// The module is Firefox's own DesktopCaptureImpl, the code path behind
+// getDisplayMedia's window sharing. It hands us I420 frames on its capture
+// thread; we crop and scale in one step, convert to ARGB, encode a JPEG,
+// base64 it and hop to the main thread to give the string to the JavaScript
+// client. Nothing here touches the content process or the page.
+//
+// The module is replaced when it ends on its own, and the last frame is
+// repeated while the module is quiet: the two constants above say why. The
+// repetition happens on the main thread; the replacement on the control
+// thread, below.
+//
+// ⛔ THE MODULE LIVES ON THE SESSION'S OWN CONTROL THREAD, NEVER ON THE MAIN
+// THREAD. The window capturer reads the window with PrintWindow, which sends
+// the window a message and waits for the thread that owns it to answer: the
+// main thread, because the window captured is our own. StopCapture waits for
+// the capture thread with a SyncRunnable, which answers no message while it
+// waits. Both called on the main thread, they waited for each other forever
+// and Juggler answered nothing more (B277). Measured with four browsers
+// starting and stopping screencasts on the hidden desktop: the main thread
+// parked in a condition variable under DesktopCaptureImpl::StopCapture and the
+// DesktopCapture thread in NtUserPrintWindow, both stacks unchanged, three
+// runs out of three (two on firefox-44, one on firefox-43), each within the
+// first fifteen stops. Firefox's own window sharing drives the module from
+// CamerasParent's "VideoCapture" thread, never from the main thread.
+//
+// ⛔ AND THE MAIN THREAD NEVER WAITS FOR THE CONTROL THREAD, NOT EVEN TO
+// START. StartCapture asks the main thread for its X11 options with a
+// SyncRunnable (CreateDesktopCaptureOptions, "help avoid an X11 deadlock",
+// bug 1456101), so a main thread waiting for the start waited for itself:
+// measured on the first build of this rule, every screencast start on Linux
+// wedged, two e2e of two, while Windows, which has no such request, started.
+// Everything the module needs is handed to the control thread and nothing is
+// waited for.
+class nsScreencastService::Session final
+    : public webrtc::VideoSinkInterface<webrtc::VideoFrame> {
+ public:
+  NS_INLINE_DECL_THREADSAFE_REFCOUNTING(Session)
+
+  Session(nsIScreencastServiceClient* aClient, nsIWidget* aWidget,
+          nsIThread* aControl, const nsACString& aWindowId, int aWidth,
+          int aHeight, int aViewportWidth, int aViewportHeight,
+          gfx::IntMargin aMargin, uint32_t aQuality, uint32_t aFps)
+      : mClient(aClient),
+        mWidget(aWidget),
+        mControl(aControl),
+        mWindowId(aWindowId),
+        mWidth(aWidth),
+        mHeight(aHeight),
+        mViewportWidth(aViewportWidth),
+        mViewportHeight(aViewportHeight),
+        mMargin(aMargin),
+        mQuality(aQuality),
+        mFps(aFps),
+        mHeartbeatAge(HeartbeatAgeFor(aFps)) {}
+
+  // The silence after which the last frame is repeated: kHeartbeatMs, or the
+  // period of the requested rate when that is longer, so a repetition never
+  // adds a frame the rate itself would not have. aFps is never 0: Start
+  // refuses it.
+  static TimeDuration HeartbeatAgeFor(uint32_t aFps) {
+    return TimeDuration::FromMilliseconds(
+        std::max(double(kHeartbeatMs), 1000.0 / double(aFps)));
+  }
+
+  nsIWidget* Widget() const { return mWidget; }
+
+  // Main thread. The module is created and started on the control thread, and
+  // DesktopCaptureImpl asserts that StartCapture and StopCapture come from the
+  // thread that created it. Nothing here waits for it (see the comment on the
+  // class): a start that fails is tried again after kRetryDelayMs, as a module
+  // that ends is, and the caller hears of a window that cannot be captured by
+  // the frames not coming, as of one that stopped being capturable. Only a
+  // control thread that takes no task is the caller's answer.
+  bool Start() {
+    nsresult rv = mControl->Dispatch(NS_NewRunnableFunction(
+        "nsScreencastService::Session::Start", [self = RefPtr{this}]() {
+          if (!self->mStopped.load() && !self->CreateAndStartModule()) {
+            self->RetryLater();
+          }
+        }));
+    if (NS_FAILED(rv)) {
+      // Nothing started, so nobody is told: the caller hears the failure.
+      // The client and the widget are dropped here for the reason Stop gives.
+      mStopped.store(true);
+      mClient = nullptr;
+      mWidget = nullptr;
+      ShutdownControl();
+      return false;
+    }
+    ArmHeartbeat();
+    return true;
+  }
+
+  // Main thread. Nothing here waits: the module is released on the control
+  // thread, which then ends. A frame already queued to the main thread finds
+  // mStopped set and drops itself, and so do the retry and the heartbeat.
+  //
+  // The widget and the client are main-thread objects and are dropped here,
+  // because the last reference to this session may go on another thread.
+  void Stop() {
+    if (mStopped.exchange(true)) {
+      return;
+    }
+    if (mClient) {
+      mClient->ScreencastStopped();
+      mClient = nullptr;
+    }
+    mWidget = nullptr;
+    ShutdownControl();
+  }
+
+  // Control thread. The module's own word that it will not ask for frames any
+  // more - a permanent error from the capturer. The module is released and
+  // another one is tried after kRetryDelayMs, for as long as this session
+  // lives: a window that cannot be captured now is usually a window that can
+  // be captured in a moment.
+  void OnCaptureEnded() {
+    if (mStopped.load()) {
+      return;
+    }
+    ReleaseModule();
+    // Whatever the old module owed an acknowledgement for is not coming
+    // through it any more; the next module starts with the budget it needs.
+    mFramesInFlight.store(0);
+    RetryLater();
+  }
+
+  void Ack() {
+    if (mFramesInFlight.load() == 0) {
+      return;
+    }
+    mFramesInFlight.fetch_sub(1);
+  }
+
+  // Capture thread.
+  void OnFrame(const webrtc::VideoFrame& aFrame) override {
+    if (mStopped.load() || mFramesInFlight.load() >= kMaxFramesInFlight) {
+      return;
+    }
+    webrtc::scoped_refptr<webrtc::I420BufferInterface> i420 =
+        aFrame.video_frame_buffer()->ToI420();
+    if (!i420) {
+      return;
+    }
+    const int frameWidth = i420->width();
+    const int frameHeight = i420->height();
+
+    // The area we keep: the window, minus its OS frame and the toolbar rows
+    // above the content - unless the caller asked for the whole window, in
+    // which case the margin is zero and this is the identity.
+    //
+    // ⛔ The margin's members are `IntCoordTyped`, a unit-carrying type, not
+    // int. std::clamp deduces one type from all three arguments and refuses
+    // the mix, so the conversion is written here once rather than left to
+    // four call sites to get right.
+    const int marginLeft = int(mMargin.left);
+    const int marginTop = int(mMargin.top);
+    const int marginRight = int(mMargin.right);
+    const int marginBottom = int(mMargin.bottom);
+    const int left = std::clamp(marginLeft, 0, std::max(frameWidth - 1, 0));
+    const int top = std::clamp(marginTop, 0, std::max(frameHeight - 1, 0));
+    int cropWidth = frameWidth - left - std::max(marginRight, 0);
+    int cropHeight = frameHeight - top - std::max(marginBottom, 0);
+    // A minimized window is captured as 1x1.
+    if (cropWidth <= 1 || cropHeight <= 1) {
+      return;
+    }
+    // A headed window brings its size in sync with the viewport slowly.
+    if (mViewportWidth && cropWidth > mViewportWidth) {
+      cropWidth = mViewportWidth;
+    }
+    if (mViewportHeight && cropHeight > mViewportHeight) {
+      cropHeight = mViewportHeight;
+    }
+    // CropAndScaleFrom asserts these with RTC_CHECK, which aborts the parent
+    // process. A frame we cannot describe is dropped instead.
+    if (left + cropWidth > frameWidth || top + cropHeight > frameHeight) {
+      return;
+    }
+
+    // Scale down to fit the requested bound, never up.
+    double scale = 1.0;
+    if (mWidth < cropWidth || mHeight < cropHeight) {
+      scale = std::min(1.0, std::min(double(mWidth) / cropWidth,
+                                     double(mHeight) / cropHeight));
+    }
+    const int outWidth = std::max(1, int(cropWidth * scale));
+    const int outHeight = std::max(1, int(cropHeight * scale));
+
+    // One step: the crop and the scale together, straight into a buffer that
+    // is already the output size. Nothing outside the kept area is ever
+    // converted, which is the half of the work Playwright's version did and
+    // then threw away.
+    webrtc::scoped_refptr<webrtc::I420Buffer> out =
+        webrtc::I420Buffer::Create(outWidth, outHeight);
+    if (!out) {
+      return;
+    }
+    out->CropAndScaleFrom(*i420, left, top, cropWidth, cropHeight);
+
+    // I420 to ARGB. libyuv's "ARGB" is B,G,R,A in memory on little-endian.
+    const int stride = outWidth * 4;
+    std::unique_ptr<uint8_t[]> argb(new uint8_t[size_t(stride) * outHeight]);
+    if (libyuv::I420ToARGB(out->DataY(), out->StrideY(), out->DataU(),
+                           out->StrideU(), out->DataV(), out->StrideV(),
+                           argb.get(), stride, outWidth, outHeight) != 0) {
+      return;
+    }
+
+    jpeg_compress_struct info;
+    jpeg_error_mgr error;
+    info.err = jpeg_std_error(&error);
+    jpeg_create_compress(&info);
+    unsigned char* jpegBuffer = nullptr;
+    unsigned long jpegSize = 0;
+    jpeg_mem_dest(&info, &jpegBuffer, &jpegSize);
+    info.image_width = outWidth;
+    info.image_height = outHeight;
+    info.input_components = 4;
+    // libyuv's "ARGB" is a 32-bit little-endian word, so the bytes come out
+    // B,G,R,A on a little-endian machine and A,R,G,B on a big-endian one.
+    //
+    // ⛔ `if constexpr`, not `#if MOZ_LITTLE_ENDIAN()`. That macro is what
+    // Playwright's version used and it does NOT EXIST in Firefox 151 - the
+    // tree moved to std::endian, and the preprocessor form fails the build
+    // with "function-like macro is not defined" rather than quietly picking
+    // the wrong branch. Both branches here are compiled on every platform, so
+    // the one this machine does not take cannot rot unnoticed.
+    if constexpr (std::endian::native == std::endian::little) {
+      info.in_color_space = JCS_EXT_BGRA;
+    } else {
+      info.in_color_space = JCS_EXT_ARGB;
+    }
+    jpeg_set_defaults(&info);
+    jpeg_set_quality(&info, int(mQuality), true);
+    jpeg_start_compress(&info, true);
+    while (info.next_scanline < info.image_height) {
+      JSAMPROW row = argb.get() + size_t(info.next_scanline) * size_t(stride);
+      if (jpeg_write_scanlines(&info, &row, 1) != 1) {
+        fprintf(stderr, "screencast: the JPEG encoder refused a scanline\n");
+        break;
+      }
+    }
+    jpeg_finish_compress(&info);
+    jpeg_destroy_compress(&info);
+
+    nsCString base64;
+    nsresult rv = Base64Encode(reinterpret_cast<const char*>(jpegBuffer),
+                               uint32_t(jpegSize), base64);
+    free(jpegBuffer);
+    if (NS_WARN_IF(NS_FAILED(rv))) {
+      return;
+    }
+
+    mFramesInFlight.fetch_add(1);
+    NS_DispatchToMainThread(NS_NewRunnableFunction(
+        "nsScreencastService::Session::Frame",
+        [self = RefPtr{this}, base64 = std::move(base64), cropWidth,
+         cropHeight]() {
+          if (self->mStopped.load() || !self->mClient) {
+            return;
+          }
+          // Kept for the heartbeat, which repeats it while the module is
+          // quiet. Main thread only, like everything that reads it.
+          self->mLastFrame = base64;
+          self->mLastWidth = uint32_t(cropWidth);
+          self->mLastHeight = uint32_t(cropHeight);
+          self->Deliver();
+        }));
+  }
+
+ private:
+  ~Session() override = default;
+
+  // Main thread. The control thread releases what it holds and ends, and its
+  // last join is an event on this thread rather than a wait. The way out of a
+  // Stop and of a Start that failed.
+  void ShutdownControl() {
+    if (!mControl) {
+      return;
+    }
+    // Neither fails while the thread is alive, and a thread already gone at
+    // XPCOM shutdown has taken its module down with it.
+    (void)mControl->Dispatch(NS_NewRunnableFunction(
+        "nsScreencastService::Session::Release",
+        [self = RefPtr{this}]() { self->ReleaseModule(); }));
+    (void)mControl->AsyncShutdown();
+    mControl = nullptr;
+  }
+
+  // Control thread. A module for the window, started. Shared by the first
+  // start and by every retry.
+  bool CreateAndStartModule() {
+    mModule = webrtc::DesktopCaptureImpl::Create(
+        NextModuleId(), mWindowId.get(), camera::CaptureDeviceType::Window);
+    if (!mModule || !StartModule()) {
+      mModule = nullptr;
+      return false;
+    }
+    return true;
+  }
+
+  // Control thread. Register, start, and listen for the module ending on its
+  // own, on this same thread.
+  bool StartModule() {
+    webrtc::VideoCaptureCapability capability;
+    // The desktop capturer takes its size from the window; the frame rate is
+    // the only knob it reads here.
+    capability.width = 1280;
+    capability.height = 960;
+    capability.maxFPS = static_cast<int32_t>(mFps);
+    capability.videoType = webrtc::VideoType::kI420;
+    mModule->RegisterCaptureDataCallback(this);
+    if (mModule->StartCapture(capability) != 0) {
+      mModule->DeRegisterCaptureDataCallback();
+      fprintf(stderr, "screencast: StartCapture failed\n");
+      return false;
+    }
+    mEnded = mModule->CaptureEndedEvent()->Connect(
+        GetCurrentSerialEventTarget(), this, &Session::OnCaptureEnded);
+    return true;
+  }
+
+  // Control thread. The listener goes first: it holds a raw pointer to this
+  // object and a module being stopped can still fire the event.
+  //
+  // The order is load-bearing. DeRegisterCaptureDataCallback takes the same
+  // lock NotifyOnFrame holds while it is inside OnFrame, so when it returns
+  // no OnFrame is running and none will start; StopCapture then waits for the
+  // capture thread, which may be inside PrintWindow waiting for the main
+  // thread - free to answer, because nothing there waits for this one.
+  void ReleaseModule() {
+    mEnded.DisconnectIfExists();
+    if (mModule) {
+      mModule->DeRegisterCaptureDataCallback();
+      mModule->StopCapture();
+      mModule = nullptr;
+    }
+  }
+
+  // Control thread.
+  void RetryLater() {
+    NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction("nsScreencastService::Session::Retry",
+                               [self = RefPtr{this}]() { self->Retry(); }),
+        kRetryDelayMs);
+  }
+
+  // Control thread. A new module for the same window, and another attempt
+  // later if this one cannot even start.
+  void Retry() {
+    if (mStopped.load() || mModule) {
+      return;
+    }
+    if (!CreateAndStartModule()) {
+      RetryLater();
+    }
+  }
+
+  void ArmHeartbeat() {
+    NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction("nsScreencastService::Session::Heartbeat",
+                               [self = RefPtr{this}]() { self->Heartbeat(); }),
+        kHeartbeatTickMs);
+  }
+
+  // Main thread. The last frame again, if the module has handed over nothing
+  // for a heartbeat and the client is not still holding one.
+  void Heartbeat() {
+    if (mStopped.load()) {
+      return;
+    }
+    if (!mLastFrame.IsEmpty() && mClient && mFramesInFlight.load() == 0 &&
+        TimeStamp::Now() - mLastDelivered > mHeartbeatAge) {
+      mFramesInFlight.fetch_add(1);
+      Deliver();
+    }
+    ArmHeartbeat();
+  }
+
+  // Main thread. The frame held in mLastFrame goes to the client, counted
+  // against the flow control by whoever called this.
+  void Deliver() {
+    mLastDelivered = TimeStamp::Now();
+    NS_ConvertUTF8toUTF16 utf16(mLastFrame);
+    mClient->ScreencastFrame(utf16, mLastWidth, mLastHeight);
+  }
+
+  // Main thread only: the client is a JavaScript object.
+  nsCOMPtr<nsIScreencastServiceClient> mClient;
+  // Main thread only.
+  nsCOMPtr<nsIWidget> mWidget;
+  // Main thread only; null once the session stopped.
+  nsCOMPtr<nsIThread> mControl;
+  // Control thread only.
+  webrtc::scoped_refptr<webrtc::DesktopCaptureImpl> mModule;
+  // Control thread only.
+  MediaEventListener mEnded;
+  const nsCString mWindowId;
+  nsCString mLastFrame;
+  uint32_t mLastWidth = 0;
+  uint32_t mLastHeight = 0;
+  TimeStamp mLastDelivered;
+  const int mWidth;
+  const int mHeight;
+  const int mViewportWidth;
+  const int mViewportHeight;
+  const gfx::IntMargin mMargin;
+  const uint32_t mQuality;
+  const uint32_t mFps;
+  const TimeDuration mHeartbeatAge;
+  std::atomic<bool> mStopped{false};
+  std::atomic<uint32_t> mFramesInFlight{0};
+};
+
+// static
+already_AddRefed<nsIScreencastService> nsScreencastService::GetSingleton() {
+  if (!gScreencastService) {
+    gScreencastService = new nsScreencastService();
+    ClearOnShutdown(&gScreencastService);
+  }
+  return do_AddRef(gScreencastService);
+}
+
+nsScreencastService::nsScreencastService() = default;
+
+nsScreencastService::~nsScreencastService() {
+  // A session outliving the service would leave a capture thread running and
+  // a window being read after nobody is listening.
+  for (auto& it : mIdToSession) {
+    it.second->Stop();
+  }
+  mIdToSession.clear();
+}
+
+NS_IMETHODIMP nsScreencastService::StartScreencast(
+    nsIScreencastServiceClient* aClient, nsIDocShell* aDocShell,
+    uint32_t aWidth, uint32_t aHeight, uint32_t aQuality,
+    uint32_t aViewportWidth, uint32_t aViewportHeight, uint32_t aOffsetTop,
+    bool aFullWindow, uint32_t aFps, nsAString& aSessionId) {
+  MOZ_RELEASE_ASSERT(NS_IsMainThread(),
+                     "the screencast is started on the main thread");
+  if (!aClient || !aDocShell || !aWidth || !aHeight || !aFps) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  // No native window, nothing to capture. Said plainly, instead of a stream
+  // of nothing: HeadlessWidget::GetNativeData returns null for every request.
+  if (gfxPlatform::IsHeadless()) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+
+  // The widget of the window this docShell paints into.
+  //
+  // Not nsIBaseWindow::GetMainWidget: nsDocShell answers that one with its
+  // PARENT widget, which is a different question. And not the view tree
+  // either - Playwright's version walked PresShell to nsViewManager to
+  // nsView, and Firefox 151 has no `view/` directory at all. PresShell
+  // climbs the pres contexts to the nearest owning widget, which is the one
+  // that was wanted all along.
+  PresShell* presShell = aDocShell->GetPresShell();
+  if (!presShell) {
+    return NS_ERROR_UNEXPECTED;
+  }
+  nsCOMPtr<nsIWidget> widget = presShell->GetRootWidget();
+  if (!widget) {
+    return NS_ERROR_UNEXPECTED;
+  }
+  // The native window id belongs to the top level, and a capture of a child
+  // widget would miss the tab strip and the address bar - which is exactly
+  // what fullWindow exists to keep.
+  if (nsIWidget* topLevel = widget->GetTopLevelWidget()) {
+    widget = topLevel;
+  }
+
+  // The capture module holds ONE sink, so one session per window. Two pages
+  // in one window share the window, and a second screencast there is refused
+  // rather than silently stealing the first one's frames.
+  for (auto& it : mIdToSession) {
+    if (it.second->Widget() == widget) {
+      return NS_ERROR_ALREADY_INITIALIZED;
+    }
+  }
+
+  // What to crop off. Screen bounds are the widget on the screen; client
+  // bounds are the content area in the parent's coordinates, so they are
+  // walked up to screen coordinates before subtracting. The difference is the
+  // window's OS frame.
+  //
+  // ⛔ THE FRAME IS CROPPED IN BOTH MODES, and the first version of this file
+  // did not: with fullWindow it left the margin at zero, and the frames opened
+  // from the firefox-28 build carried a strip of a few pixels on the right
+  // and at the bottom showing whatever window lay UNDERNEATH. Windows 11
+  // draws its resize border transparent on screen, but the capturer hands
+  // those pixels over like any others. Nobody sitting at the machine sees
+  // that border, so a "full window" frame should not either. What fullWindow
+  // skips is only the CHROME crop below: the tab strip, the address bar and
+  // the chrome-side pointer overlay are what it exists to keep.
+  gfx::IntMargin margin;
+  {
+    auto screenBounds = widget->GetScreenBounds().ToUnknownRect();
+    auto clientBounds = widget->GetClientBounds().ToUnknownRect();
+    for (auto parent = widget->GetParent(); parent;
+         parent = parent->GetParent()) {
+      auto parentBounds = parent->GetClientBounds().ToUnknownRect();
+      clientBounds.MoveBy(parentBounds.X(), parentBounds.Y());
+    }
+    margin = screenBounds - clientBounds;
+  }
+  if (!aFullWindow) {
+    margin.top += int32_t(aOffsetTop);
+  }
+
+  uintptr_t rawWindowId = reinterpret_cast<uintptr_t>(
+      widget->GetNativeData(NS_NATIVE_WINDOW_WEBRTC_DEVICE_ID));
+  if (!rawWindowId) {
+    fprintf(stderr, "screencast: this widget has no native window id\n");
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  nsCString windowId;
+  windowId.AppendPrintf("%" PRIuPTR, rawWindowId);
+
+  nsString uid;
+  nsresult rv = GenerateUid(uid);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  // The thread the capture module is created, started and stopped on: see
+  // the comment on Session for why it is never this one.
+  nsCOMPtr<nsIThread> control;
+  rv = NS_NewNamedThread("ScreencastCtl", getter_AddRefs(control));
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  RefPtr<Session> session = new Session(
+      aClient, widget, control, windowId, int(aWidth), int(aHeight),
+      int(aViewportWidth), int(aViewportHeight), margin, aQuality, aFps);
+  if (!session->Start()) {
+    return NS_ERROR_FAILURE;
+  }
+  aSessionId = uid;
+  mIdToSession.emplace(uid, std::move(session));
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsScreencastService::StopScreencast(
+    const nsAString& aSessionId) {
+  MOZ_RELEASE_ASSERT(NS_IsMainThread(),
+                     "the screencast is stopped on the main thread");
+  nsString sessionId(aSessionId);
+  auto it = mIdToSession.find(sessionId);
+  if (it == mIdToSession.end()) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  RefPtr<Session> session = it->second;
+  mIdToSession.erase(it);
+  session->Stop();
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsScreencastService::ScreencastFrameAck(
+    const nsAString& aSessionId) {
+  nsString sessionId(aSessionId);
+  auto it = mIdToSession.find(sessionId);
+  if (it == mIdToSession.end()) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  it->second->Ack();
+  return NS_OK;
+}
+
+}  // namespace mozilla
diff --git a/juggler/screencast/nsScreencastService.h b/juggler/screencast/nsScreencastService.h
new file mode 100644
index 00000000..df6c89a7
--- /dev/null
+++ b/juggler/screencast/nsScreencastService.h
@@ -0,0 +1,34 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#pragma once
+
+#include <map>
+
+#include "mozilla/RefPtr.h"
+#include "nsCOMPtr.h"
+#include "nsIScreencastService.h"
+#include "nsString.h"
+
+namespace mozilla {
+
+class nsScreencastService final : public nsIScreencastService {
+ public:
+  NS_DECL_ISUPPORTS
+  NS_DECL_NSISCREENCASTSERVICE
+
+  static already_AddRefed<nsIScreencastService> GetSingleton();
+
+  nsScreencastService();
+
+ private:
+  ~nsScreencastService();
+
+  class Session;
+  // Main thread only. Each session's capture module lives on that session's
+  // own control thread, never this one: the comment on Session says why.
+  std::map<nsString, RefPtr<Session>> mIdToSession;
+};
+
+}  // namespace mozilla
diff --git a/juggler/tests/bfcache_reattach.test.mjs b/juggler/tests/bfcache_reattach.test.mjs
new file mode 100644
index 00000000..e13cb743
--- /dev/null
+++ b/juggler/tests/bfcache_reattach.test.mjs
@@ -0,0 +1,151 @@
+// A document restored from the back-forward cache is heard from its first
+// word, and the client learns the document before it hears it.
+//
+// B303 E3: the parent end of a page's channel follows the CURRENT document's
+// actor, so on a navigation it rebinds away from the old one; the old
+// document's content end was never told, kept its transport and stayed ready.
+// Restored, it spoke at once - from its own `pageshow`, before the parent had
+// rebound - into an actor nothing listened to, and since it was ready the
+// READY of the rebinding replayed nothing. Measured on firefox-47 for
+// Windows: what a page logged in its `pageshow` and one task later never
+// reached the client in 10 rounds out of 10, nor did a binding it called;
+// what it logged 500 ms later did.
+//
+// The content end now leaves the ready state when its document goes into the
+// cache (`detachFromPeer`, from the actor's `pagehide` with `persisted`), so
+// what it says meanwhile waits in its queue, and the READY of the rebinding
+// runs the reattachment hook - the restored document's announcement - before
+// the queue goes out.
+//
+// Run: node --test juggler/tests/
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const SOURCE = fs.readFileSync(
+  path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'SimpleChannel.js'), 'utf8');
+
+function loadIntoProcess() {
+  const scope = {
+    dump: () => {},
+    ChromeUtils: { importESModule: () => ({ setTimeout }) },
+  };
+  vm.createContext(scope);
+  vm.runInContext(SOURCE, scope);
+  return scope.SimpleChannel;
+}
+
+const settle = () => new Promise(resolve => setTimeout(resolve, 20));
+
+// The browser's wiring, not a symmetric link: each content end keeps the
+// transport of its own actor for the life of its document, and the parent end
+// is bound to one actor at a time. What an actor sends while the parent is
+// bound elsewhere reaches a JugglerFrameParent that drops it.
+function page() {
+  const Parent = loadIntoProcess();
+  const Content = loadIntoProcess();
+  const parent = new Parent('browser::page[1]', 'target-1');
+  const seen = [];
+  parent.register('page', { event: value => { seen.push(value); } });
+  let boundTo = null;
+  const deliver = (to, copy) => setImmediate(() => to._onMessage(copy));
+  const documents = {};
+  const open = name => {
+    const end = new Content('', 'process-9');
+    end.setTransport({
+      sendMessage: message => {
+        if (boundTo === name)
+          deliver(parent, JSON.parse(JSON.stringify(message)));
+      },
+      dispose: () => {},
+    });
+    documents[name] = end;
+    return end;
+  };
+  const bind = name => {
+    boundTo = name;
+    const end = documents[name];
+    parent.resetTransport();
+    parent.setTransport({
+      sendMessage: message => deliver(end, JSON.parse(JSON.stringify(message))),
+      dispose: () => {},
+    });
+  };
+  return { open, bind, seen };
+}
+
+test('what a restored document says before the rebinding is heard', async () => {
+  const { open, bind, seen } = page();
+  const one = open('one');
+  bind('one');
+  await settle();
+  one.connect('page').emit('event', 'one loaded');
+  await settle();
+
+  // To page two: page one goes into the cache, the parent follows page two.
+  one.detachFromPeer();
+  const two = open('two');
+  bind('two');
+  await settle();
+  two.connect('page').emit('event', 'two loaded');
+  await settle();
+
+  // Back: page one's pageshow speaks before the parent has rebound to it.
+  one.connect('page').emit('event', 'one pageshow');
+  await settle();
+  bind('one');
+  await settle();
+  assert.deepEqual(seen, ['one loaded', 'two loaded', 'one pageshow']);
+});
+
+test('the reattachment hook speaks before the queue', async () => {
+  const { open, bind, seen } = page();
+  const one = open('one');
+  one.onReattached(() => one.connect('page').emit('event', 'one announced'));
+  bind('one');
+  await settle();
+
+  one.detachFromPeer();
+  const two = open('two');
+  bind('two');
+  await settle();
+
+  one.connect('page').emit('event', 'one pageshow');
+  one.connect('page').emit('event', 'one tick0');
+  bind('one');
+  await settle();
+  // The first READY of a document is not a reattachment: no announcement then.
+  assert.deepEqual(seen, ['one announced', 'one pageshow', 'one tick0']);
+});
+
+test('an end that was never detached announces nothing on a READY', async () => {
+  const { open, bind, seen } = page();
+  const one = open('one');
+  let announced = 0;
+  one.onReattached(() => { announced++; });
+  bind('one');
+  await settle();
+  bind('one');
+  await settle();
+  assert.equal(announced, 0);
+  assert.deepEqual(seen, []);
+});
+
+test('a request answered before the cache is not dispatched again', async () => {
+  const { open, bind, seen } = page();
+  const one = open('one');
+  bind('one');
+  await settle();
+  await one.connect('page').send('event', 'answered');
+  one.detachFromPeer();
+  const two = open('two');
+  bind('two');
+  await settle();
+  bind('one');
+  await settle();
+  assert.deepEqual(seen, ['answered']);
+});
diff --git a/juggler/tests/caller_world.test.mjs b/juggler/tests/caller_world.test.mjs
new file mode 100644
index 00000000..7eee7e62
--- /dev/null
+++ b/juggler/tests/caller_world.test.mjs
@@ -0,0 +1,154 @@
+// B322: the kinds of world a client declares, and the global each one gets.
+//
+// The caller's code (page.evaluate and the like) ran in the page's own realm,
+// so a call to a standard API went through whatever the page had put in its
+// place: a bot-challenge page wraps Document.prototype.querySelector in a
+// Proxy, and one lookup of its token field from an evaluate got the clearance
+// refused, 11 pairs out of 11. The client now declares a 'caller' world, a
+// sandbox with the page's principal and hybrid Xrays (the C++ is in
+// js/xpconnect/wrappers/XrayWrapper.h). These tests pin what FrameTree builds
+// for each declaration; what the hybrid view resolves is measured in a browser.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function load(file, scope, names) {
+  const source = fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/^export /gm, '');
+  vm.createContext(scope);
+  vm.runInContext(source + `\n;globalThis.__names = { ${names.join(', ')} };`, scope);
+  return scope.__names;
+}
+
+const sandboxes = [];
+const { FrameTree, Frame } = load('content/FrameTree.js', {
+  Components: {
+    interfaces: {},
+    results: {},
+    utils: {
+      Sandbox(principal, options) {
+        const sandbox = { principal, options };
+        sandboxes.push(sandbox);
+        return sandbox;
+      },
+    },
+  },
+  ChromeUtils: { importESModule: () => ({ Helper: class {} }) },
+  dump: () => {},
+}, ['FrameTree', 'Frame']);
+
+const dw = { name: 'the page window' };
+
+function globalFor(kind) {
+  sandboxes.length = 0;
+  return Frame.prototype._createGlobal.call({ domWindow: () => dw }, kind);
+}
+
+test('the caller\'s world is a sandbox with the page\'s principal and hybrid Xrays', () => {
+  const global = globalFor('caller');
+  assert.equal(sandboxes.length, 1);
+  // the page's principal itself, not the extended [dw]: the page must read
+  // what the caller writes and passes, as it did in its own realm
+  assert.equal(global.principal, dw);
+  assert.equal(global.options.sandboxPrototype, dw);
+  assert.equal(global.options.hybridXrays, true);
+  // hybridXrays replaces wantXrays: the engine refuses the two together
+  assert.equal(global.options.wantXrays, false);
+  assert.equal(global.options.wantComponents, false);
+  assert.equal(global.options.wantExportHelpers, false);
+});
+
+test('the isolated world keeps the extended principal and plain Xrays', () => {
+  const global = globalFor('isolated');
+  // an array from the module's realm: compared by its elements
+  assert.equal(global.principal.length, 1);
+  assert.equal(global.principal[0], dw);
+  assert.equal(global.options.wantXrays, true);
+  assert.equal(global.options.hybridXrays, undefined);
+});
+
+test('the main world is the page\'s own window, and no sandbox', () => {
+  assert.equal(globalFor('main'), dw);
+  assert.equal(sandboxes.length, 0);
+});
+
+function worlds() {
+  return {
+    _isolatedWorlds: new Map(),
+    frames: () => [],
+    _ensureWorld: FrameTree.prototype._ensureWorld,
+    setInitScripts: FrameTree.prototype.setInitScripts,
+  };
+}
+
+test('a declared kind is the world\'s kind, and the main world has none', () => {
+  const t = worlds();
+  t.setInitScripts([
+    { script: '', worldName: '__ctx_aux__' },
+    { script: '', worldName: '__ctx_caller__', worldKind: 'caller' },
+    { script: 'window.x = 1' },
+  ]);
+  assert.equal(t._isolatedWorlds.get('__ctx_aux__')._kind, 'isolated');
+  assert.equal(t._isolatedWorlds.get('__ctx_caller__')._kind, 'caller');
+  assert.equal(t._isolatedWorlds.get('')._kind, null);
+});
+
+test('a world declared again keeps its kind, and another kind is refused', () => {
+  const t = worlds();
+  t.setInitScripts([{ script: '', worldName: 'w', worldKind: 'caller' }]);
+  // the whole list again, as every client sends it: same kind, accepted
+  t.setInitScripts([{ script: '', worldName: 'w', worldKind: 'caller' }]);
+  // a binding names the world without a kind: it stays what it was
+  assert.equal(t._ensureWorld('w')._kind, 'caller');
+  assert.throws(() => t._ensureWorld('w', 'isolated'), /already a caller world/);
+});
+
+test('a kind for the main world, or a kind nobody defined, is refused', () => {
+  const t = worlds();
+  assert.throws(() => t._ensureWorld('', 'caller'), /needs a worldName/);
+  assert.throws(() => t._ensureWorld('w', 'page'), /one of: isolated, caller/);
+});
+
+test('a frame builds each world as its kind was declared', () => {
+  const declared = new Map([['w', { _kind: 'caller' }], ['u', { _kind: 'isolated' }]]);
+  const frame = {
+    _frameTree: { _isolatedWorlds: declared },
+    _createWorldContext: (name, kind) => [name, kind],
+  };
+  assert.deepEqual(Frame.prototype._createIsolatedContext.call(frame, 'w'), ['w', 'caller']);
+  assert.deepEqual(Frame.prototype._createIsolatedContext.call(frame, 'u'), ['u', 'isolated']);
+});
+
+// A navigation away from a page the back-forward cache keeps starts the new
+// document in another process, which gets the context's init scripts and
+// bindings at once. The bindings went first: one for the caller's world made it
+// an isolated world, the init scripts' declaration of it as 'caller' was then
+// refused, and the document never committed. Measured on firefox-53: after a
+// client added a binding to the caller's world, every navigation timed out.
+test('a new process takes the init scripts before the bindings, so a binding does not decide a world\'s kind', () => {
+  const t = {
+    ...worlds(),
+    addBinding: FrameTree.prototype.addBinding,
+    applyCrossProcessState: FrameTree.prototype.applyCrossProcessState,
+  };
+  t.applyCrossProcessState(
+    [{ script: '', worldName: '__ctx_caller__', worldKind: 'caller' }],
+    [{ worldName: '__ctx_caller__', name: 'exposed', script: '' }]);
+  const world = t._isolatedWorlds.get('__ctx_caller__');
+  assert.equal(world._kind, 'caller');
+  assert.equal(world._bindings.get('exposed'), '');
+});
+
+test('the content process starts its frame tree through that order', () => {
+  const main = fs.readFileSync(path.join(ROOT, 'content/main.js'), 'utf8');
+  const start = main.slice(main.indexOf('data.frameTree = new FrameTree('), main.indexOf('data.channel = new SimpleChannel('));
+  assert.match(start, /applyCrossProcessState\(/);
+  assert.doesNotMatch(start, /\.addBinding\(/);
+});
diff --git a/juggler/tests/crashed_tab_is_closed.test.mjs b/juggler/tests/crashed_tab_is_closed.test.mjs
new file mode 100644
index 00000000..472670e2
--- /dev/null
+++ b/juggler/tests/crashed_tab_is_closed.test.mjs
@@ -0,0 +1,42 @@
+// A tab whose content process crashed is closed once the client is told.
+//
+// Until firefox-48 the crash observer (oop-frameloader-crashed, TargetRegistry.js)
+// emitted Crashed and disposed the target, and nothing removed the tab: it
+// stayed in the parent until the browser exited, 15-60 MB a crash, and no
+// command reached it any more. Measured on a headed firefox-47, crashing with
+// about:crashcontent and counting the process's top-level windows: the crashed
+// page's window stayed open in every arm; with this remedy it closes, except
+// as the only window of a persistent context, where closing it would quit the
+// browser.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const code = rel => fs.readFileSync(path.join(JUGGLER, rel), 'utf8')
+    .replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');
+
+test('the crash observer closes the tab after disposing its target', () => {
+  const registry = code('TargetRegistry.js');
+  const observer = registry.slice(0, registry.indexOf("'oop-frameloader-crashed'"));
+  const tail = observer.slice(observer.lastIndexOf('target.emit(PageTarget.Events.Crashed'));
+  // dispose() first: it takes the target out of _browserToTarget, so the
+  // TabClose that removeTab fires finds nothing to dispose a second time.
+  assert.match(tail, /^target\.emit\(PageTarget\.Events\.Crashed\);\s*target\.dispose\(\);\s*target\.closeCrashedTab\(\);/);
+});
+
+test('only a browser that does not survive its last window keeps the tab', () => {
+  const registry = code('TargetRegistry.js');
+  const body = registry.slice(registry.indexOf('closeCrashedTab() {'));
+  const method = body.slice(0, body.indexOf('\n  }\n') + 4);
+  assert.match(method, /!this\._registry\._survivesLastWindow/);
+  assert.match(method, /removeTab\(this\._tab, \{ skipPermitUnload: true \}\)/);
+  // The flag is Juggler's -silent, which holds the browser in the
+  // last-window-closing survival area.
+  assert.match(code('components/Juggler.js'), /new TargetRegistry\(\{ survivesLastWindow: this\._silent \}\)/);
+});
diff --git a/juggler/tests/download_complete_follows_the_idl.test.mjs b/juggler/tests/download_complete_follows_the_idl.test.mjs
new file mode 100644
index 00000000..bcb1ed7b
--- /dev/null
+++ b/juggler/tests/download_complete_follows_the_idl.test.mjs
@@ -0,0 +1,41 @@
+// The download interceptor's completion is read with the IDL's arguments.
+//
+// nsIDownloadInterceptor.onDownloadComplete takes (aHandler, aErrorName)
+// (uriloader/exthandler/StealthDownloadInterceptor.idl). TargetRegistry.js
+// declared (handler, canceled, errorName): the error name arrived as
+// `canceled`, so every failure other than a cancel was reported as a finished
+// download, and success came with an undefined error.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const read = rel => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+
+function idlArguments() {
+  const idl = read('uriloader/exthandler/StealthDownloadInterceptor.idl');
+  const m = idl.match(/void\s+onDownloadComplete\s*\(([^)]*)\)/);
+  assert.ok(m, 'the IDL declares onDownloadComplete');
+  return m[1].split(',').map(s => s.trim()).filter(Boolean);
+}
+
+function jsParameters() {
+  const js = read('juggler/TargetRegistry.js');
+  const m = js.match(/^\s*onDownloadComplete\s*\(([^)]*)\)\s*\{/m);
+  assert.ok(m, 'TargetRegistry.js implements onDownloadComplete');
+  return m[1].split(',').map(s => s.trim()).filter(Boolean);
+}
+
+test('onDownloadComplete takes as many arguments as the IDL gives', () => {
+  assert.equal(jsParameters().length, idlArguments().length);
+});
+
+test('the second argument is the error name', () => {
+  assert.match(idlArguments()[1], /aErrorName$/);
+  assert.match(jsParameters()[1], /error/i);
+});
diff --git a/juggler/tests/explicit_size_flag_is_free.test.mjs b/juggler/tests/explicit_size_flag_is_free.test.mjs
new file mode 100644
index 00000000..de4ca249
--- /dev/null
+++ b/juggler/tests/explicit_size_flag_is_free.test.mjs
@@ -0,0 +1,56 @@
+// The chrome flag that marks a popup with an explicit size is ours: it is
+// set in toolkit/components/windowwatcher/JugglerWindowSize.h and read in
+// juggler/TargetRegistry.js, in a bit nsIWebBrowserChrome.idl leaves free.
+// It used to be declared in that IDL as 1 << 25, the bit Firefox 159 gives
+// to CHROME_MEDIA_PIP: a port would have marked every media
+// Picture-in-Picture window as sized by the page, with no conflict to see.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const TREE = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const read = rel => fs.readFileSync(path.join(TREE, rel), 'utf8');
+
+// {name: bit} of the single-bit constants of nsIWebBrowserChrome.idl.
+function chromeBits(idl) {
+  const bits = {};
+  for (const m of idl.matchAll(/const unsigned long (\w+)\s*=\s*1 << (\d+);/g))
+    bits[m[1]] = Number(m[2]);
+  return bits;
+}
+
+function ourBit(text, name) {
+  const m = text.match(new RegExp(`${name}\\s*=\\s*1u? << (\\d+);`));
+  assert.ok(m, `${name} not found`);
+  return Number(m[1]);
+}
+
+function collisions(bit, bits) {
+  return Object.entries(bits).filter(([, b]) => b === bit).map(([n]) => n);
+}
+
+test('the C++ and the JS side use the same bit', () => {
+  const cpp = ourBit(read('toolkit/components/windowwatcher/JugglerWindowSize.h'), 'kJugglerWindowExplicitSize');
+  const js = ourBit(read('juggler/TargetRegistry.js'), 'JUGGLER_WINDOW_EXPLICIT_SIZE');
+  assert.equal(cpp, js);
+});
+
+test('no flag of nsIWebBrowserChrome uses our bit', () => {
+  const bits = chromeBits(read('toolkit/components/browser/nsIWebBrowserChrome.idl'));
+  // Near-miss guard: an IDL this cannot parse would pass vacuously.
+  assert.ok(Object.keys(bits).length >= 15, `only ${Object.keys(bits).length} flags read`);
+  assert.ok(!('JUGGLER_WINDOW_EXPLICIT_SIZE' in bits), 'our flag is back in the Mozilla IDL');
+  const bit = ourBit(read('juggler/TargetRegistry.js'), 'JUGGLER_WINDOW_EXPLICIT_SIZE');
+  assert.deepEqual(collisions(bit, bits), []);
+});
+
+test('the check sees the 159 collision', () => {
+  const idl159 = 'const unsigned long CHROME_SUPPRESS_ANIMATION     = 1 << 24;\n' +
+                 'const unsigned long CHROME_MEDIA_PIP              = 1 << 25;\n';
+  assert.deepEqual(collisions(25, chromeBits(idl159)), ['CHROME_MEDIA_PIP']);
+});
diff --git a/juggler/tests/frame_tree.test.mjs b/juggler/tests/frame_tree.test.mjs
new file mode 100644
index 00000000..28a5a108
--- /dev/null
+++ b/juggler/tests/frame_tree.test.mjs
@@ -0,0 +1,114 @@
+// FrameTree's answer to a browsing context that went, loaded the way the
+// content process loads it, with the real Helper that names frames.
+//
+// B292: after a few navigations in one tab, the iframes of the page being
+// loaded were reported detached while the browser loaded them. With the
+// back-forward cache in the parent each navigation gives the tab a new
+// top-level context and a new FrameTree; a frame id names the frame, and the
+// main frame's is the browser's (`mainframe-<browserId>`), so when the cache
+// let an old top-level context go, every tree resolved it to its own main
+// frame and detached all its children. Measured on firefox-42 with an
+// instrumented copy: "discarded bc=10 ... root=14 known=true", then
+// "detach subframe-10737418245", the live iframe of the current page.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+// An ES module of Juggler's, evaluated as a script: `export` dropped, the
+// names it defines handed back.
+function load(file, scope, names) {
+  const source = fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/^export /gm, '');
+  vm.createContext(scope);
+  vm.runInContext(source + `\n;globalThis.__names = { ${names.join(', ')} };`, scope);
+  return scope.__names;
+}
+
+const { Helper } = load('Helper.js', {
+  Cc: { '@mozilla.org/uuid-generator;1': { getService: () => ({}) } },
+  Ci: {},
+  ChromeUtils: { importESModule: () => ({}) },
+}, ['Helper']);
+
+const { FrameTree } = load('content/FrameTree.js', {
+  Components: { interfaces: {}, results: {}, utils: {} },
+  ChromeUtils: { importESModule: () => ({ Helper }) },
+  dump: () => {},
+}, ['FrameTree']);
+
+// A tree as far as the answer needs it: its frames by id, and what it detaches.
+function tree(frames) {
+  return {
+    _frameIdToFrame: new Map(frames),
+    detached: [],
+    frameForBrowsingContext: FrameTree.prototype.frameForBrowsingContext,
+    _detachFrame(frame) { this.detached.push(frame); },
+  };
+}
+
+const oldTop = { id: 10, parent: null, browserId: 9 };
+const top = { id: 14, parent: null, browserId: 9 };
+const iframe = { id: 10737418245, parent: top, browserId: 9 };
+const main = { _browsingContext: top };
+const sub = { _browsingContext: iframe };
+
+function went(t, context) {
+  FrameTree.prototype._onBrowsingContextDetached.call(t, context);
+  return t.detached;
+}
+
+test('an old top-level context of the tab going detaches nothing of the current page', () => {
+  const t = tree([['mainframe-9', main], ['subframe-10737418245', sub]]);
+  assert.deepEqual(went(t, oldTop), []);
+});
+
+test('the tree\'s own top-level context going detaches its main frame', () => {
+  const t = tree([['mainframe-9', main], ['subframe-10737418245', sub]]);
+  assert.deepEqual(went(t, top), [main]);
+});
+
+test('an iframe\'s context going detaches that iframe', () => {
+  const t = tree([['mainframe-9', main], ['subframe-10737418245', sub]]);
+  assert.deepEqual(went(t, iframe), [sub]);
+});
+
+// B303 E3: the same class reached every process-wide observer, through the
+// lookups themselves. A tree whose document was in the back-forward cache
+// took the docShell of the page that replaced it for its own main frame:
+// contexts created, a navigation started, all for another document. Measured
+// on firefox-47 with an instrumented copy: the cached tree of page one queued
+// runtimeExecutionContextCreated id-11/id-12 and pageNavigationStarted nav-27
+// for page two. The identity check is now in the lookup, for every caller.
+function lookups(frames) {
+  return {
+    _frameIdToFrame: new Map(frames),
+    frameForBrowsingContext: FrameTree.prototype.frameForBrowsingContext,
+    frameForDocShell: FrameTree.prototype.frameForDocShell,
+  };
+}
+
+test('another top-level docShell of the tab is not this tree\'s main frame', () => {
+  const t = lookups([['mainframe-9', main], ['subframe-10737418245', sub]]);
+  const next = { id: 15, parent: null, browserId: 9 };
+  assert.equal(t.frameForDocShell({ browsingContext: next }), null);
+  assert.equal(t.frameForBrowsingContext(next), null);
+});
+
+test('the tree\'s own docShells are found', () => {
+  const t = lookups([['mainframe-9', main], ['subframe-10737418245', sub]]);
+  assert.equal(t.frameForDocShell({ browsingContext: top }), main);
+  assert.equal(t.frameForDocShell({ browsingContext: iframe }), sub);
+  assert.equal(t.frameForDocShell(null), null);
+});
+
+test('a context the tree never knew detaches nothing', () => {
+  const t = tree([['mainframe-9', main]]);
+  assert.deepEqual(went(t, { id: 77, parent: top, browserId: 9 }), []);
+});
diff --git a/juggler/tests/input_waits_are_bounded.test.mjs b/juggler/tests/input_waits_are_bounded.test.mjs
new file mode 100644
index 00000000..bac04d7d
--- /dev/null
+++ b/juggler/tests/input_waits_are_bounded.test.mjs
@@ -0,0 +1,53 @@
+// The input chain waits only on what is guaranteed to come.
+//
+// Every input that brings a tab forward runs through activateAndRun's chain
+// (TargetRegistry.js), so one wait that never ends stops the input of every tab
+// of the browser. Two did not end in every case:
+//
+// - `await helper.awaitTopic('apz-repaints-flushed')` after
+//   `windowUtils.flushApzRepaints()`, on the mouse and the wheel. The call
+//   answers true once it has SENT the request, and the compositor drops it in
+//   silence when its bridge is not initialized or the layer tree is gone
+//   (WebRenderBridgeParent::RecvFlushApzRepaints, test-only on desktop). And it
+//   protected nothing here: it followed a scroll of the <browser> into the
+//   window (scrollRectIntoViewIfNeeded) that no binding of Element declares in
+//   this tree, so the scroll never ran (B184).
+// - `watcher.ensureEventsAndDispose(['dragover'])` after `dispatchDragEvent`:
+//   jugglerSendDragEvent dispatches synchronously in the content process, so
+//   its reply already says the dragover was dispatched; the reported event
+//   never came when the dragover reached no frame.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const read = rel => fs.readFileSync(path.join(JUGGLER, rel), 'utf8');
+// The code, not the comments that explain why it is gone.
+const code = rel => read(rel).replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');
+
+test('no input path waits for an APZ flush', () => {
+  for (const rel of ['protocol/PageHandler.js', 'TargetRegistry.js', 'content/PageAgent.js']) {
+    assert.doesNotMatch(code(rel), /flushApzRepaints|apz-repaints-flushed/, rel);
+  }
+});
+
+test('the parent does not scroll the <browser> before an input', () => {
+  assert.doesNotMatch(code('protocol/PageHandler.js'), /scrollRectIntoViewIfNeeded/);
+});
+
+test('a drag event is acknowledged by its reply, not by a second channel', () => {
+  const handler = code('protocol/PageHandler.js');
+  assert.doesNotMatch(handler, /ensureEventsAndDispose\(\s*\[\s*'dragover'/);
+  assert.match(handler, /dispatchDragEvent', \{type: ?'dragover'/);
+  // Nothing reads a reported dragover any more, so nothing reports it.
+  assert.doesNotMatch(code('content/FrameTree.js'), /addEventListener\(chromeEventHandler, 'dragover'/);
+});
+
+test('the helper that waited on an observer topic without a bound is gone', () => {
+  assert.doesNotMatch(code('Helper.js'), /awaitTopic\s*\(/);
+});
diff --git a/juggler/tests/navigation_abort.test.mjs b/juggler/tests/navigation_abort.test.mjs
new file mode 100644
index 00000000..76349a27
--- /dev/null
+++ b/juggler/tests/navigation_abort.test.mjs
@@ -0,0 +1,141 @@
+// FrameTree's answer to the main frame's NS_BINDING_ABORTED, loaded the way the
+// content process loads it, with the real Helper that names the status.
+//
+// B302: a goto issued while the page being left rewrote itself with
+// document.open() answered "committed" on the OLD document, or waited out its
+// timeout. document.open() stops the browsing context's ongoing navigation
+// (HTML spec), and the main frame's NS_BINDING_ABORTED was dropped whole,
+// because a Fission process swap fires a spurious one; the navigation stayed
+// pending, and the document.write() that follows inserts a root element into
+// the old document, which onWindowEvent took for the pending navigation's
+// commit. Measured on firefox-45 with the wrapper: 7 gotos of 40 answered OK in
+// 0.03 s with the page still at the previous URL.
+//
+// The swap's abort is told from a real one by what the browser does to the old
+// document in the same task: BrowsingContext::DeactivateDocuments disconnects
+// the old channel and then marks the context in the BFCache, and a document
+// that cannot enter it has its channel cancelled while its docShell is
+// destroyed. A real abort (document.open, window.stop) leaves the document
+// where it is.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function load(file, scope, names) {
+  const source = fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/^export /gm, '');
+  vm.createContext(scope);
+  vm.runInContext(source + `\n;globalThis.__names = { ${names.join(', ')} };`, scope);
+  return scope.__names;
+}
+
+const Cr = { NS_BINDING_ABORTED: 0x804b0002, NS_ERROR_CONNECTION_REFUSED: 0x804b000d };
+class nsIChannel {}
+const STATE_STOP = 0x10;
+const Ci = { nsIChannel, nsIWebProgressListener: { STATE_STOP }, nsIWebNavigation: {} };
+
+const { Helper } = load('Helper.js', {
+  Cc: { '@mozilla.org/uuid-generator;1': { getService: () => ({}) } },
+  Ci, Cr,
+  ChromeUtils: { importESModule: () => ({}) },
+}, ['Helper']);
+
+// The task queue the deferred decision goes to, run by hand.
+const queue = [];
+const { FrameTree } = load('content/FrameTree.js', {
+  Components: { interfaces: Ci, results: Cr, utils: {} },
+  ChromeUtils: { importESModule: () => ({ Helper }) },
+  Services: { tm: { dispatchToMainThread: fn => queue.push(fn) } },
+  dump: () => {},
+}, ['FrameTree']);
+
+function runQueue() {
+  while (queue.length)
+    queue.shift()();
+}
+
+// A tree as far as the answer needs it: one main frame and one child frame on
+// their docShells, and what it emits.
+function setup() {
+  const mainShell = { destroyed: false, browsingContext: { isInBFCache: false },
+                      isBeingDestroyed() { return this.destroyed; },
+                      currentURI: { spec: 'http://x/old' }, QueryInterface() { return this; } };
+  const childShell = { destroyed: false, browsingContext: { isInBFCache: false },
+                       isBeingDestroyed() { return this.destroyed; } };
+  const main = { _pendingNavigationId: 'nav-1', _children: new Set() };
+  const child = { _pendingNavigationId: 'nav-2', _children: new Set() };
+  const emitted = [];
+  const t = {
+    _mainFrame: main,
+    frameForDocShell: shell => shell === mainShell ? main : shell === childShell ? child : null,
+    emit: (event, frame, ...args) => emitted.push([event, frame === main ? 'main' : 'child', ...args]),
+    forcePageReady: () => emitted.push(['pageReady']),
+    _detachFrame() {},
+    _installMainFrameInputListeners() {},
+  };
+  return { t, main, child, mainShell, childShell, emitted };
+}
+
+function stop(t, shell, status) {
+  const request = Object.assign(new nsIChannel(), { isDocument: true, QueryInterface() { return this; } });
+  FrameTree.prototype.onStateChange.call(t, { DOMWindow: { docShell: shell } }, request, STATE_STOP, status);
+}
+
+function docElementInserted(t, shell) {
+  FrameTree.prototype.onWindowEvent.call(t, { type: 'DOMDocElementInserted', target: { documentGlobal: { docShell: shell } } });
+}
+
+const ABORTED = FrameTree.Events.NavigationAborted;
+const COMMITTED = FrameTree.Events.NavigationCommitted;
+
+test('a real abort of the main frame (document.open, window.stop) is reported', () => {
+  const { t, mainShell, emitted } = setup();
+  stop(t, mainShell, Cr.NS_BINDING_ABORTED);
+  runQueue();
+  assert.deepEqual(emitted, [[ABORTED, 'main', 'nav-1', 'NS_BINDING_ABORTED']]);
+});
+
+test('the document.write after the abort is not taken for the navigation\'s commit', () => {
+  const { t, main, mainShell, emitted } = setup();
+  stop(t, mainShell, Cr.NS_BINDING_ABORTED);
+  docElementInserted(t, mainShell);
+  runQueue();
+  assert.equal(main._pendingNavigationId, null);
+  assert.equal(emitted.filter(e => e[0] === COMMITTED).length, 0);
+  assert.deepEqual(emitted, [[ABORTED, 'main', 'nav-1', 'NS_BINDING_ABORTED']]);
+});
+
+test('the process swap\'s abort, the old document entering the BFCache in the same task, is not reported', () => {
+  const { t, mainShell, emitted } = setup();
+  stop(t, mainShell, Cr.NS_BINDING_ABORTED);
+  mainShell.browsingContext.isInBFCache = true;   // DeactivateDocuments, after the disconnect
+  runQueue();
+  assert.deepEqual(emitted, []);
+});
+
+test('the process swap\'s abort while the old docShell is destroyed is not reported', () => {
+  const { t, mainShell, emitted } = setup();
+  mainShell.destroyed = true;
+  stop(t, mainShell, Cr.NS_BINDING_ABORTED);
+  runQueue();
+  assert.deepEqual(emitted, []);
+});
+
+test('a network failure of the main frame is reported at once, and readies the page', () => {
+  const { t, mainShell, emitted } = setup();
+  stop(t, mainShell, Cr.NS_ERROR_CONNECTION_REFUSED);
+  assert.deepEqual(emitted, [[ABORTED, 'main', 'nav-1', 'NS_ERROR_CONNECTION_REFUSED'], ['pageReady']]);
+});
+
+test('a child frame\'s abort is reported at once', () => {
+  const { t, childShell, emitted } = setup();
+  stop(t, childShell, Cr.NS_BINDING_ABORTED);
+  assert.deepEqual(emitted, [[ABORTED, 'child', 'nav-2', 'NS_BINDING_ABORTED']]);
+});
diff --git a/juggler/tests/not_a_chrome_package.test.mjs b/juggler/tests/not_a_chrome_package.test.mjs
new file mode 100644
index 00000000..6b1d5c8c
--- /dev/null
+++ b/juggler/tests/not_a_chrome_package.test.mjs
@@ -0,0 +1,160 @@
+// Juggler is not a chrome package, and every URL that loads it names a file the
+// build installs.
+//
+// A page can tell whether the browser registers a chrome package of a given
+// name: the parent sends every registered package to each content process, and
+// `new Worker("chrome://<name>/...")` returns for a registered name and throws
+// SecurityError at once for an absent one. Until firefox-47 every build
+// registered `juggler` (jar.mn, `% content juggler %content/`), and from
+// 2026-10-06 the challenge scripts of studied systems probed it: one such worker
+// script runs `new Worker("chrome://juggler/content/content/WorkerMain.js")`
+// (another anti-detect Firefox fork, #847), and a solved challenge was refused on our build while retail passed
+// (invisible_playwright #336). Measured from a page on firefox-46, 2026-10-14:
+// of the 65 chrome packages and resource substitutions the build registers,
+// `juggler` was the one retail does not.
+//
+// Juggler now loads from resource://gre/modules/juggler/, a namespace every
+// Firefox registers, inside which a page cannot tell which files exist. This
+// test bounds both sides: nothing registers or names the chrome package, and
+// each resource URL in the tree is one moz.build installs, so a typo is caught
+// here and not as a browser that cannot be driven.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const TREE = path.join(JUGGLER, '..');
+const PREFIX = 'resource://gre/modules/juggler/';
+// Outside juggler/, the files that load a Juggler module.
+const LOADERS_OUTSIDE = [
+  'toolkit/components/telemetry/app/TelemetrySend.sys.mjs',
+  'toolkit/components/telemetry/pings/BackgroundTask_pingsender.sys.mjs',
+];
+
+function sources() {
+  const out = [];
+  const walk = dir => {
+    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+      const p = path.join(dir, e.name);
+      if (e.isDirectory()) {
+        if (e.name !== 'tests')
+          walk(p);
+      } else if (/\.(js|mjs|jsm|conf|css|build|mn)$/.test(e.name)) {
+        out.push(p);
+      }
+    }
+  };
+  walk(JUGGLER);
+  return out.concat(LOADERS_OUTSIDE.map(f => path.join(TREE, f)));
+}
+
+// The paths under modules/juggler/ that juggler/moz.build installs.
+function installed() {
+  const build = fs.readFileSync(path.join(JUGGLER, 'moz.build'), 'utf8');
+  const files = new Set();
+  const re = /FINAL_TARGET_FILES\.modules\.juggler((?:\.\w+)*)\s*\+=\s*\[([^\]]*)\]/g;
+  for (const [, sub, list] of build.matchAll(re)) {
+    const dir = sub.split('.').filter(Boolean).join('/');
+    for (const [, src] of list.matchAll(/"([^"]+)"/g))
+      files.add((dir ? dir + '/' : '') + path.posix.basename(src));
+  }
+  return files;
+}
+
+test('no chrome package is registered for the juggler', () => {
+  assert.equal(fs.existsSync(path.join(JUGGLER, 'jar.mn')), false, 'juggler/jar.mn is back');
+  const build = fs.readFileSync(path.join(JUGGLER, 'moz.build'), 'utf8');
+  assert.doesNotMatch(build, /^\s*JAR_MANIFESTS/m);
+  const manifest = fs.readFileSync(path.join(TREE, 'browser/installer/package-manifest.in'), 'utf8');
+  assert.doesNotMatch(manifest, /chrome\/juggler/);
+});
+
+test('no source names a chrome://juggler URL', () => {
+  const offenders = sources().filter(f => fs.readFileSync(f, 'utf8').includes('chrome://juggler'));
+  assert.deepEqual(offenders.map(f => path.relative(TREE, f)), []);
+});
+
+test('every juggler resource URL names a file the build installs', () => {
+  const files = installed();
+  // Near-miss guard: the parser read the lists, so an empty set is a broken
+  // test and not a pass.
+  assert.ok(files.has('components/Juggler.js') && files.has('content/WorkerMain.js'),
+            [...files].join(' '));
+  const missing = [];
+  let seen = 0;
+  for (const f of sources()) {
+    const text = fs.readFileSync(f, 'utf8');
+    for (const [, rel] of text.matchAll(/resource:\/\/gre\/modules\/juggler\/([\w./-]+)/g)) {
+      if (rel.endsWith('/'))
+        continue;
+      seen++;
+      if (!files.has(rel))
+        missing.push(`${path.relative(TREE, f)}: ${PREFIX}${rel}`);
+    }
+  }
+  assert.ok(seen >= 40, `only ${seen} juggler URLs found: the scan is not reading the tree`);
+  assert.deepEqual(missing, []);
+});
+
+test('the stack filter skips the prefix the build installs under', () => {
+  const cpp = fs.readFileSync(path.join(TREE, 'js/src/vm/SavedStacks.cpp'), 'utf8');
+  const literal = cpp.match(/kJuggler\[\]\s*=\s*"([^"]+)"/);
+  assert.ok(literal, 'SavedStacks.cpp no longer names the prefix in kJuggler');
+  const build = fs.readFileSync(path.join(JUGGLER, 'moz.build'), 'utf8');
+  assert.match(build, /FINAL_TARGET_FILES\.modules\.juggler\s*\+=/);
+  // FINAL_TARGET_FILES.modules.juggler lands in dist/bin/modules/juggler,
+  // which is resource://gre/modules/juggler/.
+  assert.equal(literal[1], PREFIX);
+});
+
+test('a juggler name in WebIDL stays behind ChromeOnly', () => {
+  // One WebIDL member carries the name: `jugglerEventId` in the dictionary
+  // SynthesizeMouseEventData. A dictionary has no constructor and no
+  // enumeration surface, so the only way a page could read the name is by
+  // passing an object with a getter to a method that accepts the dictionary -
+  // and those methods are ChromeOnly. That annotation is the whole guard, so
+  // losing it makes the literal string probeable from a page. The name itself
+  // would be better gone (next engine release); until then this fails if the
+  // annotation does.
+  const dir = path.join(TREE, 'dom/webidl');
+  const named = [];
+  for (const f of fs.readdirSync(dir).filter(n => n.endsWith('.webidl'))) {
+    const text = fs.readFileSync(path.join(dir, f), 'utf8');
+    if (!/juggler/i.test(text))
+      continue;
+    // The dictionaries that declare a juggler-named member.
+    for (const m of text.matchAll(/dictionary\s+(\w+)[^{]*\{([\s\S]*?)\n\};/g)) {
+      if (/\bjuggler\w*\s*(=|;)/i.test(m[2]))
+        named.push({ file: f, dict: m[1], text });
+    }
+  }
+  assert.ok(named.length, 'no juggler-named WebIDL member found: the scan is not reading the tree');
+  const unguarded = [];
+  for (const { file, dict, text } of named) {
+    const lines = text.split('\n');
+    lines.forEach((line, i) => {
+      // A method taking the dictionary as a parameter type. Declarations only:
+      // a doc comment naming the dictionary is prose, not a surface.
+      if (!new RegExp(`\\b${dict}\\b`).test(line) || /^\s*dictionary\s/.test(line)
+          || /^\s*(\*|\/\/|\/\*)/.test(line))
+        return;
+      const before = lines.slice(Math.max(0, i - 10), i + 1).join('\n');
+      if (!/\[[^\]]*ChromeOnly[^\]]*\]/.test(before))
+        unguarded.push(`${file}:${i + 1}: ${line.trim()}`);
+    });
+  }
+  assert.deepEqual(unguarded, []);
+});
+
+test('the test fails on the layout it replaces', () => {
+  // The parser on a moz.build that installs nothing finds nothing, and a URL to
+  // a file not in the lists is reported: the two assertions above can fire.
+  const re = /FINAL_TARGET_FILES\.modules\.juggler((?:\.\w+)*)\s*\+=\s*\[([^\]]*)\]/g;
+  assert.equal([...'JAR_MANIFESTS += ["jar.mn"]'.matchAll(re)].length, 0);
+  assert.equal(installed().has('content/NoSuchFile.js'), false);
+});
diff --git a/juggler/tests/request_body_is_always_read.test.mjs b/juggler/tests/request_body_is_always_read.test.mjs
new file mode 100644
index 00000000..b052dc2f
--- /dev/null
+++ b/juggler/tests/request_body_is_always_read.test.mjs
@@ -0,0 +1,38 @@
+// A request's body reaches the client whether or not anything intercepts it.
+//
+// Since 2026-08-24 (B170) the body of a POST was not read, to save a copy of
+// every upload; on 2026-10-03 it came back only while interception was on
+// (invisible_core#90). So `request.post_data` answered None for every POST of a
+// page with no route - a login, a search - as if the form had been empty, with
+// no error: measured on firefox-47, a fetch POST with a body read as None with
+// no route and as the body with a route that only continues (B303 E15). The
+// owner chose upstream's behaviour on 2026-10-16: the body is always read, with
+// upstream's reader, which leaves the upload intact and skips bodies over 10 MB.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const code = fs.readFileSync(path.join(JUGGLER, 'NetworkObserver.js'), 'utf8')
+    .replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');
+
+test('the request event carries the body with no condition on interception', () => {
+  const emit = code.slice(code.indexOf('pageNetwork.emit(PageNetwork.Events.Request'));
+  const event = emit.slice(0, emit.indexOf('}, this._frameId)'));
+  assert.match(event, /postData:\s*readRequestPostData\(this\.httpChannel\)\s*,/);
+  assert.doesNotMatch(event, /_shouldIntercept\(\)/);
+});
+
+test('the reader keeps the upload intact and caps what it copies', () => {
+  const reader = code.slice(code.indexOf('function readRequestPostData('));
+  const body = reader.slice(0, reader.indexOf('\n}\n'));
+  // Cloned, or rewound where it was, so the network still sends every byte.
+  assert.match(body, /iStream\.clone\(\)/);
+  assert.match(body, /NS_SEEK_SET, 0\)/);
+  assert.match(body, /10 \* 1024 \* 1024/);
+});
diff --git a/juggler/tests/response_tells_its_security_and_service_worker.test.mjs b/juggler/tests/response_tells_its_security_and_service_worker.test.mjs
new file mode 100644
index 00000000..a0c14d2b
--- /dev/null
+++ b/juggler/tests/response_tells_its_security_and_service_worker.test.mjs
@@ -0,0 +1,46 @@
+// A response says what certificate served it and whether a service worker
+// answered it, as upstream does.
+//
+// Since 2026-08-24 (B170) `securityDetails` was always null and
+// `fromServiceWorker` always false, to save parsing a certificate per response
+// and an observer: `response.security_details()` answered None over HTTPS and
+// `response.from_service_worker` False for what a service worker answered -
+// values, not refusals, so a script read them as true (B303 E15). The owner
+// chose upstream's behaviour on 2026-10-16.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const code = fs.readFileSync(path.join(JUGGLER, 'NetworkObserver.js'), 'utf8')
+    .replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');
+
+const responseEvent = () => {
+  const emit = code.slice(code.indexOf('pageNetwork.emit(PageNetwork.Events.Response'));
+  return emit.slice(0, emit.indexOf('}, this._frameId)'));
+};
+
+test('the response carries the certificate that served it', () => {
+  assert.match(responseEvent(), /securityDetails:\s*getSecurityDetails\(this\.httpChannel\)/);
+  assert.match(code, /function getSecurityDetails\(httpChannel\)/);
+});
+
+test('the response says whether a service worker answered it', () => {
+  assert.match(responseEvent(), /fromServiceWorker:\s*this\._fulfilledByServiceWorker/);
+  // Gecko's own notification, the one the devtools read.
+  assert.match(code, /addObserver\(this\._onServiceWorkerResponse\.bind\(this\), 'service-worker-synthesized-response'\)/);
+});
+
+test('the mark lives on the request, not in a set nothing empties', () => {
+  // Upstream kept the ids in a Set emptied only when a response was emitted,
+  // so a channel with no page left its id there for good.
+  assert.doesNotMatch(code, /_channelIdsFulfilledByServiceWorker/);
+  const handler = code.slice(code.indexOf('_onServiceWorkerResponse(channel'));
+  const body = handler.slice(0, handler.indexOf('\n  }\n'));
+  assert.match(body, /_fulfilledByServiceWorker = true/);
+});
diff --git a/juggler/tests/runtime_debugger_module_url.test.mjs b/juggler/tests/runtime_debugger_module_url.test.mjs
new file mode 100644
index 00000000..5685c882
--- /dev/null
+++ b/juggler/tests/runtime_debugger_module_url.test.mjs
@@ -0,0 +1,36 @@
+// Runtime.js asks for the debugger module where Firefox 159 serves it.
+//
+// 159 moved devtools/platform/jsdebugger.sys.mjs to moz-src:/// (it is listed
+// under MOZ_SRC_FILES in devtools/platform/moz.build); the resource://gre/modules
+// address of 157 is gone, so a content process without a Debugger of its own
+// threw at load and no page ever got a Runtime.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const SOURCE = fs.readFileSync(
+  path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'content', 'Runtime.js'), 'utf8');
+
+test('a process without a Debugger imports the module from its 159 address', () => {
+  const asked = [];
+  const added = [];
+  const scope = {
+    ChromeUtils: {
+      importESModule: url => {
+        asked.push(url);
+        return { addDebuggerToGlobal: global => added.push(global) };
+      },
+    },
+    Components: { utils: { getGlobalForObject: g => g } },
+  };
+  vm.createContext(scope);
+  vm.runInContext(SOURCE, scope);
+  assert.deepEqual(asked, ['moz-src:///devtools/platform/jsdebugger.sys.mjs']);
+  assert.equal(added.length, 1);
+});
diff --git a/juggler/tests/runtime_ids_are_unique_per_session.test.mjs b/juggler/tests/runtime_ids_are_unique_per_session.test.mjs
new file mode 100644
index 00000000..8c790731
--- /dev/null
+++ b/juggler/tests/runtime_ids_are_unique_per_session.test.mjs
@@ -0,0 +1,59 @@
+// A context or object id names one thing for the whole session.
+//
+// Runtime.js is loaded once per content process and once per worker, and its
+// ids were a counter: every process named its worlds id-1, id-2... in the
+// same order. Measured 2026-10-24 on firefox-52: a page served with
+// Cross-Origin-Opener-Policy and Cross-Origin-Embedder-Policy runs in a
+// process of its own, the page after it does not, and the utility world was
+// id-8 in both - a client holding the first one's id-8 and an object of it
+// (id-10) was answered by the second one's id-8, "Cannot find object with
+// id = id-10", on every locator for good.
+//
+// Each load below is one process: its own global, its own copy of the file.
+//
+// Run: node --test juggler/tests/
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const SOURCE = fs.readFileSync(
+  path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'content', 'Runtime.js'), 'utf8');
+
+function loadIntoProcess() {
+  // A worker's global already has a Debugger, so the file skips the import
+  // that needs ChromeUtils.
+  const scope = { Debugger: function Debugger() {} };
+  vm.createContext(scope);
+  vm.runInContext(SOURCE, scope);
+  return scope;
+}
+
+test('two processes never hand out the same id', () => {
+  const first = loadIntoProcess();
+  const second = loadIntoProcess();
+  const a = Array.from({ length: 200 }, () => first.generateId());
+  const b = Array.from({ length: 200 }, () => second.generateId());
+  assert.equal(new Set(a).size, a.length);
+  assert.equal(new Set(b).size, b.length);
+  assert.deepEqual(a.filter(id => b.includes(id)), []);
+});
+
+test('the nth id of a new process is not the nth id of the old one', () => {
+  // The defect exactly: same position, same name.
+  const ids = Array.from({ length: 20 }, () => {
+    const process = loadIntoProcess();
+    for (let i = 0; i < 7; i++)
+      process.generateId();
+    return process.generateId();
+  });
+  assert.equal(new Set(ids).size, ids.length);
+});
+
+test('ids stay ordinary protocol strings', () => {
+  const id = loadIntoProcess().generateId();
+  assert.match(id, /^id-[0-9a-z]+-1$/);
+});
diff --git a/juggler/tests/shared_cookies_leave_with_their_owner.test.mjs b/juggler/tests/shared_cookies_leave_with_their_owner.test.mjs
new file mode 100644
index 00000000..30a7f6d6
--- /dev/null
+++ b/juggler/tests/shared_cookies_leave_with_their_owner.test.mjs
@@ -0,0 +1,49 @@
+// A page's and a context's sharedData entries leave with them.
+//
+// TargetRegistry writes each page's settings into Services.ppmm.sharedData
+// under its browserId, and each context's under its userContextId, for the
+// content processes to read (content/main.js). Nothing ever deleted either,
+// so every page and every context the browser ever had stayed in a map that
+// is copied whole into every content process at each flush: measured on
+// firefox-47 with an instrumented copy, 31 page entries after 30 pages opened
+// and closed. Now the owner deletes its entry when it ends, under the key it
+// wrote it with, and both sides take the key from Helper.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const JUGGLER = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const code = rel => fs.readFileSync(path.join(JUGGLER, rel), 'utf8')
+    .replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/[^\n]*/g, '');
+const method = (source, signature) => {
+  const start = source.indexOf(signature);
+  assert.notEqual(start, -1, signature);
+  return source.slice(start, source.indexOf('\n  }\n', start));
+};
+
+test('the two keys are named in Helper only', () => {
+  for (const rel of ['TargetRegistry.js', 'content/main.js'])
+    assert.doesNotMatch(code(rel), /juggler:(page|context)-cookie-/, rel);
+  assert.match(code('Helper.js'), /pageCookieKey\(browserId\)/);
+  assert.match(code('Helper.js'), /contextCookieKey\(userContextId\)/);
+});
+
+test('a page deletes its entry when it is disposed, under the key it wrote', () => {
+  const registry = code('TargetRegistry.js');
+  const pageTarget = registry.slice(registry.indexOf('export class PageTarget'), registry.indexOf('class BrowserContext'));
+  assert.match(method(pageTarget, '  dispose() {'), /sharedData\.delete\(this\._crossProcessCookieKey\(\)\)/);
+  assert.match(method(pageTarget, '  _crossProcessCookieKey() {'), /helper\.pageCookieKey\(this\._browserId\)/);
+  assert.match(method(pageTarget, '  _updateCrossProcessCookie() {'), /sharedData\.set\(this\._crossProcessCookieKey\(\)/);
+});
+
+test('a context deletes its entry when it is removed', () => {
+  const registry = code('TargetRegistry.js');
+  const context = registry.slice(registry.indexOf('class BrowserContext'));
+  assert.match(method(context, '  async destroy() {'), /sharedData\.delete\(this\._crossProcessCookieKey\(\)\)/);
+  assert.match(method(context, '  _crossProcessCookieKey() {'), /helper\.contextCookieKey\(this\.userContextId\)/);
+});
diff --git a/juggler/tests/simple_channel.test.mjs b/juggler/tests/simple_channel.test.mjs
new file mode 100644
index 00000000..b7f0d52f
--- /dev/null
+++ b/juggler/tests/simple_channel.test.mjs
@@ -0,0 +1,138 @@
+// SimpleChannel's two ends, each loaded the way loadSubScript loads it into a
+// process, connected by an in-memory transport that can lose messages.
+//
+// B286: a page's announcement that its main world was created never reached
+// the client. The content end of a page's channel is created per agents
+// instance with the uid 'process-<pid>' (content/main.js), so a second instance
+// in the same process carried the uid of the first and numbered its requests
+// from 1 again. The parent end keeps the answers it gave until they are
+// acknowledged, keyed by request number alone, and forgot them only when the
+// peer's uid changed: the new instance's first requests were answered from the
+// old instance's answers and never dispatched. Measured on firefox-41 with an
+// instrumented copy: "DEDUP #2 runtimeExecutionContextsCleared",
+// "DEDUP #3 runtimeExecutionContextCreated" on a new content channel.
+//
+// Run: node --test juggler/tests/
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const SOURCE = fs.readFileSync(
+  path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'SimpleChannel.js'), 'utf8');
+
+// One evaluation per process, as Services.scriptloader.loadSubScript does.
+function loadIntoProcess() {
+  const scope = {
+    dump: () => {},
+    ChromeUtils: { importESModule: () => ({ setTimeout }) },
+  };
+  vm.createContext(scope);
+  vm.runInContext(SOURCE, scope);
+  return scope.SimpleChannel;
+}
+
+// Connect two ends. `lose(message, from)` returning true drops a message, as
+// IPC drops what an actor that is going away sends.
+function link(a, b, lose = () => false) {
+  const deliver = (from, to) => message => {
+    if (lose(message, from))
+      return;
+    const copy = JSON.parse(JSON.stringify(message));
+    setImmediate(() => to._onMessage(copy));
+  };
+  a.setTransport({ sendMessage: deliver(a, b), dispose: () => {} });
+  b.setTransport({ sendMessage: deliver(b, a), dispose: () => {} });
+}
+
+const settle = () => new Promise(resolve => setTimeout(resolve, 20));
+
+function parentEnd() {
+  const Parent = loadIntoProcess();
+  const parent = new Parent('browser::page[1]', 'target-1');
+  const seen = [];
+  parent.register('page', { event: value => { seen.push(value); } });
+  return { parent, seen };
+}
+
+test('a new content instance in the same process is heard', async () => {
+  const { parent, seen } = parentEnd();
+  const Content = loadIntoProcess();
+
+  // The first instance's acknowledgements are lost: its actor went away
+  // before they left, so the parent still holds its answers.
+  const first = new Content('', 'process-9');
+  link(parent, first, (message, from) => from === first && message.ack === 'RESPONSE_ACK');
+  first.connect('page').emit('event', 'first #1');
+  first.connect('page').emit('event', 'first #2');
+  await settle();
+  assert.deepEqual(seen, ['first #1', 'first #2']);
+
+  // A new agents instance in the same process, with the name main.js gives.
+  parent.resetTransport();
+  const second = new Content('', 'process-9');
+  link(parent, second);
+  second.connect('page').emit('event', 'second #1');
+  second.connect('page').emit('event', 'second #2');
+  await settle();
+  assert.deepEqual(seen, ['first #1', 'first #2', 'second #1', 'second #2']);
+});
+
+test('the same instance over a new transport is not dispatched twice', async () => {
+  const { parent, seen } = parentEnd();
+  const Content = loadIntoProcess();
+  const content = new Content('', 'process-9');
+
+  // The answer is lost on the way back, so the content end sends again.
+  link(parent, content, (message, from) => from === parent && message.responseId);
+  const answered = content.connect('page').send('event', 'once');
+  await settle();
+  assert.deepEqual(seen, ['once']);
+
+  parent.resetTransport();
+  content.resetTransport();
+  link(parent, content);
+  await answered;
+  await settle();
+  assert.deepEqual(seen, ['once']);
+});
+
+test('an older instance that comes back keeps its deduplication', async () => {
+  const { parent, seen } = parentEnd();
+  const Content = loadIntoProcess();
+
+  const first = new Content('', 'process-9');
+  link(parent, first, (message, from) => from === parent && message.responseId);
+  const firstAnswered = first.connect('page').send('event', 'first');
+  await settle();
+
+  parent.resetTransport();
+  first.resetTransport();
+  const second = new Content('', 'process-9');
+  link(parent, second);
+  second.connect('page').emit('event', 'second');
+  await settle();
+
+  // The first instance's document comes back from the back-forward cache and
+  // its channel replays what it never had answered.
+  parent.resetTransport();
+  second.resetTransport();
+  link(parent, first);
+  await firstAnswered;
+  await settle();
+  assert.deepEqual(seen, ['first', 'second']);
+});
+
+test('an acknowledged answer is forgotten', async () => {
+  const { parent, seen } = parentEnd();
+  const Content = loadIntoProcess();
+  const content = new Content('', 'process-9');
+  link(parent, content);
+  await content.connect('page').send('event', 'acknowledged');
+  await settle();
+  assert.deepEqual(seen, ['acknowledged']);
+  assert.equal(parent._bufferedResponses.size, 0);
+});
diff --git a/juggler/tests/websocket_listener_follows_the_idl.test.mjs b/juggler/tests/websocket_listener_follows_the_idl.test.mjs
new file mode 100644
index 00000000..9f696688
--- /dev/null
+++ b/juggler/tests/websocket_listener_follows_the_idl.test.mjs
@@ -0,0 +1,118 @@
+// A frame's WebSocket listener reads its arguments in the order the IDL gives.
+//
+// From Firefox 159 nsIWebSocketEventListener.webSocketClosed, frameReceived and
+// frameSent take the HTTP channel id right after the serial
+// (netwerk/protocol/websocket/nsIWebSocketEventService.idl). Listeners still
+// written for 157 read that id as the frame, as wasClean, as the close code:
+// every frame came out with no opcode and no data, and every close was
+// reported as an error or not at all.
+//
+// The listener here is called the way 159's service calls it.
+//
+// Run: node --test juggler/tests/*.test.mjs
+
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import vm from 'node:vm';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+
+function load(file, scope, names) {
+  const source = fs.readFileSync(path.join(ROOT, file), 'utf8').replace(/^export /gm, '');
+  vm.createContext(scope);
+  vm.runInContext(source + `\n;globalThis.__names = { ${names.join(', ')} };`, scope);
+  return scope.__names;
+}
+
+const Services = { obs: { addObserver() {}, removeObserver() {} } };
+
+class EventEmitter {
+  on() {}
+  off() {}
+  once() {}
+  emit() {}
+}
+
+const { Helper } = load('Helper.js', {
+  Cc: { '@mozilla.org/uuid-generator;1': { getService: () => ({}) } },
+  Ci: {},
+  ChromeUtils: { importESModule: () => ({ EventEmitter }) },
+  Services,
+}, ['Helper']);
+
+const { Frame, FrameTree } = load('content/FrameTree.js', {
+  // FrameTree.js takes Ci from Components.interfaces, so the stub goes there.
+  Components: { interfaces: { nsIWebSocketChannel: { CLOSE_ABNORMAL: 1006 } }, results: {}, utils: {} },
+  Cc: {},
+  ChromeUtils: { importESModule: () => ({ Helper }), generateQI: () => () => {} },
+  Services,
+  Runtime: class {},
+  dump: () => {},
+  btoa,
+}, ['Frame', 'FrameTree']);
+
+const HTTP_CHANNEL_ID = 987654321;
+const SERIAL = 7;
+
+function listener() {
+  const events = [];
+  const frameTree = { emit: (name, payload) => events.push({ name, payload }) };
+  const browsingContext = { browserId: 1, parent: null };
+  const frame = new Frame(frameTree, {}, browsingContext, null);
+  return { events, ws: frame._webSocketListener };
+}
+
+function open(ws) {
+  ws.webSocketCreated(SERIAL, 'ws://example.test/', '');
+  ws.webSocketOpened(SERIAL, 'ws://example.test/', '', '', HTTP_CHANNEL_ID);
+}
+
+test('a received text frame is read from the third argument', () => {
+  const { events, ws } = listener();
+  open(ws);
+  ws.frameReceived(SERIAL, HTTP_CHANNEL_ID, { opCode: 1, payload: 'hello' });
+  const received = events.find(e => e.name === FrameTree.Events.WebSocketFrameReceived);
+  assert.ok(received, 'the frame was reported');
+  assert.equal(received.payload.opcode, 1);
+  assert.equal(received.payload.data, 'hello');
+  assert.equal(received.payload.wsid, SERIAL + '');
+});
+
+test('a sent binary frame is read from the third argument', () => {
+  const { events, ws } = listener();
+  open(ws);
+  ws.frameSent(SERIAL, HTTP_CHANNEL_ID, { opCode: 2, payload: 'ab' });
+  const sent = events.find(e => e.name === FrameTree.Events.WebSocketFrameSent);
+  assert.ok(sent, 'the frame was reported');
+  assert.equal(sent.payload.opcode, 2);
+  assert.equal(sent.payload.data, btoa('ab'));
+});
+
+test('a frame that arrives before the socket is open waits, and keeps its content', () => {
+  const { events, ws } = listener();
+  ws.webSocketCreated(SERIAL, 'ws://example.test/', '');
+  ws.frameReceived(SERIAL, HTTP_CHANNEL_ID, { opCode: 1, payload: 'early' });
+  ws.webSocketOpened(SERIAL, 'ws://example.test/', '', '', HTTP_CHANNEL_ID);
+  const received = events.filter(e => e.name === FrameTree.Events.WebSocketFrameReceived);
+  assert.equal(received.length, 1);
+  assert.equal(received[0].payload.data, 'early');
+});
+
+test('a clean close reports no error', () => {
+  const { events, ws } = listener();
+  open(ws);
+  ws.webSocketClosed(SERIAL, HTTP_CHANNEL_ID, true, 1000, 'bye');
+  const closed = events.find(e => e.name === FrameTree.Events.WebSocketClosed);
+  assert.equal(closed.payload.error, '');
+});
+
+test('an unclean close names its code', () => {
+  const { events, ws } = listener();
+  open(ws);
+  ws.webSocketClosed(SERIAL, HTTP_CHANNEL_ID, false, 1006, '');
+  const closed = events.find(e => e.name === FrameTree.Events.WebSocketClosed);
+  assert.equal(closed.payload.error, 'CLOSE_ABNORMAL');
+});
