+    Services.obs.addObserver({
+      observe: (subject, topic, data) => {
+        const browser = subject.ownerElement;
+        if (!browser) {
+          return;
+        }
+        const target = this._browserToTarget.get(browser);
+        if (!target) {
+          return;
+        }
+        target.emit(PageTarget.Events.Crashed);
+        target.dispose();
+      }
