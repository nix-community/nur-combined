+  // probe canvases, favicon-size sprites o WebGL pixel-readback di 1x1.
+  // Fingerprinters seri (FP Pro, CreepJS) usano canvas ≥ 280x60 per geometry.
+  if (aSize < 64u * 64u * 4u) return;
