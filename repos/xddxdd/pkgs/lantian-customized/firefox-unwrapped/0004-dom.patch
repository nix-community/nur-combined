+/* Async timer callback for the synthetic stealth candidate. Defers the
+ * call to nr_ice_gather_finished_cb until the event loop has had a chance
+ * to register ctx->trickle_cb (which happens after pc.setLocalDescription
+ * runs on the JS side). Without this defer, the trickle_cb is NULL when
+ * we fire and the candidate is silently dropped before reaching JS. */
+static void nr_ice_stealth_fire_ready(NR_SOCKET s, int how, void *cb_arg)
+  {
+    nr_ice_candidate *cand = cb_arg;
+    cand->ready_cb_timer = 0;
+    nr_ice_gather_finished_cb(0, 0, cand);
+  }
