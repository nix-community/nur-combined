+    // Per-pixel hash
+    uint32_t x = h0 ^ (uint32_t(i) * 2654435761u);
+    x ^= x >> 16; x *= 0x85ebca6bu; x ^= x >> 13;
+    x *= 0xc2b2ae35u; x ^= x >> 16;
