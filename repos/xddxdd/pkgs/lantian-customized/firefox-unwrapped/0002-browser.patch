diff --git a/browser/app/winlauncher/LauncherProcessWin.cpp b/browser/app/winlauncher/LauncherProcessWin.cpp
index 8337336dc8..326687d63e 100644
--- a/browser/app/winlauncher/LauncherProcessWin.cpp
+++ b/browser/app/winlauncher/LauncherProcessWin.cpp
@@ -19,6 +19,7 @@
 #include "nsWindowsHelpers.h"
 
 #include <windows.h>
+#include <io.h>
 #include <processthreadsapi.h>
 #include <shlwapi.h>
 
@@ -493,6 +494,21 @@ Maybe<int> LauncherMain(int& argc, wchar_t* argv[]) {
 
   attrs.AddInheritableHandles(stdHandles);
 
+  // Playwright juggler-pipe: the parent process (e.g., Playwright/node)
+  // inherits FDs 3 and 4 to us via the Node.js stdio array. Forward those
+  // pipe handles to the browser child process so the juggler pipe code in
+  // xul.dll can read/write them. FF146 patch ported for FF150.
+  bool hasJugglerPipe =
+      mozilla::CheckArg(argc, argv, "juggler-pipe", nullptr,
+                        mozilla::CheckArgFlag::None) == mozilla::ARG_FOUND;
+  if (hasJugglerPipe) {
+    intptr_t stdio3 = _get_osfhandle(3);
+    intptr_t stdio4 = _get_osfhandle(4);
+    HANDLE pipeHandles[] = {reinterpret_cast<HANDLE>(stdio3),
+                            reinterpret_cast<HANDLE>(stdio4)};
+    attrs.AddInheritableHandles(pipeHandles);
+  }
+
   DWORD creationFlags = CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT;
 
   STARTUPINFOEXW siex;
diff --git a/browser/fonts/moz.build b/browser/fonts/moz.build
--- a/browser/fonts/moz.build
+++ b/browser/fonts/moz.build
@@ -2,6 +2,21 @@
 # License, v. 2.0. If a copy of the MPL was not distributed with this
 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("windows", "gtk"):
+# Stealthfox: ship the Windows core font set so MOZ_BUNDLED_FONTS makes the
+# whitelisted families render with genuine glyphs on every host (incl. Linux /
+# macOS that lack them). The font-list ctor sets font.system.whitelist; without
+# the bundled files a non-Windows host can't render the families. macOS also
+# needs --enable-bundled-fonts in its mozconfig.
+#
+# The actual font filenames are injected by the Nix derivation's postPatch:
+# placeholder @@STEALTHFONTS@@ is replaced with the quoted, case-insensitively
+# sorted list of *.ttf/*.ttc present in this directory (sourced from the
+# windows-fonts package, plus TwemojiMozilla.ttf from this source tree) and
+# "bundle-fonts.list" (generated from those same files by
+# gen_bundle_font_manifest.py at build time). mozbuild requires the
+# FINAL_TARGET_FILES list to be sorted, so the derivation supplies it sorted.
+if CONFIG["MOZ_WIDGET_TOOLKIT"] in ("windows", "gtk", "cocoa"):
     DIST_SUBDIR = ""
-    FINAL_TARGET_FILES.fonts += ["TwemojiMozilla.ttf"]
+    FINAL_TARGET_FILES.fonts += [
+        "@@STEALTHFONTS@@",
+    ]
