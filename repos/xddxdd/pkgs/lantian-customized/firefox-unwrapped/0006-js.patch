+#define HybridXrayDOM xpc::HybridXrayWrapper<xpc::DOMXrayTraits>
+#define HybridXrayJS xpc::HybridXrayWrapper<xpc::JSXrayTraits>
+
+extern template class HybridXrayDOM;
+extern template class HybridXrayJS;
