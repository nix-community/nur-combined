diff --git a/uriloader/exthandler/StealthDownloadIntercept.cpp b/uriloader/exthandler/StealthDownloadIntercept.cpp
new file mode 100644
index 00000000..2077bc34
--- /dev/null
+++ b/uriloader/exthandler/StealthDownloadIntercept.cpp
@@ -0,0 +1,123 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "StealthDownloadIntercept.h"
+
+#include "mozilla/ErrorNames.h"
+#include "nsComponentManagerUtils.h"
+#include "nsExternalHelperAppService.h"
+#include "nsIBackgroundFileSaver.h"
+#include "nsIChannel.h"
+#include "nsIFile.h"
+#include "nsIHttpChannelInternal.h"
+#include "nsILoadInfo.h"
+#include "nsIURI.h"
+#include "nsNetCID.h"
+
+// Same saver setup as nsExternalAppHandler::SetUpTempFile, but the target is
+// the file the interceptor chose and it is final: no ".part", no rename.
+// static
+nsresult StealthDownloadIntercept::CreateSaver(
+    nsExternalAppHandler* aHandler) {
+  MOZ_ASSERT(!aHandler->mSaver, "Output file initialization called twice!");
+  nsresult rv;
+  aHandler->mSaver =
+      do_CreateInstance(NS_BACKGROUNDFILESAVERSTREAMLISTENER_CONTRACTID, &rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = aHandler->mSaver->SetObserver(aHandler);
+  if (NS_FAILED(rv)) {
+    aHandler->mSaver = nullptr;
+    return rv;
+  }
+
+  rv = aHandler->mSaver->EnableSha256();
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  rv = aHandler->mSaver->EnableSignatureInfo();
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  return aHandler->mSaver->SetTarget(aHandler->mTempFile, false);
+}
+
+// static
+bool StealthDownloadIntercept::Start(nsExternalAppHandler* aHandler,
+                                     nsIRequest* aRequest) {
+  MOZ_ASSERT(NS_IsMainThread());
+  nsCOMPtr<nsIDownloadInterceptor> interceptor =
+      aHandler->mExtProtSvc->mInterceptor;
+  if (!interceptor) {
+    return false;
+  }
+
+  nsCOMPtr<nsIFile> file;
+  bool intercepted = false;
+  nsresult rv = interceptor->InterceptDownloadRequest(
+      aHandler, aRequest, aHandler->mBrowsingContext, getter_AddRefs(file),
+      &intercepted);
+  // A throwing interceptor must not break downloads: act as if it declined.
+  if (NS_FAILED(rv) || !intercepted) {
+    return false;
+  }
+
+  // From here the interceptor expects one onDownloadComplete.
+  aHandler->mStealthIntercepted = true;
+
+  // Intercepted without a file: the client does not want the data.
+  if (!file) {
+    aHandler->Cancel(NS_BINDING_ABORTED);
+    return true;
+  }
+
+  // The file is the final destination, and no nsITransfer is created, which
+  // keeps the downloads UI and its JS components out of this download.
+  aHandler->mTempFile = file;
+  rv = file->GetLeafName(aHandler->mTempLeafName);
+  if (NS_SUCCEEDED(rv)) {
+    rv = CreateSaver(aHandler);
+  }
+  if (NS_FAILED(rv)) {
+    aRequest->Cancel(rv);
+    aHandler->Cancel(rv);
+    return true;
+  }
+
+  // Same channel preparation OnStartRequest does after SetUpTempFile.
+  nsCOMPtr<nsIChannel> channel = do_QueryInterface(aRequest);
+  nsCOMPtr<nsIHttpChannelInternal> httpInternal = do_QueryInterface(channel);
+  if (httpInternal) {
+    (void)httpInternal->SetChannelIsForDownload(true);
+  }
+  if (channel && aHandler->mSourceUrl &&
+      aHandler->mSourceUrl->SchemeIs("data")) {
+    nsCOMPtr<nsILoadInfo> loadInfo = channel->LoadInfo();
+    loadInfo->SetForceAllowDataURI(true);
+  }
+  return true;
+}
+
+// static
+void StealthDownloadIntercept::Complete(nsExternalAppHandler* aHandler,
+                                        nsresult aStatus) {
+  // The interceptor may drop its last reference to the handler.
+  RefPtr<nsExternalAppHandler> kungFuDeathGrip(aHandler);
+
+  // Cleared first: Cancel and OnSaveComplete both end here, only one reports.
+  if (!aHandler->mStealthIntercepted) {
+    return;
+  }
+  aHandler->mStealthIntercepted = false;
+
+  nsCOMPtr<nsIDownloadInterceptor> interceptor =
+      aHandler->mExtProtSvc->mInterceptor;
+  if (!interceptor) {
+    return;
+  }
+
+  nsAutoCString errorName;
+  if (NS_FAILED(aStatus)) {
+    mozilla::GetErrorName(aStatus, errorName);
+  }
+  (void)interceptor->OnDownloadComplete(aHandler, errorName);
+}
diff --git a/uriloader/exthandler/StealthDownloadIntercept.h b/uriloader/exthandler/StealthDownloadIntercept.h
new file mode 100644
index 00000000..60d6bfd5
--- /dev/null
+++ b/uriloader/exthandler/StealthDownloadIntercept.h
@@ -0,0 +1,44 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef StealthDownloadIntercept_h_
+#define StealthDownloadIntercept_h_
+
+#include "nscore.h"
+
+class nsExternalAppHandler;
+class nsIRequest;
+
+/**
+ * Stealthfox (automation/downloads): lets our automation's download
+ * interceptor (nsIDownloadInterceptor, installed with
+ * nsIExternalHelperAppService.setDownloadInterceptor) take over a download.
+ * Parent process, main thread only. Friend of nsExternalAppHandler, which
+ * only calls Start and Complete.
+ */
+class StealthDownloadIntercept final {
+ public:
+  /**
+   * Called from nsExternalAppHandler::OnStartRequest, where it would set up
+   * its own temp file. Asks the interceptor about this download. Returns true
+   * when the interceptor took it: the data goes to the file it chose (or the
+   * download is canceled when it chose none) and the caller must return
+   * NS_OK, skipping the transfer, the dialogs and the downloads UI. Returns
+   * false (nothing changed) when there is no interceptor, it declined or it
+   * failed, and the caller carries on exactly as stock Firefox.
+   */
+  static bool Start(nsExternalAppHandler* aHandler, nsIRequest* aRequest);
+
+  /**
+   * Called when the handler's download ended (saved, canceled or failed).
+   * Tells the interceptor once per intercepted download, with the error name
+   * (empty on success). Does nothing for downloads that were not intercepted.
+   */
+  static void Complete(nsExternalAppHandler* aHandler, nsresult aStatus);
+
+ private:
+  static nsresult CreateSaver(nsExternalAppHandler* aHandler);
+};
+
+#endif  // StealthDownloadIntercept_h_
diff --git a/uriloader/exthandler/StealthDownloadInterceptor.idl b/uriloader/exthandler/StealthDownloadInterceptor.idl
new file mode 100644
index 00000000..ef67b2fa
--- /dev/null
+++ b/uriloader/exthandler/StealthDownloadInterceptor.idl
@@ -0,0 +1,33 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "nsISupports.idl"
+
+// Types named by nsIDownloadInterceptor. nsIHelperAppLauncher is defined in
+// nsIExternalHelperAppService.idl, which includes this file, so it can only
+// be forward-declared here.
+interface nsIFile;
+interface nsIHelperAppLauncher;
+interface nsIRequest;
+webidl BrowsingContext;
+
+/**
+ * Stealthfox: Interceptor interface used by Juggler to redirect downloads
+ * into a developer-controlled location (Playwright's downloadOptions).
+ * Restored from FF146 stealth patch series — not present in vanilla FF150.
+ *
+ * Stealthfox: nsIExternalHelperAppService.setDownloadInterceptor() installs a
+ * Juggler-side download interceptor that takes over download routing (returns
+ * a target file from Playwright's downloadOptions). Called from
+ * juggler/TargetRegistry.js at constructor time. The setter is declared in
+ * nsIExternalHelperAppService.idl because an XPIDL method can only be declared
+ * inside its own interface block.
+ */
+[scriptable, uuid(9a20e9b0-75d0-11ea-bc55-0242ac130003)]
+interface nsIDownloadInterceptor : nsISupports
+{
+  boolean interceptDownloadRequest(in nsIHelperAppLauncher aHandler, in nsIRequest aRequest, in BrowsingContext aBrowsingContext, out nsIFile file);
+
+  void onDownloadComplete(in nsIHelperAppLauncher aHandler, in ACString aErrorName);
+};
