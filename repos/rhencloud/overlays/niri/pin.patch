+    /// Check pinned floating tiles in this workspace at the given position.
+    pub(super) fn pinned_window_under(&self, pos: Point<f64, Logical>) -> Option<(&W, HitType)> {
+        for (tile, tile_pos) in self.floating.tiles_with_render_positions() {
+            if tile.window().rules().pin == Some(true) {
+                if let Some(rv) = HitType::hit_tile(tile, tile_pos, pos) {
+                    return Some(rv);
+                }
+            }
+        }
+        None
+    }
+
+    /// Iterate pinned floating tiles with their render positions.
+    pub(super) fn pinned_tiles_with_render_positions(
+        &self,
+    ) -> impl Iterator<Item = (&Tile<W>, Point<f64, Logical>)> {
+        self.floating
+            .tiles_with_render_positions()
+            .filter(|(tile, _)| tile.window().rules().pin == Some(true))
+    }
