--- a/Samples/VirtualCamera/VirtualCameraMediaSource/SimpleFrameGenerator.cpp
+++ b/Samples/VirtualCamera/VirtualCameraMediaSource/SimpleFrameGenerator.cpp
@@ -77,2 +77,45 @@
-    LONGLONG curSysTimeInS = MFGetSystemTime() / (MFTIME)10000000;
-    int offset = curSysTimeInS % height;
+    struct SharedFrame
+    {
+        uint32_t magic;
+        uint32_t version;
+        uint32_t width;
+        uint32_t height;
+        uint32_t stride;
+        uint32_t byteCount;
+        uint32_t timestampMs;
+        volatile LONG generation;
+        BYTE pixels[1280 * 720 * 4];
+    };
+    static HANDLE mapping = nullptr;
+    static HANDLE mutex = nullptr;
+    static SharedFrame* frame = nullptr;
+    if (!mapping)
+    {
+        mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, L"Global\\MoonlightOSCameraFrame-v1");
+        if (mapping)
+        {
+            frame = static_cast<SharedFrame*>(MapViewOfFile(
+                mapping, FILE_MAP_READ, 0, 0, sizeof(SharedFrame)));
+        }
+        mutex = OpenMutexW(SYNCHRONIZE, FALSE, L"Global\\MoonlightOSCameraFrameMutex-v1");
+    }
+
+    if (!frame || !mutex || width != 1280 || height != 720)
+    {
+        ZeroMemory(pBuf, abs(pitch) * height);
+        return S_OK;
+    }
+
+    DWORD wait = WaitForSingleObject(mutex, 100);
+    if (wait != WAIT_OBJECT_0 && wait != WAIT_ABANDONED)
+    {
+        return S_OK;
+    }
+    if (frame->magic != 0x4D4C5643u || frame->version != 1 ||
+        frame->width != width || frame->height != height ||
+        frame->stride != width * 4 || frame->byteCount != width * height * 4)
+    {
+        ReleaseMutex(mutex);
+        ZeroMemory(pBuf, abs(pitch) * height);
+        return S_OK;
+    }
@@ -80,10 +123,5 @@
     for (unsigned int r = 0; r < height; r++)
     {
-        uint32_t* p = (uint32_t*)(pBuf + (r * pitch));
-        for (unsigned int c = 0; c < width; c++)
-        {
-            BYTE gray = (BYTE)(r + offset);
-            *p = ((uint32_t)gray << 16 | (uint32_t)gray << 8 | (uint32_t)gray) & rgbMask;
-            p++;
-        }
+        CopyMemory(pBuf + (r * pitch), frame->pixels + (r * frame->stride), width * 4);
     }
+    ReleaseMutex(mutex);
