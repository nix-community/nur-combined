#!/bin/sh

# Load uhid (DS5 emulation)
echo "Loading uhid kernel module for DS5 emulation."
modprobe uhid

echo "Loading vhci-hcd kernel module for USB passthrough."
modprobe vhci-hcd 2>/dev/null || modprobe vhci_hcd 2>/dev/null || \
  echo "warning: vhci-hcd is unavailable; USB passthrough will remain disabled."

# Preserve the prototype for rollback, but stop it from owning the old TCP
# port or racing the session-owned Helios backend.
for legacy_unit in mlos-host-utils.service moonlight-os-host-utils.service; do
  if systemctl list-unit-files "$legacy_unit" >/dev/null 2>&1; then
    systemctl disable --now "$legacy_unit" >/dev/null 2>&1 || true
    echo "Disabled legacy $legacy_unit; its files remain available for rollback."
  fi
done

if systemctl list-unit-files helios-usb-helper.service >/dev/null 2>&1; then
  systemctl daemon-reload
  systemctl enable helios-usb-helper.service >/dev/null 2>&1 || true
  systemctl restart helios-usb-helper.service || \
    echo "warning: helios-usb-helper.service could not be started."
fi

# Check if we're in an rpm-ostree environment
if [ ! -x "$(command -v rpm-ostree)" ]; then
  echo "Not in an rpm-ostree environment, proceeding with post install steps."

  # Ensure Helios can grab images from KMS
  path_to_setcap=$(which setcap)
  path_to_sunshine=$(readlink -f "$(which helios)")
  if [ -x "$path_to_setcap" ] ; then
    echo "Setting CAP_SYS_ADMIN capability on Helios binary."
    echo "$path_to_setcap cap_sys_admin+p $path_to_sunshine"
    $path_to_setcap cap_sys_admin+p $path_to_sunshine
    echo "CAP_SYS_ADMIN capability set on Helios binary."
  else
    echo "error: setcap not found or not executable."
  fi

  # Trigger udev rule reload for /dev/uinput and /dev/uhid
  path_to_udevadm=$(which udevadm)
  if [ -x "$path_to_udevadm" ] ; then
    echo "Reloading udev rules."
    $path_to_udevadm control --reload-rules
    $path_to_udevadm trigger --property-match=DEVNAME=/dev/uinput
    $path_to_udevadm trigger --property-match=DEVNAME=/dev/uhid
    echo "Udev rules reloaded successfully."
  else
    echo "error: udevadm not found or not executable."
  fi
else
  echo "rpm-ostree environment detected, skipping post install steps. Restart to apply the changes."
fi
