# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.10.0.schema.json
# Created with Helios's release tooling. Do not edit generated manifests.
PackageIdentifier: MoonlightOS.Helios
PackageVersion: @VERSION@
InstallerType: nullsoft
Scope: machine
InstallModes:
  - silent
  - silentWithProgress
InstallerSwitches:
  Silent: /S
  SilentWithProgress: /S
UpgradeBehavior: install
ReleaseDate: '@RELEASE_DATE@'
Installers:
  - Architecture: x64
    InstallerUrl: https://github.com/moonlight-os/helios/releases/download/v@VERSION@/Helios.exe
    InstallerSha256: '@INSTALLER_SHA256@'
    AppsAndFeaturesEntries:
      - DisplayName: Helios
        Publisher: Moonlight OS
        DisplayVersion: @VERSION@
ManifestType: installer
ManifestVersion: 1.10.0
