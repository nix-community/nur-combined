# Copy to .sops.yaml and replace recipients with REAL PUBLIC age keys.
# Include the desktop's sops-nix recipient, not just your personal editor key.
# Never store private age keys or token values here.
keys:
  - &admin age1REPLACE_WITH_YOUR_PUBLIC_AGE_RECIPIENT
  - &desktop age1REPLACE_WITH_DESKTOP_PUBLIC_AGE_RECIPIENT
creation_rules:
  - path_regex: ^secrets/cachix\.yaml$
    key_groups:
      - age:
          - *admin
          - *desktop
