# Auto-generated from template by modot
# Hosts from modot.cue (modot.hosts).
# No keepalives: a Tailscale path change freezes TCP instead of herdr --remote
# dying after ServerAliveInterval 15 * CountMax 4.

{{- range $name, $host := .root.hosts }}
{{- if $host.ips }}
Host {{ $name }}
  HostName {{ index $host.ips 0 }}
  {{- if $host.port }}
  Port {{ $host.port }}
  {{- end }}
  {{- if $host.user }}
  User {{ $host.user }}
  {{- end }}
  ServerAliveInterval 0
  TCPKeepAlive no

{{- end }}
{{- end }}
