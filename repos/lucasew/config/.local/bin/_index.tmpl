{{- /* Script x: adds lazy shims to PATH */ -}}
{{- file "x" "0755" }}
#!/usr/bin/env bash
exec "{{ home }}/.local/bin/workspaced" open exec -p "{{ userDataDir }}/shim/lazy" "$@"
{{- endfile }}

{{- /* Global shims for tools */ -}}
{{- range $name, $tool := .root.lazy_tools }}
    {{- if $tool.global }}
        {{- $ref := $tool.ref }}{{ if not $ref }}{{ $ref = $name }}{{ end }}
        {{- $bins := $tool.bins }}
        {{- if eq (len $bins) 0 }}
            {{- $binName := $tool.alias }}
            {{- if not $binName }}
                {{- $parts := split $ref ":" }}
                {{- $binName = last $parts }}
                {{- $parts = split $binName "/" }}
                {{- $binName = last $parts }}
            {{- end }}
            {{- $bins = list $binName }}
        {{- end }}
        {{- range $bins }}
            {{- file . "0755" }}
#!/usr/bin/env bash
{{- $locked := lockTool $name }}
{{- if $locked }}
# locked: {{ $locked.ref }}@{{ $locked.version }}
{{- end }}
exec "{{ home }}/.local/bin/workspaced" open lazy --home --bin "{{ . }}" "{{ $ref }}" -- "$@"
            {{- endfile }}
        {{- end }}
    {{- end }}
{{- end }}

{{- /* agent-browser: bunx CLI + the borderless webapp Chromium (browser.webapp). */ -}}
{{- if not isPhone }}
{{- $webappBin := .root.browser.webapp }}
{{- $webappRef := "" }}
{{- range $name, $tool := .root.lazy_tools }}
	{{- range $tool.bins }}
		{{- if eq . $webappBin }}
			{{- $webappRef = $tool.ref }}
			{{- if not $webappRef }}{{ $webappRef = $name }}{{ end }}
		{{- end }}
	{{- end }}
{{- end }}
{{- file "agent-browser" "0755" }}
#!/usr/bin/env bash
set -euo pipefail

_ws="{{ home }}/.local/bin/workspaced"
if [[ -z "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]]; then
	export AGENT_BROWSER_EXECUTABLE_PATH="$("$_ws" tool which "{{ $webappRef }}" "{{ $webappBin }}")"
fi

_bun="$("$_ws" tool which "{{ $.root.lazy_tools.bun.ref }}" bun)"

# bun x prefers a same-named PATH binary; drop this shim so we get the npm package.
_self="$(readlink -f "$0")"
_path=""
IFS=: read -ra _parts <<< "${PATH}"
for _p in "${_parts[@]}"; do
	if [[ -x "${_p}/agent-browser" ]] && [[ "$(readlink -f "${_p}/agent-browser")" == "${_self}" ]]; then
		continue
	fi
	_path="${_path:+${_path}:}${_p}"
done
export PATH="${_path}"

exec "${_bun}" x agent-browser "$@"
{{- endfile }}
{{- end }}
