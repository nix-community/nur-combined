# shellcheck shell=bash
# Apply terminal colors (generated from palette)
function apply_colors {
	if [[ $- != *i* ]]; then
		return
	fi

	if [[ -n "${ITERM_SESSION_ID:-}" ]]; then
		# iTerm2 proprietary ]PnRRGGBB — writes profile wells, not just OSC 4/10/11/12
		_iterm_p() {
			if [[ -n "${TMUX:-}" ]]; then
				printf '\033Ptmux;\033\033]P%s%s\033\033\\\033\\' "$1" "$2"
			else
				printf '\033]P%s%s\033\\' "$1" "$2"
			fi
		}
		_iterm_p 0 '{{ .module.palette.base00 }}'
		_iterm_p 1 '{{ .module.palette.base08 }}'
		_iterm_p 2 '{{ .module.palette.base0B }}'
		_iterm_p 3 '{{ .module.palette.base0A }}'
		_iterm_p 4 '{{ .module.palette.base0D }}'
		_iterm_p 5 '{{ .module.palette.base0E }}'
		_iterm_p 6 '{{ .module.palette.base0C }}'
		_iterm_p 7 '{{ .module.palette.base05 }}'
		_iterm_p 8 '{{ .module.palette.base03 }}'
		_iterm_p 9 '{{ .module.palette.base08 }}'
		_iterm_p a '{{ .module.palette.base0B }}'
		_iterm_p b '{{ .module.palette.base0A }}'
		_iterm_p c '{{ .module.palette.base0D }}'
		_iterm_p d '{{ .module.palette.base0E }}'
		_iterm_p e '{{ .module.palette.base0C }}'
		_iterm_p f '{{ .module.palette.base07 }}'
		_iterm_p g '{{ .module.palette.base05 }}' # foreground
		_iterm_p h '{{ .module.palette.base00 }}' # background
		_iterm_p i '{{ .module.palette.base05 }}' # bold
		_iterm_p j '{{ .module.palette.base02 }}' # selection
		_iterm_p k '{{ .module.palette.base05 }}' # selected text
		_iterm_p l '{{ .module.palette.base05 }}' # cursor
		_iterm_p m '{{ .module.palette.base00 }}' # cursor text
		unset -f _iterm_p
		return
	fi

	printf '\033]4;0;{{ .module.palette.base00 }}\033\\'
	printf '\033]4;1;{{ .module.palette.base08 }}\033\\'
	printf '\033]4;2;{{ .module.palette.base0B }}\033\\'
	printf '\033]4;3;{{ .module.palette.base0A }}\033\\'
	printf '\033]4;4;{{ .module.palette.base0D }}\033\\'
	printf '\033]4;5;{{ .module.palette.base0E }}\033\\'
	printf '\033]4;6;{{ .module.palette.base0C }}\033\\'
	printf '\033]4;7;{{ .module.palette.base05 }}\033\\'
	printf '\033]4;8;{{ .module.palette.base03 }}\033\\'
	printf '\033]4;9;{{ .module.palette.base08 }}\033\\'
	printf '\033]4;10;{{ .module.palette.base0B }}\033\\'
	printf '\033]4;11;{{ .module.palette.base0A }}\033\\'
	printf '\033]4;12;{{ .module.palette.base0D }}\033\\'
	printf '\033]4;13;{{ .module.palette.base0E }}\033\\'
	printf '\033]4;14;{{ .module.palette.base0C }}\033\\'
	printf '\033]4;15;{{ .module.palette.base07 }}\033\\'
	printf '\033]10;{{ .module.palette.base05 }}\033\\'  # foreground
	printf '\033]11;{{ .module.palette.base00 }}\033\\'  # background
	printf '\033]12;{{ .module.palette.base05 }}\033\\'  # cursor
}

# Apply colors on shell startup
apply_colors
