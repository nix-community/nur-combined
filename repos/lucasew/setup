#!/usr/bin/env bash
set -euo pipefail

cd "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Keep the installer outside DOWNLOAD_DIR. modot's setup treats every
# executable in that directory as the release binary and would re-exec itself.
installer=$(mktemp)
trap 'rm -f "$installer"' EXIT
curl -fsSL https://raw.githubusercontent.com/lewtec/modot/master/setup -o "$installer"
# No args: self-install -f. With args: self-install, then pass them to modot.
bash "$installer" "$@"


