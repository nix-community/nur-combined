#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# ///
"""Reorder Herdr workspaces.

Perceive the session, then converge: nest linked worktrees under an open
main, park feature branches off the main checkout into a grok worktree,
rename worktree workspaces to their branch, order PIN first then mains
with nested worktrees, non-git last.

Herdr freezes workspace identity_cwd from the first tab at create time.
Later tabs do not change it. Perception uses that identity (session.json,
else the first tab's pane cwd), not an arbitrary pane from pane list.
"""

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from functools import cache
from pathlib import Path

PIN = Path(__file__).resolve().parent
LAYOUT_ROOTS = (
    Path.home() / ".grok" / "worktrees",
    Path.home() / ".herdr" / "worktrees",
)
GROK_WORKTREES = LAYOUT_ROOTS[0]
DEFAULT_BRANCHES = frozenset({"main", "master"})
HERDR_SESSION = Path.home() / ".config" / "herdr" / "session.json"


def paint(code: str | None, text: str) -> str:
    if not code or os.environ.get("NO_COLOR"):
        return text
    if not sys.stdout.isatty() and not os.environ.get("FORCE_COLOR"):
        return text
    return f"\033[{code}m{text}\033[0m"


def herdr(*args: str) -> dict:
    proc = subprocess.run(["herdr", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout)
        raise SystemExit(proc.returncode)
    return json.loads(proc.stdout)


def herdr_try(*args: str) -> dict | None:
    proc = subprocess.run(["herdr", *args], capture_output=True, text=True)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).strip()
        print(paint("33", f"  herdr {' '.join(args)}: {err}"))
        return None
    return json.loads(proc.stdout)


def herdr_rpc(method: str, params: dict) -> dict:
    status = herdr("status", "--json")
    sock_path = status.get("server", {}).get("socket")
    if not sock_path:
        raise SystemExit("herdr server is not running")
    req = {"id": "reorder_herdr_workspaces", "method": method, "params": params}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.connect(sock_path)
        sock.sendall((json.dumps(req) + "\n").encode())
        buf = bytearray()
        while True:
            chunk = sock.recv(1 << 16)
            if not chunk:
                break
            buf.extend(chunk)
            if b"\n" in buf:
                break
    if not buf:
        raise SystemExit(f"empty reply from herdr {method}")
    resp = json.loads(buf)
    err = resp.get("error")
    if err:
        raise SystemExit(f"herdr {method}: {err.get('code')}: {err.get('message')}")
    return resp.get("result") or {}


@cache
def git_info(path: Path) -> tuple[Path, Path, bool] | None:
    proc = subprocess.run(
        [
            "git",
            "-C",
            str(path),
            "rev-parse",
            "--path-format=absolute",
            "--show-toplevel",
            "--git-common-dir",
        ],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        return None
    lines = proc.stdout.splitlines()
    toplevel = Path(lines[0]).resolve()
    common = Path(lines[1]).resolve()
    repo_root = common.parent if common.name == ".git" else common
    return toplevel, repo_root, toplevel != repo_root


def git_run(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo), *args], capture_output=True, text=True
    )


@cache
def git_branch(path: Path) -> str | None:
    proc = git_run(path, "rev-parse", "--abbrev-ref", "HEAD")
    if proc.returncode != 0:
        return None
    name = proc.stdout.strip()
    if not name or name == "HEAD":
        return None
    return name


def git_cache_clear() -> None:
    git_info.cache_clear()
    git_branch.cache_clear()


def git_dirty(repo: Path) -> bool:
    return bool(git_run(repo, "status", "--porcelain").stdout.strip())


def default_branch(repo: Path) -> str | None:
    proc = git_run(repo, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD")
    if proc.returncode == 0:
        name = proc.stdout.strip().rsplit("/", 1)[-1]
        if name in DEFAULT_BRANCHES:
            return name
    for name in ("master", "main"):
        ref = f"refs/heads/{name}"
        if git_run(repo, "show-ref", "--verify", "--quiet", ref).returncode == 0:
            return name
    return None


def list_worktrees(repo: Path) -> list[tuple[Path, str | None]]:
    rows: list[tuple[Path, str | None]] = []
    path: Path | None = None
    branch: str | None = None

    def flush() -> None:
        nonlocal path, branch
        if path is not None:
            rows.append((path, branch))
        path = None
        branch = None

    proc = git_run(repo, "worktree", "list", "--porcelain")
    for line in proc.stdout.splitlines():
        if not line:
            flush()
        elif line.startswith("worktree "):
            flush()
            path = Path(line[9:]).resolve()
        elif line.startswith("branch "):
            ref = line[7:]
            prefix = "refs/heads/"
            branch = ref[len(prefix) :] if ref.startswith(prefix) else ref
        elif line == "detached":
            branch = None
    flush()
    return rows


def origin_slug(repo: Path) -> str | None:
    proc = git_run(repo, "remote", "get-url", "origin")
    if proc.returncode != 0:
        return None
    url = proc.stdout.strip()
    if url.endswith(".git"):
        url = url[:-4]
    if "://" in url:
        parts = url.split("://", 1)[1].split("/")
        if len(parts) < 3:
            return None
        owner, name = parts[-2], parts[-1]
    elif ":" in url:
        owner, _, name = url.split(":", 1)[1].lstrip("/").partition("/")
    else:
        return None
    if not owner or not name:
        return None
    return f"{owner}-{name}".lower()


def grok_slug(repo: Path) -> str:
    counts: dict[str, int] = {}
    root = GROK_WORKTREES.resolve()
    for path, _branch in list_worktrees(repo):
        try:
            rel = path.relative_to(root)
        except ValueError:
            continue
        if rel.parts:
            slug = rel.parts[0]
            counts[slug] = counts.get(slug, 0) + 1
    if counts:
        return max(counts, key=lambda slug: counts[slug])
    return origin_slug(repo) or repo.name.lower()


def linked_worktree_for(repo: Path, branch: str) -> Path | None:
    root = repo.resolve()
    for path, name in list_worktrees(repo):
        if name == branch and path != root:
            return path
    return None


def grok_worktree_path(repo: Path, branch: str) -> Path:
    return GROK_WORKTREES / grok_slug(repo) / branch.replace("/", "-")


def layout_slug(path: Path) -> str | None:
    resolved = path.resolve()
    for root in LAYOUT_ROOTS:
        try:
            rel = resolved.relative_to(root.resolve())
        except ValueError:
            continue
        if len(rel.parts) >= 2:
            return rel.parts[0]
    return None


def match_slug(slug: str, known: list[tuple[str, Path]]) -> Path | None:
    slug_l = slug.lower()
    hits = [
        (name, root)
        for name, root in known
        if slug_l == name or slug_l.endswith("-" + name)
    ]
    if not hits:
        return None
    return max(hits, key=lambda item: len(item[0]))[1]


def infer_repo_root(checkout: Path) -> Path | None:
    parent = checkout.parent
    if not parent.is_dir():
        return None
    for sibling in sorted(parent.iterdir()):
        if sibling == checkout or not sibling.is_dir():
            continue
        info = git_info(sibling)
        if info is not None:
            return info[1]
    return None


def ensure_branch(repo: Path, name: str) -> bool:
    heads = f"refs/heads/{name}"
    remotes = f"refs/remotes/origin/{name}"
    if git_run(repo, "show-ref", "--verify", "--quiet", heads).returncode == 0:
        return True
    if git_run(repo, "show-ref", "--verify", "--quiet", remotes).returncode != 0:
        return False
    print(paint("36", f"+ git -C {repo} branch --track {name} origin/{name}"))
    proc = git_run(repo, "branch", "--track", name, f"origin/{name}")
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        return False
    return True


def relink_worktree(checkout: Path, repo_root: Path) -> bool:
    if git_info(checkout):
        return True
    name = checkout.name
    if not ensure_branch(repo_root, name):
        print(paint("33", f"  no branch {name} in {repo_root}"))
        return False
    gitdir = repo_root / ".git"
    if not gitdir.is_dir():
        print(paint("33", f"  {repo_root} has no .git directory"))
        return False
    admin = gitdir / "worktrees" / name
    print(paint("36", f"+ relink {checkout} -> {admin}"))
    admin.mkdir(parents=True, exist_ok=True)
    (admin / "commondir").write_text("../..\n")
    (admin / "gitdir").write_text(f"{checkout / '.git'}\n")
    (admin / "HEAD").write_text(f"ref: refs/heads/{name}\n")
    (checkout / ".git").write_text(f"gitdir: {admin}\n")
    git_run(repo_root, "worktree", "repair", str(checkout))
    git_cache_clear()
    if git_info(checkout) is None:
        print(paint("33", "  relink failed"))
        return False
    print(paint("32", "  git worktree restored"))
    return True


def worktree_open(
    path: Path,
    label: str,
    *,
    workspace: str | None = None,
) -> dict | None:
    # --cwd XOR --workspace. --cwd is the first tab (identity_cwd) when
    # opening a new space; --workspace nests under an existing main.
    args = ["worktree", "open", "--path", str(path), "--label", label, "--no-focus"]
    shown = ["+ herdr worktree open"]
    if workspace:
        args.extend(["--workspace", workspace])
        shown.append(f"--workspace {workspace}")
    else:
        args.extend(["--cwd", str(path)])
        shown.append(f"--cwd {path}")
    shown.append(f"--path {path} --label {label} --no-focus")
    print(paint("36", " ".join(shown)))
    data = herdr_try(*args)
    return None if data is None else data.get("result")


def session_identity_cwds() -> dict[str, Path]:
    try:
        data = json.loads(HERDR_SESSION.read_text())
    except OSError:
        return {}
    out: dict[str, Path] = {}
    for ws in data.get("workspaces") or []:
        wid = ws.get("id")
        cwd = ws.get("identity_cwd")
        if wid and cwd:
            out[wid] = Path(cwd).resolve()
    return out


def print_table(
    rows: list[tuple[str, ...]], paints: list[tuple[str | None, ...]]
) -> None:
    if not rows:
        return
    widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]))]
    for row, codes in zip(rows, paints):
        cells = [paint(codes[0], row[0].rjust(widths[0]))]
        cells.extend(
            paint(code, cell.ljust(width))
            for cell, width, code in zip(row[1:], widths[1:], codes[1:])
        )
        print("  ".join(cells).rstrip())


@dataclass
class Space:
    workspace_id: str
    label: str
    number: int
    identity_cwd: Path | None
    checkout: Path | None
    repo_root: Path | None
    linked: bool
    source: str
    repo_name: str | None = None
    branch: str | None = None


@dataclass
class Perception:
    spaces: list[Space] = field(default_factory=list)
    raw: list[dict] = field(default_factory=list)

    @classmethod
    def see(cls) -> Perception:
        print(paint("36", "+ herdr workspace list"))
        workspaces = herdr("workspace", "list")["result"]["workspaces"]
        print(paint("2", f"  {len(workspaces)} workspaces"))

        print(paint("36", "+ herdr tab list"))
        tabs = herdr("tab", "list")["result"]["tabs"]
        print(paint("2", f"  {len(tabs)} tabs"))

        print(paint("36", "+ herdr pane list"))
        panes = herdr("pane", "list")["result"]["panes"]
        print(paint("2", f"  {len(panes)} panes"))

        frozen = session_identity_cwds()
        first_tab: dict[str, str] = {}
        for tab in tabs:
            first_tab.setdefault(tab["workspace_id"], tab["tab_id"])
        cwd_by_tab: dict[str, str] = {}
        cwd_by_ws: dict[str, str] = {}
        for pane in panes:
            if pane.get("cwd"):
                cwd_by_tab.setdefault(pane["tab_id"], pane["cwd"])
                cwd_by_ws.setdefault(pane["workspace_id"], pane["cwd"])

        spaces: list[Space] = []
        probed = 0
        for ws in workspaces:
            wid = ws["workspace_id"]
            ident = frozen.get(wid)
            if ident is None:
                tid = first_tab.get(wid)
                raw_cwd = (cwd_by_tab.get(tid) if tid else None) or cwd_by_ws.get(wid)
                ident = Path(raw_cwd).resolve() if raw_cwd else None
            space = cls._classify(ws, ident)
            wt = ws.get("worktree")
            herdr_co = (
                Path(wt["checkout_path"]).resolve()
                if wt and wt.get("checkout_path")
                else None
            )
            if (
                herdr_co is not None
                and space.checkout is not None
                and herdr_co != space.checkout
            ):
                print(
                    paint(
                        "33",
                        f"  {ws['label']}: identity {space.checkout} "
                        f"(herdr bound {herdr_co})",
                    )
                )
            if space.source != "herdr":
                probed += 1
                target = ident or "-"
                print(
                    paint(
                        "36",
                        f"+ git -C {target} rev-parse --show-toplevel --git-common-dir",
                    )
                )
                if space.repo_root is None:
                    print(paint("33", f"  {ws['label']}: not a git repo"))
                else:
                    kind = "worktree" if space.linked else "main"
                    print(paint("32", f"  {ws['label']}: {kind} of {space.repo_root}"))
            spaces.append(space)
        cls._attach_layout(spaces)
        print(
            paint(
                "2",
                f"  herdr worktree on {len(spaces) - probed}, git probe on {probed}",
            )
        )
        return cls(spaces=spaces, raw=workspaces)

    @staticmethod
    def _classify(ws: dict, ident: Path | None) -> Space:
        info = git_info(ident) if ident else None
        wt = ws.get("worktree")
        herdr_co = (
            Path(wt["checkout_path"]).resolve()
            if wt and wt.get("checkout_path")
            else None
        )
        if info is not None:
            toplevel, repo_root, linked = info
            agrees = herdr_co is not None and herdr_co == toplevel
            return Space(
                ws["workspace_id"],
                ws["label"],
                ws["number"],
                ident,
                toplevel,
                repo_root,
                linked,
                "herdr" if agrees else "git",
                (wt or {}).get("repo_name") or repo_root.name,
                git_branch(toplevel),
            )
        if wt:
            checkout = herdr_co or Path(wt["checkout_path"]).resolve()
            repo_root = Path(wt["repo_root"]).resolve()
            return Space(
                ws["workspace_id"],
                ws["label"],
                ws["number"],
                ident,
                checkout,
                repo_root,
                bool(wt["is_linked_worktree"]),
                "herdr",
                wt.get("repo_name"),
                git_branch(checkout),
            )
        return Space(
            ws["workspace_id"],
            ws["label"],
            ws["number"],
            ident,
            ident,
            None,
            False,
            "git",
        )

    @staticmethod
    def _attach_layout(spaces: list[Space]) -> None:
        known: list[tuple[str, Path]] = []
        for space in spaces:
            if space.repo_root is None:
                continue
            known.append((space.repo_root.name.lower(), space.repo_root))
            if space.repo_name:
                known.append((space.repo_name.lower(), space.repo_root))
        for space in spaces:
            if space.repo_root is not None or space.checkout is None:
                continue
            slug = layout_slug(space.checkout)
            if slug is None:
                continue
            print(paint("36", f"+ layout {space.checkout}"))
            root = match_slug(slug, known) or infer_repo_root(space.checkout)
            if root is None:
                print(
                    paint(
                        "33",
                        f"  {space.label}: worktree layout {slug}, no main repo found",
                    )
                )
                continue
            space.linked = True
            space.source = "layout"
            space.repo_root = root
            space.repo_name = root.name
            print(paint("35", f"  {space.label}: worktree of {root}"))

    def refresh(self) -> None:
        git_cache_clear()
        other = Perception.see()
        self.spaces = other.spaces
        self.raw = other.raw

    def _by_id(self) -> dict[str, Space]:
        return {space.workspace_id: space for space in self.spaces}

    def _open_main(self, root: Path, group: list[Space]) -> tuple[str, bool] | None:
        if git_info(root) is None:
            print(paint("33", f"  no main checkout at {root}"))
            return None
        label = next(
            (space.repo_name for space in group if space.repo_name),
            root.name,
        )
        result = worktree_open(root, label)
        if result is not None:
            parent = result["workspace"]["workspace_id"]
            already = bool(result.get("already_open"))
            extra = ", already open" if already else ""
            existing = self._by_id().get(parent)
            if existing is None or (not existing.linked and existing.checkout == root):
                print(paint("32", f"  opened main {label} ({parent}{extra})"))
                return parent, not already
            print(
                paint(
                    "33",
                    f"  {label}: herdr main is worktree identity {existing.checkout}",
                )
            )
        print(
            paint(
                "36",
                f"+ herdr workspace create --cwd {root} --label {label} --no-focus",
            )
        )
        created = herdr_try(
            "workspace",
            "create",
            "--cwd",
            str(root),
            "--label",
            label,
            "--no-focus",
        )
        if created is None:
            return None
        ws = (created.get("result") or created).get("workspace") or {}
        parent = ws.get("workspace_id")
        if not parent:
            return None
        print(paint("32", f"  created main {label} ({parent})"))
        return parent, True

    def nest(self) -> bool:
        groups: dict[Path, list[Space]] = defaultdict(list)
        for space in self.spaces:
            if space.repo_root is not None:
                groups[space.repo_root].append(space)
        acted = False
        for root, group in sorted(groups.items(), key=lambda item: str(item[0])):
            linked = [space for space in group if space.linked]
            mains = [
                space
                for space in group
                if not space.linked and space.checkout == space.repo_root
            ]
            if not linked:
                continue
            if mains:
                parent = mains[0].workspace_id
            else:
                opened = self._open_main(root, group)
                if opened is None:
                    continue
                parent, created = opened
                if created:
                    acted = True
            for space in linked:
                if space.source == "herdr" or space.checkout is None:
                    continue
                if space.workspace_id == parent:
                    print(
                        paint(
                            "33",
                            f"  {space.label}: identity is worktree, "
                            "herdr still bound it as main",
                        )
                    )
                    continue
                broken = git_info(space.checkout) is None
                if not relink_worktree(space.checkout, root):
                    continue
                label = git_branch(space.checkout) or space.label
                result = worktree_open(space.checkout, label, workspace=parent)
                if result is None:
                    continue
                already = result.get("already_open")
                ws_id = result.get("workspace", {}).get("workspace_id", "?")
                extra = ", already open" if already else ""
                print(
                    paint(
                        "35",
                        f"  nested {label} under {root.name} ({ws_id}{extra})",
                    )
                )
                if broken or not already:
                    acted = True
        return acted

    def park(self) -> bool:
        acted = False
        seen: set[Path] = set()
        for space in self.spaces:
            if space.linked or space.repo_root is None:
                continue
            if space.repo_root in seen:
                continue
            seen.add(space.repo_root)
            if self._park_one(space):
                acted = True
        return acted

    def _park_one(self, space: Space) -> bool:
        root = space.repo_root
        if root is None:
            return False
        branch = git_branch(root)
        if branch is None:
            print(paint("33", f"  {space.label}: detached HEAD, skip park"))
            return False
        if branch in DEFAULT_BRANCHES:
            return False
        default = default_branch(root)
        if default is None:
            print(paint("33", f"  {space.label}: no main/master, skip park"))
            return False
        wt_path = linked_worktree_for(root, branch)
        dirty = git_dirty(root)
        if dirty:
            msg = f"reorder_herdr_workspaces:{branch}"
            print(paint("36", f"+ git -C {root} stash push -u -m {msg}"))
            proc = git_run(root, "stash", "push", "-u", "-m", msg)
            if proc.returncode != 0:
                sys.stderr.write(proc.stderr)
                print(paint("33", f"  {space.label}: stash failed, skip park"))
                return False
        if wt_path is None:
            wt_path = grok_worktree_path(root, branch)
            wt_path.parent.mkdir(parents=True, exist_ok=True)
            print(
                paint(
                    "36",
                    f"+ git -C {root} worktree add -f {wt_path} {branch}",
                )
            )
            proc = git_run(root, "worktree", "add", "-f", str(wt_path), branch)
            git_cache_clear()
            if proc.returncode != 0:
                sys.stderr.write(proc.stderr)
                if dirty:
                    git_run(root, "stash", "pop")
                print(paint("33", f"  {space.label}: worktree add failed"))
                return False
        result = worktree_open(wt_path, branch, workspace=space.workspace_id)
        wt_ws = None
        if result is not None:
            wt_ws = result.get("workspace", {}).get("workspace_id")
            already = bool(result.get("already_open"))
            extra = ", already open" if already else ""
            print(
                paint(
                    "35",
                    f"  parked {branch} under {root.name} ({wt_ws}{extra})",
                )
            )
        print(paint("36", f"+ git -C {root} checkout {default}"))
        proc = git_run(root, "checkout", default)
        git_cache_clear()
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr)
            print(paint("33", f"  {space.label}: checkout {default} failed"))
            if dirty:
                git_run(root, "stash", "pop")
            return bool(wt_ws)
        print(paint("32", f"  {space.label}: {branch} -> {default}"))
        if dirty:
            print(paint("36", f"+ git -C {wt_path} stash pop"))
            proc = git_run(wt_path, "stash", "pop")
            if proc.returncode != 0:
                sys.stderr.write(proc.stderr)
                print(paint("33", f"  stash pop in {wt_path} failed; stash kept"))
            else:
                print(paint("32", f"  restored dirty work in {branch}"))
        return True

    def relabel(self) -> bool:
        acted = False
        for space in self.spaces:
            if not space.linked or space.checkout is None:
                continue
            branch = git_branch(space.checkout)
            if branch is None or branch == space.label:
                continue
            print(
                paint(
                    "36",
                    f"+ herdr workspace rename {space.workspace_id} {branch}",
                )
            )
            if herdr_try("workspace", "rename", space.workspace_id, branch) is None:
                continue
            print(paint("32", f"  {space.label} -> {branch}"))
            space.label = branch
            acted = True
        return acted

    def order(self) -> list[Space]:
        pin_main: list[Space] = []
        pin_wt: list[Space] = []
        groups: dict[Path, list[Space]] = defaultdict(list)
        nongit: list[Space] = []
        for space in self.spaces:
            if space.checkout == PIN:
                pin_main.append(space)
            elif space.repo_root == PIN:
                pin_wt.append(space)
            elif space.repo_root is not None:
                groups[space.repo_root].append(space)
            else:
                nongit.append(space)

        def key(space: Space) -> tuple[str, str, str]:
            return (
                str(space.checkout or ""),
                space.label,
                space.workspace_id,
            )

        out = sorted(pin_main, key=key) + sorted(pin_wt, key=key)
        for root in sorted(groups, key=str):
            group = groups[root]
            mains = sorted((s for s in group if not s.linked), key=key)
            wts = sorted((s for s in group if s.linked), key=key)
            out.extend(mains)
            out.extend(wts)
        out.extend(sorted(nongit, key=key))
        return out

    def criterion(self, space: Space) -> str:
        if space.checkout == PIN:
            return "this checkout first; on main/master"
        if space.repo_root == PIN:
            return "worktree nested under this checkout; label is branch"
        if space.linked and space.repo_root is not None:
            return f"worktree nested under {space.repo_root}; label is branch"
        if space.repo_root is not None:
            return f"main checkout {space.repo_root} on main/master"
        return "not a git repo, last"

    def kind(self, space: Space) -> str:
        if space.linked:
            return "worktree"
        if space.repo_root is not None:
            return "repo"
        return "dir"

    def kind_color(self, space: Space) -> str:
        if space.checkout == PIN:
            return "1;36"
        if space.linked:
            return "35"
        if space.repo_root is not None:
            return "32"
        return "33"

    def show(self, wanted: list[Space]) -> None:
        by_id = {ws["workspace_id"]: ws for ws in self.raw}
        print(paint("1", "order:"))
        table: list[tuple[str, ...]] = []
        paints: list[tuple[str | None, ...]] = []
        for i, space in enumerate(wanted, 1):
            kind = self.kind(space)
            was = by_id[space.workspace_id]["number"]
            moved = "" if was == i else f"was {was}"
            color = self.kind_color(space)
            table.append(
                (
                    str(i),
                    space.label,
                    kind,
                    space.source,
                    self.criterion(space),
                    moved,
                )
            )
            paints.append(
                (
                    color,
                    "1;36" if space.checkout == PIN else color,
                    color,
                    "2",
                    "2",
                    "33" if moved else None,
                )
            )
        print_table(table, paints)

    def sort(self, wanted: list[Space]) -> None:
        current_ids = [ws["workspace_id"] for ws in self.raw]
        wanted_ids = [space.workspace_id for space in wanted]
        if current_ids == wanted_ids:
            print(paint("32", "already in order, no move"))
            return
        if len(wanted_ids) <= 1:
            return
        anchor = wanted[-1]
        print(
            paint(
                "36",
                f"+ workspace.move_block {len(wanted_ids) - 1} ids "
                f"before {anchor.label} ({anchor.workspace_id})",
            )
        )
        herdr_rpc(
            "workspace.move_block",
            {
                "workspace_ids": wanted_ids[:-1],
                "before_workspace_id": wanted_ids[-1],
            },
        )
        print(paint("32", "ok"))

    def towards(self) -> None:
        for _ in range(6):
            if self.nest() | self.park() | self.relabel():
                self.refresh()
                continue
            break
        wanted = self.order()
        self.show(wanted)
        self.sort(wanted)


def main() -> None:
    if len(sys.argv) != 1:
        raise SystemExit(f"usage: {Path(sys.argv[0]).name}")
    Perception.see().towards()


if __name__ == "__main__":
    main()
