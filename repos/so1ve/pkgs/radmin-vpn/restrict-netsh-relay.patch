diff --git a/run.sh b/run.sh
index 0451ecc..bdd9e6b 100755
--- a/run.sh
+++ b/run.sh
@@ -5,6 +5,7 @@
 #   --filter-ui  launch the optional GTK4 packet-filter UI (off by default)
 #   --fix-chat   patch Qt qwindows.dll to fix the chat crash (off by default)
 set -euo pipefail
+umask 077
 
 DIR="$(cd "$(dirname "$0")" && pwd)"
 
@@ -317,6 +318,25 @@ wine reg add "HKLM\\System\\CurrentControlSet\\Control\\Session Manager\\Memory
 wine reg add "HKLM\\System\\CurrentControlSet\\Control\\Session Manager\\Memory Management" /v LargeSystemCache /t REG_DWORD /d 1 /f > /dev/null 2>&1
 good "Registry configured"
 
+run_netsh_command() {
+    local command="$1"
+    local ipv4="^ip addr add (([0-9]{1,3}\.){3}[0-9]{1,3}/(8|16|24)) dev ${TAP_DEV} 2>/dev/null; ip link set ${TAP_DEV} up 2>/dev/null$"
+    local ipv6="^ip -6 addr add ([0-9A-Fa-f:]+/128) dev ${TAP_DEV} 2>/dev/null$"
+
+    if [[ "$command" =~ $ipv4 ]]; then
+        sudo ip addr add "${BASH_REMATCH[1]}" dev "$TAP_DEV" 2>/dev/null || true
+        sudo ip link set "$TAP_DEV" up 2>/dev/null || true
+    elif [[ "$command" =~ $ipv6 ]]; then
+        sudo ip -6 addr add "${BASH_REMATCH[1]}" dev "$TAP_DEV" 2>/dev/null || true
+    elif [ "$command" = "ip link set $TAP_DEV up" ]; then
+        sudo ip link set "$TAP_DEV" up 2>/dev/null || true
+    elif [ "$command" = "ip addr flush dev $TAP_DEV" ]; then
+        sudo ip addr flush dev "$TAP_DEV" 2>/dev/null || true
+    else
+        warn "Rejected netsh relay command: $command"
+    fi
+}
+
 # 8. Start netsh relay
 rm -f "$CMD_FILE" "${CMD_FILE}.proc"
 (
@@ -326,7 +346,7 @@ rm -f "$CMD_FILE" "${CMD_FILE}.proc"
             while IFS= read -r cmd; do
                 cmd=$(printf '%s' "$cmd" | tr -d '\r')
                 [ -z "$cmd" ] && continue
-                sudo sh -c "$cmd" 2>/dev/null
+                run_netsh_command "$cmd"
             done < "${CMD_FILE}.proc"
             rm -f "${CMD_FILE}.proc"
         fi
