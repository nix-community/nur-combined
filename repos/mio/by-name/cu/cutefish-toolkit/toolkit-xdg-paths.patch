 namespace cutefish::base::paths {
 
+// XDG lists are colon-separated. Empty entries are skipped.
+static std::vector<std::string> splitColon(const char *value)
+{
+    std::vector<std::string> parts;
+    if (!value || !*value)
+        return parts;
+    const std::string text(value);
+    size_t start = 0;
+    while (start <= text.size()) {
+        size_t end = text.find(':', start);
+        if (end == std::string::npos)
+            end = text.size();
+        if (end > start)
+            parts.push_back(text.substr(start, end - start));
+        if (end == text.size())
+            break;
+        start = end + 1;
+    }
+    return parts;
+}
