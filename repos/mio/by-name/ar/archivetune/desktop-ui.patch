+
+    Column(modifier = Modifier.fillMaxSize().verticalScroll(rememberScrollState())) {
+        HomeCategoryChips(
+            chips = chips,
+            selectedChip = selectedChip,
+            onChipSelected = { selectedChip = it }
+        )
