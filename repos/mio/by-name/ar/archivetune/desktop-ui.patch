+        )
+
+
+        QuickPicksSection(songs = dummySongs)
+        
+        Spacer(modifier = Modifier.height(24.dp))
+        
+        val forgottenSongs = listOf(
+            StubSong("5", "Billie Jean", "Michael Jackson"),
+            StubSong("6", "Beat It", "Michael Jackson"),
+            StubSong("7", "Thriller", "Michael Jackson"),
+            StubSong("8", "Smooth Criminal", "Michael Jackson"),
+            StubSong("9", "Bad", "Michael Jackson"),
+            StubSong("10", "Black or White", "Michael Jackson")
+        )
+        
+
+        ForgottenFavoritesSection(songs = forgottenSongs)
+        
+        Spacer(modifier = Modifier.height(24.dp))
+        
+        val keepListeningAlbums = listOf(
+            StubAlbum("1", "Thriller", "Michael Jackson"),
+            StubAlbum("2", "Bad", "Michael Jackson"),
+            StubAlbum("3", "Dangerous", "Michael Jackson")
+        )
+        
+
+        KeepListeningSection(items = keepListeningAlbums)
+        
+        Spacer(modifier = Modifier.height(24.dp))
+        
+        val similarSongs = listOf(
+            StubSong("11", "Don't Stop 'Til You Get Enough", "Michael Jackson"),
+            StubSong("12", "Rock with You", "Michael Jackson"),
+            StubSong("13", "Wanna Be Startin' Somethin'", "Michael Jackson")
+        )
+        
+
+        SimilarRecommendationsSection(title = "Michael Jackson", songs = similarSongs)
+        
+        Spacer(modifier = Modifier.height(24.dp))
+        
+        val accountPlaylists = listOf(
+            StubAlbum("p1", "My Mix 1", "YouTube Music"),
+            StubAlbum("p2", "Discover Weekly", "YouTube Music"),
+            StubAlbum("p3", "Liked Music", "YouTube Music")
+        )
+        
+        AccountPlaylistsSection(playlists = accountPlaylists)
+
+
+
+
+        
+        Spacer(modifier = Modifier.height(32.dp))
+    }
+
+}
