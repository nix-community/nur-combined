+MemMap MemMap::MapAnonymousJit(const char* name,
+                               uint8_t* hint,
+                               size_t byte_count,
+                               std::string* error_msg) {
+#if defined(__APPLE__) && defined(__aarch64__)
+#ifndef MAP_JIT
+#define MAP_JIT 0x0800
+#endif
+  if (byte_count == 0) {
+    *error_msg = "Empty JIT MemMap requested.";
+    return Invalid();
+  }
+  const size_t page_aligned_byte_count = RoundUp(byte_count, kPageSize);
+  const int prot = PROT_READ | PROT_WRITE | PROT_EXEC;
+  const int flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT;
+  void* actual = MAP_FAILED;
+  int saved_errno = EINVAL;
+  // MAP_FIXED|MAP_JIT is rejected. A hint at a page we just unmapped is honored;
+  // retry in case another thread wins the address.
+  for (int attempt = 0; attempt < 8; ++attempt) {
+    actual = mmap(hint, page_aligned_byte_count, prot, flags, -1, 0);
+    if (actual == hint) {
+      break;
+    }
+    saved_errno = errno;
+    if (actual != MAP_FAILED) {
+      munmap(actual, page_aligned_byte_count);
+    }
+    actual = MAP_FAILED;
+  }
+  if (actual != hint) {
+    *error_msg = StringPrintf("mmap(%p, %zd, MAP_JIT) failed: %s",
+                              hint,
+                              page_aligned_byte_count,
+                              strerror(saved_errno));
+    return Invalid();
+  }
+  return MemMap(name,
+                reinterpret_cast<uint8_t*>(actual),
+                byte_count,
+                actual,
+                page_aligned_byte_count,
+                prot,
+                /*reuse=*/ false);
+#else
+  UNUSED(name, hint, byte_count);
+  *error_msg = "MapAnonymousJit is only implemented for Apple Silicon";
+  return Invalid();
+#endif
+}
