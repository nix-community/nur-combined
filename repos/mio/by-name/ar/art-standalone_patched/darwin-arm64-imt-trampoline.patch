     tbnz x15, #ACC_OBSOLETE_METHOD_SHIFT, .Limt_conflict_trampoline_dex_cache_miss
+#if defined(__APPLE__)
+    // declaring class is a compressed ref. xSELF->reference_base_ptr_ is offset 0.
