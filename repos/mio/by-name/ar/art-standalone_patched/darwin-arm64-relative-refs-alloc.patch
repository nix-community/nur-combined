 // The regular start of memory allocations. The first 64KB is protected by SELinux.
 static constexpr uintptr_t LOW_MEM_START = 64 * KB;

+#if ART_USE_RELATIVE_REFS
+// With relative heap references the allocator hands out memory from a 4 GiB
+// window whose base is chosen at RUNTIME so it lands in actually-free memory
+// (macOS reserves/occupies much of the address space, so no fixed 4 GiB base is
+// safe).  Must match runtime_globals.h g_reference_base.
+extern "C" uintptr_t g_reference_base = 0x300000000ULL;  // must match runtime_globals.h kReferenceBase
+extern "C" uintptr_t art_get_reference_base() { return g_reference_base; }
+
+void ReserveReferenceWindow() {
+  constexpr size_t kWindow = 4ULL * GB;
+  // Ask the kernel where a free 8 GiB region is, take the 4 GiB-aligned half
+  // inside as the window base (so it is aligned without MAP_FIXED-clobbering
+  // live memory), then release the probe so the allocator can map the window
+  // itself (it must appear free to the msync check).
+  void* p = mmap(nullptr, 2 * kWindow, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  CHECK(p != MAP_FAILED) << "Failed to probe for the reference window";
+  uintptr_t a = reinterpret_cast<uintptr_t>(p);
+  uintptr_t aligned = (a + kWindow - 1) & ~(kWindow - 1);
+  CHECK_LE(aligned + kWindow, a + 2 * kWindow) << "reference window alignment";
+  CHECK_EQ(munmap(p, 2 * kWindow), 0) << "Failed to release the reference window probe";
+  g_reference_base = aligned;
+  LOG(INFO) << "Reference window base at " << reinterpret_cast<void*>(aligned);
+}
+#endif
+
+static uintptr_t LowMemStart() {
+#if ART_USE_RELATIVE_REFS
+  return g_reference_base;
+#else
+  return LOW_MEM_START;
+#endif
+}
+static uintptr_t LowMemEnd() {
+#if ART_USE_RELATIVE_REFS
+  return g_reference_base + 4 * GB;
+#else
+  return 4 * GB;
+#endif
+}
