 // Size of a heap reference.
 static constexpr size_t kHeapReferenceSize = sizeof(uint32_t);
 
+// Whether heap references are encoded relative to a base address instead of as
+// truncated absolute addresses.  Opt in with -DART_USE_RELATIVE_REFS on hosts
+// whose address space has no usable low 4 GiB (e.g. aarch64 macOS, whose kernel
+// reserves the low 4 GiB as __PAGEZERO).  When enabled, every object and the
+// boot image must live in [g_reference_base, g_reference_base + 4 GiB) so that the
+// reference still fits in a uint32_t.  See
+// by-name/ar/art-standalone_patched/DARWIN-ARM64.md.
+#ifndef ART_USE_RELATIVE_REFS
+#define ART_USE_RELATIVE_REFS 0
+#endif
+
+#if ART_USE_RELATIVE_REFS
+// Base of the heap-reference window (4 GiB aligned).  Chosen at runtime by
+// art::ReserveReferenceWindow() so the window lands in actually-free memory
+// (macOS reserves/occupies much of the address space).
+extern "C" uintptr_t g_reference_base;
+#endif
+
 }  // namespace art
 
 #endif  // ART_RUNTIME_RUNTIME_GLOBALS_H_
