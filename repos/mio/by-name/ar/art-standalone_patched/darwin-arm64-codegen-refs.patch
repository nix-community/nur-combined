+  masm->B(&done, hs);
+  masm->Add(ip0, ip0, ip1);
+  masm->Bind(&done);
+  if (reg.GetCode() == ip0.GetCode()) {
+    masm->Str(ip0, MemOperand(sp));
+  } else if (reg.GetCode() == ip1.GetCode()) {
+    masm->Str(ip0, MemOperand(sp, 8));
+  } else {
+    masm->Mov(reg.X(), ip0);
+  }
+  masm->Ldp(ip0, ip1, MemOperand(sp, 16, PostIndex));
