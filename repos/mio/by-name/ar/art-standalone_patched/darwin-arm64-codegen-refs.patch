+// A 4 GiB-aligned base means the low 32 bits of an absolute pointer are the
+// compressed ref, so a later 32-bit store still writes the right slot.
+// Shared with code_generator_vector_arm64.cc.
+void MakeReferenceAbsolute(vixl::aarch64::MacroAssembler* masm,
+                                  vixl::aarch64::Register reg) {
+  // ip0/ip1 are the only scratches, and callers often already hold both.
+  // Spill them, compute in ip0, then put the result back in reg.
+  masm->Stp(ip0, ip1, MemOperand(sp, -16, PreIndex));
+  masm->Mov(ip0, reg.X());
