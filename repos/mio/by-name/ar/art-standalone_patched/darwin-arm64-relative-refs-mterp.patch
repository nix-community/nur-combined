--- a/art/runtime/interpreter/mterp/arm64/main.S	2026-10-09 21:41:11.446258631 +1100
+++ b/art/runtime/interpreter/mterp/arm64/main.S	2026-10-10 22:50:19.207796642 +1100
@@ -109,7 +109,35 @@
 #define ip       x16
 #define ip2      x17

+#if defined(ART_USE_RELATIVE_REFS) && ART_USE_RELATIVE_REFS
 /*
+ * Base of the heap reference window (see runtime_globals.h kReferenceBase).
+ * References held in vregs and object fields are offsets from this base, so the
+ * base must be added before a reference is used as an address or passed to a
+ * C++ helper that expects a pointer.  x27 is callee-saved and unused by mterp;
+ * it is set up in ExecuteMterpImpl below.
+ */
+#define xREFBASE x27
+#endif
+
+/*
+ * Add the reference base to a register that holds a heap reference (which under
+ * relative references is an offset from xREFBASE).  No-op unless enabled.
+ */
+#if defined(ART_USE_RELATIVE_REFS) && ART_USE_RELATIVE_REFS
+.macro ADD_REF_BASE reg
+    cbz     \reg, .Lskip_ref_base\@
+    cmp     \reg, xREFBASE
+    b.hs    .Lskip_ref_base\@
+    add     \reg, \reg, xREFBASE
+.Lskip_ref_base\@:
+.endm
+#else
+.macro ADD_REF_BASE reg
+.endm
+#endif
+
+/*
  * Instead of holding a pointer to the shadow frame, we keep xFP at the base of the vregs.  So,
  * to access other shadow frame fields, we need to use a backwards offset.  Define those here.
  */
@@ -429,6 +453,12 @@
     add     xPC, x1, x0, uxtx #1                    // Create direct pointer to 1st dex opcode
     CFI_DEFINE_DEX_PC_WITH_OFFSET(CFI_TMP, CFI_DEX, 0)
     EXPORT_PC
+
+#if defined(ART_USE_RELATIVE_REFS) && ART_USE_RELATIVE_REFS
+    /* Heap reference base, chosen at runtime (art::g_reference_base). */
+    bl      _art_get_reference_base
+    mov     xREFBASE, x0
+#endif

     /* Starting ibase */
     ldr     xIBASE, [xSELF, #THREAD_CURRENT_IBASE_OFFSET]
