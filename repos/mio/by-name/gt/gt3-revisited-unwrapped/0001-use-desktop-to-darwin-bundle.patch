From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NUR Packages <nur@example.invalid>
Date: Wed, 25 Nov 2026 00:00:00 +1100
Subject: [PATCH] Use the Nix desktop-to-Darwin bundle hook

Upstream builds its macOS .app with sips, iconutil and codesign. Those
tools are unavailable in the Nix build sandbox, so install the ordinary
desktop payload and let desktopToDarwinBundle create the app.

---
 CMakeLists.txt        | 3 ++-
 cmake/Packaging.cmake | 4 ++--
 2 files changed, 4 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,2 +14,3 @@
 option(GT3R_BUILD_TOOLS "Build the gt3tool command line utility" ON)
+option(GT3R_DARWIN_BUNDLE "Build a native .app bundle on macOS" ON)
 option(GT3R_BUILD_TESTS "Build unit tests" ON)
@@ -132,2 +133,2 @@ if(ANDROID)
-  elseif(APPLE)
+  elseif(APPLE AND GT3R_DARWIN_BUNDLE)
     set_target_properties(gt3r PROPERTIES
diff --git a/cmake/Packaging.cmake b/cmake/Packaging.cmake
--- a/cmake/Packaging.cmake
+++ b/cmake/Packaging.cmake
@@ -26,3 +26,3 @@ if(TARGET gt3r AND IOS)
     XCODE_ATTRIBUTE_ASSETCATALOG_COMPILER_APPICON_NAME AppIcon)
-elseif(TARGET gt3r AND APPLE)
+elseif(TARGET gt3r AND APPLE AND GT3R_DARWIN_BUNDLE)
   # .icns generated from packaging/icon.png with the macOS tools.
@@ -63,2 +63,2 @@ if(TARGET gt3r)
-if(APPLE)
+if(APPLE AND GT3R_DARWIN_BUNDLE)
   install(TARGETS gt3r BUNDLE DESTINATION .)
