-VkResult bionic_vkCreateInstance(VkInstanceCreateInfo *pCreateInfo, const VkAllocationCallbacks *pAllocator, VkInstance *pInstance)
+/* The host loader rejects extensions its drivers do not advertise, and portability
+ * enumeration changes the instance flags as well as the extension list. */
+static bool instance_extension_supported(const char *name)
 {
-	int original_extension_count = pCreateInfo->enabledExtensionCount;
-	int new_extension_count = original_extension_count + 3;
-	const char **enabled_exts = malloc(new_extension_count * sizeof(char *));
-	memcpy(enabled_exts, pCreateInfo->ppEnabledExtensionNames, original_extension_count * sizeof(char *));
-	enabled_exts[original_extension_count] = "VK_KHR_wayland_surface";
-	enabled_exts[original_extension_count + 1] = "VK_KHR_xlib_surface";
-	enabled_exts[original_extension_count + 2] = "VK_KHR_surface";
+	uint32_t count = 0;
+	if (vkEnumerateInstanceExtensionProperties(NULL, &count, NULL) != VK_SUCCESS || !count)
+		return false;
+	VkExtensionProperties *properties = calloc(count, sizeof(*properties));
+	if (!properties)
+		return false;
+	bool found = false;
+	if (vkEnumerateInstanceExtensionProperties(NULL, &count, properties) == VK_SUCCESS)
+		for (uint32_t i = 0; i < count; i++)
+			if (!strcmp(properties[i].extensionName, name)) { found = true; break; }
+	free(properties);
+	return found;
+}
 
-	pCreateInfo->enabledExtensionCount = new_extension_count;
-	pCreateInfo->ppEnabledExtensionNames = enabled_exts;
-	return vkCreateInstance(pCreateInfo, pAllocator, pInstance);
+VkResult bionic_vkCreateInstance(VkInstanceCreateInfo *pCreateInfo, const VkAllocationCallbacks *pAllocator, VkInstance *pInstance)
+{
+	/* Android's surface extension must never reach the host Vulkan loader; the
+	 * macOS surface extensions are only added when the ICD advertises them. */
+	const char *const managed[] = { "VK_KHR_android_surface", "VK_KHR_surface", "VK_EXT_metal_surface", "VK_MVK_macos_surface", "VK_KHR_portability_enumeration" };
+	const char *const surfaces[] = { "VK_KHR_surface", "VK_EXT_metal_surface", "VK_MVK_macos_surface" };
+	bool portability = instance_extension_supported("VK_KHR_portability_enumeration");
+	uint32_t count = 0;
+	const char **extensions = calloc(pCreateInfo->enabledExtensionCount + ARRAY_SIZE(surfaces) + 1, sizeof(*extensions));
+	if (!extensions)
+		return VK_ERROR_OUT_OF_HOST_MEMORY;
+	for (uint32_t i = 0; i < pCreateInfo->enabledExtensionCount; i++) {
+		const char *extension = pCreateInfo->ppEnabledExtensionNames[i];
+		bool skip = false;
+		for (uint32_t j = 0; j < ARRAY_SIZE(managed); j++)
+			if (!strcmp(extension, managed[j])) skip = true;
+		if (!skip) extensions[count++] = extension;
+	}
+	for (uint32_t i = 0; i < ARRAY_SIZE(surfaces); i++)
+		if (instance_extension_supported(surfaces[i])) extensions[count++] = surfaces[i];
+	if (portability) extensions[count++] = "VK_KHR_portability_enumeration";
+	VkInstanceCreateInfo info = *pCreateInfo;
+	if (portability) info.flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
+	info.enabledExtensionCount = count;
+	info.ppEnabledExtensionNames = extensions;
+	VkResult result = vkCreateInstance(&info, pAllocator, pInstance);
+	free(extensions);
+	return result;
 }
 
