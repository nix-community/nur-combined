-	return vkCreateInstance(pCreateInfo, pAllocator, pInstance);
+	/* Android's surface extension must not reach the host Vulkan loader. */
+	uint32_t count = 0;
+	const char **extensions = calloc(pCreateInfo->enabledExtensionCount + 4, sizeof(*extensions));
+	if (!extensions)
+		return VK_ERROR_OUT_OF_HOST_MEMORY;
+	for (uint32_t i = 0; i < pCreateInfo->enabledExtensionCount; i++) {
+		const char *extension = pCreateInfo->ppEnabledExtensionNames[i];
+		if (strcmp(extension, "VK_KHR_android_surface") &&
+		    strcmp(extension, "VK_MVK_macos_surface") &&
+		    strcmp(extension, "VK_KHR_surface") &&
+		    strcmp(extension, "VK_KHR_portability_enumeration"))
+			extensions[count++] = extension;
+	}
+	extensions[count++] = "VK_KHR_surface";
+	extensions[count++] = "VK_MVK_macos_surface";
+	extensions[count++] = "VK_KHR_portability_enumeration";
+	VkInstanceCreateInfo info = *pCreateInfo;
+	info.flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
+	info.enabledExtensionCount = count;
+	info.ppEnabledExtensionNames = extensions;
+	VkResult result = vkCreateInstance(&info, pAllocator, pInstance);
+	free(extensions);
+	return result;
 }
 
