-}
+static void *xr_lookup(const char *name)
+{
+	if (!openxr_loader_handle)
+		openxr_loader_handle = dlopen("libopenxr_loader.dylib", RTLD_LAZY | RTLD_LOCAL);
+	return openxr_loader_handle ? dlsym(openxr_loader_handle, name) : NULL;
+}
+#define xr_lazy_call(name, ...) ({ \
+	PFN_##name function = (PFN_##name)xr_lookup(#name); \
+	function ? function(__VA_ARGS__) : XR_ERROR_RUNTIME_UNAVAILABLE; \
+})
 
