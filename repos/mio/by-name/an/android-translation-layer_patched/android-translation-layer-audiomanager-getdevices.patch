From: Developer
Date: Wed, 12 Aug 2026
Subject: [PATCH] stub AudioManager.getDevices() for ExoPlayer / NewPipe

NewPipe's ExoPlayer calls AudioManager.getDevices(GET_DEVICES_OUTPUTS)
(API 23) while probing Bluetooth audio. ATL had no such method, so
initPlayback failed with NoSuchMethodError.

--- a/src/api-impl/android/media/AudioDeviceInfo.java	2026-09-13 17:56:26.889103052 +1000
+++ b/src/api-impl/android/media/AudioDeviceInfo.java	2026-09-13 17:56:26.893103062 +1000
@@ -1,4 +1,25 @@
 package android.media;
 
 public class AudioDeviceInfo {
+	public static final int TYPE_UNKNOWN = 0;
+	public static final int TYPE_BUILTIN_SPEAKER = 2;
+	public static final int TYPE_BLUETOOTH_SCO = 7;
+	public static final int TYPE_BLUETOOTH_A2DP = 8;
+	public static final int TYPE_BLE_HEADSET = 26;
+	public static final int TYPE_BLE_SPEAKER = 27;
+	public static final int TYPE_BLE_BROADCAST = 30;
+
+	private final int type;
+
+	public AudioDeviceInfo() {
+		this(TYPE_BUILTIN_SPEAKER);
+	}
+
+	public AudioDeviceInfo(int type) {
+		this.type = type;
+	}
+
+	public int getType() {
+		return type;
+	}
 }
--- a/src/api-impl/android/media/AudioManager.java	2026-09-13 17:56:26.901103083 +1000
+++ b/src/api-impl/android/media/AudioManager.java	2026-09-13 17:56:26.905103094 +1000
@@ -7,5 +7,8 @@
 	public static final String PROPERTY_OUTPUT_SAMPLE_RATE = "android.media.property.OUTPUT_SAMPLE_RATE";
 
 	public static final int STREAM_MUSIC = 0x3;
+	public static final int GET_DEVICES_INPUTS = 0x1;
+	public static final int GET_DEVICES_OUTPUTS = 0x2;
+	public static final int GET_DEVICES_ALL = GET_DEVICES_INPUTS | GET_DEVICES_OUTPUTS;
 
 	private native void nativeSetStreamVolume(int volume);
