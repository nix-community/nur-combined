@@ -6,6 +6,27 @@
 
 #include "looper.h"
 
+#if defined(__APPLE__)
+/* AOSP's C++ android::Looper is not part of the Darwin build, so back the native looper API
+ * with glib. Each thread gets an opaque handle that stands in for a Looper; the main thread's
+ * handle is the one glib sources get attached to. */
+#define ALOOPER_POLL_TIMEOUT (-3)
+
+static GPrivate darwin_looper_key = G_PRIVATE_INIT(g_free);
+
+static ALooper *darwin_looper_for_thread(void)
+{
+	ALooper *looper = g_private_get(&darwin_looper_key);
+
+	if (!looper) {
+		looper = g_malloc0(1);
+		g_private_set(&darwin_looper_key, looper);
+	}
+
+	return looper;
+}
+#endif
+
 // dummy strong pointer class
 struct sp {
 	ALooper *ptr;
@@ -20,25 +41,42 @@
 struct sp _ZN7android6Looper12getForThreadEv(void);
 ALooper *ALooper_forThread(void)
 {
+#if defined(__APPLE__)
+	return darwin_looper_for_thread();
+#else
 	return _ZN7android6Looper12getForThreadEv().ptr;
+#endif
 }
 
 struct sp _ZN7android6Looper7prepareEi(int opts);
 ALooper *ALooper_prepare(int opts)
 {
+#if defined(__APPLE__)
+	(void)opts;
+	return darwin_looper_for_thread();
+#else
 	return _ZN7android6Looper7prepareEi(opts).ptr;
+#endif
 }
 
