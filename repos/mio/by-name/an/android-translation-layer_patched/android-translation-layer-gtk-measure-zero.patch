From: Developer
Date: Thu, 06 Aug 2026
Subject: [PATCH] set minimum size to zero during GTK measure

Allow GTK windows to shrink properly on the desktop.

--- a/src/api-impl-jni/widgets/WrapperWidget.c
+++ b/src/api-impl-jni/widgets/WrapperWidget.c
@@ -128,7 +128,8 @@
 	if (orientation == GTK_ORIENTATION_HORIZONTAL && (wrapper->layout_width > 0)) {
-		*minimum = *natural = wrapper->layout_width;
+		*natural = wrapper->layout_width;
 	} else if (orientation == GTK_ORIENTATION_VERTICAL && (wrapper->layout_height > 0)) {
-		*minimum = *natural = wrapper->layout_height;
+		*natural = wrapper->layout_height;
 	}
+	*minimum = 0;
 }
 
--- a/src/api-impl-jni/views/AndroidLayout.c
+++ b/src/api-impl-jni/views/AndroidLayout.c
@@ -62,3 +62,4 @@
 	if (*natural < *minimum)
 		*natural = *minimum;
+	*minimum = 0;
 
