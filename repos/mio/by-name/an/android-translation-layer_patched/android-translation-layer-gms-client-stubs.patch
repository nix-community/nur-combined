From: Developer
Date: Thu, 06 Aug 2026
Subject: [PATCH] stub GoogleApiClient and FirebaseCrashlytics

Bypass initialization crashes for legacy connection clients and standard crashlytics integrations.

diff -urN a/src/api-impl/com/google/android/gms/common/api/GoogleApiClient.java b/src/api-impl/com/google/android/gms/common/api/GoogleApiClient.java
--- a/src/api-impl/com/google/android/gms/common/api/GoogleApiClient.java	1970-01-01 10:00:00.000000000 +1000
+++ b/src/api-impl/com/google/android/gms/common/api/GoogleApiClient.java	2026-08-07 19:52:47.471113684 +1000
@@ -0,0 +1,32 @@
+package com.google.android.gms.common.api;
+import android.content.Context;
+import com.google.android.gms.common.ConnectionResult;
+public abstract class GoogleApiClient {
+    public abstract void connect();
+    public abstract void disconnect();
+    public abstract boolean isConnected();
+    public abstract boolean isConnecting();
+
+    public interface ConnectionCallbacks {
+        void onConnected(android.os.Bundle connectionHint);
+        void onConnectionSuspended(int cause);
+    }
+    public interface OnConnectionFailedListener {
+        void onConnectionFailed(ConnectionResult result);
+    }
+
+    public static final class Builder {
+        public Builder(Context context) {}
+        public Builder addApi(Object api) { return this; }
+        public Builder addConnectionCallbacks(ConnectionCallbacks listener) { return this; }
+        public Builder addOnConnectionFailedListener(OnConnectionFailedListener listener) { return this; }
+        public GoogleApiClient build() {
+            return new GoogleApiClient() {
+                @Override public void connect() {}
+                @Override public void disconnect() {}
+                @Override public boolean isConnected() { return true; }
+                @Override public boolean isConnecting() { return false; }
+            };
+        }
+    }
+}
diff -urN a/src/api-impl/com/google/firebase/crashlytics/FirebaseCrashlytics.java b/src/api-impl/com/google/firebase/crashlytics/FirebaseCrashlytics.java
--- a/src/api-impl/com/google/firebase/crashlytics/FirebaseCrashlytics.java	1970-01-01 10:00:00.000000000 +1000
+++ b/src/api-impl/com/google/firebase/crashlytics/FirebaseCrashlytics.java	2026-08-07 19:52:47.469113701 +1000
@@ -0,0 +1,16 @@
+package com.google.firebase.crashlytics;
+public class FirebaseCrashlytics {
+    private static final FirebaseCrashlytics INSTANCE = new FirebaseCrashlytics();
+    private FirebaseCrashlytics() {}
+    public static FirebaseCrashlytics getInstance() { return INSTANCE; }
+    public void setCrashlyticsCollectionEnabled(boolean enabled) {}
+    public void setUserId(String identifier) {}
+    public void setCustomKey(String key, String value) {}
+    public void setCustomKey(String key, boolean value) {}
+    public void setCustomKey(String key, double value) {}
+    public void setCustomKey(String key, float value) {}
+    public void setCustomKey(String key, int value) {}
+    public void setCustomKey(String key, long value) {}
+    public void log(String message) {}
+    public void recordException(Throwable throwable) {}
+}
