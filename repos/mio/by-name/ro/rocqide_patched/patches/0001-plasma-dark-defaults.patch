+  new preference ~name:["source_style"]
+    ~init:(if prefer_dark then "coq_style_dark" else "coq_style")
+    ~repr:Repr.(string)
 
 let global_auto_reload =
   new preference ~name:["global_auto_reload"] ~init:false ~repr:Repr.(bool)
