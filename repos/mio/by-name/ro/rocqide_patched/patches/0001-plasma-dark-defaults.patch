+(* Set by the packaging wrapper from the desktop color-scheme preference
+   (KDE Plasma / xdg-desktop-portal). Used only for built-in defaults when
+   the user has no coqiderc yet; an existing config always wins. *)
+let prefer_dark =
+  match Sys.getenv_opt "ROCQIDE_PREFER_DARK" with
+  | Some ("1" | "true" | "yes") -> true
+  | Some ("0" | "false" | "no") -> false
+  | Some _ | None -> false
+
 let lang_manager = GSourceView3.source_language_manager ~default:true
 let () = lang_manager#set_search_path
   ((Minilib.rocqide_data_dirs ())@lang_manager#search_path)
