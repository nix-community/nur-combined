package hanga:engine;

interface gameplay {
    /// Initialize the mod (called once when the component is loaded).
    init-mod: func();

    /// Voxel world generation owned by the mod.
    query-voxel: func(x: s32, y: s32, z: s32) -> s32;

    /// Action validation and state owned by the mod.
    /// action-type: 1=BreakBlock, 2=PlaceBlock, 3=EnterVehicle, 4=Explosion
    mod-get-action-range: func(action-type: s32) -> f32;
    mod-evaluate-action: func(action-type: s32, current-state: s32) -> s32;
    mod-should-spawn-agent: func(action-type: s32, old-state: s32, new-state: s32) -> s32;

    /// Traffic AI: engine supplies heading + whether the path is blocked.
    compute-traffic-vx: func(fwd-x: f32, fwd-z: f32, blocked: bool) -> f32;
    compute-traffic-vz: func(fwd-x: f32, fwd-z: f32, blocked: bool) -> f32;

    /// Agent AI (cops, pedestrians, etc.)
    compute-agent-vx: func(agent-type: s32, cur-x: f32, cur-z: f32, target-x: f32, target-z: f32) -> f32;
    compute-agent-vz: func(agent-type: s32, cur-x: f32, cur-z: f32, target-x: f32, target-z: f32) -> f32;

    /// Storyteller and economy owned by the mod.
    mod-get-storyteller-level: func() -> s32;
    generate-story-event: func(player-level: s32) -> s32;
    mod-get-economy-params: func() -> s32;
    compute-economy-price: func(base: s32, supply: s32, demand: s32) -> s32;

    /// World setup owned by the mod (engine only instantiates the entities).
    player-spawn: func() -> tuple<s32, s32, s32>;
    vehicle-spawn-count: func() -> s32;
    vehicle-spawn: func(index: s32) -> tuple<s32, s32, s32>;

    /// Teardown rules owned by the mod.
    /// 1 if this voxel type can become physical debris when fractured.
    can-fracture: func(voxel-type: s32) -> s32;
    /// Chebyshev radius of collapse around a broken voxel of this type.
    fracture-spread: func(voxel-type: s32) -> s32;
    /// Impulse applied to spawned debris for an action type.
    debris-impulse: func(action-type: s32) -> f32;

    /// Passive tick owned by the mod (wanted-level decay, etc.). `dt-ms` is elapsed millis.
    mod-tick: func(current-state: s32, dt-ms: s32) -> s32;
    /// 1 if this agent type should leave given the current mod state.
    should-despawn-agent: func(agent-type: s32, current-state: s32) -> s32;

    /// Ambient civilians / NPCs the mod wants at load (x, y, z, agent-type).
    ambient-agent-count: func() -> s32;
    ambient-agent-spawn: func(index: s32) -> tuple<s32, s32, s32, s32>;

    /// Human-readable material name. `locale` is a BCP-47 tag (en, mi, fr, zh-TW).
    voxel-label: func(voxel-type: s32, locale: string) -> string;

    /// Mod-owned wallet / score after this action. `extra` is payout or loot type.
    /// action-type: 5=AcceptContract, 6=CompleteContract, 7=FenceLoot
    mod-wallet-after: func(action-type: s32, current-wallet: s32, extra: s32) -> s32;
    /// Offered contract (kind, payout, danger). kind 0 = none.
    mod-offer-contract: func(player-state: s32) -> tuple<s32, s32, s32>;
    /// 1 if this verb is legal given current state + contract (kind, danger).
    mod-can-complete: func(action-type: s32, player-state: s32, contract-kind: s32, contract-danger: s32) -> s32;
    /// Accessibility / log label for a story or contract id.
    event-label: func(event-id: s32, locale: string) -> string;
    /// Name of a contract kind (0 = none) in the given locale.
    contract-label: func(kind: s32, locale: string) -> string;
    /// Comma-separated locales this mod ships, e.g. "en,mi,fr,zh-TW".
    supported-locales: func() -> string;
}

world plugin {
    export gameplay;
}
