{
  lib,
  buildGoModule,
  fetchFromGitHub,
  fetchNpmDeps,
  nodejs_22,
  python3,
  runCommand,
  stdenvNoCC,
  writeShellApplication,
}:

let
  version = "0.6.10";

  src = fetchFromGitHub {
    owner = "songquanpeng";
    repo = "one-api";
    rev = "v${version}";
    hash = "sha256-az+nkjrTWTHH7CH7BjzBC2Sp8Im803zhURFBKkPk/XM=";
  };

  themes = [
    "default"
    "berry"
    "air"
  ];

  # Upstream does not commit npm lockfiles (its Dockerfile runs `npm install`),
  # so locks/<theme>/package-lock.json are generated by update.py and committed
  # here.  fetchNpmDeps needs a lockfile to prefetch reproducibly.
  frontendSrc =
    theme:
    runCommand "one-api-${theme}-frontend-src" { } ''
      mkdir -p $out
      cp ${src}/web/${theme}/package.json $out/package.json
      cp ${./locks}/${theme}/package-lock.json $out/package-lock.json
    '';

  npmDepsHashes = {
    default = "sha256-hn/nchkbb8+7aFtjbcS19b7gK2yYww2c3IW6wSjE5Io=";
    berry = "sha256-aentRD/R43MwbUDUEpRb20OucQLOazuHRPKeeR2yWdM=";
    air = "sha256-FMnMxRarbAeRbsCJ/srkUIuZFzGZRnetubFxI65+Oas=";
  };

  npmDepsFor =
    theme:
    fetchNpmDeps {
      name = "one-api-${theme}-npm-deps";
      src = frontendSrc theme;
      hash = npmDepsHashes.${theme};
    };

  # The three React themes are built separately: buildGoModule's goModules
  # derivation inherits preBuild/postPatch but not configure hooks, so keeping
  # the frontend out of the package expression keeps the vendor fetch cheap.
  webAssets = stdenvNoCC.mkDerivation {
    pname = "one-api-web-assets";
    inherit version src;

    nativeBuildInputs = [ nodejs_22 ];

    postPatch = lib.concatMapStringsSep "\n" (
      theme: "cp ${./locks}/${theme}/package-lock.json web/${theme}/package-lock.json"
    ) themes;

    dontConfigure = true;

    buildPhase = ''
      runHook preBuild

      buildTheme() {
        local theme="$1"
        local deps="$2"
        local cache="$TMPDIR/npm-cache-$theme"

        echo "building one-api web theme: $theme"

        # fetchNpmDeps output is a read-only npm cache; npm insists on writing
        # its log/_update-notifier files there, so use a writable copy.
        cp -r "$deps" "$cache"
        chmod -R u+w "$cache"

        pushd "web/$theme"
        npm_config_cache="$cache" \
          npm_config_offline=true \
          npm_config_progress=false \
          npm ci --ignore-scripts --no-audit --no-fund

        # npm's bin shims start with #!/usr/bin/env, which does not exist in the
        # build sandbox (the npmConfigHook does the same).
        patchShebangs node_modules

        # CI=false: react-scripts treats warnings as errors when CI is set.
        # GENERATE_SOURCEMAP=false: do not ship upstream source in the binary.
        CI=false \
          DISABLE_ESLINT_PLUGIN=true \
          GENERATE_SOURCEMAP=false \
          REACT_APP_VERSION=v${version} \
          npm run build
        popd
      }

      # Upstream's per-theme build script moves react-scripts' output to
      # ../build/<theme>, so the whole web/build tree is what gets embedded.
      rm -rf web/build
      mkdir -p web/build

      buildTheme default ${npmDepsFor "default"}
      buildTheme berry ${npmDepsFor "berry"}
      buildTheme air ${npmDepsFor "air"}

      runHook postBuild
    '';

    installPhase = ''
      runHook preInstall
      mkdir -p $out
      cp -r web/build $out/build
      runHook postInstall
    '';
  };
in
buildGoModule (finalAttrs: {
  pname = "one-api";
  inherit version src;

  vendorHash = "sha256-ZhS7rhAUilYq5LlgdVmfYvgJZvA+fLMNInOfrVe2fsI=";

  # Storage is SQLite through mattn/go-sqlite3, which is a cgo package.
  env.CGO_ENABLED = "1";

  # configurePhase runs postConfigure, and goModules does not inherit it, so
  # the vendor fetch never builds or copies the web UI.
  postConfigure = ''
    rm -rf web/build
    cp -r ${webAssets}/build web/build
  '';

  ldflags = [
    "-s"
    "-w"
    "-X"
    "github.com/songquanpeng/one-api/common.Version=v${version}"
  ];

  # Every test in common/image downloads its fixtures from upload.wikimedia.org,
  # which the build sandbox cannot do.  Skip those four tests instead of
  # disabling checks for the whole package.
  checkFlags = [
    "-skip"
    "^(TestDecode|TestBase64|TestGetImageSize|TestGetImageSizeFromBase64)$"
  ];

  passthru = {
    # Used by update.py to re-pin hashes without rebuilding the frontends.
    inherit (finalAttrs) goModules;
    npmDeps = lib.genAttrs themes npmDepsFor;
    updateScript = writeShellApplication {
      name = "update-one-api";
      runtimeInputs = [
        nodejs_22
        python3
      ];
      text = "exec python3 ${./update.py} \"$@\"";
    };
  };

  meta = {
    description = "LLM API gateway and key management service with an OpenAI-compatible API";
    homepage = "https://github.com/songquanpeng/one-api";
    downloadPage = "https://github.com/songquanpeng/one-api/releases";
    changelog = "https://github.com/songquanpeng/one-api/releases/tag/v${version}";
    license = lib.licenses.mit;
    mainProgram = "one-api";
    sourceProvenance = with lib.sourceTypes; [ fromSource ];
    maintainers = with lib.maintainers; [ ];
    platforms = [
      "x86_64-linux"
      "aarch64-linux"
      "x86_64-darwin"
      "aarch64-darwin"
    ];
  };
})
