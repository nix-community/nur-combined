+async function makeWritable(dirPath: string): Promise<void> {
+  await fs.chmod(dirPath, 0o755);
+  for (const entry of await fs.readdir(dirPath, { withFileTypes: true })) {
+    // Do not follow the node_modules symlink into the Nix store.
+    if (entry.isSymbolicLink()) continue;
+    const entryPath = path.join(dirPath, entry.name);
+    if (entry.isDirectory()) {
+      await makeWritable(entryPath);
+    } else {
+      const mode = (await fs.stat(entryPath)).mode;
+      const isExecutable = (mode & 0o111) !== 0;
+      await fs.chmod(entryPath, isExecutable ? 0o755 : 0o644);
+    }
+  }
+}
