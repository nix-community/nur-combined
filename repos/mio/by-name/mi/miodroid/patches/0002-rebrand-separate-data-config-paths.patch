From: miodroid contributors
Date: 2026-10-03
Subject: [PATCH 0002] rebrand: separate data/config paths from waydroid

Store all runtime and user data under miodroid-specific paths so the
two daemons can coexist on the same system:

  System work dir:  /var/lib/waydroid  -> /var/lib/miodroid
  User state dir:   ~/.local/share/waydroid -> ~/.local/share/miodroid
  Config file:      /var/lib/waydroid/waydroid.cfg -> /var/lib/miodroid/miodroid.cfg
  Pre-installed:    /etc/waydroid-extra   -> /etc/miodroid-extra
                    /usr/share/waydroid-extra -> /usr/share/miodroid-extra
  Channels config:  /usr/share/waydroid-extra/channels.cfg -> /usr/share/miodroid-extra/channels.cfg
  LXC container:    waydroid -> miodroid
  Log file path:    /var/lib/waydroid/waydroid.log -> /var/lib/miodroid/miodroid.log
  AppArmor profile: lxc-waydroid -> lxc-miodroid

--- a/tools/config/__init__.py
+++ b/tools/config/__init__.py
@@ -30,7 +30,7 @@ config_keys = ["arch",
 # overridden on the commandline)
 defaults = {
     "arch": "arm64",
-    "work": "/var/lib/waydroid",
+    "work": "/var/lib/miodroid",
     "vendor_type": "MAINLINE",
     "system_datetime": "0",
     "vendor_datetime": "0",
     "preinstalled_images_paths": [
-        "/etc/waydroid-extra/images",
-        "/usr/share/waydroid-extra/images",
+        "/etc/miodroid-extra/images",
+        "/usr/share/miodroid-extra/images",
     ],
     "suspend_action": "freeze",
     "mount_overlays": "True",
     "auto_adb": "False",
     "container_xdg_runtime_dir": "/run/xdg",
     "container_wayland_display": "wayland-0",
 }
-defaults["images_path"] = defaults["work"] + "/images"
-defaults["rootfs"] = defaults["work"] + "/rootfs"
-defaults["overlay"] = defaults["work"] + "/overlay"
-defaults["overlay_rw"] = defaults["work"] + "/overlay_rw"
-defaults["overlay_work"] = defaults["work"] + "/overlay_work"
-defaults["data"] = defaults["work"] + "/data"
-defaults["lxc"] = defaults["work"] + "/lxc"
-defaults["host_perms"] = defaults["work"] + "/host-permissions"
+defaults["images_path"] = defaults["work"] + "/images"
+defaults["rootfs"] = defaults["work"] + "/rootfs"
+defaults["overlay"] = defaults["work"] + "/overlay"
+defaults["overlay_rw"] = defaults["work"] + "/overlay_rw"
+defaults["overlay_work"] = defaults["work"] + "/overlay_work"
+defaults["data"] = defaults["work"] + "/data"
+defaults["lxc"] = defaults["work"] + "/lxc"
+defaults["host_perms"] = defaults["work"] + "/host-permissions"
 defaults["container_pulse_runtime_path"] = defaults["container_xdg_runtime_dir"] + "/pulse"
 
 session_defaults = {
@@ -58,14 +58,14 @@ session_defaults = {
     "state": "STOPPED",
     "lcd_density": "0",
     "background_start": "true"
 }
-session_defaults["waydroid_user_state"] = session_defaults["xdg_data_home"] + "/waydroid"
-session_defaults["waydroid_data"] = session_defaults["waydroid_user_state"] + "/data"
+session_defaults["waydroid_user_state"] = session_defaults["xdg_data_home"] + "/miodroid"
+session_defaults["waydroid_data"] = session_defaults["waydroid_user_state"] + "/data"
 if session_defaults["pulse_runtime_path"] == "None":
     session_defaults["pulse_runtime_path"] = session_defaults["xdg_runtime_dir"] + "/pulse"
 
 channels_defaults = {
-    "config_path": "/usr/share/waydroid-extra/channels.cfg",
+    "config_path": "/usr/share/miodroid-extra/channels.cfg",
     "system_channel": "https://ota.waydro.id/system",
     "vendor_channel": "https://ota.waydro.id/vendor",
     "rom_type": "lineage",
     "system_type": "VANILLA"
 }

--- a/tools/helpers/arguments.py
+++ b/tools/helpers/arguments.py
@@ -1,7 +1,7 @@
 # (in arguments() function, --work default and --config default)
     parser.add_argument("-w", "--work", dest="work",
-                        default="/var/lib/waydroid",
-                        help="main work directory (default: /var/lib/waydroid)")
+                        default="/var/lib/miodroid",
+                        help="main work directory (default: /var/lib/miodroid)")
     # config path derived from work in tools/__init__.py after parse
