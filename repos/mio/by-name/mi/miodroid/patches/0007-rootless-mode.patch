diff --git a/tools/helpers/rootless.py b/tools/helpers/rootless.py
--- a/tools/helpers/rootless.py	1970-01-01 10:00:00.000000000 +1000
+++ b/tools/helpers/rootless.py	2026-10-06 16:13:33.405627115 +1100
@@ -0,0 +1,186 @@
+import tools.helpers.run
+
+import logging
+import os
+import pwd
+import shutil
+import stat
+import hashlib
+
+def _run(args, command, check=True):
+    return tools.helpers.run.user(args, command, check=check)
+
+def _ismount(path):
+    path = os.path.realpath(path)
+    with open("/proc/mounts") as mounts:
+        return any(len(words) >= 2 and words[1] == path
+                   for words in (line.split() for line in mounts))
+
+def _grow(args, path):
+    """Give a cached image some free space.
+
+    The OTA images are shipped with no free blocks at all, and the "grow"
+    image strategy mounts the image itself read-write (there is no overlay
+    to absorb writes), so Android cannot even create /mnt/user. Growing the
+    cache copy once is enough.
+    """
+    if os.environ.get("WAYDROID_NO_IMAGE_GROWTH"):
+        return
+    marker = path + ".grown"
+    if os.path.exists(marker):
+        return
+    with open(path, "rb+") as image:
+        image.truncate(os.path.getsize(path) + 1024 * 1024 * 1024)
+    _run(args, ["resize2fs", path])
+    open(marker, "w").close()
+
+def _fusermount():
+    """Locate a usable fusermount3.
+
+    libfuse looks the helper up in /run/wrappers/bin (the store copy
+    is not setuid, and /nix/store is mounted nosuid), so resolving it
+    through PATH from the wrapped waydroid can find a binary that
+    cannot unmount anything.
+    """
+    for candidate in ("/run/wrappers/bin/fusermount3", "fusermount3"):
+        path = shutil.which(candidate)
+        if path:
+            return path
+    raise RuntimeError("fusermount3 is required for rootless mode")
+
+def _subid_range(path, uid, name):
+    """First subordinate id range for the user in an /etc/subuid
+    style file, as (start, count). NixOS writes the account name,
+    other systems may write the numeric id."""
+    try:
+        with open(path) as subids:
+            for line in subids:
+                fields = line.split(":")
+                if len(fields) == 3 and fields[0] in (name, str(uid)):
+                    return int(fields[1]), int(fields[2])
+    except (OSError, ValueError):
+        pass
+    return 100000, 65536
+
+def write_lxc_idmap(lxc_path):
+    """Write the rootless idmap and rootfs lines to a container config.
+
+    The container's root is mapped to the invoking user: that is the
+    only account the unprivileged fuse2fs/fuse-overlayfs mounts can
+    hand to the container, and it is the only account that may
+    traverse the paths waydroid has to bind into it (XDG_RUNTIME_DIR,
+    the work directory, the user's home). The remaining container ids
+    come from the account's own subordinate id ranges.
+    """
+    uid = os.getuid()
+    gid = os.getgid()
+    try:
+        name = pwd.getpwuid(uid).pw_name
+    except KeyError:
+        name = str(uid)
+    subuid, subuid_count = _subid_range("/etc/subuid", uid, name)
+    subgid, subgid_count = _subid_range("/etc/subgid", gid, name)
+    os.makedirs(os.path.join(lxc_path, "rootfs"), exist_ok=True)
+    with open(os.path.join(lxc_path, "config"), "a") as output:
+        output.write("lxc.idmap = u 0 {} 1\n".format(uid))
+        output.write("lxc.idmap = g 0 {} 1\n".format(gid))
+        output.write("lxc.idmap = u 1 {} {}\n".format(
+            subuid, min(subuid_count, 65535)))
+        output.write("lxc.idmap = g 1 {} {}\n".format(
+            subgid, min(subgid_count, 65535)))
+        output.write("lxc.rootfs.mount = {}/rootfs\n".format(lxc_path))
+
+def bind(args, source, destination, create_folders=True, umount=False):
+    if os.path.isdir(source):
+        if create_folders:
+            os.makedirs(destination, exist_ok=True)
+        shutil.copytree(source, destination, dirs_exist_ok=True)
+        return
+    bind_file(args, source, destination, create_folders)
+
+def bind_file(args, source, destination, create_folders=False):
+    os.makedirs(os.path.dirname(destination), exist_ok=True)
+    shutil.copy2(source, destination)
+
+def mount(args, source, destination, create_folders=True, umount=False,
+          readonly=True, mount_type=None, options=None, force=True):
+    # A run that died without stopping the container leaves its mounts
+    # behind; replacing them keeps "start" from stacking a second mount on a
+    # path that is already mounted.
+    if _ismount(destination) and (umount or mount_type == "overlay"):
+        umount_all(args, destination)
+    os.makedirs(destination, exist_ok=True)
+    if source.endswith(".img"):
+        with open(source, "rb") as image:
+            is_sparse = image.read(4) == b"\x3a\xff\x26\xed"
+        cache_dir = os.path.join(
+            os.environ.get("WAYDROID_WORK", "/tmp"),
+            "raw-images")
+        os.makedirs(cache_dir, exist_ok=True)
+        cache = os.path.join(
+            cache_dir,
+            hashlib.sha256(os.fsencode(source)).hexdigest() + ".img")
+        if not os.path.exists(cache):
+            if is_sparse:
+                _run(args, ["simg2img", source, cache])
+            else:
+                shutil.copyfile(source, cache)
+        # simg2img and shutil.copyfile can inherit the read-only mode of the
+        # store copy, and both fuse2fs and e2fsck want to open the cache
+        # read-write.
+        os.chmod(cache, os.stat(cache).st_mode | stat.S_IWUSR)
+        if not readonly:
+            # Only a read-write image can be left inconsistent or full, so
+            # the fsck and the one-off growth belong to that case alone: a
+            # read-only image gets its writes from the overlay above it.
+            status = _run(args, ["e2fsck", "-fy", cache], check=False)
+            if status not in (0, 1, 2):
+                raise RuntimeError(
+                    "e2fsck failed for rootless image: " + source)
+            _grow(args, cache)
+        source = cache
+        mount_options = ["fakeroot"]
+        mount_options.append("ro" if readonly else "rw")
+        if os.environ.get("WAYDROID_ROOTLESS"):
+            mount_options.append("allow_other")
+        command = ["fuse2fs", "-o", ",".join(mount_options),
+                   source, destination]
+    elif mount_type == "overlay":
+        command = ["fuse-overlayfs"]
+        if options:
+            opts = options.copy()
+            if os.environ.get("WAYDROID_ROOTLESS"):
+                # The container's root is mapped to the invoking user
+                # (see write_lxc_idmap), so that account is the only
+                # owner the daemon can give files it creates: it has
+                # no CAP_CHOWN for any other id. The extra one-id
+                # mapping keeps the image's root-owned files (uid 0)
+                # looking like the container's root.
+                uid = os.getuid()
+                gid = os.getgid()
+                opts.append("uidmapping={0}:0:65536,{0}:{0}:1".format(uid))
+                opts.append("gidmapping={0}:0:65536,{0}:{0}:1".format(gid))
+                opts.append("allow_other")
+            command += ["-o", ",".join(opts)]
+        command.append(destination)
+    else:
+        raise RuntimeError(
+            "Rootless mode cannot mount {} at {}; use a rootful helper"
+            .format(source, destination))
+    _run(args, command)
+    if not _ismount(destination):
+        raise RuntimeError("Rootless mount failed: " + destination)
+
+def umount_all(args, folder):
+    folder = os.path.realpath(folder)
+    with open("/proc/mounts") as mounts:
+        paths = sorted(
+            (words[1] for words in (line.split() for line in mounts)
+             if len(words) >= 2 and
+             (words[1] == folder or words[1].startswith(folder + "/"))),
+            reverse=True)
+    if not paths:
+        return
+    fusermount = _fusermount()
+    for path in paths:
+        _run(args, [fusermount, "-u", path])
