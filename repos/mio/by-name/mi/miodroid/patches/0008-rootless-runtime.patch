-LXC_NETWORK="192.168.${NET_ID}.0/24"
-LXC_DHCP_RANGE="192.168.${NET_ID}.16,192.168.${NET_ID}.254"
+LXC_NETWORK="172.29.${NET_ID}.0/24"
+LXC_DHCP_RANGE="172.29.${NET_ID}.2,172.29.${NET_ID}.254"
+# Detect hash collisions or a host network using the selected subnet.
+if [ "$1" = "start" ] && ip -4 route show exact "$LXC_NETWORK" | grep -qv "dev $LXC_BRIDGE "; then
+    echo "Miodroid subnet $LXC_NETWORK is already in use; choose a different instance name" >&2
+    exit 1
+fi
