+"""Forward desktop sockets without changing their access permissions.
+
+SCM_RIGHTS forwarding is required by Wayland (buffers/keymaps) and PulseAudio
+(shared memory). The public end is only exposed inside the Android container;
+its parent directory remains private to the desktop user.
+"""
+import array
+import os
+import socket
+import threading
+
+
+class Proxy:
+    def __init__(self, source, destination):
+        self.source = source
+        self.connections = set()
+        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.listener.bind(destination)
+        os.chmod(destination, 0o666)
+        self.listener.listen(16)
+        threading.Thread(target=self.accept, daemon=True).start()
+
+    def accept(self):
+        while True:
+            try:
+                client, _ = self.listener.accept()
+                upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+                upstream.connect(self.source)
+            except OSError:
+                if 'client' in locals():
+                    client.close()
+                return
+            self.connections.update((client, upstream))
+            for reader, writer in ((client, upstream), (upstream, client)):
+                threading.Thread(target=self.forward, args=(reader, writer), daemon=True).start()
+
+    def forward(self, reader, writer):
+        try:
+            while True:
+                data, ancillary, flags, _ = reader.recvmsg(65536, socket.CMSG_SPACE(256 * 4))
+                descriptors = []
+                for level, kind, value in ancillary:
+                    if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
+                        fds = array.array('i')
+                        fds.frombytes(value[:len(value) - len(value) % fds.itemsize])
+                        descriptors.extend(fds)
+                try:
+                    if flags & socket.MSG_CTRUNC:
+                        raise OSError("Truncated desktop socket descriptors")
+                    if not data:
+                        break
+                    rights = [(level, kind, value) for level, kind, value in ancillary
+                              if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS]
+                    sent = writer.sendmsg([data], rights)
+                    writer.sendall(data[sent:])
+                finally:
+                    for fd in descriptors:
+                        os.close(fd)
+        except OSError:
+            pass
+        finally:
+            for connection in (reader, writer):
+                try:
+                    connection.shutdown(socket.SHUT_RDWR)
+                except OSError:
+                    pass
+                connection.close()
+                self.connections.discard(connection)
+
+    def close(self):
+        self.listener.close()
+        for connection in tuple(self.connections):
+            try:
+                connection.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            connection.close()
+
+
+def start(args, session):
+    import tempfile
+    import shutil
+    runtime = session['xdg_runtime_dir']
+    directory = tempfile.mkdtemp(prefix='miodroid-sockets-', dir=runtime)
+    args.socket_proxy_directory = directory
+    args.socket_proxies = []
+    wayland = session['wayland_display']
+    if not os.path.isabs(wayland):
+        wayland = os.path.join(runtime, wayland)
+    args.socket_proxies.append(Proxy(wayland, directory + '/wayland'))
+    session['wayland_display'] = directory + '/wayland'
+    pulse = os.path.join(session['pulse_runtime_path'], 'native')
+    if os.path.exists(pulse):
+        args.socket_proxies.append(Proxy(pulse, directory + '/native'))
+        session['pulse_runtime_path'] = directory
+
+
+def stop(args):
+    import shutil
+    for proxy in getattr(args, 'socket_proxies', []):
+        proxy.close()
+    directory = getattr(args, 'socket_proxy_directory', None)
+    if directory:
+        shutil.rmtree(directory, ignore_errors=True)
