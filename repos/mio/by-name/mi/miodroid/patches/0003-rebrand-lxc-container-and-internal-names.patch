From: miodroid contributors
Date: 2026-10-03
Subject: [PATCH 0003] rebrand: rename LXC container name and internal paths

Rename the LXC container from "waydroid" to "miodroid", the AppArmor
profile from "lxc-waydroid" to "lxc-miodroid", and fix the config/log
filenames under the work directory.

Ensures no LXC or AppArmor name collision with upstream waydroid.

--- a/tools/__init__.py
+++ b/tools/__init__.py
@@ -17,8 +17,8 @@ def prep_args(args):
     args.cache = {}
     args.work = config.defaults["work"]
-    args.config = args.work + "/waydroid.cfg"
-    args.log = args.work + "/waydroid.log"
+    args.config = args.work + "/miodroid.cfg"
+    args.log = args.work + "/miodroid.log"
     args.sudo_timer = True
     args.timeout = 1800
 
@@ -40,7 +40,7 @@ def main():
         elif not os.path.exists(args.log):
             args.log = "/tmp/tools.log"
 
-        if not actions.initializer.is_initialized(args) and \
-                args.action not in ("init", "container", "first-launch", "log", "bugreport"):
-            print('Waydroid is not initialized, run "waydroid init"')
+        if not actions.initializer.is_initialized(args) and \
+                args.action not in ("init", "container", "first-launch", "log", "bugreport"):
+            print('Miodroid is not initialized, run "miodroid init"')
             return 0
 
--- a/tools/helpers/lxc.py
+++ b/tools/helpers/lxc.py
@@ -129,7 +129,7 @@ def get_lxc_version(args):
-LXC_APPARMOR_PROFILE = "lxc-waydroid"
+LXC_APPARMOR_PROFILE = "lxc-miodroid"
 
 @@ -144,9 +144,9 @@ def setup_lxc_config(args):
-    lxc_path = tools.config.defaults["lxc"] + "/waydroid"
+    lxc_path = tools.config.defaults["lxc"] + "/miodroid"
 
 @@ -149,3 +149,3 @@ def setup_lxc_config(args):
-    seccomp_profile = tools.config.tools_src + "/data/configs/waydroid.seccomp"
+    seccomp_profile = tools.config.tools_src + "/data/configs/waydroid.seccomp"
 
 @@ -167,3 +167,3 @@ def setup_lxc_config(args):
-    command = ["cp", "-fpr", seccomp_profile, lxc_path + "/waydroid.seccomp"]
+    command = ["cp", "-fpr", seccomp_profile, lxc_path + "/miodroid.seccomp"]
 
 @@ -212,3 +212,3 @@ def generate_nodes_lxc_config(args):
-    lxc_path = tools.config.defaults["lxc"] + "/waydroid"
+    lxc_path = tools.config.defaults["lxc"] + "/miodroid"
 
 @@ -348,3 +348,3 @@ def write_lxc_config(args):
-    with open(args.work + "/waydroid_base.prop", "w") as f:
+    with open(args.work + "/miodroid_base.prop", "w") as f:
 
 @@ -381,3 +381,3 @@ def get_container_state(args):
-    command = ["lxc-info", "-P", tools.config.defaults["lxc"], "-n", "waydroid", "-sH"]
+    command = ["lxc-info", "-P", tools.config.defaults["lxc"], "-n", "miodroid", "-sH"]
 
 @@ -402,3 +402,3 @@ def start_lxc_container(args):
-               "-F", "-n", "waydroid", "--", "/init"]
+               "-F", "-n", "miodroid", "--", "/init"]
 
 @@ -411,3 +411,3 @@ def stop_lxc_container(args):
-               tools.config.defaults["lxc"], "-n", "waydroid", "-k"]
+               tools.config.defaults["lxc"], "-n", "miodroid", "-k"]
 
 @@ -415,3 +415,3 @@ def freeze_lxc_container(args):
-    command = ["lxc-freeze", "-P", tools.config.defaults["lxc"], "-n", "waydroid"]
+    command = ["lxc-freeze", "-P", tools.config.defaults["lxc"], "-n", "miodroid"]
 
 @@ -420,3 +420,3 @@ def unfreeze_lxc_container(args):
-               tools.config.defaults["lxc"], "-n", "waydroid"]
+               tools.config.defaults["lxc"], "-n", "miodroid"]
 
 @@ -439,3 +439,3 @@ def run_in_lxc_container(args):
-               "-n", "waydroid", "--clear-env", "--",
+               "-n", "miodroid", "--clear-env", "--",
 
 @@ -461,3 +461,3 @@ def attach_to_lxc_container(args):
-               "-n", "waydroid", "--clear-env"
+               "-n", "miodroid", "--clear-env"
 
--- a/data/configs/apparmor_profiles/lxc-waydroid
+++ b/data/configs/apparmor_profiles/lxc-miodroid
