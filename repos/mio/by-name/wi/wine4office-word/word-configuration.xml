<?xml version="1.0" encoding="utf-8"?>
<!--
  Office Deployment Tool configuration used by wine4office-install-word.

  Installs 64-bit Microsoft 365 Apps but excludes every application except
  Word. Replace the Product ID (e.g. "WordRetail" for a standalone Word
  licence, or "O365BusinessRetail") and the Channel to match your licence, or
  pass your own file with the configuration option of
  wine4office-install-word.
-->
<Configuration ID="wine4office-word">
  <Add OfficeClientEdition="64" Channel="Current">
    <Product ID="O365ProPlusRetail">
      <Language ID="MatchOS" Fallback="en-us" />
      <ExcludeApp ID="Access" />
      <ExcludeApp ID="Bing" />
      <ExcludeApp ID="Excel" />
      <ExcludeApp ID="Groove" />
      <ExcludeApp ID="Lync" />
      <ExcludeApp ID="OneDrive" />
      <ExcludeApp ID="OneNote" />
      <ExcludeApp ID="Outlook" />
      <ExcludeApp ID="OutlookForWindows" />
      <ExcludeApp ID="PowerPoint" />
      <ExcludeApp ID="Publisher" />
      <ExcludeApp ID="Teams" />
    </Product>
  </Add>
  <Display Level="None" AcceptEULA="TRUE" />
  <Property Name="PinIconsToTaskbar" Value="FALSE" />
</Configuration>
