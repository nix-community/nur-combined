+// Ladybird has no extension store, so a small built-in list of per-site user scripts is injected into matching
+// documents after they load. Each script is a plain resource shipped in `resource://ladybird/user-scripts`.
+static bool is_youtube_document(URL::URL const& url)
+{
+    if (url.scheme() != "http"sv && url.scheme() != "https"sv)
+        return false;
+
+    auto host = url.serialized_host();
+    return host == "youtube.com"sv || host.ends_with(".youtube.com"sv);
+}
+
+static ErrorOr<String> load_site_user_script(StringView filename)
+{
+    auto resource = TRY(Core::Resource::load_from_uri(TRY(String::formatted("resource://ladybird/user-scripts/{}", filename))));
+    auto data = resource->data();
+    return String::from_utf8_with_replacement_character(StringView { data });
+}
+
+void PageClient::maybe_inject_site_user_scripts(Web::DOM::Document& document)
+{
+    if (!document.is_fully_active())
+        return;
+
+    if (!is_youtube_document(document.url()))
+        return;
+
+    auto document_id = document.unique_id().value();
+    if (m_documents_with_injected_user_scripts.contains(document_id))
+        return;
+    if (m_documents_with_pending_user_script_injection.contains(document_id))
+        return;
+
+    auto script_or_error = load_site_user_script("yt-mirror.js"sv);
+    if (script_or_error.is_error()) {
+        dbgln("Failed to load site user script: {}", script_or_error.error());
+        return;
+    }
+
+    m_documents_with_pending_user_script_injection.set(document_id);
+
+    // Queue a task rather than running immediately: this is invoked from within the document's load algorithm, and
+    // running script re-entrantly there is not safe.
+    Web::HTML::queue_a_task(Web::HTML::Task::Source::Unspecified, nullptr, document,
+        GC::create_function(heap(), [page_client = GC::Ref { *this }, document = GC::Ref { document }, source = script_or_error.release_value()]() {
+            page_client->run_site_user_script(document, source, "yt-mirror.js"sv);
+        }));
+}
+
+void PageClient::run_site_user_script(Web::DOM::Document& document, String const& source, StringView label)
+{
+    m_documents_with_pending_user_script_injection.remove(document.unique_id().value());
+
+    if (!document.is_fully_active())
+        return;
+
+    m_documents_with_injected_user_scripts.set(document.unique_id().value());
+
+    auto& settings = document.relevant_settings_object();
+    auto base_url = settings.api_base_url();
+    auto script_source = Utf16String::from_utf8(source);
+
+    auto script = Web::HTML::ClassicScript::create(ByteString::formatted("(site user script: {})", label), script_source, settings, move(base_url));
+    auto evaluation_status = script->run();
+
+    if (evaluation_status.is_error())
+        dbgln("Site user script '{}' threw an exception", label);
+}
+
 void PageClient::did_output_js_console_message(WebView::ConsoleOutput console_output)
 {
     client().async_did_output_js_console_message(m_id, move(console_output));
