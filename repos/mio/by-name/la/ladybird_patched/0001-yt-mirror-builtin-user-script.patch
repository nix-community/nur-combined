+// YT Mirror — in-browser port of the "YT Mirror" extension for Ladybird.
+//
+// Adds a "Mirror" button to the YouTube player that flips the video (and Shorts)
+// horizontally with one click. Ladybird has no extension store, so this script is
+// injected into matching pages by the WebContent process (see PageClient).
+//
+// Mirrored from the Chrome extension at
+// https://chromewebstore.google.com/detail/yt-mirror/nokjcgeafjfhlbclmmgfeiiebgjfollb
+
+(function () {
+  "use strict";
+
+  const oldSvgPath =
+    "M 12.99 16.5 L 9 20.5 l 3.99 4 v -3 H 20 v -2 H 12.99 v -3 z M 27 14.5 l -3.99 -4 v 3 H 16 v 2 h 7.01 v 3 L 27 14.5 z";
+  const newSvgPath =
+    "M5.32 10.1429L0 15.5714L5.32 21V16.9286H14.6667V14.2143H5.32V10.1429ZM24 7.42857L18.68 2V6.07143H9.33333V8.78571H18.68V12.8571L24 7.42857Z";
+
+  const mirror = {
+    state: false,
+    videoButton: null,
+    shortButton: null,
+    styleSheet: null,
+
+    isNewUI() {
+      return !!document.querySelector(".ytp-right-controls-left");
+    },
+
+    embedVideoButton() {
+      if (mirror.videoButton || !document.querySelector(".ytp-right-controls")) return;
+      if (mirror.isNewUI()) mirror.embedVideoButtonNew();
+      else mirror.embedVideoButtonOld();
+    },
+
+    embedVideoButtonOld() {
+      const button = document.createElement("button");
+      button.classList.add("ytp-button");
+      button.style.height = "100%";
+      button.style.width = "56px";
+      button.title = "YT Mirror";
+      button.addEventListener("click", mirror.toggle);
+      button.innerHTML = `
+    <svg height="100%" version="1.1" viewBox="0 0 36 36" width="100%" fill-opacity="1">
+      <use class="ytp-svg-shadow" href="#ytp-mirror-button-path"></use>
+      <path d="${oldSvgPath}" fill="white" id="ytp-mirror-button-path"></path>
+    </svg>
+    `;
+      mirror.videoButton = button;
+      document.querySelector(".ytp-right-controls").prepend(button);
+    },
+
+    embedVideoButtonNew() {
+      const button = document.createElement("button");
+      button.classList.add("ytp-button");
+      button.title = "YT Mirror";
+      button.setAttribute("data-tooltip-title", "YT Mirror");
+      button.setAttribute("aria-expanded", "false");
+      button.setAttribute("aria-haspopup", "false");
+      button.addEventListener("click", mirror.toggle);
+      button.innerHTML = `
+    <svg fill="none" height="24" viewBox="0 0 24 24" width="24">
+      <use class="ytp-svg-shadow" href="#ytp-mirror-button-path"></use>
+      <path d="${newSvgPath}" fill="white" id="ytp-mirror-button-path"></path>
+    </svg>
+    `;
+      mirror.videoButton = button;
+      document
+        .querySelector(".ytp-right-controls")
+        .querySelector(".ytp-right-controls-left")
+        .prepend(button);
+    },
+
+    embedShortButton() {
+      if (mirror.shortButton || !document.querySelector(".navigation-container")) return;
+
+      const navigationButton = document.createElement("div");
+      navigationButton.classList.add("navigation-button", "style-scope", "ytd-shorts");
+      navigationButton.style.position = "absolute";
+      navigationButton.style.top = "unset";
+      navigationButton.style.bottom = "30px";
+
+      const button = document.createElement("button");
+      button.classList.add(
+        "yt-spec-button-shape-next",
+        "yt-spec-button-shape-next--tonal",
+        "yt-spec-button-shape-next--mono",
+        "yt-spec-button-shape-next--size-xl",
+        "yt-spec-button-shape-next--icon-button"
+      );
+      button.title = "YT Mirror";
+      button.addEventListener("click", mirror.toggle);
+      button.innerHTML = `
+    <svg height="100%" version="1.1" viewBox="0 0 36 36" width="100%" fill-opacity="1">
+      <use class="ytp-svg-shadow" href="#ytp-mirror-button-path"></use>
+      <path d="${oldSvgPath}" fill="#FFFFFF" id="ytp-mirror-button-path"></path>
+    </svg>
+    `;
+
+      navigationButton.appendChild(button);
+      mirror.shortButton = button;
+      document.querySelector(".navigation-container").prepend(navigationButton);
+    },
+
+    changeButtonColor() {
+      // Match the extension: yellow while the mirror is being turned on, white while it is being turned off.
+      const fill = mirror.state ? "#FFFFFF" : "#fbff12";
+      for (const button of [mirror.videoButton, mirror.shortButton]) {
+        if (!button) continue;
+        const path = button.querySelector("svg path");
+        if (path) path.style.fill = fill;
+      }
+    },
+
+    flipPlayer() {
+      if (mirror.state) {
+        if (mirror.styleSheet && mirror.styleSheet.parentNode)
+          mirror.styleSheet.parentNode.removeChild(mirror.styleSheet);
+      } else {
+        const styleSheet = document.createElement("style");
+        styleSheet.type = "text/css";
+        // `scaleX(-1)` on the video container flips the composited video surface.
+        styleSheet.innerText =
+          ".html5-video-container { transform: scaleX(-1) !important; }";
+        mirror.styleSheet = styleSheet;
+        (document.head || document.documentElement).appendChild(styleSheet);
+      }
+    },
+
+    toggle() {
+      mirror.changeButtonColor();
+      mirror.flipPlayer();
+      mirror.state = !mirror.state;
+    },
+
+    ensureButtons() {
+      const path = window.location.pathname;
+      if (path === "/watch" || path.startsWith("/live")) mirror.embedVideoButton();
+      if (path.indexOf("/shorts/") !== -1) mirror.embedShortButton();
+    },
+  };
+
+  function install() {
+    mirror.ensureButtons();
+
+    const observer = new MutationObserver(function () {
+      mirror.ensureButtons();
+    });
+    observer.observe(document.documentElement, { childList: true, subtree: true });
+
+    // YouTube is a single-page app; re-check after in-app navigation settles.
+    setInterval(function () {
+      if (window.location.pathname === "/watch" || window.location.pathname.indexOf("/shorts/") !== -1)
+        mirror.ensureButtons();
+    }, 1000);
+  }
+
+  if (document.readyState === "loading")
+    document.addEventListener("DOMContentLoaded", install, { once: true });
+  else
+    install();
+})();
