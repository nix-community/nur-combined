Our Xcode 26's Swift compiler refuses to type-check the matrix build in
`matrix(outgoing:tint:luminance:)`: the chained concatenation of array literals
whose elements mix `min` and a CGFloat subtraction exceeds the solver budget, so
the Release build fails with "the compiler is unable to type-check this
expression in reasonable time". Assemble the matrix with `append` instead.
--- a/packages/ChatUI/Sources/ChatUI/ChatBubbleWallpaperMaterial.swift
+++ b/packages/ChatUI/Sources/ChatUI/ChatBubbleWallpaperMaterial.swift
@@ -150,10 +150,16 @@
             let rgb = tint.usingColorSpace(.sRGB) ?? tint.usingColorSpace(.deviceRGB) ?? .white
             let bias = 0.17 + 0.1 * light
             let weights: [CGFloat] = [0.08504, 0.28608, 0.02888, 0]
-            return weights + [min(0.97, rgb.redComponent) - bias]
-                + weights + [min(0.97, rgb.greenComponent) - bias]
-                + weights + [min(0.97, rgb.blueComponent) - bias]
-                + [0, 0, 0, 1, 0]
+            var matrix: [CGFloat] = []
+            matrix.reserveCapacity(20)
+            matrix += weights
+            matrix.append(min(0.97, rgb.redComponent) - bias)
+            matrix += weights
+            matrix.append(min(0.97, rgb.greenComponent) - bias)
+            matrix += weights
+            matrix.append(min(0.97, rgb.blueComponent) - bias)
+            matrix += [0, 0, 0, 1, 0]
+            return matrix
         }
         let index = light * CGFloat(grayBlueWeights.count - 1)
         let lower = Int(index)
