 static volume* volumes = NULL;
 
 /*
+ * Test-only: the reader's messages and its key prompt normally go to Quibble's
+ * graphical console, which a headless test cannot read.  Mirror them to
+ * ConOut, which OVMF also sends to the serial port, so the test can assert on
+ * the key store without OCR.
+ */
+static void
+test_serial(const char* s)
+{
+    CHAR16 w[300];
+    UINTN i = 0;
+
+    if (!systable || !systable->ConOut)
+        return;
+    while (s[i] != 0 && i < 298) {
+        w[i] = (CHAR16)(unsigned char)s[i];
+        i++;
+    }
+    w[i] = 0;
+    systable->ConOut->OutputString(systable->ConOut, w);
+}
+
+/*
  * Typed key at boot.  Firmware console input is the only keyboard the driver
  * has (Quibble's graphical console has no input protocol), so the prompt goes
  * to ConOut and the person at the machine types the passphrase there.  The
@@ -94,6 +116,8 @@
     wbuf[i] = 0;
     systable->ConOut->OutputString(systable->ConOut, wbuf);
 
+    test_serial(prompt);
+
     if (systable->ConIn->Reset)
         systable->ConIn->Reset(systable->ConIn, FALSE);
 
@@ -151,6 +175,7 @@
     if (info_proto)
         info_proto->Print(s);
 #endif
