@@ -2444,6 +2444,18 @@
 		return (error);
 	}
 
+	/*
+	 * The reader does not implement the ZFS key store or AES, so an encrypted
+	 * block cannot be decrypted.  Say so, rather than returning ciphertext
+	 * that fails the checksum and looks like pool corruption.
+	 */
+	if (BP_IS_ENCRYPTED(bp)) {
+		if (print)
+			printf("ZFS: block is encrypted - encrypted datasets are "
+			    "not supported\n");
+		return (ENOTSUP);
+	}
+
