--- a/src/engine/zfsimpl.h	2026-11-28 09:45:48.660345467 +1100
+++ b/src/engine/zfsimpl.h	2026-11-28 09:45:48.724344963 +1100
@@ -391,6 +391,15 @@
 
 #define	BP_IS_EMBEDDED(bp)	BF64_GET((bp)->blk_prop, 39, 1)
 
+/*
+ * Set on every block of an encrypted object, and on the indirect blocks above
+ * it.  The encryption parameters (salt, IV and MAC) then live in block pointer
+ * words that are otherwise padding, unused DVA slots or the fill count (see
+ * OpenZFS's spa.h).  This reader has neither a key store nor AES, so it must
+ * refuse these blocks by this bit instead of reading ciphertext.
+ */
+#define	BP_IS_ENCRYPTED(bp)	BF64_GET((bp)->blk_prop, 61, 1)
+
 #define	BP_GET_DEDUP(bp)	BF64_GET((bp)->blk_prop, 62, 1)
 #define	BP_SET_DEDUP(bp, x)	BF64_SET((bp)->blk_prop, 62, 1, x)
 
