@@ -391,6 +391,16 @@
 
 #define	BP_IS_EMBEDDED(bp)	BF64_GET((bp)->blk_prop, 39, 1)
 
+/*
+ * Set on every block that carries ZFS encryption parameters: encrypted and
+ * authenticated level 0 blocks, and the indirect blocks whose checksum is a
+ * checksum of MACs.  The salt and IV then live in the block pointer words that
+ * would otherwise be the third DVA and the fill count (see OpenZFS's spa.h).
+ * This reader has neither a key store nor AES, so it must refuse these blocks
+ * instead of reading ciphertext.
+ */
+#define	BP_USES_CRYPT(bp)	BF64_GET((bp)->blk_prop, 61, 1)
+
 #define	BP_GET_DEDUP(bp)	BF64_GET((bp)->blk_prop, 62, 1)
 #define	BP_SET_DEDUP(bp, x)	BF64_SET((bp)->blk_prop, 62, 1, x)
 
