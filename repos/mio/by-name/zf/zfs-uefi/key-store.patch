+/*
+ * Hand in the dataset's wrapping key (keyformat=raw: the 32 raw keyfile
+ * bytes).  Must be called before zfse_mount() so the reader can unwrap the
+ * dataset key while opening it.
+ */
+int
+zfse_set_key_provider(zfse_key_provider_fn fn, void* priv)
+{
+    extern void zfs_set_key_provider(zfse_key_provider_fn, void*);
+
+    zfs_set_key_provider(fn, priv);
+    return 0;
+}
+
+int
+zfse_set_wrapping_key(const uint8_t* key, size_t len)
+{
+    extern void zfs_set_wrapping_key(const uint8_t*);
+
+    if (len != 32)
+        return EINVAL;
+    zfs_set_wrapping_key(key);
+    return 0;
+}
