diff --git a/src/zfs.c b/src/zfs.c
index 1888a4a..e87e8f2 100644
--- a/src/zfs.c
+++ b/src/zfs.c
@@ -72,6 +72,70 @@ typedef struct {
 
 static volume* volumes = NULL;
 
+/*
+ * Typed key at boot.  Firmware console input is the only keyboard the driver
+ * has (Quibble's graphical console has no input protocol), so the prompt goes
+ * to ConOut and the person at the machine types the passphrase there.  The
+ * engine calls this only when the pool's dataset is encrypted and no key was
+ * handed in, and calls it again if the key does not verify.
+ */
+static int
+efi_get_key(char* buf, size_t buflen, void* priv) {
+    static const char prompt[] = "ZFS: dataset is encrypted - enter key/passphrase: ";
+    EFI_INPUT_KEY key;
+    EFI_STATUS status;
+    CHAR16 wbuf[128];
+    size_t n = 0, i;
+
+    (void)priv;
+
+    for (i = 0; prompt[i] && i < 127; i++)
+        wbuf[i] = (CHAR16)(unsigned char)prompt[i];
+    wbuf[i] = 0;
+    systable->ConOut->OutputString(systable->ConOut, wbuf);
+
+    if (systable->ConIn->Reset)
+        systable->ConIn->Reset(systable->ConIn, FALSE);
+
+    for (;;) {
+        do {
+            status = systable->ConIn->ReadKeyStroke(systable->ConIn, &key);
+            if (status == EFI_NOT_READY)
+                bs->Stall(10000);
+        } while (status == EFI_NOT_READY);
+
+        if (status != EFI_SUCCESS)
+            return -1;
+
+        if (key.UnicodeChar == L'\r' || key.UnicodeChar == L'\n')
+            break;
+
+        if (key.UnicodeChar == 8) {
+            if (n > 0) {
+                n--;
+                systable->ConOut->OutputString(systable->ConOut, L"\b \b");
+            }
+            continue;
+        }
+
+        if (key.UnicodeChar < 0x20 || key.UnicodeChar > 0x7e)
+            continue;
+        if (n + 1 >= buflen)
+            continue;
+
+        buf[n++] = (char)key.UnicodeChar;
+        wbuf[0] = L'*';
+        wbuf[1] = 0;
+        systable->ConOut->OutputString(systable->ConOut, wbuf);
+    }
+
+    systable->ConOut->OutputString(systable->ConOut, L"\r\n");
+    buf[n] = 0;
+
+    return n != 0 ? 0 : -1;
+}
