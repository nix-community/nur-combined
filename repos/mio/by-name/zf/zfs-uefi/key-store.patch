+/*
+ * Encrypted datasets: the key store.
+ *
+ * An encrypted dataset's DSL dir is a ZAP object with an entry pointing at a
+ * second ZAP (``com.datto:crypto_key_obj'') that holds the dataset key, wrapped
+ * with the dataset's wrapping key.  For keyformat=raw that wrapping key is the
+ * raw keyfile, so the reader needs it handed in (zfs_set_wrapping_key) before
+ * the dataset can be opened; keyformat=passphrase additionally needs PBKDF2 and
+ * is not handled here.
+ *
+ * The wrapped blob is 96 bytes (32-byte master key + 64-byte HMAC key) and the
+ * MAC over it is a 16-byte AES-GCM tag, so a wrong key fails the tag check
+ * rather than yielding a plausible-looking key.
+ */
+#define	ZIO_CRYPT_AES_256_GCM_ID	8ULL	/* zio_crypt_table index */
+#define	DSL_KEY_MASTER_LEN	32
+#define	DSL_KEY_HMAC_LEN	64
+#define	DSL_KEY_WRAPPED_LEN	(DSL_KEY_MASTER_LEN + DSL_KEY_HMAC_LEN)
+
+struct zfs_dataset_key {
+	boolean_t	loaded;
+	uint64_t	crypt;
+	uint64_t	version;
+	uint64_t	guid;
+	uint8_t		key[DSL_KEY_MASTER_LEN];
+	uint8_t		hmac[DSL_KEY_HMAC_LEN];
+};
+
+static struct zfs_dataset_key dataset_key;
+static uint8_t wrapping_key[32];
+static boolean_t wrapping_key_set = B_FALSE;
+
+void
+zfs_set_wrapping_key(const uint8_t *key)
+{
+	memcpy(wrapping_key, key, sizeof (wrapping_key));
+	wrapping_key_set = B_TRUE;
+}
+
+static void
+zfs_put_le64(uint8_t *p, uint64_t v)
+{
+	int i;
+
+	for (i = 0; i < 8; i++)
+		p[i] = (uint8_t)(v >> (8 * i));
+}
+
+
+typedef int (*zfs_key_provider_fn)(char *buf, size_t buflen, void *priv);
+
+static zfs_key_provider_fn key_provider;
+static void *key_provider_priv;
+
+void
+zfs_set_key_provider(zfs_key_provider_fn fn, void *priv)
+{
+	key_provider = fn;
+	key_provider_priv = priv;
+}
+
+/*
+ * Turn whatever was typed (or handed in) into the 32-byte wrapping key.
+ * keyformat=raw is 32 bytes verbatim, keyformat=hex is 64 hex digits, and
+ * keyformat=passphrase is PBKDF2-HMAC-SHA1 with the on-disk salt (stored as a
+ * little-endian uint64) and pbkdf2iters - exactly libzfs_crypto.c:derive_key.
+ */
+#define	ZFS_KEYFORMAT_RAW_ID		1
+#define	ZFS_KEYFORMAT_HEX_ID		2
+#define	ZFS_KEYFORMAT_PASSPHRASE_ID	3
+#define	ZFS_MIN_PBKDF2_ITERATIONS	100000ULL
+
+static int
+zfs_hexval(char c)
+{
+	if (c >= '0' && c <= '9')
+		return (c - '0');
+	if (c >= 'a' && c <= 'f')
+		return (c - 'a' + 10);
+	if (c >= 'A' && c <= 'F')
+		return (c - 'A' + 10);
+	return (-1);
+}
+
+static int
+zfs_derive_wrapping_key(uint64_t keyformat, uint64_t salt, uint64_t iters,
+    const char *secret, size_t len)
+{
+	uint8_t saltbuf[8];
+	size_t i;
+
+	switch (keyformat) {
+	case ZFS_KEYFORMAT_RAW_ID:
+		if (len != 32) {
+			printf("ZFS: raw key must be 32 bytes\n");
+			return (EINVAL);
+		}
+		memcpy(wrapping_key, secret, 32);
+		break;
+
+	case ZFS_KEYFORMAT_HEX_ID:
+		if (len != 64) {
+			printf("ZFS: hex key must be 64 hex digits\n");
+			return (EINVAL);
+		}
+		for (i = 0; i < 32; i++) {
+			int hi = zfs_hexval(secret[2 * i]);
+			int lo = zfs_hexval(secret[2 * i + 1]);
+
+			if (hi < 0 || lo < 0) {
+				printf("ZFS: invalid hex key\n");
+				return (EINVAL);
+			}
+			wrapping_key[i] = (uint8_t)((hi << 4) | lo);
+		}
+		break;
+
+	case ZFS_KEYFORMAT_PASSPHRASE_ID:
+		if (iters < ZFS_MIN_PBKDF2_ITERATIONS) {
+			printf("ZFS: passphrase dataset has %ju pbkdf2 iterations, "
+			    "need at least %ju\n", (uintmax_t)iters,
+			    (uintmax_t)ZFS_MIN_PBKDF2_ITERATIONS);
+			return (ENOTSUP);
+		}
+		for (i = 0; i < sizeof (saltbuf); i++)
+			saltbuf[i] = (uint8_t)(salt >> (8 * i));
+		pbkdf2_sha1((const uint8_t *)secret, len, saltbuf,
+		    sizeof (saltbuf), (uint32_t)iters, wrapping_key, 32);
+		break;
+
+	default:
+		printf("ZFS: unsupported keyformat %ju\n", (uintmax_t)keyformat);
+		return (ENOTSUP);
+	}
+
+	wrapping_key_set = B_TRUE;
+	return (0);
+}
+
+/*
+ * Unwrap the dataset key.  version 1 authenticates guid, crypto suite and
+ * version (24 bytes of AAD); the original version 0 only authenticated the
+ * guid.
+ */
+static int
+zfs_unwrap_dataset_key(const uint8_t *wrapped, const uint8_t *iv,
+    const uint8_t *mac, uint64_t crypt, uint64_t version, uint64_t guid)
+{
+	uint8_t aad[24];
+	uint8_t plain[DSL_KEY_WRAPPED_LEN];
+	size_t aad_len;
+
+	if (crypt != ZIO_CRYPT_AES_256_GCM_ID) {
+		printf("ZFS: encrypted dataset uses encryption suite %ju, "
+		    "only aes-256-gcm is supported\n", (uintmax_t)crypt);
+		return (ENOTSUP);
+	}
+
+	aad_len = (version == 0) ? 8 : sizeof (aad);
+	zfs_put_le64(aad, guid);
+	if (version != 0) {
+		zfs_put_le64(aad + 8, crypt);
+		zfs_put_le64(aad + 16, version);
+	}
+
+	if (aes256_gcm_decrypt(wrapping_key, iv, aad, aad_len, wrapped,
+	    sizeof (plain), plain, mac) != 0) {
+		printf("ZFS: dataset key unwrap failed - wrong key or passphrase?\n");
+		return (EACCES);
+	}
+
+	memcpy(dataset_key.key, plain, DSL_KEY_MASTER_LEN);
+	memcpy(dataset_key.hmac, plain + DSL_KEY_MASTER_LEN, DSL_KEY_HMAC_LEN);
+	dataset_key.crypt = crypt;
+	dataset_key.version = version;
+	dataset_key.guid = guid;
+	dataset_key.loaded = B_TRUE;
+
+	printf("ZFS: dataset key loaded: aes-256-gcm, guid %llx\n",
+	    (unsigned long long)guid);
+	return (0);
+}
+
+
+static int
+zfs_load_dataset_key(const spa_t *spa, uint64_t dir_obj)
+{
+	dnode_phys_t dir, keydn;
+	uint64_t keyobj = 0, crypt = 0, version = 0, guid = 0;
+	uint64_t keyformat = 0, salt = 0, iters = 0;
+	uint8_t keydata[DSL_KEY_MASTER_LEN], hmacdata[DSL_KEY_HMAC_LEN];
+	uint8_t iv[12], mac[16];
+	uint8_t wrapped[DSL_KEY_WRAPPED_LEN];
+	char secret[256];
+	int rc, attempt;
+
+	if (objset_get_dnode(spa, spa->spa_mos, dir_obj, &dir) != 0)
+		return (EIO);
+
+	if (zap_lookup(spa, &dir, "com.datto:crypto_key_obj", sizeof (keyobj),
+	    1, &keyobj) != 0)
+		return (0);	/* not an encrypted dataset */
+
+	if (keyobj == 0)
+		return (0);
+
+	if (objset_get_dnode(spa, spa->spa_mos, keyobj, &keydn) != 0) {
+		printf("ZFS: can't read the dataset key object\n");
+		return (EIO);
+	}
+
+	rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_SUITE", sizeof (crypt), 1,
+	    &crypt);
+	if (rc == 0)
+		rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_GUID", sizeof (guid), 1,
+		    &guid);
+	if (rc == 0)
+		rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_MASTER_KEY_1", 1,
+		    sizeof (keydata), keydata);
+	if (rc == 0)
+		rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_HMAC_KEY_1", 1,
+		    sizeof (hmacdata), hmacdata);
+	if (rc == 0)
+		rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_IV", 1, sizeof (iv), iv);
+	if (rc == 0)
+		rc = zap_lookup(spa, &keydn, "DSL_CRYPTO_MAC", 1, sizeof (mac),
+		    mac);
+	if (rc != 0) {
+		printf("ZFS: can't read the dataset key object (%d)\n", rc);
+		return (rc);
+	}
+
+	/* version 0 predates the field, so a failed lookup means 0 */
+	(void) zap_lookup(spa, &keydn, "DSL_CRYPTO_VERSION", sizeof (version),
+	    1, &version);
+
+	/* passphrases additionally carry the keyformat and PBKDF2 parameters */
+	(void) zap_lookup(spa, &keydn, "keyformat", sizeof (keyformat), 1,
+	    &keyformat);
+	(void) zap_lookup(spa, &keydn, "pbkdf2salt", sizeof (salt), 1, &salt);
+	(void) zap_lookup(spa, &keydn, "pbkdf2iters", sizeof (iters), 1,
+	    &iters);
+
+	memcpy(wrapped, keydata, sizeof (keydata));
+	memcpy(wrapped + sizeof (keydata), hmacdata, sizeof (hmacdata));
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		if (!wrapping_key_set) {
+			int got;
+
+			if (key_provider == NULL) {
+				printf("ZFS: encrypted dataset found, but no "
+				    "key was supplied\n");
+				return (EACCES);
+			}
+
+			got = key_provider(secret, sizeof (secret),
+			    key_provider_priv);
+			if (got != 0) {
+				printf("ZFS: no key entered\n");
+				return (EACCES);
+			}
+
+			rc = zfs_derive_wrapping_key(keyformat, salt, iters,
+			    secret, strlen(secret));
+			if (rc != 0)
+				return (rc);
+		}
+
+		rc = zfs_unwrap_dataset_key(wrapped, iv, mac, crypt, version,
+		    guid);
+		if (rc != EACCES || key_provider == NULL)
+			return (rc);
+
+		/* wrong key: let the provider ask again */
+		wrapping_key_set = B_FALSE;
+		printf("ZFS: wrong passphrase/key, try again\n");
+	}
+
+	return (EACCES);
+}
+
