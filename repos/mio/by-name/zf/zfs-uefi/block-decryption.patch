+++ b/src/engine/zfsimpl.h
@@ -401,6 +401,26 @@ _NOTE(CONSTCOND) } while (0)
  */
 #define	BP_USES_CRYPT(bp)	BF64_GET((bp)->blk_prop, 61, 1)
 
+/*
+ * How OpenZFS classifies a block (spa.h): a level 0 block uses the dataset key
+ * for AES-GCM if its object type is encrypted, and is only authenticated with
+ * SHA512-HMAC otherwise; blocks above level 0 hold a SHA-512 of their
+ * children's MACs.  The third DVA word and blk_fill carry the salt/IV.
+ */
+#define	BP_IS_ENCRYPTED(bp)					\
+	(BP_USES_CRYPT(bp) && BP_GET_LEVEL(bp) == 0 &&		\
+	zfs_ot_is_encrypted(BP_GET_TYPE(bp)))
+#define	BP_IS_AUTHENTICATED(bp)				\
+	(BP_USES_CRYPT(bp) && BP_GET_LEVEL(bp) == 0 &&		\
+	!zfs_ot_is_encrypted(BP_GET_TYPE(bp)))
+#define	BP_HAS_INDIRECT_MAC_CKSUM(bp)				\
+	(BP_USES_CRYPT(bp) && BP_GET_LEVEL(bp) > 0)
+#define	BP_IS_PROTECTED(bp)					\
+	(BP_IS_ENCRYPTED(bp) || BP_IS_AUTHENTICATED(bp))
+#define	BP_GET_IV2(bp)	BF64_GET((bp)->blk_fill, 32, 32)
+
+static int zfs_ot_is_encrypted(uint64_t);
+
 #define	BP_GET_DEDUP(bp)	BF64_GET((bp)->blk_prop, 62, 1)
 #define	BP_SET_DEDUP(bp, x)	BF64_SET((bp)->blk_prop, 62, 1, x)
 
diff --git a/src/engine/zfssubr.c b/src/engine/zfssubr.c
index 8de463e..244d742 100644
--- a/src/engine/zfssubr.c
+++ b/src/engine/zfssubr.c
@@ -279,6 +279,16 @@ zio_checksum_verify(const spa_t *spa, const blkptr_t *bp, void *data)
 {
 	uint64_t size;
 	unsigned int checksum;
+
+	/*
+	 * An encrypted (or authenticated) block does not carry a regular
+	 * checksum of its plaintext: the last 128 bits of blk_cksum hold a GCM
+	 * tag or HMAC, and indirect blocks hold a SHA-512 of their children's
+	 * MACs.  Those are verified by the crypto path; a normal checksum here
+	 * would fail on every encrypted block.
+	 */
