+    // LayoutTransform stretches a 1x buffer (blurry). Set Avalonia X11 scale
+    // before the platform starts so Skia renders at the real DPI.
+    // AVALONIA_GLOBAL_SCALE_FACTOR post-multiplies Xft.dpi/96, so 1.5x GLOBAL
+    // on a 144dpi Xft is 2.25x (sharp but huge). Named SCREEN_SCALE_FACTORS
+    // replace Xrdb and are absolute.
+    private static void ConfigureLinuxHidpi()
+    {
+        if (!OperatingSystem.IsLinux())
+            return;
+
+        var scale = ResolveLinuxUiScale();
+        if (scale is null || scale.Value <= 1.01)
+            return;
+
+        var text = scale.Value.ToString("0.##", CultureInfo.InvariantCulture);
+        Environment.SetEnvironmentVariable("AVALONIA_SCREEN_SCALE_IGNORE_QT", "1");
+        Environment.SetEnvironmentVariable("QT_SCREEN_SCALE_FACTORS", null);
+        Environment.SetEnvironmentVariable("QT_SCALE_FACTOR", null);
+        Environment.SetEnvironmentVariable("AVALONIA_GLOBAL_SCALE_FACTOR", null);
+        Environment.SetEnvironmentVariable(
+            "AVALONIA_SCREEN_SCALE_FACTORS",
+            NamedScaleFactors(text)
+        );
+    }
+
+    private static string NamedScaleFactors(string text)
+    {
+        var names = new SortedSet<string>(StringComparer.Ordinal)
+        {
+            "DP-1",
+            "DP-2",
+            "DP-3",
+            "DisplayPort-1",
+            "HDMI-1",
+            "HDMI-A-1",
+            "HDMI-A-2",
+            "WL-1",
+            "XWAYLAND0",
+            "eDP-1",
+            "eDP-2",
+        };
+        foreach (var name in ReadKwinOutputNames())
+            names.Add(name);
+
+        var parts = new List<string>();
+        foreach (var name in names)
+            parts.Add(name + "=" + text);
+        return string.Join(";", parts);
+    }
+
+    private static double? ResolveLinuxUiScale()
+    {
+        var raw = Environment.GetEnvironmentVariable("DISCORDCHATEXPORTER_SCALE");
+        if (
+            !string.IsNullOrWhiteSpace(raw)
+            && double.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed)
+            && parsed > 0
+        )
+            return parsed;
+
+        if (KwinXwaylandClientsScale() == false)
+            return null;
+
+        var fromKwin = ReadKwinOutputScale();
+        if (fromKwin is not null)
+            return SnapScale(fromKwin.Value);
+
+        var gdk = Environment.GetEnvironmentVariable("GDK_SCALE");
+        if (
+            !string.IsNullOrWhiteSpace(gdk)
+            && double.TryParse(
+                gdk,
+                NumberStyles.Any,
+                CultureInfo.InvariantCulture,
+                out var gdkScale
+            )
+            && gdkScale > 1.01
+        )
+            return SnapScale(gdkScale);
+
+        var wayland =
+            !string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WAYLAND_DISPLAY"))
+            || string.Equals(
+                Environment.GetEnvironmentVariable("XDG_SESSION_TYPE"),
+                "wayland",
+                StringComparison.OrdinalIgnoreCase
+            );
+        var kde = (Environment.GetEnvironmentVariable("XDG_CURRENT_DESKTOP") ?? "").Contains(
+            "KDE",
+            StringComparison.OrdinalIgnoreCase
+        );
+        if (wayland && kde && KwinXwaylandClientsScale() != false)
+            return 1.5;
+
+        return null;
+    }
+
+    private static double SnapScale(double guessed)
+    {
+        guessed = Math.Clamp(guessed, 1, 3);
+        var steps = new[] { 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 3.0 };
+        var best = 1.0;
+        var bestDelta = double.MaxValue;
+        foreach (var step in steps)
+        {
+            var delta = Math.Abs(step - guessed);
+            if (delta < bestDelta)
+            {
+                best = step;
+                bestDelta = delta;
+            }
+        }
+
+        return best;
+    }
+
+    private static IEnumerable<string> ReadKwinOutputNames()
+    {
+        var path = Path.Combine(XdgConfigHome(), "kwinoutputconfig.json");
+        if (!File.Exists(path))
+            yield break;
+
+        foreach (
+            Match match in Regex.Matches(File.ReadAllText(path), @"""name""\s*:\s*""([^""]+)""")
+        )
+        {
+            var name = match.Groups[1].Value;
+            if (name.Length > 0 && name.Length < 32)
+                yield return name;
+        }
+    }
+
+    private static double? ReadKwinOutputScale()
+    {
+        var path = Path.Combine(XdgConfigHome(), "kwinoutputconfig.json");
+        if (!File.Exists(path))
+            return null;
+
+        var json = File.ReadAllText(path);
+        var matches = Regex.Matches(json, @"""scale""\s*:\s*([0-9]+(?:\.[0-9]+)?)");
+        double? best = null;
+        foreach (Match match in matches)
+        {
+            if (
+                !double.TryParse(
+                    match.Groups[1].Value,
+                    NumberStyles.Any,
+                    CultureInfo.InvariantCulture,
+                    out var value
+                )
+            )
+                continue;
+            if (value < 1.05 || value > 3)
+                continue;
+            if (best is null || value > best)
+                best = value;
+        }
+
+        return best;
+    }
+
+    private static string XdgConfigHome()
+    {
+        var xdg = Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");
+        if (!string.IsNullOrEmpty(xdg))
+            return xdg;
+        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        return Path.Combine(home, ".config");
+    }
+
+    private static bool? KwinXwaylandClientsScale()
+    {
+        var config = XdgConfigHome();
+        return ReadKdeIniBool(Path.Combine(config, "kdeglobals"), "KScreen", "XwaylandClientsScale")
+            ?? ReadKdeIniBool(Path.Combine(config, "kwinrc"), "Xwayland", "XwaylandClientsScale");
+    }
+
+    private static bool? ReadKdeIniBool(string path, string group, string key)
+    {
+        if (!File.Exists(path))
+            return null;
+
+        string? current = null;
+        foreach (var line in File.ReadLines(path))
+        {
+            var t = line.Trim();
+            if (t.Length == 0 || t.StartsWith('#') || t.StartsWith(';'))
+                continue;
+            if (t.StartsWith('[') && t.EndsWith(']'))
+            {
+                current = t[1..^1];
+                continue;
+            }
+            var eq = t.IndexOf('=');
+            if (eq <= 0 || current != group)
+                continue;
+            var name = t[..eq].Trim();
+            if (name != key && !name.StartsWith(key + "[", StringComparison.Ordinal))
+                continue;
+            var value = t[(eq + 1)..].Trim();
+            if (value is "true" or "1" or "yes")
+                return true;
+            if (value is "false" or "0" or "no")
+                return false;
+        }
+
+        return null;
+    }
 }
