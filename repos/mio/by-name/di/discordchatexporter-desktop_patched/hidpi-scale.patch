+    // X11/XWayland often reports RenderScaling=1 on HiDPI. Scale the visual tree instead.
+    private static void ApplyLinuxHidpiScale(Window window)
+    {
+        if (!OperatingSystem.IsLinux())
+            return;
+
+        if (window.Content is LayoutTransformControl)
+            return;
+
+        var scale = ResolveLinuxUiScale(window);
+        if (scale <= 1.01)
+            return;
+
+        if (window.Content is Control child)
+        {
+            window.Content = null;
+            window.Content = new LayoutTransformControl
+            {
+                LayoutTransform = new ScaleTransform(scale, scale),
+                Child = child,
+            };
+        }
+
+        window.MinWidth *= scale;
+        window.MinHeight *= scale;
+        window.Width *= scale;
+        window.Height *= scale;
+    }
+
+    private static double ResolveLinuxUiScale(Window window)
+    {
+        var raw = Environment.GetEnvironmentVariable("DISCORDCHATEXPORTER_SCALE");
+        if (
+            !string.IsNullOrWhiteSpace(raw)
+            && double.TryParse(raw, NumberStyles.Any, CultureInfo.InvariantCulture, out var parsed)
+            && parsed > 0
+        )
+            return parsed;
+
+        if (window.RenderScaling > 1.1)
+            return 1;
+
+        // KWin "Scaled by the system": compositor magnifies X11; do not stack.
+        // KWin "Apply scaling themselves" (XwaylandClientsScale=true): we must scale.
+        if (KwinXwaylandClientsScale() == false)
+            return 1;
+
+        var wayland =
+            !string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WAYLAND_DISPLAY"))
+            || string.Equals(
+                Environment.GetEnvironmentVariable("XDG_SESSION_TYPE"),
+                "wayland",
+                StringComparison.OrdinalIgnoreCase
+            );
+        var kde = (Environment.GetEnvironmentVariable("XDG_CURRENT_DESKTOP") ?? "").Contains(
+            "KDE",
+            StringComparison.OrdinalIgnoreCase
+        );
+        // GNOME and other compositors scale XWayland themselves unless Plasma
+        // opted into client-side X11 scale.
+        if (wayland && !kde && KwinXwaylandClientsScale() != true)
+            return 1;
+
+        var screen = window.Screens?.ScreenFromWindow(window) ?? window.Screens?.Primary;
+        if (screen is null)
+            return 1;
+
+        if (screen.Scaling > 1.1)
+            return 1;
+
+        var guessed = screen.Bounds.Width / 1920.0;
+        guessed = Math.Clamp(guessed, 1, 3);
+
+        var steps = new[] { 1.0, 1.25, 1.5, 1.75, 2.0, 2.25, 2.5, 3.0 };
+        var best = 1.0;
+        var bestDelta = double.MaxValue;
+        foreach (var step in steps)
+        {
+            var delta = Math.Abs(step - guessed);
+            if (delta < bestDelta)
+            {
+                best = step;
+                bestDelta = delta;
+            }
+        }
+
+        return best;
+    }
+
+    private static string XdgConfigHome()
+    {
+        var xdg = Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");
+        if (!string.IsNullOrEmpty(xdg))
+            return xdg;
+        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+        return Path.Combine(home, ".config");
+    }
+
+    // true = Legacy X11 apps apply scaling themselves; false = scaled by KWin.
+    private static bool? KwinXwaylandClientsScale()
+    {
+        var config = XdgConfigHome();
+        return ReadKdeIniBool(Path.Combine(config, "kdeglobals"), "KScreen", "XwaylandClientsScale")
+            ?? ReadKdeIniBool(Path.Combine(config, "kwinrc"), "Xwayland", "XwaylandClientsScale");
+    }
+
+    private static bool? ReadKdeIniBool(string path, string group, string key)
+    {
+        if (!File.Exists(path))
+            return null;
+
+        string? current = null;
+        foreach (var line in File.ReadLines(path))
+        {
+            var t = line.Trim();
+            if (t.Length == 0 || t.StartsWith('#') || t.StartsWith(';'))
+                continue;
+            if (t.StartsWith('[') && t.EndsWith(']'))
+            {
+                current = t[1..^1];
+                continue;
+            }
+            var eq = t.IndexOf('=');
+            if (eq <= 0 || current != group)
+                continue;
+            var name = t[..eq].Trim();
+            if (name != key && !name.StartsWith(key + "[", StringComparison.Ordinal))
+                continue;
+            var value = t[(eq + 1)..].Trim();
+            if (value is "true" or "1" or "yes")
+                return true;
+            if (value is "false" or "0" or "no")
+                return false;
+        }
+
+        return null;
+    }
