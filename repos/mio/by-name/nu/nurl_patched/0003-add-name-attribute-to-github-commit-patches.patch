+
+fn github_patch_name(url: &Url) -> Option<String> {
+    let (owner, repo, kind, id) = github_patch_parts(url)?;
+    let api_url = match kind {
+        "pull" => format!("https://api.github.com/repos/{owner}/{repo}/pulls/{id}"),
+        "commit" => format!("https://api.github.com/repos/{owner}/{repo}/commits/{id}"),
+        _ => return None,
+    };
+
+    let mut request = ureq::get(&api_url)
+        .header("Accept", "application/vnd.github+json")
+        .header("X-GitHub-Api-Version", "2022-11-28");
+
+    if let Some(token) = ["GH_TOKEN", "GITHUB_TOKEN", "GITHUB_API_TOKEN"]
+        .iter()
+        .find_map(|key| std::env::var(key).ok())
+    {
+        request = request.header("Authorization", &format!("Bearer {token}"));
+    }
+
+    let response = request.call().ok()?;
+    let title = match kind {
+        "pull" => {
+            #[derive(Deserialize)]
+            struct PullRequest {
+                title: String,
             }
+            response.into_body().read_json::<PullRequest>().ok()?.title
         }
-        Ok(None)
+        "commit" => {
+            #[derive(Deserialize)]
+            struct CommitResponse {
+                commit: Commit,
+            }
+            #[derive(Deserialize)]
+            struct Commit {
+                message: String,
+            }
+            response
+                .into_body()
+                .read_json::<CommitResponse>()
+                .ok()?
+                .commit
+                .message
+                .lines()
+                .next()
+                .filter(|line| !line.is_empty())?
+                .to_string()
+        }
+        _ => return None,
+    };
+
+    Some(title.replace('"', "\\\""))
+}
+
+fn github_patch_parts(url: &Url<'_>) -> Option<(String, String, &'static str, String)> {
+    let rest = url.as_str().strip_prefix("https://github.com/")?;
+    let mut parts = rest.split('/');
+    let owner = parts.next()?.to_string();
+    let repo = parts.next()?.to_string();
+    let kind = match parts.next()? {
+        "pull" => "pull",
+        "commit" => "commit",
+        _ => return None,
+    };
+    let file = parts.next()?;
+    if parts.next().is_some() {
+        return None;
+    }
+    let id = file
+        .strip_suffix(".patch")
+        .or_else(|| file.strip_suffix(".diff"))?
+        .to_string();
+    if id.is_empty() {
+        return None;
     }
+    Some((owner, repo, kind, id))
 }
