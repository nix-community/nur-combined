+fn request(url: &Url, head: bool) -> Option<ureq::http::Response<ureq::Body>> {
+    let agent: ureq::Agent = ureq::Agent::config_builder()
+        .timeout_global(Some(std::time::Duration::from_secs(30)))
+        .build()
+        .into();
+    let request = if head {
+        agent.head(url.as_str())
+    } else {
+        // A server that answers HEAD with 405 or without the header still
+        // sends it on a GET, so ask for a single byte: the body of a download
+        // link can be gigabytes and is never read.
+        agent.get(url.as_str()).header("Range", "bytes=0-0")
+    };
+    request
+        .header("User-Agent", concat!("nurl/", env!("CARGO_PKG_VERSION")))
+        .header("Accept", "*/*")
+        .call()
+        .ok()
+}
+
+// `attachment; filename="Burnout 3 (USA).iso"`, or the RFC 5987 form
+// `filename*=UTF-8''Burnout%203%20%28USA%29.iso`.
+fn disposition_name(header: &str) -> Option<String> {
+    let mut plain = None;
+    for part in header.split(';').skip(1) {
+        let part = part.trim();
+        if let Some(value) = part.strip_prefix("filename*=") {
+            let encoded = value.split_once("''").map_or(value, |(_, rest)| rest);
+            return Some(percent_decode(encoded.trim_matches('"')));
+        }
+        if let Some(value) = part.strip_prefix("filename=") {
+            plain = Some(percent_decode(value.trim_matches('"')));
+        }
     }
+    plain
+}
