             self.fetch_fod(url, cfg)
         } else {
-            url_prefetch(url.as_str())
+            let name = self.name(url)?;
+            url_prefetch(url.as_str(), name.as_deref())
         }
     }
+
+    // `nix store prefetch-file` derives the store name from the URL's last
+    // path segment and rejects names it cannot use there (spaces, parentheses)
+    // before it ever computes the hash, so such URLs cannot be hashed at all.
+    // Pass it a sanitised name, and keep the generated expression consistent.
+    fn name(&self, url: &Url) -> Result<Option<String>> {
+        Ok(store_safe_name(url))
+    }
+}
+
+fn store_safe_name(url: &Url) -> Option<String> {
+    let raw = url.as_str().rsplit('/').next()?.split('?').next()?;
+    let base = percent_decode(raw);
+    if base.is_empty() {
+        return None;
+    }
+
+    let is_safe = |c: char| c.is_ascii_alphanumeric() || "+-._?=".contains(c);
+    if base.chars().all(is_safe) {
+        return None;
+    }
+
+    Some(
+        base.chars()
+            .map(|c| if is_safe(c) { c } else { '_' })
+            .collect(),
+    )
+}
+
+fn percent_decode(input: &str) -> String {
+    let bytes = input.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        let hex = (bytes[i] == b'%' && i + 2 < bytes.len())
+            .then(|| std::str::from_utf8(&bytes[i + 1..i + 3]).ok())
+            .flatten()
+            .and_then(|hex| u8::from_str_radix(hex, 16).ok());
+        match hex {
+            Some(byte) => {
+                out.push(byte);
+                i += 3;
+            }
+            None => {
+                out.push(bytes[i]);
+                i += 1;
+            }
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
 }
