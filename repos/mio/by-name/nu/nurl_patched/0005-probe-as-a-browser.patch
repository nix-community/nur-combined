index d055037..cc52a65 100644
--- a/src/fetcher/url.rs
+++ b/src/fetcher/url.rs
@@ -69,11 +69,25 @@ fn request(url: &Url, head: bool) -> Option<ureq::http::Response<ureq::Body>> {
         // link can be gigabytes and is never read.
         agent.get(url.as_str()).header("Range", "bytes=0-0")
     };
-    request
-        .header("User-Agent", concat!("nurl/", env!("CARGO_PKG_VERSION")))
-        .header("Accept", "*/*")
-        .call()
-        .ok()
+    let mut request = request
+        .header("User-Agent", BROWSER_USER_AGENT)
+        .header("Accept", BROWSER_ACCEPT);
+    if let Some(referer) = referer(url.as_str()) {
+        request = request.header("Referer", referer);
+    }
+    request.call().ok()
+}
+
+// Download links often refuse clients that do not look like the browser the
+// link was meant for (vimm.net answers 400 to anything else), so the probe
+// carries a navigation's headers.
+const BROWSER_USER_AGENT: &str = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36";
+const BROWSER_ACCEPT: &str = "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8";
+
+fn referer(url: &str) -> Option<String> {
+    let (scheme, rest) = url.split_once("://")?;
+    let host = rest.split('/').next()?;
+    Some(format!("{scheme}://{host}/"))
 }
 
