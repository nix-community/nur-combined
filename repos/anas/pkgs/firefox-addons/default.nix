# Package set for the add-ons listed in ./addons.json.
#
# Two files drive this set:
#
#   addons.json      Hand maintained allowlist. Only lists the slugs that are
#                    packaged, plus optional `pname` and `license` overrides.
#   addons.lock.json Generated by ../../scripts/update-firefox-addons from the
#                    addons.mozilla.org API. Do not edit by hand.
#
# The add-ons are built with the unmodified XPI published by
# addons.mozilla.org, so they can be installed on stock Firefox through policy
# and keep their Mozilla signature. See ../../lib/mozilla.nix for the layouts
# that are produced and how they are consumed.
#
# Upstream reference implementation:
# <https://gitlab.com/rycee/nur-expressions> (MIT licensed).
{ pkgs }:

let
  inherit (pkgs) lib;

  policyDir = "share/mozilla/extensions/{ec8030f7-c20a-464f-9b0e-13a3a9e97384}";

  buildMozillaXpiAddon = (import ../../lib/mozilla.nix { inherit lib; }).mkBuildMozillaXpiAddon {
    inherit (pkgs) fetchurl stdenv;
  };

  readJson = path: builtins.fromJSON (builtins.readFile path);

  allowlist = readJson ./addons.json;
  lock = readJson ./addons.lock.json;

  # Maps the license ids reported by the addons.mozilla.org API onto the
  # licenses available in nixpkgs. Mirrors the mapping used by upstream's
  # `mozilla-addons-to-nix` generator.
  licensesByAmoId = {
    "6" = "gpl3";
    "12" = "lgpl3";
    "13" = "gpl2";
    "16" = "lgpl21";
    "18" = "bsd2";
    "22" = "mit";
    "3338" = "mpl20";
    "4160" = "asl20";
    "4814" = "cc0";
    "5296" = "bsd3";
    "7068" = "zlib";
    "7551" = "isc";
    "6978" = "cc-by-sa-30";
    "6979" = "cc-by-30";
    "6982" = "cc-by-nc-sa-30";
    "7714" = "agpl3Plus";
    "7770" = "agpl3Only";
  };

  customLicense =
    l: {
      shortName = l.shortName;
      fullName = l.fullName or l.shortName;
      url = l.url or "";
      free = l.free or false;
    };

  licenseFor =
    entry: req:
    let
      override = req.license or null;
    in
    if override == null then
      let
        shortName = licensesByAmoId.${toString entry.licenseId} or null;
      in
      if shortName == null then
        throw ''
          Unknown addons.mozilla.org license id '${toString entry.licenseId}' for
          add-on '${entry.slug}'. Add a "license" override for it in
          pkgs/firefox-addons/addons.json.
        ''
      else
        lib.licenses.${shortName}
    else if override.tag == "predefined" then
      lib.licenses.${override.shortName}
    else
      customLicense override;

  reqsBySlug = lib.listToAttrs (map (req: lib.nameValuePair req.slug req) allowlist);

  allowlistSlugs = map (req: req.slug) allowlist;
  lockSlugs = map (entry: entry.slug) lock;

  missingFromLock = builtins.filter (slug: !(builtins.elem slug lockSlugs)) allowlistSlugs;
  missingFromAllowlist = builtins.filter (slug: !(builtins.elem slug allowlistSlugs)) lockSlugs;

  checkLock =
    if missingFromLock != [ ] then
      throw ''
        pkgs/firefox-addons/addons.lock.json is missing entries for
        ${lib.concatStringsSep ", " missingFromLock}. Run
        `x addons` to regenerate it.
      ''
    else if missingFromAllowlist != [ ] then
      throw ''
        pkgs/firefox-addons/addons.lock.json contains entries that are not
        listed in pkgs/firefox-addons/addons.json:
        ${lib.concatStringsSep ", " missingFromAllowlist}. Run `x addons` to
        regenerate the lock file.
      ''
    else
      null;

  fromLock =
    entry: req:
    let
      homepage = entry.homepage or null;
    in
    buildMozillaXpiAddon {
      pname = req.pname or entry.slug;
      inherit (entry) version addonId url;
      sha256 = builtins.replaceStrings [ "sha256:" ] [ "" ] entry.hash;
      meta = {
        description = entry.summary;
        license = licenseFor entry req;
        platforms = pkgs.lib.platforms.all;

        # Permissions requested by the add-on, as reported by the
        # addons.mozilla.org API. Home Manager uses this to assert that the
        # permissions granted through
        # `programs.firefox.profiles.<name>.extensions.settings.<id>.permissions`
        # have not drifted from what the add-on actually requests.
        mozPermissions = entry.permissions;
      }
      // lib.optionalAttrs (homepage != null) { inherit homepage; };
    };

  addons = lib.listToAttrs (
    map
      (entry: {
        name = reqsBySlug.${entry.slug}.pname or entry.slug;
        value = fromLock entry reqsBySlug.${entry.slug};
      })
      lock
  );

  checkedAddons =
    if checkLock == null then
      addons
    else
      throw checkLock;

in
# The add-on derivations are merged in last so that the convenience
  # attributes below cannot be shadowed by an add-on.
rec {
  recurseForDerivations = true;

  # Convenience list with every add-on package, e.g. for Home Manager:
  #   programs.firefox.profiles.default.extensions.packages = nur...firefox-addons.all;
  # Home Manager releases before 26.05 also accept it as
  # `programs.firefox.globalExtensions`.
  all = lib.attrValues checkedAddons;

  # Convenience policies, e.g. on NixOS
  #   programs.firefox.policies = nur...firefox-addons.policies;
  policies = {
    ExtensionSettings = lib.mapAttrs
      (_: addon: {
        installation_mode = "force_installed";
        install_url = "file://${addon.outPath}/${policyDir}/${addon.addonId}.xpi";
      })
      checkedAddons;
  };
} // checkedAddons
