diff --git a/src/daemon/asr/backends/sherpa_disabled_backend.cpp b/src/daemon/asr/backends/sherpa_disabled_backend.cpp
new file mode 100644
index 0000000..558c5a3
--- /dev/null
+++ b/src/daemon/asr/backends/sherpa_disabled_backend.cpp
@@ -0,0 +1,29 @@
+#include "daemon/asr/backends/sherpa_offline_backend.h"
+#include "daemon/asr/backends/sherpa_streaming_backend.h"
+
+namespace vinput::daemon::asr {
+
+namespace {
+
+std::unique_ptr<AsrBackend> LocalAsrUnavailable(std::string *error) {
+  if (error) {
+    *error = "Local ASR support is not available in this build.";
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+std::unique_ptr<AsrBackend>
+CreateSherpaOfflineBackend(const CoreConfig &, const LocalAsrProvider &,
+                           std::string *error) {
+  return LocalAsrUnavailable(error);
+}
+
+std::unique_ptr<AsrBackend>
+CreateSherpaStreamingBackend(const CoreConfig &, const LocalAsrProvider &,
+                             std::string *error) {
+  return LocalAsrUnavailable(error);
+}
+
+}  // namespace vinput::daemon::asr
