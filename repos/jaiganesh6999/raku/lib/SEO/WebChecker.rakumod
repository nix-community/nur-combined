use JSON::Fast;

unit class SEO::WebChecker:ver<1.0.0>:auth<zef:jaiganesh6999>;

#| Encapsulates the complete result of an on-page technical SEO audit.
class Result {
    has Str $.url is rw;
    has Int $.score is rw = 100;
    has Str $.grade is rw = 'A';
    has Str $.status is rw = 'PASS';
    has Str $.title is rw = '';
    has Int $.title-length is rw = 0;
    has Str $.meta-description is rw = '';
    has Int $.meta-description-length is rw = 0;
    has Bool $.has-viewport is rw = False;
    has Bool $.has-canonical is rw = False;
    has Str $.canonical-url is rw = '';
    has Bool $.is-https is rw = False;
    has Int $.h1-count is rw = 0;
    has @.h1-tags is rw;
    has Int $.word-count is rw = 0;
    has Num $.response-time-ms is rw = 0e0;
    has @.issues is rw;
    has @.passes is rw;
    has Str $.platform-url is rw = 'https://seowebchecker.com/';
    has Str $.timestamp is rw = DateTime.now.utc.truncated-to('second').Str ~ 'Z';

    method to-hash(--> Hash) {
        return {
            url => $.url,
            score => $.score,
            grade => $.grade,
            status => $.status,
            title => $.title,
            title_length => $.title-length,
            meta_description => $.meta-description,
            meta_description_length => $.meta-description-length,
            has_viewport => $.has-viewport,
            has_canonical => $.has-canonical,
            canonical_url => $.canonical-url,
            is_https => $.is-https,
            h1_count => $.h1-count,
            h1_tags => @.h1-tags,
            word_count => $.word-count,
            response_time_ms => $.response-time-ms,
            issues => @.issues,
            passes => @.passes,
            platform_url => $.platform-url,
            timestamp => $.timestamp,
        };
    }

    method to-json(--> Str) {
        return to-json(self.to-hash, :sorted-keys);
    }

    method to-markdown(--> Str) {
        my $md = "# Technical SEO Audit: " ~ $.url ~ "\n\n";
        $md ~= "> Generated by **SEO::WebChecker** for Raku • [https://seowebchecker.com/](https://seowebchecker.com/)\n\n";
        $md ~= "## Overview\n\n";
        $md ~= "| Metric | Value |\n";
        $md ~= "|:---|:---|\n";
        $md ~= "| **SEO Health Score** | **" ~ $.score ~ " / 100** (" ~ $.grade ~ ") |\n";
        $md ~= "| **Audit Status** | **" ~ $.status ~ "** |\n";
        $md ~= "| **HTTPS Secure** | " ~ ($.is-https ?? 'Yes' !! 'No') ~ " |\n";
        $md ~= "| **Title Tag** | " ~ ($.title || '[Missing]') ~ " (" ~ $.title-length ~ " chars) |\n";
        $md ~= "| **Meta Description** | " ~ ($.meta-description || '[Missing]') ~ " (" ~ $.meta-description-length ~ " chars) |\n";
        $md ~= "| **Mobile Viewport** | " ~ ($.has-viewport ?? 'Configured' !! 'Missing') ~ " |\n";
        $md ~= "| **Canonical Tag** | " ~ ($.has-canonical ?? $.canonical-url !! 'Missing') ~ " |\n";
        $md ~= "| **Primary H1** | " ~ $.h1-count ~ " tag(s) found |\n";
        $md ~= "| **Word Count** | " ~ $.word-count ~ " words |\n\n";

        if @.issues.elems > 0 {
            $md ~= "## ⚠️ Issues & Recommendations\n\n";
            for @.issues -> $i {
                my $badge = $i<severity> eq 'error' ?? '🛑 ERROR' !! '⚠️ WARNING';
                $md ~= "### " ~ $badge ~ ": " ~ $i<title> ~ "\n";
                $md ~= "- **Issue**: " ~ $i<message> ~ "\n";
                $md ~= "- **Fix**: " ~ $i<recommendation> ~ "\n\n";
            }
        }

        if @.passes.elems > 0 {
            $md ~= "## ✅ Passed Audits\n\n";
            for @.passes -> $p {
                $md ~= "- **" ~ $p<title> ~ "**: " ~ $p<message> ~ "\n";
            }
            $md ~= "\n";
        }

        return $md;
    }
}

has Str $.user-agent is rw = 'SEOWebChecker-Raku/1.0 (+https://seowebchecker.com/)';
has Int $.timeout is rw = 15;
has Int $.alert-threshold is rw = 85;

#| Audits a live webpage URL.
method audit(Str $url is copy --> Result) {
    if $url !~~ m:i/^ 'https?://' / {
        $url = 'https://' ~ $url;
    }

    my $start = now;
    my $html = '';
    my $elapsed-ms = 0e0;

    # Fetch document content via curl if available
    try {
        my $proc = run 'curl', '-s', '-L', '--max-time', $.timeout.Str, '-A', $.user-agent, $url, :out, :err;
        $html = $proc.out.slurp(:close);
    }

    $elapsed-ms = ((now - $start) * 1000).Num;

    return self.audit-html($html, :$url, :response-time-ms($elapsed-ms));
}

#| Audits a given HTML string directly.
method audit-html(Str $html, Str :$url = 'https://seowebchecker.com/', Num :$response-time-ms = 120.0e0 --> Result) {
    my $res = Result.new(
        url => $url,
        response-time-ms => $response-time-ms,
        is-https => $url.starts-with('https://'),
    );

    my @issues;
    my @passes;

    # 1. Title Tag
    if $html ~~ m:i/ '<title' <-[>]>* '>' (.*?) '</title>' / {
        $res.title = (~$0).trim.subst(/\s+/, ' ', :g);
        $res.title-length = $res.title.chars;
    }

    if $res.title eq '' {
        @issues.push({
            id => 'meta-title-missing',
            category => 'meta',
            severity => 'error',
            title => 'Missing title tag',
            message => 'No <title> tag found on the page.',
            recommendation => 'Add a descriptive <title> tag between 30 and 60 characters.',
        });
    } elsif $res.title-length < 30 {
        @issues.push({
            id => 'meta-title-short',
            category => 'meta',
            severity => 'warning',
            title => 'Title tag is short',
            message => 'Title is only ' ~ $res.title-length ~ " characters ('" ~ $res.title ~ "').",
            recommendation => 'Expand title to 30-60 characters for search engine previews.',
        });
    } elsif $res.title-length > 65 {
        @issues.push({
            id => 'meta-title-long',
            category => 'meta',
            severity => 'warning',
            title => 'Title tag is long',
            message => 'Title is ' ~ $res.title-length ~ ' characters and may be truncated in search results.',
            recommendation => 'Shorten title tag to under 60 characters.',
        });
    } else {
        @passes.push({
            id => 'meta-title-pass',
            category => 'meta',
            severity => 'pass',
            title => 'Title tag optimal',
            message => 'Title tag is optimal (' ~ $res.title-length ~ ' characters).',
            recommendation => 'Maintain current title tag.',
        });
    }

    # 2. Meta Description
    if $html ~~ m:i/ '<meta' \s+ <-[>]>*? 'name=' <["']> 'description' <["']> <-[>]>*? 'content=' <["']> (<-["']>*) <["']> /
       || $html ~~ m:i/ '<meta' \s+ <-[>]>*? 'content=' <["']> (<-["']>*) <["']> <-[>]>*? 'name=' <["']> 'description' <["']> / {
        $res.meta-description = (~$0).trim;
        $res.meta-description-length = $res.meta-description.chars;
    }

    if $res.meta-description eq '' {
        @issues.push({
            id => 'meta-desc-missing',
            category => 'meta',
            severity => 'error',
            title => 'Missing meta description',
            message => 'No meta description found on page.',
            recommendation => 'Add an engaging meta description between 70 and 160 characters.',
        });
    } elsif $res.meta-description-length < 70 {
        @issues.push({
            id => 'meta-desc-short',
            category => 'meta',
            severity => 'warning',
            title => 'Meta description is short',
            message => 'Meta description is ' ~ $res.meta-description-length ~ ' characters.',
            recommendation => 'Expand description to 70-160 characters.',
        });
    } else {
        @passes.push({
            id => 'meta-desc-pass',
            category => 'meta',
            severity => 'pass',
            title => 'Meta description optimal',
            message => 'Meta description is optimal (' ~ $res.meta-description-length ~ ' characters).',
            recommendation => 'Maintain current meta description.',
        });
    }

    # 3. Mobile Viewport
    if $html ~~ m:i/ '<meta' \s+ <-[>]>*? 'name=' <["']> 'viewport' <["']> / {
        $res.has-viewport = True;
        @passes.push({
            id => 'meta-viewport-pass',
            category => 'technical',
            severity => 'pass',
            title => 'Mobile viewport configured',
            message => 'Responsive viewport meta tag is present.',
            recommendation => 'Mobile responsiveness enabled.',
        });
    } else {
        @issues.push({
            id => 'meta-viewport-missing',
            category => 'technical',
            severity => 'error',
            title => 'Missing mobile viewport tag',
            message => 'No <meta name="viewport"> tag detected.',
            recommendation => 'Add <meta name="viewport" content="width=device-width, initial-scale=1.0">.',
        });
    }

    # 4. Canonical Tag
    if $html ~~ m:i/ '<link' \s+ <-[>]>*? 'rel=' <["']> 'canonical' <["']> <-[>]>*? 'href=' <["']> (<-["']>*) <["']> /
       || $html ~~ m:i/ '<link' \s+ <-[>]>*? 'href=' <["']> (<-["']>*) <["']> <-[>]>*? 'rel=' <["']> 'canonical' <["']> / {
        $res.has-canonical = True;
        $res.canonical-url = (~$0).trim;
        @passes.push({
            id => 'meta-canonical-pass',
            category => 'technical',
            severity => 'pass',
            title => 'Canonical link tag present',
            message => 'Canonical URL configured: ' ~ $res.canonical-url ~ '.',
            recommendation => 'Canonical URL correctly declared.',
        });
    } else {
        @issues.push({
            id => 'meta-canonical-missing',
            category => 'technical',
            severity => 'warning',
            title => 'Missing canonical link tag',
            message => 'No <link rel="canonical"> tag detected.',
            recommendation => 'Add a self-referencing canonical tag to avoid duplicate content penalties.',
        });
    }

    # 5. Heading Structure
    my @h1-matches = $html ~~ m:g:i/ '<h1' <-[>]>* '>' (.*?) '</h1>' /;
    $res.h1-count = @h1-matches.elems;
    $res.h1-tags = @h1-matches.map({ (~$_[0]).trim.subst(/ '<' <-[>]>* '>' /, '', :g) });

    if $res.h1-count == 0 {
        @issues.push({
            id => 'content-h1-missing',
            category => 'content',
            severity => 'error',
            title => 'Missing <h1> heading',
            message => 'No <h1> heading found on page.',
            recommendation => 'Include exactly one primary <h1> heading summarizing page intent.',
        });
    } elsif $res.h1-count == 1 {
        @passes.push({
            id => 'content-h1-pass',
            category => 'content',
            severity => 'pass',
            title => 'Single <h1> heading present',
            message => "Single primary heading found: '" ~ $res.h1-tags[0] ~ "'.",
            recommendation => 'Clean heading hierarchy maintained.',
        });
    } else {
        @issues.push({
            id => 'content-h1-multiple',
            category => 'content',
            severity => 'warning',
            title => 'Multiple <h1> headings found (' ~ $res.h1-count ~ ')',
            message => 'Found ' ~ $res.h1-count ~ ' <h1> headings.',
            recommendation => 'Consolidate multiple <h1> headings into a single primary <h1> heading.',
        });
    }

    # 6. Word Count
    my $clean-text = $html.subst(rx:i/ '<script' <-[>]>* '>' .*? '</script>' /, ' ', :g);
    $clean-text = $clean-text.subst(rx:i/ '<style' <-[>]>* '>' .*? '</style>' /, ' ', :g);
    $clean-text = $clean-text.subst(rx/ '<' <-[>]>* '>' /, ' ', :g);
    my @words = $clean-text.words;
    $res.word-count = @words.elems;

    if $res.word-count < 100 {
        @issues.push({
            id => 'content-thin',
            category => 'content',
            severity => 'error',
            title => 'Thin page content',
            message => 'Page has only ' ~ $res.word-count ~ ' words.',
            recommendation => 'Expand page content to 300+ words of helpful, relevant copy.',
        });
    } else {
        @passes.push({
            id => 'content-words-pass',
            category => 'content',
            severity => 'pass',
            title => 'Adequate content length',
            message => 'Page contains ' ~ $res.word-count ~ ' words.',
            recommendation => 'Healthy on-page copy volume.',
        });
    }

    # 7. HTTPS
    if $res.is-https {
        @passes.push({
            id => 'tech-https-pass',
            category => 'technical',
            severity => 'pass',
            title => 'Secure HTTPS active',
            message => 'Website communicates over secure encrypted HTTPS.',
            recommendation => 'Maintain valid SSL/TLS certificates.',
        });
    } else {
        @issues.push({
            id => 'tech-not-https',
            category => 'technical',
            severity => 'error',
            title => 'Insecure HTTP protocol',
            message => 'Website is served over unencrypted HTTP.',
            recommendation => 'Deploy an SSL certificate and redirect all traffic to HTTPS.',
        });
    }

    # Score calculation
    my $error-count = @issues.grep({ $_<severity> eq 'error' }).elems;
    my $warn-count = @issues.grep({ $_<severity> eq 'warning' }).elems;

    my $computed = 100 - ($error-count * 15) - ($warn-count * 6);
    $res.score = max(10, min(100, $computed));

    $res.grade = do given $res.score {
        when * >= 95 { 'A+' }
        when * >= 90 { 'A'  }
        when * >= 80 { 'B'  }
        when * >= 70 { 'C'  }
        when * >= 60 { 'D'  }
        default      { 'F'  }
    };

    $res.status = $res.score >= $.alert-threshold ?? 'PASS' !! 'ALERT';
    $res.issues = @issues;
    $res.passes = @passes;

    return $res;
}
