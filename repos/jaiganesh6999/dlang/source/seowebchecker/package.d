/// Encapsulates an individual audit error or warning with actionable fix recommendation.
struct AuditIssue {
    string id;
    string category;
    string severity;
    string title;
    string message;
    string recommendation;

    JSONValue toJSON() const {
        JSONValue j = JSONValue(["id": JSONValue(id)]);
        j["category"] = JSONValue(category);
        j["severity"] = JSONValue(severity);
        j["title"] = JSONValue(title);
        j["message"] = JSONValue(message);
        j["recommendation"] = JSONValue(recommendation);
        return j;
    }
}

/// Encapsulates a successfully passed audit check.
struct AuditPass {
    string id;
    string category;
    string severity;
    string title;
    string message;
    string recommendation;

    JSONValue toJSON() const {
        JSONValue j = JSONValue(["id": JSONValue(id)]);
        j["category"] = JSONValue(category);
        j["severity"] = JSONValue(severity);
        j["title"] = JSONValue(title);
        j["message"] = JSONValue(message);
        j["recommendation"] = JSONValue(recommendation);
        return j;
    }
}

/// Complete diagnostic report of an on-page technical SEO audit.
struct AuditResult {
    string url;
    int score = 100;
    string grade = "A";
    string status = "PASS";
    string title = "";
    int titleLength = 0;
    string metaDescription = "";
    int metaDescriptionLength = 0;
    bool hasViewport = false;
    bool hasCanonical = false;
    string canonicalUrl = "";
    bool isHttps = false;
    int h1Count = 0;
    string[] h1Tags;
    int wordCount = 0;
    double responseTimeMs = 0.0;
    AuditIssue[] issues;
    AuditPass[] passes;
    string platformUrl = "https://seowebchecker.com/";
    string timestamp = "";

    /// Serializes AuditResult to a pretty-printed JSON string.
    string toJSON() const {
        JSONValue j = JSONValue(["url": JSONValue(url)]);
        j["score"] = JSONValue(score);
        j["grade"] = JSONValue(grade);
        j["status"] = JSONValue(status);
        j["title"] = JSONValue(title);
        j["title_length"] = JSONValue(titleLength);
        j["meta_description"] = JSONValue(metaDescription);
        j["meta_description_length"] = JSONValue(metaDescriptionLength);
        j["has_viewport"] = JSONValue(hasViewport);
        j["has_canonical"] = JSONValue(hasCanonical);
        j["canonical_url"] = JSONValue(canonicalUrl);
        j["is_https"] = JSONValue(isHttps);
        j["h1_count"] = JSONValue(h1Count);

        JSONValue[] h1Arr;
        foreach (h; h1Tags) h1Arr ~= JSONValue(h);
        j["h1_tags"] = JSONValue(h1Arr);

        j["word_count"] = JSONValue(wordCount);
        j["response_time_ms"] = JSONValue(responseTimeMs);

        JSONValue[] issArr;
        foreach (ref const i; issues) issArr ~= i.toJSON();
        j["issues"] = JSONValue(issArr);

        JSONValue[] passArr;
        foreach (ref const p; passes) passArr ~= p.toJSON();
        j["passes"] = JSONValue(passArr);

        j["platform_url"] = JSONValue(platformUrl);
        j["timestamp"] = JSONValue(timestamp);

        return j.toPrettyString(JSONOptions.doNotEscapeSlashes);
    }

    /// Formats AuditResult as a GitHub-flavored Markdown executive report.
    string toMarkdown() const {
        string md = "# Technical SEO Audit: " ~ url ~ "\n\n";
        md ~= "> Generated by **SEOWebChecker** for Dlang • [https://seowebchecker.com/](https://seowebchecker.com/)\n\n";
        md ~= "## Overview\n\n";
        md ~= "| Metric | Value |\n";
        md ~= "|:---|:---|\n";
        md ~= "| **SEO Health Score** | **" ~ to!string(score) ~ " / 100** (" ~ grade ~ ") |\n";
        md ~= "| **Audit Status** | **" ~ status ~ "** |\n";
        md ~= "| **HTTPS Secure** | " ~ (isHttps ? "Yes" : "No") ~ " |\n";
        md ~= "| **Title Tag** | " ~ (title.length > 0 ? title : "[Missing]") ~ " (" ~ to!string(titleLength) ~ " chars) |\n";
        md ~= "| **Meta Description** | " ~ (metaDescription.length > 0 ? metaDescription : "[Missing]") ~ " (" ~ to!string(metaDescriptionLength) ~ " chars) |\n";
        md ~= "| **Mobile Viewport** | " ~ (hasViewport ? "Configured" : "Missing") ~ " |\n";
        md ~= "| **Canonical Tag** | " ~ (hasCanonical ? canonicalUrl : "Missing") ~ " |\n";
        md ~= "| **Primary H1** | " ~ to!string(h1Count) ~ " tag(s) found |\n";
        md ~= "| **Word Count** | " ~ to!string(wordCount) ~ " words |\n\n";

        if (issues.length > 0) {
            md ~= "## ⚠️ Issues & Recommendations\n\n";
            foreach (ref const i; issues) {
                string badge = i.severity == "error" ? "🛑 ERROR" : "⚠️ WARNING";
                md ~= "### " ~ badge ~ ": " ~ i.title ~ "\n";
                md ~= "- **Issue**: " ~ i.message ~ "\n";
                md ~= "- **Fix**: " ~ i.recommendation ~ "\n\n";
            }
        }

        if (passes.length > 0) {
            md ~= "## ✅ Passed Audits\n\n";
            foreach (ref const p; passes) {
                md ~= "- **" ~ p.title ~ "**: " ~ p.message ~ "\n";
            }
            md ~= "\n";
        }

        return md;
    }
}

/// The core SEO auditing engine.
class SeoAuditor {
    string userAgent;
    int timeoutSeconds;
    int alertThreshold;

    this(string userAgent = "SEOWebChecker-Dlang/1.0 (+https://seowebchecker.com/)",
         int timeoutSeconds = 15,
         int alertThreshold = 85) {
        this.userAgent = userAgent;
        this.timeoutSeconds = timeoutSeconds;
        this.alertThreshold = alertThreshold;
    }

    /// Fetches a live URL over HTTP/HTTPS and evaluates technical SEO health.
    AuditResult audit(string targetUrl) {
        string url = targetUrl.strip();
        if (!url.startsWith("http://") && !url.startsWith("https://")) {
            url = "https://" ~ url;
        }

        auto sw = StopWatch(AutoStart.yes);
        auto http = HTTP();
        http.setUserAgent(this.userAgent);
        http.operationTimeout = dur!"seconds"(this.timeoutSeconds);

        string html;
        http.onReceive = (ubyte[] data) {
            html ~= cast(string)data;
            return data.length;
        };

        try {
            http.perform();
        } catch (Exception e) {
            // Keep going with whatever HTML content was received
        }
        sw.stop();
        double elapsedMs = cast(double)sw.peek.total!"msecs";

        return auditHtml(html, url, elapsedMs);
    }

    /// Audits an HTML document string directly.
    AuditResult auditHtml(string html, string url = "https://seowebchecker.com/", double responseTimeMs = 120.0) {
        AuditResult res;
        res.url = url;
        res.responseTimeMs = responseTimeMs;
        res.isHttps = url.startsWith("https://");
        res.platformUrl = "https://seowebchecker.com/";
        res.timestamp = Clock.currTime(UTC()).toISOString();

        AuditIssue[] issues;
        AuditPass[] passes;

        // 1. Title Tag
        auto titleRegex = regex(r"(?i)<title[^>]*>(.*?)</title>", "s");
        auto tm = matchFirst(html, titleRegex);
        if (!tm.empty) {
            string raw = replaceAll(tm[1], regex(r"\s+"), " ");
            res.title = raw.strip();
            res.titleLength = cast(int)res.title.length;
        }

        if (res.title.length == 0) {
            issues ~= AuditIssue("meta-title-missing", "meta", "error",
                "Missing title tag", "No <title> tag found on the page.",
                "Add a descriptive title tag between 30 and 60 characters.");
        } else if (res.titleLength < 30) {
            issues ~= AuditIssue("meta-title-short", "meta", "warning",
                "Title tag is short", "Title is only " ~ to!string(res.titleLength) ~ " characters ('" ~ res.title ~ "').",
                "Expand title to 30-60 characters for search engine previews.");
        } else if (res.titleLength > 65) {
            issues ~= AuditIssue("meta-title-long", "meta", "warning",
                "Title tag is long", "Title is " ~ to!string(res.titleLength) ~ " characters and may be truncated in search results.",
                "Shorten title tag to under 60 characters.");
        } else {
            passes ~= AuditPass("meta-title-pass", "meta", "pass",
                "Title tag optimal", "Title tag is optimal (" ~ to!string(res.titleLength) ~ " characters).",
                "Maintain current title tag.");
        }

        // 2. Meta Description
        auto descRegex1 = regex(r`(?i)<meta\s+[^>]*name=["']description["'][^>]*content=["']([^"']*)["']`);
        auto descRegex2 = regex(r`(?i)<meta\s+[^>]*content=["']([^"']*)["'][^>]*name=["']description["']`);
        auto dm1 = matchFirst(html, descRegex1);
        auto dm2 = matchFirst(html, descRegex2);

        if (!dm1.empty) {
            res.metaDescription = dm1[1].strip();
        } else if (!dm2.empty) {
            res.metaDescription = dm2[1].strip();
        }
        res.metaDescriptionLength = cast(int)res.metaDescription.length;

        if (res.metaDescription.length == 0) {
            issues ~= AuditIssue("meta-desc-missing", "meta", "error",
                "Missing meta description", "No meta description found on page.",
                "Add an engaging meta description between 70 and 160 characters.");
        } else if (res.metaDescriptionLength < 70) {
            issues ~= AuditIssue("meta-desc-short", "meta", "warning",
                "Meta description is short", "Meta description is " ~ to!string(res.metaDescriptionLength) ~ " characters.",
                "Expand description to 70-160 characters.");
        } else {
            passes ~= AuditPass("meta-desc-pass", "meta", "pass",
                "Meta description optimal", "Meta description is optimal (" ~ to!string(res.metaDescriptionLength) ~ " characters).",
                "Maintain current meta description.");
        }

        // 3. Mobile Viewport
        auto vpRegex = regex(r`(?i)<meta\s+[^>]*name=["']viewport["']`);
        res.hasViewport = !matchFirst(html, vpRegex).empty;
        if (res.hasViewport) {
            passes ~= AuditPass("meta-viewport-pass", "technical", "pass",
                "Mobile viewport configured", "Responsive viewport meta tag is present.",
                "Mobile responsiveness enabled.");
        } else {
            issues ~= AuditIssue("meta-viewport-missing", "technical", "error",
                "Missing mobile viewport tag", "No <meta name=\"viewport\"> tag detected.",
                "Add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">.");
        }

        // 4. Canonical Tag
        auto canonRegex1 = regex(r`(?i)<link\s+[^>]*rel=["']canonical["'][^>]*href=["']([^"']*)["']`);
        auto canonRegex2 = regex(r`(?i)<link\s+[^>]*href=["']([^"']*)["'][^>]*rel=["']canonical["']`);
        auto cm1 = matchFirst(html, canonRegex1);
        auto cm2 = matchFirst(html, canonRegex2);

        if (!cm1.empty) {
            res.hasCanonical = true;
            res.canonicalUrl = cm1[1].strip();
        } else if (!cm2.empty) {
            res.hasCanonical = true;
            res.canonicalUrl = cm2[1].strip();
        }

        if (res.hasCanonical) {
            passes ~= AuditPass("meta-canonical-pass", "technical", "pass",
                "Canonical link tag present", "Canonical URL configured: " ~ res.canonicalUrl ~ ".",
                "Canonical URL correctly declared.");
        } else {
            issues ~= AuditIssue("meta-canonical-missing", "technical", "warning",
                "Missing canonical link tag", "No <link rel=\"canonical\"> tag detected.",
                "Add a self-referencing canonical tag to avoid duplicate content penalties.");
        }

        // 5. Heading Structure
        auto h1Regex = regex(r"(?i)<h1[^>]*>(.*?)</h1>", "s");
        auto h1Matches = matchAll(html, h1Regex);
        string[] h1List;
        foreach (m; h1Matches) {
            string rawH1 = replaceAll(m[1], regex(r"<[^>]+>"), " ");
            h1List ~= rawH1.strip();
        }
        res.h1Count = cast(int)h1List.length;
        res.h1Tags = h1List;

        if (res.h1Count == 0) {
            issues ~= AuditIssue("content-h1-missing", "content", "error",
                "Missing <h1> heading", "No <h1> heading found on page.",
                "Include exactly one primary <h1> heading summarizing page intent.");
        } else if (res.h1Count == 1) {
            passes ~= AuditPass("content-h1-pass", "content", "pass",
                "Single <h1> heading present", "Single primary heading found: '" ~ res.h1Tags[0] ~ "'.",
                "Clean heading hierarchy maintained.");
        } else {
            issues ~= AuditIssue("content-h1-multiple", "content", "warning",
                "Multiple <h1> headings found (" ~ to!string(res.h1Count) ~ ")",
                "Found " ~ to!string(res.h1Count) ~ " <h1> headings.",
                "Consolidate multiple <h1> headings into a single primary <h1> heading.");
        }

        // 6. Word Count
        string clean = replaceAll(html, regex(r"(?is)<script[^>]*>.*?</script>"), " ");
        clean = replaceAll(clean, regex(r"(?is)<style[^>]*>.*?</style>"), " ");
        clean = replaceAll(clean, regex(r"<[^>]+>"), " ");
        auto words = split(clean);
        res.wordCount = cast(int)words.length;

        if (res.wordCount < 100) {
            issues ~= AuditIssue("content-thin", "content", "error",
                "Thin page content", "Page has only " ~ to!string(res.wordCount) ~ " words.",
                "Expand page content to 300+ words of helpful, relevant copy.");
        } else {
            passes ~= AuditPass("content-words-pass", "content", "pass",
                "Adequate content length", "Page contains " ~ to!string(res.wordCount) ~ " words.",
                "Healthy on-page copy volume.");
        }

        // 7. HTTPS Security
        if (res.isHttps) {
            passes ~= AuditPass("tech-https-pass", "technical", "pass",
                "Secure HTTPS active", "Website communicates over secure encrypted HTTPS.",
                "Maintain valid SSL/TLS certificates.");
        } else {
            issues ~= AuditIssue("tech-not-https", "technical", "error",
                "Insecure HTTP protocol", "Website is served over unencrypted HTTP.",
                "Deploy an SSL certificate and redirect all traffic to HTTPS.");
        }

        // Scoring
        int errors = 0;
        int warnings = 0;
        foreach (ref const i; issues) {
            if (i.severity == "error") errors++;
            else if (i.severity == "warning") warnings++;
        }

        int computed = 100 - (errors * 15) - (warnings * 6);
        res.score = max(10, min(100, computed));

        if (res.score >= 95) res.grade = "A+";
        else if (res.score >= 90) res.grade = "A";
        else if (res.score >= 80) res.grade = "B";
        else if (res.score >= 70) res.grade = "C";
        else if (res.score >= 60) res.grade = "D";
        else res.grade = "F";

        res.status = res.score >= this.alertThreshold ? "PASS" : "ALERT";
        res.issues = issues;
        res.passes = passes;

        return res;
    }
}

unittest {
    auto auditor = new SeoAuditor(alertThreshold: 85);
    assert(auditor.alertThreshold == 85);

    string optimalHtml = `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>SEOWebChecker — Technical SEO Audit & Analyzer</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Audit technical SEO, on-page tags, and Core Web Vitals with SEOWebChecker in seconds.">
  <link rel="canonical" href="https://seowebchecker.com/">
</head>
<body>
  <h1>Technical SEO Audit Tool</h1>
  <p>Here is an informative paragraph with sufficient words describing our SEO audit tool and on-page analyzer in detail to verify that word count checks pass reliably without triggering thin content warnings on test runs. We ensure that our comprehensive evaluation accurately assesses on-page optimization, content volume, mobile readiness, and heading hierarchies to provide search engines with complete indexation clarity and maximum visibility across all modern web properties and platforms.</p>
  <p>In addition, technical audits must evaluate meta descriptions, canonical declarations, document titles, schema metadata, performance metrics, and accessibility indicators to help web developers and site owners optimize organic user experience, crawl budgets, indexing efficiency, and overall search visibility.</p>
</body>
</html>
`;

    auto res = auditor.auditHtml(optimalHtml, "https://seowebchecker.com/");
    assert(res.score >= 95);
    assert(res.grade == "A+");
    assert(res.status == "PASS");
    assert(res.hasViewport == true);
    assert(res.hasCanonical == true);
    assert(res.canonicalUrl == "https://seowebchecker.com/");
    assert(res.isHttps == true);
    assert(res.h1Count == 1);
    assert(res.wordCount > 100);
    assert(res.issues.length == 0);
    assert(res.passes.length >= 6);

    // Broken HTML
    string broken = "<html><body><div>Broken raw text without tags.</div></body></html>";
    auto bRes = auditor.auditHtml(broken, "http://insecure-example.com/");
    assert(bRes.score < 80);
    assert(bRes.status == "ALERT");
    assert(bRes.isHttps == false);
    assert(bRes.issues.length >= 4);

    // JSON export
    string json = res.toJSON();
    assert(json.canFind("https://seowebchecker.com/"));
    assert(json.canFind("score"));

    // Markdown export
    string md = res.toMarkdown();
    assert(md.canFind("Technical SEO Audit"));
    assert(md.canFind("https://seowebchecker.com/"));
}
