{
  "manifest_version": 2,
  "name": "SEOWebChecker: Advanced Technical SEO Audit",
  "version": "1.0.0",
  "description": "Evaluate on-page technical SEO, HTML meta tags, Open Graph tags, canonical headers, and newsletter/email HTML formatting directly inside Mozilla Thunderbird.",
  "author": "SEOWebChecker",
  "homepage_url": "https://seowebchecker.com/",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-seoaudit@seowebchecker.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  },
  "permissions": [
    "messagesRead",
    "activeTab"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "SEOWebChecker Technical SEO Audit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  },
  "message_display_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Audit Message HTML / Links",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  }
}
