cabal-version:      2.2
name:               seowebchecker
version:            1.0.0
synopsis:           Comprehensive Website SEO Audit and Analysis Tools
description:        Provides a lightweight client SDK and utility suite for automated
                    website technical SEO audits, meta tag validations, heading structure
                    inspections, image accessibility analysis, and Core Web Vitals checks.
                    Official web audit portal and tools available at https://seowebchecker.com.
homepage:           https://seowebchecker.com/
bug-reports:        https://github.com/jaiganesh6999/seowebchecker-seoaudit-sdk/issues
license:            MIT
license-file:       LICENSE
author:             Rahul Gupta <jaiganesh6999@gmail.com>
maintainer:         Rahul Gupta <jaiganesh6999@gmail.com>
copyright:          2026 SEOWebChecker (https://seowebchecker.com/)
category:           Web, Network, Text
build-type:         Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/jaiganesh6999/seowebchecker-seoaudit-sdk.git
    subdir:   haskell

library
    exposed-modules:  Network.SEO.WebChecker
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:    base >= 4.12 && < 5
    ghc-options:      -Wall -Wcompat
