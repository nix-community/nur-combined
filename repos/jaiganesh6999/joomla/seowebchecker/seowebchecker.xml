<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
  <name>System - SEOWebChecker</name>
  <author>SEOWebChecker</author>
  <creationDate>2026-10-04</creationDate>
  <copyright>Copyright (C) 2026 SEOWebChecker. All rights reserved.</copyright>
  <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
  <authorEmail>support@seowebchecker.com</authorEmail>
  <authorUrl>https://seowebchecker.com/</authorUrl>
  <version>1.0.0</version>
  <description>Automated on-page technical SEO audits, heading structure inspections, image accessibility analysis, and Core Web Vitals checks for Joomla 5.</description>
  <namespace path="src">SeoWebChecker\Plugin\System\SeoWebChecker</namespace>
  <files>
    <folder plugin="seowebchecker">services</folder>
    <folder>src</folder>
    <folder>assets</folder>
    <filename>index.html</filename>
    <filename>README.md</filename>
    <filename>LICENSE.txt</filename>
  </files>
  <languages folder="language">
    <language tag="en-GB">en-GB/plg_system_seowebchecker.ini</language>
    <language tag="en-GB">en-GB/plg_system_seowebchecker.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field
          name="min_score"
          type="number"
          label="PLG_SYSTEM_SEOWEBCHECKER_MIN_SCORE_LABEL"
          description="PLG_SYSTEM_SEOWEBCHECKER_MIN_SCORE_DESC"
          default="80"
          min="0"
          max="100"
        />
        <field
          name="check_images"
          type="radio"
          label="PLG_SYSTEM_SEOWEBCHECKER_CHECK_IMAGES_LABEL"
          description="PLG_SYSTEM_SEOWEBCHECKER_CHECK_IMAGES_DESC"
          default="1"
          class="btn-group btn-group-yesno">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
        <field
          name="check_headings"
          type="radio"
          label="PLG_SYSTEM_SEOWEBCHECKER_CHECK_HEADINGS_LABEL"
          description="PLG_SYSTEM_SEOWEBCHECKER_CHECK_HEADINGS_DESC"
          default="1"
          class="btn-group btn-group-yesno">
          <option value="1">JYES</option>
          <option value="0">JNO</option>
        </field>
      </fieldset>
    </fields>
  </config>
  <updateservers>
    <server type="extension" priority="1" name="SEOWebChecker Updates">https://raw.githubusercontent.com/jaiganesh6999/seowebchecker-seoaudit-sdk/main/joomla/update.xml</server>
  </updateservers>
</extension>
