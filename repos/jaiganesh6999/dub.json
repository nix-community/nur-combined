{
  "name": "seowebchecker",
  "description": "Technical SEO audit library and CLI tool for on-page performance, meta tags, and content health",
  "authors": [
    "SEOWebChecker <support@seowebchecker.com>"
  ],
  "homepage": "https://seowebchecker.com/",
  "license": "MIT",
  "sourcePaths": ["dlang/source"],
  "importPaths": ["dlang/source"],
  "targetType": "library",
  "configurations": [
    {
      "name": "library",
      "targetType": "library",
      "excludedSourceFiles": ["dlang/source/app.d"]
    },
    {
      "name": "executable",
      "targetType": "executable",
      "mainSourceFile": "dlang/source/app.d",
      "targetName": "seowebchecker"
    },
    {
      "name": "unittest",
      "targetType": "executable",
      "mainSourceFile": "dlang/source/app.d"
    }
  ]
}
