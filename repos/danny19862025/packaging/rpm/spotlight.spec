# build-rpm.sh compiles natively and supplies an explicitly staged binary payload.
# ELF runtime requirements are generated by rpmbuild, never disabled.
%{!?spotlight_version:%global spotlight_version 0.4.0}
%global debug_package %{nil}
%global _build_id_links none

Name:           spotlight
Version:        %{spotlight_version}
Release:        1%{?dist}
Summary:        Keyboard-first native Linux productivity launcher
License:        MIT
URL:            https://github.com/danny19862025/spotlight
Source0:        spotlight-%{version}-payload.tar.gz
ExclusiveArch:  x86_64 aarch64
%if 0%{?suse_version}
Requires:       libgtk-4-1 >= 4.10
%else
Requires:       gtk4 >= 4.10
%endif
Suggests:       python3
Suggests:       curl
Suggests:       ripgrep
Suggests:       xdg-utils

%description
Search applications and files, calculate, and manage notes and snippets.
KDE-specific integrations require their corresponding desktop services.
Optional native helper bridges are not included.

%prep
%setup -q -n spotlight-%{version}

%build
# Payload was compiled on this distribution by packaging/build-rpm.sh.

%install
mkdir -p %{buildroot}
cp -a usr %{buildroot}/

%files
%dir %{_prefix}/lib/spotlight
%{_prefix}/lib/spotlight/spotlight
%{_prefix}/lib/spotlight/community-plugins.toml
%{_bindir}/spotlight
%{_datadir}/applications/spotlight.desktop
%{_datadir}/icons/hicolor/scalable/apps/spotlight.svg
%dir %{_datadir}/licenses/spotlight
%license %{_datadir}/licenses/spotlight/*
%dir %{_datadir}/doc/spotlight
%doc %{_datadir}/doc/spotlight/copyright
