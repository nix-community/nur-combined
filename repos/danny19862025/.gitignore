# Build output
/target/
/result
/examples/plugins/*/plugin.wasm

# Runtime data and private local configuration (never distribute)
data.json
data.tmp
desktop-themes.json
desktop-themes.tmp
/quick-notes/
/scripts/
/.local/
/.config/
/.obsidian/
.env
.env.*
!.env.example
*.pem
*.key

