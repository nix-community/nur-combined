/preview.png
/currency-preview.png

# Editor and operating-system files
*.swp
__pycache__/
*~
.DS_Store

# Distribution packaging outputs
/dist/
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/spotlight/
/packaging/arch/*.pkg.tar.*
