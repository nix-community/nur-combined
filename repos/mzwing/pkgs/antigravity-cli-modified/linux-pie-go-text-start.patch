+def _elf_go_text_start(data, pclntab_off):
+    shoff = struct.unpack_from("<Q", data, 40)[0]
+    shentsize, shnum = struct.unpack_from("<HH", data, 58)
+    relas = []
+    pclntab_va = None
+    for i in range(shnum):
+        sh = shoff + i * shentsize
+        sh_type = struct.unpack_from("<I", data, sh + 4)[0]
+        addr, offset, size = struct.unpack_from("<QQQ", data, sh + 16)
+        if offset <= pclntab_off < offset + size:
+            pclntab_va = addr + pclntab_off - offset
+        if sh_type == 4:  # SHT_RELA
+            relas.append((offset, size, struct.unpack_from("<Q", data, sh + 56)[0]))
+    if pclntab_va is None:
+        raise PatchError("pclntab virtual address not found")
+
+    def relocations():
+        for offset, size, entsize in relas:
+            for rel in range(offset, offset + size, entsize):
+                r_offset, _r_info, addend = struct.unpack_from("<QQq", data, rel)
+                yield r_offset, addend
+
+    # PIE leaves pcHeader.textStart zero; recover runtime.text from firstmoduledata
+    moduledata_candidates = [r_off for r_off, addend in relocations() if addend == pclntab_va]
+    targets = {md + delta for md in moduledata_candidates for delta in (8, 176)}
+    addends = {r_off: addend for r_off, addend in relocations() if r_off in targets}
+    text_starts = {
+        addends[md + 176]
+        for md in moduledata_candidates
+        if addends.get(md + 8) == pclntab_va + 72 and addends.get(md + 176, 0)
+    }
+    if len(text_starts) != 1:
+        raise PatchError(f"expected 1 Go text start, found {len(text_starts)}")
+    return text_starts.pop()
+
+
