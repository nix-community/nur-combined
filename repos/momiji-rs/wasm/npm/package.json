{
  "name": "sasso",
  "version": "0.7.10",
  "description": "A pure-Rust SCSS to CSS compiler (a dart-sass alternative), as a tiny dependency-free WebAssembly module.",
  "type": "module",
  "main": "./sasso.mjs",
  "module": "./sasso.mjs",
  "types": "./sasso.d.ts",
  "bin": {
    "sasso": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./sasso.d.ts",
      "import": "./sasso.mjs",
      "default": "./sasso.mjs"
    },
    "./speed": {
      "types": "./sasso.speed.d.ts",
      "import": "./sasso.speed.mjs",
      "default": "./sasso.speed.mjs"
    },
    "./native": {
      "types": "./native.d.ts",
      "import": "./native.mjs",
      "default": "./native.mjs"
    }
  },
  "files": [
    "_loader.mjs",
    "_importer.mjs",
    "_value.mjs",
    "_immutable.mjs",
    "_jobs.mjs",
    "_deprecations.mjs",
    "_addon.mjs",
    "_watchfilter.mjs",
    "_coalesce.mjs",
    "_probe.mjs",
    "_watchers.mjs",
    "_poller.mjs",
    "_baseline.mjs",
    "_errorcss.mjs",
    "cli.mjs",
    "sasso.mjs",
    "sasso.speed.mjs",
    "native.mjs",
    "sasso.wasm",
    "sasso.speed.wasm",
    "sasso.async.wasm",
    "sasso.speed.async.wasm",
    "sasso.d.ts",
    "sasso.speed.d.ts",
    "native.d.ts",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "keywords": [
    "sass",
    "scss",
    "css",
    "compiler",
    "wasm",
    "webassembly",
    "dart-sass"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momiji-rs/sasso.git",
    "directory": "wasm"
  },
  "homepage": "https://github.com/momiji-rs/sasso#readme",
  "bugs": "https://github.com/momiji-rs/sasso/issues",
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  }
}
