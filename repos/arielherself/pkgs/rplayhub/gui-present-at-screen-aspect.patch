+static void present_size(int &w, int &h)
+{
+    w = g_bound_screen_w; h = g_bound_screen_h;
+    if ((w <= 0 || h <= 0) && !g_bound_product_type.empty()) {
+        if (const auto *m = lookup_device_model(g_bound_product_type)) { w = m->screen_w; h = m->screen_h; }
+    }
+    if (w <= 0 || h <= 0) { w = g_frame_w; h = g_frame_h; }
+    if (w <= 0 || h <= 0) { w = g_vtex_w; h = g_vtex_h; }
