-    int rc = (send(fd, hdr, 4, 0) == 4 && send(fd, xml, xlen, 0) == (ssize_t)xlen) ? 0 : -1;
+    int rc = (write_all(fd, hdr, 4) == 0 && write_all(fd, xml, xlen) == 0) ? 0 : -1;
     plist_mem_free(xml);
