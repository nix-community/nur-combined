#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname -r)" == *gvisor* ]]; then
	nix_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nix"
	mkdir -p "$nix_config_dir"
	if ! grep -Fqx 'sandbox = false' "$nix_config_dir/nix.conf" 2>/dev/null; then
		printf '\nsandbox = false\n' >>"$nix_config_dir/nix.conf"
	fi
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="$HOME/.nix-profile"
if [[ -x "$nix_profile/bin/nix" ]]; then
	export PATH="$nix_profile/bin:$PATH"
fi
nix_path="$(command -v nix)"
nix store info >/dev/null

# Refresh the old daemon-profile and global PATH hooks on stale snapshots.
touch "$HOME/.bash_profile"
tmp="$(mktemp)"
awk '
	$0 == "# nur-packages Nix environment" { skip = 1 }
	$0 == "# nur-packages Nix binary path" { skip = 1 }
	$0 == "# nur-packages orb Nix" { skip = 1 }
	skip && ($0 == "fi" || $0 == "esac") { skip = 0; next }
	!skip { print }
' "$HOME/.bash_profile" >"$tmp"
cat >>"$tmp" <<EOF
# nur-packages orb Nix
if [[ "\${PWD}" == "$repo_root" ]]; then
	export PATH="$(dirname "$nix_path"):\${PATH}"
fi
EOF
mv "$tmp" "$HOME/.bash_profile"

echo "Evaluating the locked flake..."
nix eval --accept-flake-config --no-write-lock-file \
	"$repo_root#packages.$(nix eval --raw --impure --expr builtins.currentSystem)" \
	--apply builtins.attrNames >/dev/null

echo "Orb setup complete."
