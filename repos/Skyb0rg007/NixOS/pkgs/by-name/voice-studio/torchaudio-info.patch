+def _audio_info(path: str):
+    """``torchaudio.info()`` replacement; torchaudio 2.9 removed it."""
+    import soundfile
+    from types import SimpleNamespace
+
+    info = soundfile.info(path)
+    bits = {"PCM_U8": 8, "PCM_S8": 8, "PCM_16": 16, "PCM_24": 24, "PCM_32": 32,
+            "FLOAT": 32, "DOUBLE": 64}.get(info.subtype, 0)
+    return SimpleNamespace(num_frames=info.frames, sample_rate=info.samplerate,
+                           num_channels=info.channels, bits_per_sample=bits)
+
