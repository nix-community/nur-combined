diff --git a/src/audio-mp3.h b/src/audio-mp3.h
new file mode 100644
index 0000000..27d47ac
--- /dev/null
+++ b/src/audio-mp3.h
@@ -0,0 +1,114 @@
+#pragma once
+// audio-mp3.h: encode mono float32 PCM to MP3 via LAME.
+// Links against libmp3lame (system library).  Provides one public
+// function: audio_encode_mp3().  Returns the raw MP3 byte stream
+// (with a Xing VBR header).  Mono, 24 kHz default.
+//
+// If LAME is not available at compile time the encode function
+// returns an empty string; the caller (tts-server) should treat that
+// as an encoder-unavailable error.
+
+#include <lame/lame.h>
+
+#include <cmath>
+#include <cstdint>
+#include <string>
+
+// Encode mono float32 PCM to MP3.  Returns the MP3 byte string
+// (empty on failure or if LAME is not linked).
+//
+//   audio   – interleaved mono samples in [-1, 1]
+//   T_audio – number of samples
+//   sr      – sample rate (default 24000, matching qwen output)
+//   brate   – target bit-rate in kbps (default 192 VBR quality 2)
+static std::string audio_encode_mp3(const float * audio, int T_audio, int sr = 24000, int brate = 192) {
+    if (T_audio <= 0 || !audio) {
+        return {};
+    }
+
+    // LAME recommends ≤ 9216 samples per encode call; use 4096 as a
+    // conservative middle ground that keeps memory low on long clips.
+    const int CHUNK = 4096;
+
+    lame_global_flags * gfp = lame_init();
+    if (!gfp) {
+        return {};
+    }
+
+    // Mono, given rate, VBR quality 2 (≈ 190 kbps), no free-format.
+    if (lame_set_in_samplerate(gfp, sr) < 0 ||
+        lame_set_out_samplerate(gfp, sr) < 0 ||
+        lame_set_num_channels(gfp, 1) < 0 ||
+        lame_set_quality(gfp, 2) < 0) {
+        lame_close(gfp);
+        return {};
+    }
+
+    // VBR / ABR target: use the "brate" as a kbps target with VBR
+    // mode q=a (unspecified VBR = high-quality default), but set the
+    // nominal bitrate so LAME produces roughly the requested rate.
+    lame_set_VBR(gfp, vbr_default);
+    lame_set_VBR_quality(gfp, 2.0f);
+    lame_set_brate(gfp, brate);
+
+    // Write a Xing VBR header so clients can seek and display duration.
+    lame_set_bWriteVbrTag(gfp, 1);
+
+    if (lame_init_params(gfp) < 0) {
+        lame_close(gfp);
+        return {};
+    }
+
+    // Output buffer: LAME says MP3 bytes ≤ 1.25 × input_samples + 7200.
+    const int out_buf_size = (int) (T_audio * 1.25f + 7200);
+    std::string out;
+    out.resize((size_t) out_buf_size);
+
+    int encoded = 0;
+    int offset  = 0;
+    int remain  = T_audio;
+
+    while (remain > 0) {
+        int n = remain < CHUNK ? remain : CHUNK;
+        // lame_encode_buffer_ieee_float returns the number of output
+        // bytes, or -1 on error (not fatal — may just need more input).
+        int rc = lame_encode_buffer_ieee_float(
+            gfp,
+            audio + offset,  // left channel (mono = right is unused)
+            audio + offset,  // right channel (same buffer for mono)
+            n,
+            (unsigned char *) out.data() + encoded,
+            out_buf_size - encoded
+        );
+        if (rc < 0) {
+            // Fatal LAME error (e.g. bad bitrate / sample-rate combo
+            // that init_params should already have rejected, but guard
+            // against release changes).
+            lame_close(gfp);
+            return {};
+        }
+        encoded += rc;
+        offset  += n;
+        remain  -= n;
+    }
+
+    // Flush the encoder buffer to write the final frame and Xing header.
+    int rc = lame_encode_flush(gfp, (unsigned char *) out.data() + encoded, out_buf_size - encoded);
+    if (rc < 0) {
+        lame_close(gfp);
+        return {};
+    }
+    encoded += rc;
+
+    // Remove the MP3 tag LAME prepends — it is around 224 bytes for a
+    // typical VBR file (448 bytes worst-case for ID3v2.3).  We keep it
+    // because most MP3 players expect it; the callee sets
+    // Content-Type audio/mpeg and ID3-tagged MP3 plays fine everywhere.
+    // If a caller truly needs a tagless stream it can strip bytes 0..idx
+    // where lame_get_lametag_frame returns the tag size.
+
+    lame_close(gfp);
+
+    out.resize((size_t) encoded);
+    return out;
+}
\ No newline at end of file
