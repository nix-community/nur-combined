+    if (req.format == "mp3") {
+        std::vector<float> buf;
+        tts_sink           sink = [&buf](const float * s, int n) {
+            buf.insert(buf.end(), s, s + n);
+            return true;
+        };
+        std::string synth_err;
+        int         rc = be.synthesize(req, sink, synth_err);
+        if (rc != 0) {
+            tts_json_error(res, tts_status_to_http(rc), "server_error",
+                           synth_err.empty() ? "synthesis failed" : synth_err.c_str());
+            return;
+        }
+        std::string mp3 = audio_encode_mp3(buf.data(), (int) buf.size(), 24000, 192);
+        if (mp3.empty()) {
+            tts_json_error(res, 500, "server_error",
+                           "MP3 encoder unavailable: is libmp3lame installed?");
+            return;
+        }
+        res.set_content(std::move(mp3), "audio/mpeg");
+        return;
+    }
+
