+// Ensure the model is loaded. When sleep is disabled this is a fast
+// check; when sleep is enabled the first call after idleness
+// transparently reloads the model. Returns the raw pointer on success
+// or nullptr on failure (err already set via qt_last_error). The
+// caller must not hold ModelState::mu across the qt_init call for
+// longer than the double-checked fast path.
+static struct qt_context * ensure_model_loaded(const std::shared_ptr<ModelState> & st, std::string & err) {
+    if (!st) {
+        err = "internal: missing model state";
+        return nullptr;
+    }
+    if (st->sleep_idle_seconds == -1) {
+        std::lock_guard<std::mutex> lk(st->mu);
+        if (!st->q) {
+            err = "model not loaded";
+            return nullptr;
+        }
+        return st->q;
+    }
+    // Sleep mode: fast path without blocking on reload.
+    {
+        std::lock_guard<std::mutex> lk(st->mu);
+        if (st->q) {
+            return st->q;
+        }
+    }
+    // Slow path: need to (re)load. Serialize concurrent wakers.
+    std::lock_guard<std::mutex> lk(st->mu);
+    if (st->q) {
+        return st->q;
+    }
+    fprintf(stderr, "[Server] waking up: loading model '%s' / '%s' ...\n", st->talker_path_s.c_str(),
+            st->codec_path_s.c_str());
+    auto                t0 = std::chrono::steady_clock::now();
+    struct qt_context * q2 = qt_init(&st->iparams);
+    if (!q2) {
+        err = qt_last_error();
+        if (err.empty()) {
+            err = "model reload failed";
+        }
+        fprintf(stderr, "[Server] reload failed: %s\n", err.c_str());
+        return nullptr;
+    }
+    st->q = q2;
+    st->last_activity.store(time(nullptr), std::memory_order_relaxed);
+    auto t1 = std::chrono::steady_clock::now();
+    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count();
+    fprintf(stderr, "[Server] model loaded in %lld ms (sleep idle=%ds)\n", (long long) ms, st->sleep_idle_seconds);
+    return st->q;
+}
+
+static void maybe_sleep(const std::shared_ptr<ModelState> & st) {
+    if (!st || st->sleep_idle_seconds < 0) {
+        return;
+    }
+    if (st->inflight.load(std::memory_order_relaxed) != 0) {
+        return;
+    }
+    time_t last = st->last_activity.load(std::memory_order_relaxed);
+    if (last == 0) {
+        return;  // never loaded, nothing to unload
+    }
+    time_t now = time(nullptr);
+    if (st->sleep_idle_seconds > 0 && now - last < st->sleep_idle_seconds) {
+        return;
+    }
+    // For sleep==0, any moment with inflight==0 qualifies.
+    std::lock_guard<std::mutex> lk(st->mu);
+    if (!st->q) {
+        return;
+    }
+    if (st->inflight.load(std::memory_order_relaxed) != 0) {
+        return;
+    }
+    time_t last2 = st->last_activity.load(std::memory_order_relaxed);
+    if (last2 == 0) {
+        return;
+    }
+    if (st->sleep_idle_seconds > 0 && time(nullptr) - last2 < st->sleep_idle_seconds) {
+        return;
+    }
+    if (st->sleep_idle_seconds == 0) {
+        fprintf(stderr, "[Server] no inflight requests, unloading model to free VRAM (sleep idle=0)...\n");
+    } else {
+        fprintf(stderr, "[Server] idle %ds, unloading model to free VRAM (sleep idle=%ds)...\n", st->sleep_idle_seconds,
+                st->sleep_idle_seconds);
+    }
+    qt_free(st->q);
+    st->q = nullptr;
+    fprintf(stderr, "[Server] model unloaded (sleeping), will reload on next request\n");
+}
+
+static void sleep_monitor_loop(std::shared_ptr<ModelState> st) {
+    if (!st || st->sleep_idle_seconds < 0) {
+        return;
+    }
+    // Poll interval: 1s normally, 200ms for idle==0 to make immediate
+    // sleep feel prompt without busy spinning.
+    auto interval = st->sleep_idle_seconds == 0 ? std::chrono::milliseconds(200) : std::chrono::seconds(1);
+    while (!st->stop.load(std::memory_order_relaxed)) {
+        std::this_thread::sleep_for(interval);
+        if (st->stop.load(std::memory_order_relaxed)) {
+            break;
+        }
+        maybe_sleep(st);
+    }
+}
