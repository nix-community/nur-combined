+// Sleep state: when --sleep-idle-seconds >=0 the model is loaded lazily
+// on the first synthesis/voice-extract request and unloaded after N
+// seconds of idleness (0 = unload as soon as inflight drops to 0).
+// -1 disables the feature (eager load, never sleep).
+struct ModelState {
+    std::mutex            mu;             // protects q existence
+    struct qt_context *   q = nullptr;    // guarded by mu
+    struct qt_init_params iparams{};      // deep copy for reload
+    std::string           talker_path_s;  // stable storage for iparams pointers
+    std::string           codec_path_s;
+    std::atomic<int>      inflight{ 0 };
+    std::atomic<time_t>   last_activity{ 0 };  // 0 = never loaded
+    std::atomic<bool>     stop{ false };
+    std::thread           monitor;
+    int                   sleep_idle_seconds = -1;
+};
