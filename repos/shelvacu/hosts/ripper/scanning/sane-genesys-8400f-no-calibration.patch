 }
 
+// Returns true if the environment variable is set, non-empty and not "0"
+inline bool get_env_flag(const char* name)
+{
+    const char* value = std::getenv(name);
+    return value != nullptr && value[0] != '\0' && std::strcmp(value, "0") != 0;
+}
+
+// Parses an environment variable holding exactly `count` comma-separated integers, each within
+// [min, max]. Returns an empty vector if the variable is unset or empty.
+inline std::vector<unsigned> get_env_unsigned_list(const char* name, std::size_t count,
+                                                   unsigned min, unsigned max)
+{
+    std::vector<unsigned> ret;
+    const char* value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return ret;
+    }
+    std::stringstream str{std::string{value}};
+    std::string item;
+    while (std::getline(str, item, ',')) {
+        char* end = nullptr;
+        unsigned long v = std::strtoul(item.c_str(), &end, 10);
+        if (item.empty() || *end != '\0' || v < min || v > max) {
+            throw SaneException(SANE_STATUS_INVAL, "%s: '%s' is not an integer in [%u, %u]",
+                                name, item.c_str(), min, max);
+        }
+        ret.push_back(static_cast<unsigned>(v));
+    }
+    if (ret.size() != count) {
+        throw SaneException(SANE_STATUS_INVAL, "%s: expected %zu comma-separated values, got %zu",
+                            name, count, ret.size());
+    }
+    return ret;
+}
+
