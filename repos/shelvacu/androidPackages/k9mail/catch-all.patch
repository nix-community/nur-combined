+                            addresses[0].getAddress().startsWith("*@")) {
+                        Toast.makeText(this, R.string.custom_from_invalid, Toast.LENGTH_LONG).show();
+                        return;
+                    }
+                    Identity newIdentity = baseIdentity.withEmail(addresses[0].getAddress());
