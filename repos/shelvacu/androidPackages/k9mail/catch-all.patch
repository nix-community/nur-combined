+    private val CATCH_ALL_RECIPIENT_TYPES = listOf(
+        RecipientType.X_ENVELOPE_TO,
+        RecipientType.X_ORIGINAL_TO,
+        RecipientType.TO,
+        RecipientType.CC,
+    )
+
+    /**
+     * Identities with an email of the form `*@example.com` are catch-all identities. If the message was sent to an
+     * address in that domain, return the identity with its email replaced by that address.
+     */
+    private fun getCatchAllIdentity(account: LegacyAccountDto, message: Message): Identity? {
+        val catchAllIdentities = account.identities.filter { isCatchAll(it) }
+        if (catchAllIdentities.isEmpty()) return null
+
+        return CATCH_ALL_RECIPIENT_TYPES.asSequence()
+            .flatMap { recipientType -> message.getRecipients(recipientType).asSequence() }
+            .mapNotNull { address ->
+                val domain = address.hostname ?: return@mapNotNull null
+                catchAllIdentities
+                    .find { it.email!!.substring(2).equals(domain, ignoreCase = true) }
+                    ?.withEmail(address.address)
+            }
+            .firstOrNull()
+    }
+
+    @JvmStatic
+    fun isCatchAll(identity: Identity): Boolean = identity.email?.startsWith("*@") == true
+
