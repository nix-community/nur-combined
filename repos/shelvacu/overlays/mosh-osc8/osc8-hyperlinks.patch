+bool Hyperlink::operator==( const Hyperlink& x ) const
+{
+  if ( rep == x.rep ) {
+    return true;
+  }
+  if ( rep == nullptr || x.rep == nullptr ) {
+    return false;
+  }
+
+  return rep->url == x.rep->url && rep->params == x.rep->params;
+}
+
+std::string Hyperlink::osc8() const
+{
+  std::string ret;
+
+  ret.append( "\033]8;" );
+
+  if ( *this )
+    ret.append( rep->params );
+  ret.append( ";" );
+  if ( *this )
+    ret.append( rep->url );
+
+  ret.append( "\033\\" );
+  return ret;
+}
