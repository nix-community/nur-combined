+void Vt102EmulationTest::testOsc8OnAlternateScreen()
+{
+    TestEmulation em;
+    em.reset();
+    em.setCodec(TestEmulation::Utf8Codec);
+    em.setUrlExtractorEnabled(true, {QStringLiteral("https://")});
+
+    const char link[] = "\033]8;;https://example.com\033\\Example\033]8;;\033\\";
+
+    em.receiveData(link, sizeof link - 1);
+    QCOMPARE(em._currentScreen->urlExtractor()->history().size(), qsizetype(1));
+
+    // Pagers such as less print on the alternate screen, hyperlinks have to
+    // be extracted there as well.
+    const char enterAlternateScreen[] = "\033[?1049h";
+    em.receiveData(enterAlternateScreen, sizeof enterAlternateScreen - 1);
+    QVERIFY(em._currentScreen->urlExtractor() != nullptr);
+
+    em.receiveData(link, sizeof link - 1);
+    QCOMPARE(em._currentScreen->urlExtractor()->history().size(), qsizetype(1));
+}
+
+void Vt102EmulationTest::testOsc8RowsMatchTextWhileScrolling()
+{
+    TestEmulation em;
+    em.reset();
+    em.setCodec(TestEmulation::Utf8Codec);
+    em.setUrlExtractorEnabled(true, {QStringLiteral("https://")});
+
+    const char enterAlternateScreen[] = "\033[?1049h";
+    em.receiveData(enterAlternateScreen, sizeof enterAlternateScreen - 1);
+
+    Screen *screen = em._currentScreen;
+    const int lines = screen->getLines();
+
+    // Start at the bottom, as a pager does when the shell prompt was there,
+    // and print more lines than fit so that the screen keeps scrolling.
+    const QByteArray toLastLine = QByteArrayLiteral("\033[") + QByteArray::number(lines) + QByteArrayLiteral(";1H");
+    em.receiveData(toLastLine.constData(), toLastLine.size());
+
+    for (int i = 1; i <= lines + 10; ++i) {
+        const QByteArray text = QByteArrayLiteral("Line") + QByteArray::number(i);
+        const QByteArray line = QByteArrayLiteral("\033]8;;https://example.com/") + QByteArray::number(i) + QByteArrayLiteral("\033\\") + text
+            + QByteArrayLiteral("\033]8;;\033\\\r\n");
+        em.receiveData(line.constData(), line.size());
+    }
+
+    const auto urls = em._currentScreen->urlExtractor()->history();
+    QVERIFY(!urls.isEmpty());
+
+    // Every recorded URL has to sit on the row that still shows its own text.
+    const int columns = screen->getColumns();
+    for (const auto &url : urls) {
+        const QString rowText = screen->text(url.begin.row * columns, (url.begin.row + 1) * columns - 1, Screen::PlainText);
+        QVERIFY2(rowText.contains(url.text),
+                 qPrintable(QStringLiteral("url %1 (%2) recorded on row %3 which shows '%4'")
+                                .arg(url.url, url.text, QString::number(url.begin.row), rowText.trimmed())));
+    }
+}
+
+void Vt102EmulationTest::testOsc8FollowsScrollingBack()
+{
+    TestEmulation em;
+    em.reset();
+    em.setCodec(TestEmulation::Utf8Codec);
+    em.setUrlExtractorEnabled(true, {QStringLiteral("https://")});
+
+    const char enterAlternateScreen[] = "\033[?1049h";
+    em.receiveData(enterAlternateScreen, sizeof enterAlternateScreen - 1);
+
+    Screen *screen = em._currentScreen;
+    const int lines = screen->getLines();
+
+    auto linkFor = [](int n) -> QByteArray {
+        const QByteArray text = QByteArrayLiteral("Line") + QByteArray::number(n);
+        return QByteArrayLiteral("\033]8;;https://example.com/") + QByteArray::number(n) + QByteArrayLiteral("\033\\") + text
+            + QByteArrayLiteral("\033]8;;\033\\");
+    };
+
+    // Fill the screen from the bottom, the way a pager does.
+    const QByteArray toLastLine = QByteArrayLiteral("\033[") + QByteArray::number(lines) + QByteArrayLiteral(";1H");
+    em.receiveData(toLastLine.constData(), toLastLine.size());
+    for (int i = 1; i <= lines * 2; ++i) {
+        const QByteArray line = linkFor(i) + QByteArrayLiteral("\r\n");
+        em.receiveData(line.constData(), line.size());
+    }
+
+    // Scroll back: the pager moves the screen down with a reverse index and
+    // draws the line that comes into view at the top.
+    for (int i = 5; i >= 1; --i) {
+        const QByteArray back = QByteArrayLiteral("\033[1;1H\033M") + linkFor(1000 + i);
+        em.receiveData(back.constData(), back.size());
+    }
+
+    const auto urls = screen->urlExtractor()->history();
+    QVERIFY(!urls.isEmpty());
+
+    const int columns = screen->getColumns();
+    for (const auto &url : urls) {
+        QVERIFY2(url.begin.row >= 0 && url.begin.row < screen->getLines(),
+                 qPrintable(QStringLiteral("url %1 (%2) recorded on row %3, outside the %4 line screen")
+                                .arg(url.url, url.text, QString::number(url.begin.row), QString::number(screen->getLines()))));
+        const QString rowText = screen->text(url.begin.row * columns, (url.begin.row + 1) * columns - 1, Screen::PlainText);
+        QVERIFY2(rowText.contains(url.text),
+                 qPrintable(QStringLiteral("url %1 (%2) recorded on row %3 which shows '%4'")
+                                .arg(url.url, url.text, QString::number(url.begin.row), rowText.trimmed())));
+    }
+}
+
+void Vt102EmulationTest::testOsc8FollowsAlternateScreenScrolling()
+{
+    TestEmulation em;
+    em.reset();
+    em.setCodec(TestEmulation::Utf8Codec);
+    em.setUrlExtractorEnabled(true, {QStringLiteral("https://")});
+
+    const char enterAlternateScreen[] = "\033[?1049h";
+    em.receiveData(enterAlternateScreen, sizeof enterAlternateScreen - 1);
+
+    // Print the link on the last line, as a pager does when the cursor was at
+    // the bottom of the screen, then scroll it up by one line.
+    const int lastLine = em._currentScreen->getLines();
+    const QByteArray toLastLine = QByteArrayLiteral("\033[") + QByteArray::number(lastLine) + QByteArrayLiteral(";1H");
+    em.receiveData(toLastLine.constData(), toLastLine.size());
+
+    const char link[] = "\033]8;;https://example.com\033\\Example\033]8;;\033\\\n";
+    em.receiveData(link, sizeof link - 1);
+
+    const auto urls = em._currentScreen->urlExtractor()->history();
+    QCOMPARE(urls.size(), qsizetype(1));
+    QCOMPARE(urls.at(0).begin.row, lastLine - 2);
+    QCOMPARE(urls.at(0).end.row, lastLine - 2);
+}
