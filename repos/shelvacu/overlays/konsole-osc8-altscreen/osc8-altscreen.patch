+void EscapeSequenceUrlExtractor::screenLinesInserted(int from, int to, int count)
+{
+    const int firstRow = _screen->getHistLines() + from;
+    const int lastRow = _screen->getHistLines() + to;
+
+    for (auto &url : _history) {
+        if (url.begin.row >= firstRow && url.begin.row <= lastRow) {
+            url.begin.row += count;
+            url.end.row += count;
+        }
+    }
+
+    _history.removeIf([lastRow](const ExtractedUrl &url) {
+        return url.begin.row > lastRow;
+    });
+}
