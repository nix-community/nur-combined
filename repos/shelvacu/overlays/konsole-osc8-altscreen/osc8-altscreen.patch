+void Emulation::setUrlExtractorEnabled(bool enable, const QStringList &allowedLinkSchema)
+{
+    for (Screen *screen : _screen) {
+        screen->setEnableUrlExtractor(enable);
+        if (EscapeSequenceUrlExtractor *extractor = screen->urlExtractor()) {
+            extractor->setAllowedLinkSchema(allowedLinkSchema);
+        }
+    }
+}
