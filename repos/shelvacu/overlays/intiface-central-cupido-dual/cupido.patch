From 0608b20ee67f689918889bdd90c4ecb81cff23de Mon Sep 17 00:00:00 2001
From: Shelvacu <git@shelvacu.com>
Date: Fri, 13 Nov 2026 11:53:55 -0800
Subject: [PATCH] cupido: support second vibrator

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../src/device/protocol_impl/cupido.rs        | 22 ++++++++++++++-----
 .../buttplug-device-config-v4.json            | 16 +++++++++++++-
 .../device-config-v4/protocols/cupido.yml     | 11 +++++++++-
 .../device-config-v4/version.yaml             |  2 +-
 .../tests/test_device_protocols.rs            |  4 ++--
 .../test_cupido_protocol.yaml                 | 15 ++++++++++++-
 6 files changed, 58 insertions(+), 12 deletions(-)

diff --git a/crates/buttplug_server/src/device/protocol_impl/cupido.rs b/crates/buttplug_server/src/device/protocol_impl/cupido.rs
index 644392c..e2d360c 100644
--- a/crates/buttplug_server/src/device/protocol_impl/cupido.rs
+++ b/crates/buttplug_server/src/device/protocol_impl/cupido.rs
@@ -5,7 +5,9 @@
 // Licensed under the BSD 3-Clause license. See LICENSE file in the project root
 // for full license information.
 
-use uuid::Uuid;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use uuid::{Uuid, uuid};
 
 use crate::device::{
   hardware::{HardwareCommand, HardwareWriteCmd},
@@ -14,23 +16,31 @@ use crate::device::{
 use buttplug_core::errors::ButtplugDeviceError;
 use buttplug_server_device_config::Endpoint;
 
+// Both motors share one frame, so they share a command id.
+const MOTOR_COMMAND_ID: Uuid = uuid!("0a3f0c8e-5d6b-4a2f-9e43-6f1c7b2d8e51");
+
 generic_protocol_setup!(Cupido, "cupido");
 
 #[derive(Default)]
-pub struct Cupido {}
+pub struct Cupido {
+  motors: [AtomicU8; 2],
+}
 
 impl ProtocolHandler for Cupido {
   fn handle_output_vibrate_cmd(
     &self,
-    _feature_index: u32,
-    feature_id: Uuid,
+    feature_index: u32,
+    _feature_id: Uuid,
     speed: u32,
   ) -> Result<Vec<HardwareCommand>, ButtplugDeviceError> {
+    self.motors[(feature_index as usize).min(1)].store(speed as u8, Ordering::Relaxed);
+    let motor1 = self.motors[0].load(Ordering::Relaxed);
+    let motor2 = self.motors[1].load(Ordering::Relaxed);
     Ok(vec![
       HardwareWriteCmd::new(
-        &[feature_id],
+        &[MOTOR_COMMAND_ID],
         Endpoint::Tx,
-        vec![0xb0, 0x03, 0, 0, 0, speed as u8, 0xaa],
+        vec![0xb0, 0x03, 0, 0, motor2, motor1, 0xaa],
         false,
       )
       .into(),
diff --git a/crates/buttplug_server_device_config/build-config/buttplug-device-config-v4.json b/crates/buttplug_server_device_config/build-config/buttplug-device-config-v4.json
index a85f6e0..585317c 100644
--- a/crates/buttplug_server_device_config/build-config/buttplug-device-config-v4.json
+++ b/crates/buttplug_server_device_config/build-config/buttplug-device-config-v4.json
@@ -1,7 +1,7 @@
 {
   "version": {
     "major": 4,
-    "minor": 189
+    "minor": 190
   },
   "protocols": {
     "activejoy": {
@@ -711,6 +711,7 @@
       "defaults": {
         "features": [
           {
+            "description": "Vibrator 1",
             "id": "7f645006-1074-415f-8b06-43aa473573c0",
             "index": 0,
             "output": {
@@ -721,6 +722,19 @@
                 ]
               }
             }
+          },
+          {
+            "description": "Vibrator 2",
+            "id": "3b9e2d47-8c1a-4f6e-b5d0-92a7e4c61f38",
+            "index": 1,
+            "output": {
+              "vibrate": {
+                "value": [
+                  0,
+                  255
+                ]
+              }
+            }
           }
         ],
         "id": "8ef3fe28-6903-4418-9dd8-5323788ca961",
diff --git a/crates/buttplug_server_device_config/device-config-v4/protocols/cupido.yml b/crates/buttplug_server_device_config/device-config-v4/protocols/cupido.yml
index 893516e..692ccb1 100644
--- a/crates/buttplug_server_device_config/device-config-v4/protocols/cupido.yml
+++ b/crates/buttplug_server_device_config/device-config-v4/protocols/cupido.yml
@@ -2,13 +2,22 @@
 defaults:
   name: Cupido Device
   features:
-  - id: 7f645006-1074-415f-8b06-43aa473573c0
+  - description: Vibrator 1
+    id: 7f645006-1074-415f-8b06-43aa473573c0
     output:
       vibrate:
         value:
         - 0
         - 255
     index: 0
+  - description: Vibrator 2
+    id: 3b9e2d47-8c1a-4f6e-b5d0-92a7e4c61f38
+    output:
+      vibrate:
+        value:
+        - 0
+        - 255
+    index: 1
   id: 8ef3fe28-6903-4418-9dd8-5323788ca961
 communication:
 - btle:
diff --git a/crates/buttplug_server_device_config/device-config-v4/version.yaml b/crates/buttplug_server_device_config/device-config-v4/version.yaml
index d9cf432..04e9442 100644
--- a/crates/buttplug_server_device_config/device-config-v4/version.yaml
