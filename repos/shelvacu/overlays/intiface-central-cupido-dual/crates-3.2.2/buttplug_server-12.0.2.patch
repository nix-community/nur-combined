+#[cfg(test)]
+mod tests {
+  use super::*;
+
+  fn data(cmds: Vec<HardwareCommand>) -> Vec<Vec<u8>> {
+    cmds
+      .into_iter()
+      .map(|c| match c {
+        HardwareCommand::Write(w) => w.data().clone(),
+        other => panic!("unexpected {other:?}"),
+      })
+      .collect()
+  }
+
+  #[test]
+  fn vibration_pattern() {
+    let c = Cupido::default();
+    let id = Uuid::nil();
+    // Not running: just remembered
+    assert!(data(c.handle_output_led_cmd(VIBRATION_PATTERN, id, 4).unwrap()).is_empty());
+    assert_eq!(
+      data(c.handle_output_vibrate_cmd(VIBRATION, id, 50).unwrap()),
+      vec![vec![0xb0, 0x01, 0, 0, 4, 50]]
+    );
+    assert_eq!(
+      data(c.handle_output_led_cmd(VIBRATION_PATTERN, id, 0).unwrap()),
+      vec![vec![0xb0, 0x01, 0, 0, 1, 50]]
+    );
+    // 0 and 1 are the same pattern
+    assert!(data(c.handle_output_led_cmd(VIBRATION_PATTERN, id, 1).unwrap()).is_empty());
+    assert_eq!(
+      data(c.handle_output_vibrate_cmd(VIBRATION, id, 0).unwrap()),
+      vec![vec![0xb0, 0x01, 0, 0, 0, 0]]
+    );
+  }
+
+  #[test]
+  fn tapping_pattern() {
+    let c = Cupido::default();
+    let id = Uuid::nil();
+    assert_eq!(
+      data(c.handle_output_vibrate_cmd(TAPPING, id, 255).unwrap()),
+      vec![vec![0xb0, 0x03, 0, 0, 0, 255, 0xaa]]
+    );
+    assert_eq!(
+      data(c.handle_output_led_cmd(TAPPING_PATTERN, id, 3).unwrap()),
+      vec![
+        vec![0xb0, 0x03, 0, 0, 0, 0, 0xaa],
+        vec![0xb0, 0x01, 0, 1, 3, 100]
+      ]
+    );
+    assert_eq!(
+      data(c.handle_output_vibrate_cmd(TAPPING, id, 1).unwrap()),
+      vec![vec![0xb0, 0x01, 0, 1, 3, 1]]
+    );
+    assert_eq!(
+      data(c.handle_output_led_cmd(TAPPING_PATTERN, id, 0).unwrap()),
+      vec![
+        vec![0xb0, 0x01, 0, 1, 0, 0],
+        vec![0xb0, 0x03, 0, 0, 0, 1, 0xaa]
+      ]
+    );
+  }
