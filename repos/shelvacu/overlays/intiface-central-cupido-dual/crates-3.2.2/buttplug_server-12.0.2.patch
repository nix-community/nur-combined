+const TAPPING: u32 = 0;
+const VIBRATION: u32 = 1;
+const VIBRATION_PATTERN: u32 = 2;
+const TAPPING_PATTERN: u32 = 3;
+
+// Motor ids in the B0 01 pattern frame
+const VIBRATION_MOTOR: u8 = 0;
+const TAPPING_MOTOR: u8 = 1;
+
 #[derive(Default)]
-pub struct Cupido {}
+pub struct Cupido {
+  tapping_level: AtomicU32,
+  vibration_level: AtomicU32,
+  // 0 = default: pattern 1 for vibration, direct level (B0 03) for tapping
+  vibration_pattern: AtomicU32,
+  tapping_pattern: AtomicU32,
+}
+
+fn pattern_frame(motor: u8, pattern: u32, strength: u32) -> Vec<u8> {
+  let pattern = if strength == 0 { 0 } else { pattern as u8 };
+  vec![0xb0, 0x01, 0, motor, pattern, strength as u8]
+}
+
+fn direct_frame(level: u32) -> Vec<u8> {
+  vec![0xb0, 0x03, 0, 0, 0, level as u8, 0xaa]
+}
+
+impl Cupido {
+  fn vibration_frame(&self) -> Vec<u8> {
+    let pattern = self.vibration_pattern.load(Ordering::Relaxed).max(1);
+    pattern_frame(
+      VIBRATION_MOTOR,
+      pattern,
+      self.vibration_level.load(Ordering::Relaxed),
+    )
+  }
+
+  fn tapping_frame(&self) -> Vec<u8> {
+    let level = self.tapping_level.load(Ordering::Relaxed);
+    match self.tapping_pattern.load(Ordering::Relaxed) {
+      0 => direct_frame(level),
+      // Pattern strength is 0-100, the tapping feature is 0-255
+      pattern => {
+        let strength = if level == 0 {
+          0
+        } else {
+          ((level * 100 + 127) / 255).max(1)
+        };
+        pattern_frame(TAPPING_MOTOR, pattern, strength)
+      }
+    }
+  }
+
+  fn set_tapping_pattern(&self, pattern: u32) -> Vec<Vec<u8>> {
+    let old = self.tapping_pattern.swap(pattern, Ordering::Relaxed);
+    if self.tapping_level.load(Ordering::Relaxed) == 0 || old == pattern {
+      return vec![];
+    }
+    let stop_old = if old == 0 {
+      direct_frame(0)
+    } else {
+      pattern_frame(TAPPING_MOTOR, 0, 0)
+    };
+    vec![stop_old, self.tapping_frame()]
+  }
+}
+
+fn write(feature_id: Uuid, frames: Vec<Vec<u8>>) -> Vec<HardwareCommand> {
+  frames
+    .into_iter()
+    .map(|data| HardwareWriteCmd::new(&[feature_id], Endpoint::Tx, data, false).into())
+    .collect()
+}
 
 impl ProtocolHandler for Cupido {
   fn handle_output_vibrate_cmd(
     &self,
-    _feature_index: u32,
+    feature_index: u32,
     feature_id: Uuid,
     speed: u32,
   ) -> Result<Vec<HardwareCommand>, ButtplugDeviceError> {
-    Ok(vec![
-      HardwareWriteCmd::new(
-        &[feature_id],
-        Endpoint::Tx,
-        vec![0xb0, 0x03, 0, 0, 0, speed as u8, 0xaa],
-        false,
-      )
-      .into(),
-    ])
+    let frame = match feature_index {
+      TAPPING => {
+        self.tapping_level.store(speed, Ordering::Relaxed);
+        self.tapping_frame()
+      }
+      VIBRATION => {
+        self.vibration_level.store(speed, Ordering::Relaxed);
+        self.vibration_frame()
+      }
+      _ => return self.command_unimplemented("OutputCmd (Vibrate Actuator)"),
+    };
+    Ok(write(feature_id, vec![frame]))
+  }
+
+  fn handle_output_led_cmd(
+    &self,
+    feature_index: u32,
+    feature_id: Uuid,
+    level: u32,
+  ) -> Result<Vec<HardwareCommand>, ButtplugDeviceError> {
+    let frames = match feature_index {
+      VIBRATION_PATTERN => {
+        let old = self.vibration_pattern.swap(level, Ordering::Relaxed);
+        if self.vibration_level.load(Ordering::Relaxed) == 0 || old.max(1) == level.max(1) {
+          vec![]
+        } else {
+          vec![self.vibration_frame()]
+        }
+      }
+      TAPPING_PATTERN => self.set_tapping_pattern(level),
+      _ => return self.command_unimplemented("OutputCmd (Led Actuator)"),
+    };
+    Ok(write(feature_id, frames))
   }
 
