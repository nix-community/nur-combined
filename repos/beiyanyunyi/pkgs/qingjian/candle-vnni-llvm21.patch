+    #[target_feature(enable = "avx2,avxvnni")]
+    unsafe fn _mm256_dpbusd_avx_epi32(mut acc: __m256i, unsigned: __m256i, signed: __m256i) -> __m256i {
+        core::arch::asm!(
+            "{{vex}} vpdpbusd {acc}, {unsigned}, {signed}",
+            acc = inout(ymm_reg) acc,
+            unsigned = in(ymm_reg) unsigned,
+            signed = in(ymm_reg) signed,
+            options(pure, nomem, nostack, preserves_flags),
+        );
+        acc
+    }
