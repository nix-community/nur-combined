{
  lib,
  buildGoModule,
  go_1_26,
  pkg-config,
  wrapGAppsHook3,
  copyDesktopItems,
  makeDesktopItem,
  gtk3,
  webkitgtk_4_1,
  wayland,
  xdg-utils,
  desktop-file-utils,
  sources,
}:

let
  # nvfetcher keeps the upstream tag verbatim, with its "v" prefix.
  version = lib.removePrefix "v" sources.magpie.version;
in
(buildGoModule.override { go = go_1_26; }) (finalAttrs: {
  pname = "magpie";
  inherit version;
  src = sources.magpie.src;

  # Only the app; the module also holds the Windows launcher and the icon
  # generator, which have no place in a Linux package.
  subPackages = [ "." ];

  # Regenerated by scripts/update.py (hash of the Go module vendor tree).
  vendorHash = "sha256-CSFUYQB28DBs0oQSObJEqu07+b7T7DKxINQVu+lHNUw=";

  nativeBuildInputs = [
    pkg-config
    wrapGAppsHook3
    copyDesktopItems
  ];

  # The Linux desktop build is the cgo/GTK 3 build from the upstream
  # Makefile: Wails' default GTK 4 and WebKitGTK 6 would leave out older
  # distributions. wayland is a pkg-config dependency of the clipboard
  # shim (gtk+-3.0 wayland-client).
  buildInputs = [
    gtk3
    webkitgtk_4_1
    wayland
  ];

  env.CGO_ENABLED = 1;
  tags = [
    "production"
    "gtk3"
  ];

  ldflags = [
    "-s"
    "-w"
    "-X main.version=${finalAttrs.version}"
  ];

  # The upstream suite exercises WSL interop, a session D-Bus and a real zsh;
  # none exist in the build sandbox, so its failures say nothing about the
  # package. Compile and install without running it.
  doCheck = false;

  # gappsWrapperArgs is a shell array initialised by wrapGAppsHook3, so the
  # extra entries have to be appended from preFixup rather than an attribute.
  preFixup = ''
    gappsWrapperArgs+=(
      --prefix PATH : "${lib.makeBinPath [
        xdg-utils
        desktop-file-utils
      ]}"
    )
  '';

  postInstall = ''
    install -Dm644 internal/gui/icon-256.png \
      $out/share/icons/hicolor/256x256/apps/magpie.png
  '';

  desktopItems = [
    (makeDesktopItem {
      name = "magpie";
      exec = "magpie %u";
      icon = "magpie";
      desktopName = "magpie";
      comment = "Every agent's model. One place.";
      categories = [
        "Development"
        "Utility"
      ];
      mimeTypes = [ "x-scheme-handler/magpie" ];
      startupWMClass = "magpie";
    })
  ];

  meta = {
    description = "Local gateway and desktop app that puts every AI coding agent's model in one place";
    homepage = "https://github.com/yetone/magpie";
    changelog = "https://github.com/yetone/magpie/releases/tag/v${finalAttrs.version}";
    license = lib.licenses.mit;
    mainProgram = "magpie";
    # go.mod needs 1.26.8; the older go_1_26 in nixos-25.11 would fail before
    # reading it, and nixpkgs pins GOTOOLCHAIN=local so Go cannot fetch one.
    broken = lib.versionOlder go_1_26.version "1.26.8";
    platforms = lib.platforms.linux;
  };
})
