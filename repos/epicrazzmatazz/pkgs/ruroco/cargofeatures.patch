-anyhow = "1.0"
+clap = { version = "4.5", features = ["derive", "string"] }
+openssl = { version = "0.10" }
+serde = { version = "1.0", features = ["derive"] }
+toml = { version = "0.9", optional = true }
+slint = { version = "1.10", optional = true }
+# only needed for client to update itself
+reqwest = { version = "0.12", features = ["blocking", "json"], optional = true }
+
+# android dependencies
+jni = { version = "0.21", optional = true }
+ndk-context = { version = "0.1", optional = true }
 
 [dev-dependencies]
 test-with = { version = "*", default-features = false, features = [] }
 tempfile = "3.23.0"
 
+[build-dependencies]
+slint-build = { version = "1.9.2", optional = true }
+
 [lib]
 crate-type = ["lib", "cdylib"]
 
 [features]
 release-build = ["openssl/vendored"]
-android-build = ["slint/backend-android-activity-06"]
+android-build = ["dep:ndk-context", "slint/backend-android-activity-06"]
+server = ["dep:toml"]
+client-gui = ["dep:slint", "dep:toml", "dep:slint-build", "client-nogui"]
+client-nogui = ["dep:reqwest"]
 
-[build-dependencies]
-slint-build = "1.9.2"
+[[bin]]
+name = "ruroco-client"
+path = "src/bin/client.rs"
+required-features = ["client-nogui"]
+
+[[bin]]
+name = "ruroco-client-ui"
+path = "src/bin/client_ui.rs"
+required-features = ["client-gui"]
+
+[[bin]]
+name = "ruroco-server"
+path = "src/bin/server.rs"
+required-features = ["server"]
+
+[[bin]]
+name = "ruroco-commander"
+path = "src/bin/commander.rs"
+required-features = ["server"]
 
 [profile.dev]
 opt-level = 0
