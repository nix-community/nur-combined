From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NUR-Repo <nur@example.invalid>
Date: Sat, 7 Nov 2026 00:00:00 +0000
Subject: [PATCH] pathops: replace unstable `isolate_lowest_one`

`usize::isolate_lowest_one` is still unstable (rust-lang/rust#136909),
so the crate fails to compile on the stable toolchain nixpkgs ships.
Use the equivalent stable expression, matching what upstream `main`
does.

---
 crates/pathops/src/budget.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/pathops/src/budget.rs b/crates/pathops/src/budget.rs
--- a/crates/pathops/src/budget.rs
+++ b/crates/pathops/src/budget.rs
@@ -112,7 +112,7 @@ impl Fenwick {
         let mut i = rank + 1;
         while let Some(c) = self.0.get_mut(i) {
             *c += by;
-            i += i.isolate_lowest_one();
+            i += i & i.wrapping_neg();
         }
     }
 
@@ -123,7 +123,7 @@ impl Fenwick {
             && let Some(c) = self.0.get(i)
         {
             n += c;
-            i -= i.isolate_lowest_one();
+            i -= i & i.wrapping_neg();
         }
         u64::try_from(n).unwrap_or(0)
     }
