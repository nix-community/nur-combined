{
  "name": "yaqmc",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/ci/verify-release-bundle.mjs --renderer dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "test:playwright": "playwright test",
    "test:e2e:electron": "playwright test -c playwright.electron.config.ts",
    "docs:check": "node scripts/check-public-docs.mjs",
    "plugins:pack": "node scripts/pack-example-plugins.mjs",
    "plugin:build": "node scripts/build-plugin-examples.mjs",
    "plugin:build:provider-example": "node scripts/build-provider-component-example.mjs",
    "plugin:build:provider-platform-example": "node scripts/build-provider-component-example.mjs platform-example",
    "plugin:build:host-fixture": "node scripts/build-provider-component-example.mjs host-fixture",
    "plugin:verify:provider-example": "npm run plugin:build:provider-example && cargo run --quiet -p yaqmc-core --example verify-provider-component -- examples/plugins/provider-catalog-rust/component/provider.wasm",
    "plugin:pack:provider-example": "npm run plugin:verify:provider-example && npm run plugin:validate && node scripts/pack-example-plugins.mjs --provider-example",
    "plugin:pack:provider-platform-example": "npm run plugin:build:provider-platform-example && npm run plugin:validate && node scripts/pack-example-plugins.mjs --provider-platform-example",
    "plugin:verify:provider-platform-example": "npm run plugin:pack:provider-platform-example && cargo test -p yaqmc-core --test plugin_provider_example complete_platform_component_exercises_capabilities_and_lifecycle -- --exact",
    "plugin:validate": "node scripts/validate-example-plugins.mjs",
    "plugin:pack": "npm run plugin:build && npm run plugin:validate && node scripts/pack-example-plugins.mjs",
    "pages:build": "node scripts/build-pages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run docs:check && npm run lint && npm run test && npm run build",
    "ci:frontend-build": "tsc -b && vite build && node scripts/ci/verify-release-bundle.mjs --renderer dist && node scripts/ci/write-frontend-build-info.mjs",
    "release:bundle:check": "node scripts/ci/verify-release-bundle.mjs --renderer dist --desktop apps/desktop/dist",
    "ci:package-metadata": "node scripts/ci/write-build-info.mjs",
    "ci:test-scripts": "node --test scripts/ci/*.test.mjs",
    "ci:verify-workspace": "node scripts/ci/verify-workspace-contract.mjs",
    "provenance:report": "node scripts/validate-provenance-ledger.mjs",
    "provenance:enforce": "node scripts/validate-provenance-ledger.mjs --enforce",
    "provider:readiness": "node scripts/ci/p14c-readiness.mjs",
    "provider:enforce": "node scripts/ci/p14c-readiness.mjs --enforce",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "contracts:update": "node scripts/update-contract-fixtures.mjs",
    "contracts:check": "node scripts/update-contract-fixtures.mjs --check",
    "android:check": "node scripts/ci/verify-android-project.mjs && node scripts/build-android.mjs --variant debug --skip-web --skip-sync --skip-gradle && node scripts/run-android-gradle.mjs :app:testDebugUnitTest",
    "android:build:debug": "node scripts/build-android.mjs --variant debug",
    "android:build:release": "node scripts/build-android.mjs --variant release --stage-to release-android",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "stage-core": "node scripts/stage-core.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "p7:fake-playback": "node scripts/migration/p7-fake-playback.mjs",
    "soak": "node scripts/soak-electron.mjs",
    "perf:windows-gpu": "node scripts/migration/lyrics-multiwindow-gpu-profile.mjs",
    "perf:lyrics-occlusion": "node scripts/migration/lyrics-occlusion-lifecycle-diag.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "0.5.2",
    "@applemusic-like-lyrics/react": "0.5.2",
    "@capacitor/app": "8.1.1",
    "@yaqmc/client": "*",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "stackblur-canvas": "^3.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    },
    "js-yaml": "4.3.2",
    "uuid": "11.1.1"
  }
}
