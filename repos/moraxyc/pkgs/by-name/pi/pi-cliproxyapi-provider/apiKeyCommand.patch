+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { CONFIG_FILE_NAME, resolveConnection, runApiKeyCommand } from "../extensions/lib.ts";
+
+const dirs: string[] = [];
+
+afterEach(() => {
+	vi.unstubAllEnvs();
+	for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function makeFixture(key = "secret-from-command") {
+	const dir = mkdtempSync(join(tmpdir(), "pi-cpa-secret-test-"));
+	dirs.push(dir);
+	const command = join(dir, "secret-tool-mock");
+	writeFileSync(command, `#!/bin/sh\nprintf '%s\\n' '${key}'\n`, { mode: 0o700 });
+	const config = { baseUrl: "http://127.0.0.1:8317", apiKeyCommand: { command, args: ["lookup", "service", "codex-cpa"] } };
+	writeFileSync(join(dir, CONFIG_FILE_NAME), JSON.stringify(config));
+	return { dir, command };
+}
+
+describe("apiKeyCommand", () => {
+	it("runs an argv-based command and uses its trimmed output", () => {
+		const { dir } = makeFixture();
+		expect(resolveConnection(dir, "cliproxyapi")?.apiKey).toBe("secret-from-command");
+	});
+
+	it("gives CLIPROXYAPI_API_KEY precedence without executing the command", () => {
+		const { dir, command } = makeFixture();
+		writeFileSync(command, "#!/bin/sh\nexit 12\n", { mode: 0o700 });
+		vi.stubEnv("CLIPROXYAPI_API_KEY", "from-env");
+		expect(resolveConnection(dir, "cliproxyapi")?.apiKey).toBe("from-env");
+	});
+
+	it("rejects empty, malformed, and failing commands without leaking output", () => {
+		expect(() => runApiKeyCommand({ command: "" })).toThrow(/must contain/);
+		expect(() => runApiKeyCommand({ command: "echo", args: [3] as unknown as string[] })).toThrow(/must contain/);
+		const { command } = makeFixture();
+		writeFileSync(command, "#!/bin/sh\nprintf 'sensitive-error' >&2\nexit 1\n", { mode: 0o700 });
+		expect(() => runApiKeyCommand({ command })).toThrow(/^cliproxyapi\.json: "apiKeyCommand" failed$/);
+	});
+
+	it("rejects an empty command result", () => {
+		const { command } = makeFixture();
+		writeFileSync(command, "#!/bin/sh\nexit 0\n", { mode: 0o700 });
+		expect(() => runApiKeyCommand({ command })).toThrow(/empty API key/);
+	});
+});

