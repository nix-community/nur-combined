+/** Run a configured secret lookup without a shell or leaking subprocess output. */
+export function runApiKeyCommand(value: CliproxyConfigFile["apiKeyCommand"]): string {
+	if (
+		!value ||
+		typeof value !== "object" ||
+		typeof value.command !== "string" ||
+		!value.command.trim() ||
+		(value.args !== undefined && (!Array.isArray(value.args) || !value.args.every((arg) => typeof arg === "string")))
+	) {
+		throw new Error('cliproxyapi.json: "apiKeyCommand" must contain a command and optional string[] args');
+	}
+
+	let output: string;
+	try {
+		output = execFileSync(value.command, value.args ?? [], {
+			encoding: "utf8",
+			timeout: 5000,
+			maxBuffer: 65536,
+			stdio: ["ignore", "pipe", "pipe"],
+		});
+	} catch {
+		// Do not surface child-process errors: they may contain secret stdout/stderr.
+		throw new Error('cliproxyapi.json: "apiKeyCommand" failed');
+	}
+
+	const key = output.trim();
+	if (!key) throw new Error('cliproxyapi.json: "apiKeyCommand" returned an empty API key');
+	return key;
+}
