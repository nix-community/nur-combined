+func TestCheckUploadLocalPath_SymlinkChains(t *testing.T) {
+	tmp := t.TempDir()
+	for _, dir := range []string{"public", ".ssh"} {
+		if err := os.Mkdir(filepath.Join(tmp, dir), 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(tmp, "public", "report.txt"), []byte("report"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, link := range [][2]string{
+		{"public-link", "public/report.txt"},
+		{"public-dir", "public"},
+		{"id_rsa", "public/report.txt"},
+		{".ssh/key", "../public/report.txt"},
+		{"innocent.txt", ".ssh/key"},
+		{"credentials", ".ssh"},
+		{"loop", "loop"},
+	} {
+		if err := os.Symlink(link[1], filepath.Join(tmp, link[0])); err != nil {
+			t.Fatal(err)
+		}
+	}
+	g := NewGuard()
+	for _, tc := range []struct {
+		path    string
+		wantErr bool
+	}{
+		{"public-link", false},
+		{"public-dir/report.txt", false},
+		{"id_rsa", true},
+		{".ssh/key", true},
+		{"innocent.txt", true},
+		{"credentials/key", true},
+		{"loop", true},
+	} {
+		t.Run(tc.path, func(t *testing.T) {
+			err := g.CheckUploadLocalPath(filepath.Join(tmp, tc.path))
+			if (err != nil) != tc.wantErr {
+				t.Errorf("CheckUploadLocalPath(%q): got %v, want error=%v", tc.path, err, tc.wantErr)
+			}
+		})
+	}
