+DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "modeltrace"
+DATA.mkdir(parents=True, exist_ok=True)
+# Seed writable banks without overwriting user data, even on concurrent startup.
+for source in (PROJECT / "data").iterdir():
+    target = DATA / source.name
+    if target.exists():
+        continue
+    with tempfile.NamedTemporaryFile(dir=DATA) as temporary:
+        with source.open("rb") as handle:
+            shutil.copyfileobj(handle, temporary)
+        temporary.flush()
+        try:
+            os.link(temporary.name, target)
+        except FileExistsError:
+            pass
+CUSTOM_BANKS_FILE = DATA / "custom_banks.json"
+UNIFIED_BANK_FILE = DATA / "unified_bank.json"
 DEFAULT_BANK_ID = "claude"
 
 
